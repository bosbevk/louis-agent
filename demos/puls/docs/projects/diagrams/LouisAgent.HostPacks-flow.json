{
  "kind": "flow",
  "type": "activity",
  "title": "LouisAgent.HostPacks: start-up, step by step",
  "caption": "The Puls program asks for its catalogue once at start-up: the names in IDENTITIES and PACKS become enums, each identity brings its packs, and the catalogue refuses what doesn't fit before any engine is built.",
  "flow": {
    "direction": "down",
    "nodes": [
      {
        "id": "start",
        "label": "LouisAgent.PulsApi\nstarts",
        "icon": "terminal",
        "tone": "blue",
        "shape": "terminal"
      },
      {
        "id": "env",
        "label": "Load config/.env\nread IDENTITIES and PACKS",
        "icon": "settings",
        "tone": "green"
      },
      {
        "id": "known",
        "label": "Every name\nknown?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "stop",
        "label": "Stop start-up\nname the supported ones",
        "icon": "shield",
        "tone": "red",
        "shape": "terminal"
      },
      {
        "id": "identities",
        "label": "Create each identity",
        "icon": "user",
        "tone": "green"
      },
      {
        "id": "packs",
        "label": "Add the packs it names\nto those named alone, once each",
        "icon": "box",
        "tone": "green"
      },
      {
        "id": "catalogue",
        "label": "AgentCatalog checks:\na name twice, a cycle,\na shared tool name",
        "icon": "checks",
        "tone": "violet"
      },
      {
        "id": "fits",
        "label": "It fits?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "end",
        "label": "AgentHost builds\nevery engine from it",
        "icon": "chip",
        "tone": "green",
        "shape": "terminal"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "env"
      },
      {
        "from": "env",
        "to": "known"
      },
      {
        "from": "known",
        "to": "stop",
        "word": "no"
      },
      {
        "from": "known",
        "to": "identities",
        "word": "yes"
      },
      {
        "from": "identities",
        "to": "packs"
      },
      {
        "from": "packs",
        "to": "catalogue"
      },
      {
        "from": "catalogue",
        "to": "fits"
      },
      {
        "from": "fits",
        "to": "stop",
        "word": "no"
      },
      {
        "from": "fits",
        "to": "end",
        "word": "yes"
      }
    ]
  }
}

@page "/admin/prompts"
@layout AdminLayout

@* CL27: every built-in prompt as its header says it, from GET /v1/admin/prompts: its name and file, the level it runs
   at, what it is, and the toolsets it always loads. The model reads only each file's body. *@

<PageTitle>Prompts · Puls Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Prompts</h1>
        <p>Every built-in prompt: its modes, roles, minions, toolset guides and principles, as each file's header says it.</p>
    </div>
    <div class="page-actions">
        <button class="header-button" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Reload</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

@if (_loading && _prompts is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else if (_prompts is { } prompts)
{
    <section class="card-p prompts">
        <table class="prompts-table">
            <thead>
                <tr><th>Prompt</th><th>Level</th><th>What it is</th><th>Always loads</th></tr>
            </thead>
            <tbody>
                @foreach (var prompt in prompts)
                {
                    <tr class="prompt-row">
                        <td><code>@prompt.Name</code><small class="muted prompt-path">@prompt.Path</small></td>
                        <td class="prompt-level">@Shown(prompt.Level)</td>
                        <td>@prompt.Description</td>
                        <td>@Shown(prompt.Toolsets)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

      { "id": "areas", "name": "SiteAreas", "kind": "louis-agent.web, what the site has", "tone": "violet",
        "members": [ "+PageAssemblies" ] },
      { "id": "addresses", "name": "SiteAddresses", "kind": "louis-agent.web, the rule both ways", "tone": "violet",
        "members": [ "+From(home, assemblies) SiteAddresses", "+Read(address)", "+PageType(page) Type?" ] },
      { "id": "section", "name": "SectionPage", "kind": "the catch-all route, /{*Path}",

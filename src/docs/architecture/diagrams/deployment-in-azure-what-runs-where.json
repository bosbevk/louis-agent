{
  "kind": "flow",
  "type": "deployment",
  "title": "The framework's two sites in Azure: what runs where",
  "caption": "Two apps in one environment in rg-louis-agent-za, on no network of ours, each asleep until someone visits: they share an identity that reads the vault and a share that holds each one's logs in a folder of its own.",
  "flow": {
    "nodes": [
      { "id": "person", "shape": "terminal", "icon": "user", "tone": "blue", "label": "A visitor's browser" },
      { "id": "dns", "icon": "world", "tone": "red", "label": "Cloudflare, DNS-only\nlouis-agent.dev, framework." },
      { "id": "site", "icon": "server", "tone": "green", "label": "louis-agent-app\nlouis-agent.dev, the public Orbi", "group": "env" },
      { "id": "framework", "icon": "server", "tone": "green", "label": "louis-agent-framework-app\nframework.louis-agent.dev, the framework Orbi", "group": "env" },
      { "id": "identity", "icon": "shield", "tone": "teal", "label": "louis-agent-app-identity\nKey Vault Secrets User" },
      { "id": "vault", "shape": "data", "icon": "shield", "tone": "amber", "label": "Key Vault puls-keys\nevery secret value" },
      { "id": "share", "shape": "data", "icon": "folder", "tone": "amber", "label": "pulsstorage, louis-agent-workspace\nlogs/, data/, framework/logs/" },
      { "id": "registry", "shape": "data", "icon": "box", "tone": "amber", "label": "Registry acrpulsza\nlouis-agent-site, louis-agent-site-framework" },
      { "id": "insights", "icon": "chart", "tone": "violet", "label": "Application Insights\npuls-insights, on puls-logs" },
      { "id": "model", "icon": "chip", "tone": "red", "label": "Anthropic\nClaude Haiku 5.5" }
    ],
    "edges": [
      { "from": "person", "to": "dns", "word": "HTTPS" },
      { "from": "dns", "to": "site" },
      { "from": "dns", "to": "framework" },
      { "from": "site", "to": "identity", "word": "reads with", "style": "dashed" },
      { "from": "framework", "to": "identity", "style": "dashed" },
      { "from": "identity", "to": "vault", "style": "dashed" },
      { "from": "site", "to": "share" },
      { "from": "framework", "to": "share" },
      { "from": "registry", "to": "site", "word": "AcrPull", "style": "dashed" },
      { "from": "site", "to": "insights" },
      { "from": "framework", "to": "insights" },
      { "from": "site", "to": "model" },
      { "from": "framework", "to": "model" }
    ],
    "groups": [
      { "id": "env", "label": "louis-agent-env, Consumption, asleep at no replicas" }
    ]
  }

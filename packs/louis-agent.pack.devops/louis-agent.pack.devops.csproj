<Project Sdk="Microsoft.NET.Sdk">

  <!-- Azure DevOps as tools: work items, sprints and team queries. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.DevOps</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, the toolset's guide is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.devops.tests" />
    <InternalsVisibleTo Include="louis-agent.pack.devops.integration-tests" />
    <InternalsVisibleTo Include="louis-agent.coding-catalog.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

</Project>

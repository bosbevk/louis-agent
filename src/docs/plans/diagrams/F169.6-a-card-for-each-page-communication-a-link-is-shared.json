{
  "kind": "sequence",
  "title": "F169.6 a card for each page: a link to Getting started is shared",
  "caption": "The crawler runs no script, so everything it shows is in the head the host writes. The handler asks for the card of the route it matched, never of the address it was asked for.",
  "sequence": {
    "participants": [
      { "id": "C", "icon": "user", "tone": "blue", "label": "A platform's crawler", "actor": true },
      { "id": "H", "icon": "box", "tone": "green", "label": "SitePageHandler" },
      { "id": "P", "icon": "code", "tone": "green", "label": "PageCards" },
      { "id": "W", "icon": "file", "tone": "amber", "label": "The web root" },
      { "id": "S", "icon": "code", "tone": "green", "label": "PageShell" }
    ],
    "steps": [
      { "step": "message", "from": "C", "to": "H", "text": "GET /getting-started" },
      { "step": "note", "over": ["H"], "text": "the route is /getting-started, its page rendered once and kept" },
      { "step": "message", "from": "H", "to": "P", "text": "For(\"/getting-started\")  (step 4)" },
      { "step": "message", "from": "P", "to": "W", "text": "social-cards/getting-started.png and .txt" },
      { "step": "reply", "from": "W", "to": "P", "text": "both are there" },
      { "step": "reply", "from": "P", "to": "H", "text": "a PageCard: the picture's path, and its words" },
      { "step": "message", "from": "H", "to": "S", "text": "Fill(index, page, site, route, card)  (step 3)" },
      { "step": "reply", "from": "S", "to": "H", "text": "the head: og:image on the site's own address, og:image:alt its words" },
      { "step": "reply", "from": "H", "to": "C", "text": "the page's HTML" },
      { "step": "message", "from": "C", "to": "W", "text": "GET /social-cards/getting-started.png" },
      { "step": "reply", "from": "W", "to": "C", "text": "the picture, 2400 by 1260, served as the file it is" },
      { "step": "note", "over": ["C"], "text": "the card shows: louis-agent, Getting started, Your agent, in two lines." }
    ]
  }
}

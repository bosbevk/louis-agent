@* F18 step 6a.3: the blind review. The judge's verdict and reason sit inside the JudgeShown branch, so before this reviewer grades they are not in the markup at all. *@
<section class="review-panel">
    <h4 class="review-question">@QuestionText</h4>
    <div class="review-ask">
        @foreach (var ask in Asked)
        {
            <p>@ask</p>
        }
    </div>
    @if (Answer is not null)
    {
        <div class="review-answer markdown">@LouisAgent.Web.Shared.Text.Markdown.ToHtml(Answer)</div>
    }
    @if (!HasName)
    {
        <p class="review-need-name">Who is grading? Type your name once, and it is kept in this browser.</p>
        <input class="review-name" placeholder="Your name" maxlength="@ReviewerName.MaxLength" @bind="_typedName" />
        <button type="button" class="review-name-keep" @onclick="KeepNameAsync">Keep</button>
    }
    <textarea class="review-note" placeholder="A note (optional)" maxlength="2000" @bind="_note"></textarea>
    <div class="review-buttons">
        <button type="button" class="review-pass" disabled="@(!HasName || _busy)" @onclick='() => GradeAsync("pass")'>Pass</button>
        <button type="button" class="review-fail" disabled="@(!HasName || _busy)" @onclick='() => GradeAsync("fail")'>Fail</button>
        <button type="button" class="review-unsure" disabled="@(!HasName || _busy)" @onclick='() => GradeAsync("unsure")'>Unsure</button>
    </div>
    @if (_error is not null)
    {
        <p class="review-error">@_error</p>
    }
    @if (JudgeShown && PersonVerdict is not null && JudgeGrade is { } judge)
    {
        <p class="review-result">@ResultText</p>
        <p class="review-judge">@JudgeText @judge.Reason</p>
    }
</section>

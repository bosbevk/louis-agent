@using Microsoft.AspNetCore.Components.Routing
@* A sidebar link for each screen the packs offer, and Uploads if one takes a file; with none, no heading is left on its own. *@
@if (_screens.Count > 0 || _takesUploads)
{
    <div class="sidebar-label">Packs</div>
    <nav class="side-nav">
        @foreach (var screen in _screens)
        {
            <NavLink @key="screen.Name" class="side-link" href="@AddressOf(screen)"><span class="ic i-file" aria-hidden="true"></span>@screen.Title</NavLink>
        }
        @if (_takesUploads)
        {
            <NavLink class="side-link" href="admin/imports"><span class="ic i-archive" aria-hidden="true"></span>Uploads</NavLink>
        }
    </nav>
}

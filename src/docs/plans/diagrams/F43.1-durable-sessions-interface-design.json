{
  "kind": "classes",
  "title": "F43.1 durable sessions: the interface design",
  "caption": "AgentSessions keeps its sessions in memory as today and writes each one through ISessionStore, which a setting fills with the in-memory or the MongoDB store. A session is saved as how it opened and then its turns; resumed, it is opened again from that request with its history restored. The number in brackets is the step that builds it.",
  "classes": {
    "types": [
      { "id": "sessions", "name": "AgentSessions", "members": ["+Create(request) AgentSession", "+GetAsync(id) AgentSession?  (4)", "+Remove(id)", "saves the opening, each turn  (3)"] },
      { "id": "store", "name": "ISessionStore", "kind": "interface", "members": ["+SaveOpeningAsync(StoredSession)  (2)", "+AppendTurnAsync(id, StoredTurn)  (2)", "+LoadAsync(id) SavedSession?  (2)", "+DeleteAsync(id)  (2)"] },
      { "id": "memory", "name": "InMemorySessionStore", "members": ["a dictionary per process  (2)"] },
      { "id": "mongo", "name": "MongoSessionStore", "members": ["sessions, turns collections  (5)", "TTL on last activity  (5)"] },
      { "id": "opening", "name": "StoredSession", "kind": "record", "members": ["+Id, the opening request", "+Attachments, Turns", "+LastActivity  (2)"] },
      { "id": "turn", "name": "StoredTurn", "kind": "record", "members": ["+Number", "+Messages (JSON, thinking kept)  (2)"] },
      { "id": "options", "name": "SessionStoreOptions", "kind": "record", "members": ["+Store memory | mongo", "+Url (secret), +Retention 30 days  (6)"] },
      { "id": "session", "name": "AgentSession", "members": ["+History", "restored from its turns  (4)"] },
      { "id": "opener", "name": "SessionOpening", "members": ["+Open(), with a given id  (4)"] }
    ],
    "relations": [
      { "from": "sessions", "to": "store", "kind": "uses" },
      { "from": "memory", "to": "store", "kind": "implements" },
      { "from": "mongo", "to": "store", "kind": "implements" },
      { "from": "store", "to": "opening", "kind": "holds" },
      { "from": "store", "to": "turn", "kind": "holds" },
      { "from": "sessions", "to": "opener", "kind": "uses" },
      { "from": "opener", "to": "session", "kind": "creates" },
      { "from": "options", "to": "store", "kind": "uses" }
    ]
  }
}

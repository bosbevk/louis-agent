@* A way to the coding agent, from the header and from the landing page: its chat when the chat is open to visitors,
   else its recorded session (SiteDoors, FX88, F120), so no door on the site leads nowhere. *@
@if (SiteDoors.CodingAgent)
{
    <a class="@Class" href="@Address">@ChildContent</a>
}
else
{
    <a class="@Class" href="@Recording">@Watch</a>
}

@inherits LayoutComponentBase
@* The framework's site frame, filled with what's this site's own: its name, its pages, the way to the chat and its
   footer lines. The router draws every page in it but the chat's, which keeps its own full-screen layout. *@

<SiteShell Layout="PageLayout.Flow" MovingPage="true" AnswerUnder="true" ShowIndex="false" ShowWayUp="false">
    <Brand><Wordmark Before="l" After="uis-agent" /></Brand>
    <Tagline>The website that answers.</Tagline>
    <Stage><StageFlag Label="alpha-1" Note="This is version alpha-1. You may run into inconsistencies while it is built." LinkText="Tell us what you find" Href="/contact" /></Stage>
    <Links>
        @* The framework's pages are hidden from the menu for now, kept until they are fixed (FX176). *@
        <SiteMenu Label="Demos">
            <NavLink href="/demos" Match="NavLinkMatch.All">All demos</NavLink>
            <NavLink href="/guesthouse-demo" Match="NavLinkMatch.All">A guesthouse</NavLink>
            <NavLink href="/restaurant-demo" Match="NavLinkMatch.All">A restaurant</NavLink>
            <NavLink href="/law-practice-demo" Match="NavLinkMatch.All">A law practice</NavLink>
        </SiteMenu>
        <NavLink href="/contact" Match="NavLinkMatch.All">Contact</NavLink>
        <SiteMenu Label="The framework" Hidden="true">
            <NavLink href="/framework/how-it-works" Match="NavLinkMatch.All">How it works</NavLink>
            <NavLink href="/framework/architecture" Match="NavLinkMatch.All">Architecture</NavLink>
            <NavLink href="/framework/identities" Match="NavLinkMatch.All">Identities</NavLink>
            <NavLink href="/framework/packs" Match="NavLinkMatch.All">Packs</NavLink>
            <NavLink href="/framework/build-your-own" Match="NavLinkMatch.All">Build your own</NavLink>
            <NavLink href="/framework/measured" Match="NavLinkMatch.All">Measured</NavLink>
            <NavLink href="/framework/built-on-it" Match="NavLinkMatch.All">Built on it</NavLink>
            <NavLink href="/framework/whats-coming" Match="NavLinkMatch.All">What's coming</NavLink>
            <NavLink href="/framework/theme" Match="NavLinkMatch.All">The theme</NavLink>
            <NavLink href="/csharp-ai-agent-framework" Match="NavLinkMatch.All">Compared</NavLink>
        </SiteMenu>
    </Links>
    <Settings><CvLink /></Settings>
    <Footer>
        <span><Wordmark Before="l" After="uis-agent" /> · all rights reserved · <a class="footer-link" href="https://www.linkedin.com/in/louismarais86" target="_blank" rel="noopener"><LinkedInMark /> LinkedIn</a> · <a class="footer-link" href="/privacy">Privacy</a></span>
        <span>The website that answers.</span>
    </Footer>
    <Corner><ExpertChat /></Corner>
    <ChildContent>@Body</ChildContent>
</SiteShell>

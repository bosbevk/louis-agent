<Project Sdk="Microsoft.NET.Sdk">

  <!-- What an agent team triages a service's errors with (F106.3.1): the error feed a department's workflow reads, the
       recorder of a run's steps, the decision tools whose records are checked in code, a person's endpoint and the run
       read back. Needs one setting, TRIAGE_RUNS, and no network. References the composition's contracts only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Triage</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, toolsets/triage.md is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.triage.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.triage.md" Link="docs\louis-agent.pack.triage.md" />
    <None Include="..\..\..\src\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

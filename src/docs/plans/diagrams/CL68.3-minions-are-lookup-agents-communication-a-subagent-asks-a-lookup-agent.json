{
  "kind": "sequence",
  "title": "CL68.3: a subagent asks a lookup agent",
  "caption": "The address is the name: the base and the voice are read from the agent's folder, and the run is on the model LOOKUP_LLMS names.",
  "sequence": {
    "participants": [
      { "id": "asker", "label": "testprod.specialist", "icon": "users", "tone": "green" },
      { "id": "ask", "label": "AskAgent", "icon": "exchange", "tone": "violet" },
      { "id": "addresses", "label": "AgentAddresses", "icon": "search", "tone": "teal" },
      { "id": "lookupask", "label": "LookupAsk", "icon": "chip", "tone": "violet" },
      { "id": "lookup", "label": "testprod.lookup", "icon": "search", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "asker", "to": "ask", "text": "AskAgent(\"testprod.lookup\", task, tool: \"FetchUrl\")" },
      { "step": "message", "from": "ask", "to": "addresses", "text": "ResolveLookup(testprod.lookup)" },
      { "step": "reply", "from": "addresses", "to": "ask", "text": "the lookup agent, role testprod.lookup" },
      { "step": "message", "from": "ask", "to": "lookupask", "text": "one task, one of the asker's tools" },
      { "step": "message", "from": "lookupask", "to": "lookup", "text": "a sub-session at depth 2: lookup.md, then its voice, on LOOKUP_LLMS" },
      { "step": "reply", "from": "lookup", "to": "asker", "text": "a few lines, each with its source" }
    ]
  }
}

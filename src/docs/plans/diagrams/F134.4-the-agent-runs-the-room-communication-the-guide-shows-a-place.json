      {
        "id": "guide",
        "label": "The guide",
        "icon": "server",
        "tone": "violet"
      },
      {
        "id": "bar",
        "label": "AgentBar",
        "icon": "box",
        "tone": "green"
      },
      {
        "id": "script",
        "label": "The widget's script",
        "icon": "code",
        "tone": "green"
      },
      {
        "id": "demo",
        "label": "A demo's player",
        "icon": "play",
        "tone": "blue"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "guide",
        "to": "bar",
        "text": "streams: words"
      },
      {
        "step": "message",
        "from": "bar",
        "to": "demo",
        "text": "talking: hold"
      },
      {
        "step": "message",
        "from": "guide",
        "to": "script",
        "text": "ShowPage: lights the place"
      },
      {
        "step": "message",
        "from": "bar",
        "to": "script",

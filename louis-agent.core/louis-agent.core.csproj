<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LouisAgent.Core</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Keeps the embedded prompts' folder paths (ManifestEmbeddedFileProvider). -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
      <!-- F18 step 1c: core reads a peer's stream through the one session-stream reader (CL11); the reader references nothing. -->
      <ProjectReference Include="..\louis-agent.session-stream\louis-agent.session-stream.csproj" />
    </ItemGroup>

  <ItemGroup>
      <InternalsVisibleTo Include="louis-agent.core.tests" />
      <!-- The API's file browser applies the same workspace and secret-file rules as the agent's tools. -->
      <InternalsVisibleTo Include="louis-agent.api" />
      <!-- The orchestrator runs git and dotnet against the service it watches without a shell, like the tools do. -->
      <InternalsVisibleTo Include="louis-agent.orchestrator" />
      <InternalsVisibleTo Include="louis-agent.orchestrator.tests" />
      <PackageReference Include="Anthropic" Version="12.53.0" />
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
      <PackageReference Include="dotenv.net" Version="4.2.0" />
      <PackageReference Include="ExcelDataReader" Version="3.9.0" />
      <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
      <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Composite" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
      <PackageReference Include="OllamaSharp" Version="5.5.0" />
      <PackageReference Include="PdfPig" Version="0.1.16" />
      <PackageReference Include="PuppeteerSharp" Version="25.14.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- CL8 step 4: the built-in prompts live in Prompts/, one folder per level beside toolsets/, and are read only from
           the assembly (Skills/SkillFileSource), by their own paths through the manifest. What the agent writes stays on
           disk, in the skills folder (SKILLS_DIRECTORY, else the repo's Skills/). -->
      <EmbeddedResource Include="Prompts\**\*.md;Prompts\**\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
             built or copied. -->
        <None Include="..\docs\projects\louis-agent.core.md" Link="docs\louis-agent.core.md" />
        <None Include="..\docs\guides\change-the-engine.md" Link="docs\change-the-engine.md" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Diagrams</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.diagrams.tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- A diagram's kind, a card's icon and a link's direction are enums read by their wire names (ADR 0024). -->
    <ProjectReference Include="..\..\engine\louis-agent.choices\louis-agent.choices.csproj" />
  </ItemGroup>

  <!-- CL60.1 (Louis's pick P1 A): the framework's diagrams as plain C#, with no Blazor and no ASP.NET, so the site's
       GraphView and the docs' tool draw with the same code (ADR 0092: what is reused together is one project). It
       references only louis-agent.choices, which references nothing, and no package. -->

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is built or
         copied. -->
    <None Include="..\..\docs\projects\louis-agent.diagrams.md" Link="docs\louis-agent.diagrams.md" />
    <None Include="..\..\docs\guides\draw-a-diagram.md" Link="docs\draw-a-diagram.md" />
  </ItemGroup>

</Project>

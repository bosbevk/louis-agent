@* F14: the currency costs are shown in, in this browser; the server's (the PC's region) until changed here. *@
@using louis_agent.web.Services
@inject CurrencyState Currency
@implements IDisposable

@if (Currency.Choices.Count > 1 && Currency.Current is { } current)
{
    <label class="settings" title="@(current.Converts ? $"1 {current.Base} = {current.Rate} {current.Code} on {current.AsOf}; the ledger keeps what was charged" : "As charged")">
        Currency
        <select value="@current.Code" @onchange="Change">
            @foreach (var (currency, symbol) in Currency.Choices)
            {
                <option value="@currency">@(symbol == currency ? currency : $"{currency} ({symbol})")</option>
            }
        </select>
    </label>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Currency.Changed += Redraw;
        await Currency.LoadAsync();
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private async Task Change(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { } chosen) await Currency.ChooseAsync(chosen);
    }

    public void Dispose() => Currency.Changed -= Redraw;
}
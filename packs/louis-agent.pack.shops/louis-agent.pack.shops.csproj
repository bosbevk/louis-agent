<Project Sdk="Microsoft.NET.Sdk">

  <!-- What an agent can do with shops (CL15, ADR 0027, 0028): a shop's products, specials and promotions from its own
       catalogue, read through core's guarded browser; one provider today (Checkers, F33, F34), and the town geocoder the
       Checkers store lookup uses (OpenStreetMap's Nominatim), until the places feature takes it. References core only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Shops</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.shops.tests" />
    <InternalsVisibleTo Include="louis-agent.pack.shops.integration-tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\louis-agent.core\louis-agent.core.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.shops.md" Link="docs\louis-agent.pack.shops.md" />
    <None Include="..\..\docs\guides\add-a-shop.md" Link="docs\add-a-shop.md" />
    <None Include="..\..\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

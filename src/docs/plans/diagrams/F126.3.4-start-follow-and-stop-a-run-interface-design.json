      { "id": "player", "name": "ConversationPlayer", "kind": "changed in step 2", "members": ["adds a turn's marks' costs"] },
      { "id": "turn", "name": "TurnRun", "kind": "record, changed in step 2", "members": ["decimal? JudgeCost { get; init; }"] },

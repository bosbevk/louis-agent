@page "/admin/runs/{RunId}"
@layout AdminLayout
@implements IDisposable

@* F31 step 10: one stored run, read from the benchmark store. F53.1: the answer first (the verdict under the head),
   then one tab at a time, the tab in the address: the summary (results by category, pass rates, the trends), the
   explorer (RunExplorer), the judge against people, the notes, and what it ran with. *@

<PageTitle>Run @RunId · Admin</PageTitle>

<RunHead RunId="@RunId" Run="_run?.Run" Check="@_check" Title="@_title" Currency="Currency.Current" />

@if (_error is { } error)
{
    <section class="card-p admin-gate"><strong>@error</strong></section>
}
else if (_run is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else
{
    @if (_run.Run.StoreError is { } storeError)
    {
        <section class="card-p store-banner"><strong>Not all of this run was stored.</strong><p>@storeError</p></section>
    }
    <RunVerdict RunId="@RunId" View="RunVerdictView.Of(_run, _trend)" Currency="Currency.Current" />
    <RunTabBar RunId="@RunId" Active="ActiveTab" />
    @switch (ActiveTab)
    {
        case RunTab.Conversations:
            @* No entrance animation on this card: a filled transform animation makes it the frame of every fixed
               child, so the explorer's chats modal would be clipped to the card and painted under the cards after it. *@
            <section class="card-p holds-modal">
                <RunExplorer Run="_run" Currency="Currency.Current" Place="_place" OnMoved="Moved" />
            </section>
            break;
        case RunTab.Judge:
            @if (_run.Agreement.Count == 0)
            {
                <section class="card-p"><p class="muted judge-none">No judge of this run has a blind review by a person yet, so there is nothing to compare.</p></section>
            }
            <AgreementPanel Agreement="_run.Agreement" RunId="@RunId" />
            break;
        case RunTab.Notes:
            <section class="card-p">
                <NotesPanel RunId="@RunId" Notes="NoteReader.Of(_run.Run.Id, _run.Notes)" />
            </section>
            break;
        case RunTab.Settings:
            <RunSettings Run="_run" />
            break;
        default:
            <section class="card-p">
                <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Results by category<span class="fold-note">per mode: overall, then each category</span></summary>
                    <SummaryPanel Summaries="_run.Summaries" RunId="@_run.Run.Id" Currency="Currency.Current" />
                </details>
            </section>
            <section class="card-p">
                <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Pass rates per mode<span class="fold-note">as the runner wrote them on the last repeat</span></summary>
                    <ModeRatesList Modes="_run.Modes" />
                </details>
            </section>
            @if (_trend is { } trend)
            {
                <section class="card-p">
                    <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Trend<span class="fold-note">this check over its runs, this run marked</span></summary>
                        <TrendChart Series="trend.Modes" Highlight="@RunId" Labels="_labels" ShowTitle="false" Currency="Currency.Current" />
                    </details>
                </section>
                <section class="card-p">
                    <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Trend by category<span class="fold-note">pass@k and pass^k per category, per model</span></summary>
                        <CategoryTrends Categories="trend.Categories" Highlight="@RunId" Currency="Currency.Current" />
                    </details>
                </section>
            }
            break;
    }
}

# The framework's site's secrets (F124) - COPY TO .env.secrets AND FILL IN YOUR VALUES. .env.secrets is git-ignored and
# is never committed.
#
# Anthropic API key, for the guide's turns (https://console.anthropic.com). Without it the pages still serve, and the
# guide can't answer.
ANTHROPIC_API_KEY=
# Key for the site's API: required (FX18). The guide's door lets a visitor in without it; everything else needs it.
AGENT_API_KEY=
# Resend's key, for the guide's lead mail (F112). Without it the lead goes to the log.
# RESEND_API_KEY=

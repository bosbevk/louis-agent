    @* A lit stage (F134.1): a light from above, a pool of it on the floor and the floor's lines, in one colour, behind
   whatever stands on it. The three are decoration, kept in a layer of their own that is cut at the stage's edge, so
   what stands on the stage is never cut by it. *@
<div class="@Classes">
    <span class="lit-back" aria-hidden="true">
        <span class="lit-floor"></span>
        <span class="lit-light"></span>
        <span class="lit-pool"></span>
    </span>
    @ChildContent
</div>

{
  "kind": "nested",
  "title": "The files view: what it is made of",
  "caption": "The view holds the workspace's tree beside the file that's open; a file opened in the tree is read from the API, and a question about it goes to the chat.",
  "nested": {
    "subtitle": "LouisAgent.Packs.Files.Web, Views / FilesView",
    "root": {
      "id": "view",
      "name": "FilesView",
      "kind": "a pack's view",
      "tone": "green",
      "aside": "admin/screens/workspace-files",
      "in": [
        "Screen"
      ],
      "holds": [
        {
          "id": "tree",
          "name": "FileTree",
          "kind": "a folder",
          "tone": "green",
          "note": "one folder; a sub-folder loads when first opened, a FileTree of its own",
          "in": [
            "Path",
            "Depth",
            "SelectedPath"
          ],
          "out": [
            "OnOpenFile"
          ]
        },
        {
          "id": "viewer",
          "name": "FileViewer",
          "kind": "a panel",
          "tone": "green",
          "note": "the open file, its lines numbered and highlighted",
          "in": [
            "File",
            "Busy"
          ],
          "out": [
            "OnReview",
            "OnAsk",
            "OnClose"
          ]
        }
      ]
    },
    "around": [
      {
        "id": "screen",
        "name": "an admin screen",
        "side": "before",
        "tone": "blue",
        "kind": "screen",
        "heading": "Who puts it on a page",
        "note": "the framework's screens, which name the view",
        "gives": [
          "Screen"
        ]
      },
      {
        "id": "api",
        "name": "AgentApi",
        "side": "after",
        "tone": "teal",
        "heading": "What it asks",
        "note": "the workspace's folders and files",
        "calls": "ListFolderAsync, ReadFileAsync"
      },
      {
        "id": "handoff",
        "name": "ChatHandoff",
        "side": "after",
        "tone": "teal",
        "heading": "What it hands on",
        "note": "a prompt for the chat, waiting in its box",
        "calls": "hands"
      }
    ]
  }
}

# LLM profile a session may name (F30), not one an instance runs on: Puls's price lookups (puls-prices) on a local
# model, while Puls and its cook stay on LLM_PROFILE's (Claude). Listed in LLM_SESSION_PROFILES on puls-agent
# (docker/docker-compose.puls.yml); a sub-session opened with "llm": "ollama-puls" runs here.
# Only this file's settings and the API keys apply: nothing else is taken from the instance's profile.
#
# Ollama runs natively on Windows for an AMD card (Docker Desktop doesn't pass AMD GPUs to containers), with the
# context, flash attention and KV cache set as in docs/MODELS.md (Native Ollama on Windows). Pull the model first:
#   ollama pull qwen3:4b-instruct-2507-q4_K_M

LLM_PROVIDER=ollama
# The instruct variant answers without thinking and makes real tool calls (Local triage, https://github.com/bosbevk/louis-agent/blob/pre-cl10/docs/BENCHMARKS.md). It reads
# English far better than Afrikaans: the role and the task it gets are in English.
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Ollama's port on the host, from the containers and from the host (see .env.ollama).
LLM_ENDPOINT=http://host.docker.internal:11434

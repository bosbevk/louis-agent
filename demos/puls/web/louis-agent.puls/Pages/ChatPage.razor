@page "/gesels"
@page "/verken"
@page "/studio"
@page "/gesels/{SessionId}"
@page "/chat/{SessionId}"
@implements IDisposable

@* Puls on the framework's chat frame: its logo, its views, its empty chat and its words. *@

@{
    RenderFragment Explore = @<ChatViews View="@View" Recent="Store.Chats.Where(c => !c.Archived).Take(5).ToList()" OnStart="StartTemplate" OnNewProject='() => _shell.ComingSoonAsync("Projekte")' />;
}

<ChatShell @ref="_shell" SessionId="@SessionId" ChatPath="gesels" Title="Puls" OpenSession="OpenSessionAsync" VoicePrefix="puls/voice-" DefaultLanguage="af"
           BrandTitle="Puls se tuisblad" Tagline="Elke vraag op pad na 'n antwoord" ViewTitle="@ViewTitle" ViewContent="@(View == "chat" ? null : Explore)"
           EmptyWorkImage="brand/puls-mark.svg" WorkAvatar="brand/puls-icon-tile.svg">
    <Logo><PulsLogo /></Logo>
    <Views>
        <a class="side-link" href="./"><span class="ic i-home" aria-hidden="true"></span>Tuis</a>
        <a class="side-link @(View == "verken" ? "active" : "")" href="verken"><span class="ic i-compass" aria-hidden="true"></span>Verken</a>
        <a class="side-link @(View == "studio" ? "active" : "")" href="studio"><span class="ic i-sparkle" aria-hidden="true"></span>Studio</a>
    </Views>
    <Profile><ProfileCard /></Profile>
    @* The landing's water, low behind an empty chat: across the column, under the messages. *@
    <Background><Water /></Background>
    <Empty Context="empty"><EmptyChat Composer="empty.MessageBox" Streaming="empty.Streaming" OnDraft="empty.OnDraft" OnSuggest="empty.OnSuggest" /></Empty>
    <UsageLine Context="chatUsage">Hierdie gesprek: @chatUsage.Requests versoeke · @UsageFormat.Tokens(chatUsage.TotalTokens) tokens · @UsageFormat.Cost(chatUsage, Currency.Current), spesialiste ingesluit</UsageLine>
</ChatShell>

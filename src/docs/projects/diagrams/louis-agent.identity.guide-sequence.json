{
  "kind": "sequence",
  "title": "louis-agent.identity.guide: one question answered",
  "caption": "It reads the skill for the job before it speaks, names no price, and the place it names opens in the visitor's browser.",
  "sequence": {
    "participants": [
      {
        "id": "visitor",
        "label": "A visitor",
        "actor": true,
        "tone": "blue"
      },
      {
        "id": "guide",
        "label": "The guide",
        "icon": "chip",
        "tone": "green"
      },
      {
        "id": "site",
        "label": "site pack",
        "icon": "browser",
        "tone": "violet"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "visitor",
        "to": "guide",
        "text": "how much is a website with an agent?"
      },
      {
        "step": "note",
        "over": [
          "guide"
        ],
        "text": "ReadSkill what-we-sell"
      },
      {
        "step": "message",
        "from": "guide",
        "to": "site",
        "text": "ShowPage(\"/contact\")"
      },
      {
        "step": "reply",
        "from": "site",
        "to": "visitor",
        "text": "the browser opens the contact page"
      },
      {
        "step": "reply",
        "from": "guide",
        "to": "visitor",
        "text": "no price list: Louis quotes each site after a short call"
      },
      {
        "step": "block",
        "block": "opt",
        "label": "the visitor wants Louis to call, and says yes",
        "steps": [
          {
            "step": "note",
            "over": [
              "guide"
            ],
            "text": "SendLead, once"
          }
        ]
      }
    ]
  }
}

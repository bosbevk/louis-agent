@using Microsoft.AspNetCore.Components.Routing
@* The packs area's sidebar links (F144): the packs page, then each screen the packs offer, and Uploads if one takes a
   file; with none, no heading is left on its own. *@
@if (!_offer.IsEmpty)
{
    <div class="sidebar-label">Packs</div>
    <nav class="side-nav">
        <NavLink class="side-link" href="admin/packs"><span class="ic i-archive" aria-hidden="true"></span>All packs</NavLink>
        @foreach (var screen in _offer.Screens)
        {
            <NavLink @key="screen.Name" class="side-link pack-link" href="@PackOffer.AddressOf(screen)"><span class="ic i-file" aria-hidden="true"></span>@screen.Title</NavLink>
        }
        @if (_offer.Uploads.Count > 0)
        {
            <NavLink class="side-link pack-link" href="admin/imports"><span class="ic i-archive" aria-hidden="true"></span>Uploads</NavLink>
        }
    </nav>
}

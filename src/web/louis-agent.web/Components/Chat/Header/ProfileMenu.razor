@* The profile (a guest until accounts come): credits, the theme (dark; the others to come), profile, settings, admin, sign out. *@
<div class="dropdown">
    <button class="profile-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Text.Profile">@Text.GuestInitial</button>
    <ul class="dropdown-menu dropdown-menu-end profile-menu">
        <li class="profile-menu-head">
            <span class="profile-avatar">@Text.GuestInitial</span>
            <span class="profile-who"><strong>@Text.Guest</strong><small>@Text.LocalOnly</small></span>
        </li>
        <li><button class="dropdown-item" type="button" @onclick="() => OnComingSoon.InvokeAsync(Text.Credits)"><span class="ic i-coin" aria-hidden="true"></span>@Text.BuyCredits</button></li>
        <li><hr class="dropdown-divider" /></li>
        <li><h6 class="dropdown-header">@Text.Theme</h6></li>
        <li><button class="dropdown-item active" type="button"><span class="ic i-moon" aria-hidden="true"></span>@Text.ThemeDark <span class="ic i-check ms-auto" aria-hidden="true"></span></button></li>
        <li><button class="dropdown-item" type="button" @onclick="() => OnComingSoon.InvokeAsync(Text.ThemeLightSoon)"><span class="ic i-sun" aria-hidden="true"></span>@Text.ThemeLight</button></li>
        <li><button class="dropdown-item" type="button" @onclick="() => OnComingSoon.InvokeAsync(Text.ThemeAutoSoon)"><span class="ic i-auto" aria-hidden="true"></span>@Text.ThemeAuto</button></li>
        <li><hr class="dropdown-divider" /></li>
        <li><button class="dropdown-item" type="button" @onclick="() => OnComingSoon.InvokeAsync(Text.Profile)"><span class="ic i-user" aria-hidden="true"></span>@Text.Profile</button></li>
        <li><button class="dropdown-item" type="button" onclick="chatUi.openSettings()"><span class="ic i-cog" aria-hidden="true"></span>@Text.Settings</button></li>
        @* The admin portal; the API's admin key gates it, not this menu. *@
        <li><a class="dropdown-item" href="admin"><span class="ic i-sliders" aria-hidden="true"></span>Admin</a></li>
        <li><button class="dropdown-item" type="button" @onclick="() => OnComingSoon.InvokeAsync(Text.SignOut)"><span class="ic i-logout" aria-hidden="true"></span>@Text.SignOut</button></li>
    </ul>
</div>

@page "/gesels"
@page "/gesels/{SessionId}"
@page "/chat/{SessionId}"
@using System.Net
@using System.Text.Json
@inject AgentApi Api
@inject ChatStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CurrencyState Currency
@implements IDisposable

<PageTitle>@(_chat?.Title ?? "Puls")</PageTitle>

<div class="app">
    @* Below Bootstrap's lg breakpoint (992px) the sidebar is an offcanvas, opened from this bar. *@
    <header class="topbar d-lg-none">
        <button class="icon menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Maak die kieslys oop">☰</button>
        <div class="brand"><PulsLogo /></div>
        <button class="icon" type="button" @onclick="NewChat" aria-label="Nuwe gesprek">＋</button>
    </header>

    <aside class="sidebar offcanvas-lg offcanvas-start" id="sidebar" tabindex="-1" aria-label="Gesprekke">
        <div class="sidebar-top">
            <a class="brand brand-stack" href="./" title="Puls se tuisblad"><PulsLogo /><span class="tagline">Elke vraag op pad na 'n antwoord</span></a>
            <button class="icon d-none d-lg-inline-grid" type="button" onclick="pulsUi.toggleSidebar()" title="Versteek die kantbalk" aria-label="Versteek die kantbalk">⇤</button>
            <button class="icon d-lg-none" type="button" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Maak die kieslys toe">×</button>
        </div>
        <button class="new-chat" @onclick="NewChat">Nuwe gesprek</button>
        <button class="side-search" id="search-button" type="button" @onclick="() => _searchOpen = true">
            <span class="ic i-search" aria-hidden="true"></span>Soek gesprekke<kbd>Ctrl K</kbd>
        </button>
        <nav class="side-nav">
            <a class="side-link" href="./"><span class="ic i-home" aria-hidden="true"></span>Tuis</a>
            <button class="side-link" type="button" @onclick='() => ComingSoon("Verken")'><span class="ic i-compass" aria-hidden="true"></span>Verken</button>
            <button class="side-link" type="button" @onclick='() => ComingSoon("Studio")'><span class="ic i-sparkle" aria-hidden="true"></span>Studio</button>
        </nav>

        <div class="chat-list">
            @if (Store.Chats.Any(c => c.Favourite && !c.Archived))
            {
                <div class="sidebar-label">Gunstelinge</div>
                @foreach (var chat in Store.Chats.Where(c => c.Favourite && !c.Archived))
                {
                    @ChatItem(chat)
                }
            }

            <div class="sidebar-label sidebar-label-row">Projekte
                <button class="icon" type="button" title="Nuwe projek" @onclick='() => ComingSoon("Projekte")'>+</button>
            </div>
            <button class="side-link side-link-quiet" type="button" @onclick='() => ComingSoon("Projekte")'><span class="ic i-folder" aria-hidden="true"></span>Nuwe projek</button>

            @if (Store.Chats.Any(c => !c.Favourite && !c.Archived))
            {
                <div class="sidebar-label">Onlangs</div>
                @foreach (var chat in Store.Chats.Where(c => !c.Favourite && !c.Archived))
                {
                    @ChatItem(chat)
                }
            }

            @if (Store.Chats.Count(c => c.Archived) is > 0 and var archived)
            {
                <details class="side-archive">
                    <summary><span class="ic i-archive" aria-hidden="true"></span>Geargiveer <span class="side-count">@archived</span></summary>
                    @foreach (var chat in Store.Chats.Where(c => c.Archived))
                    {
                        @ChatItem(chat)
                    }
                </details>
            }
        </div>

        <div class="side-footer">
            @* A placeholder profile until Puls has accounts (step 5 adds its menu). *@
            <div class="profile-card">
                <span class="profile-avatar">G</span>
                <span class="profile-who"><strong>Gas</strong><small>Plaaslik · gratis</small></span>
            </div>
            <details class="sidebar-settings">
                <summary>Instellings</summary>
                <CurrencySwitcher />
                @* Where the user is (F22): typed, or found by the browser and named by OpenStreetMap's Nominatim. Kept in this
                   browser; sent with a new chat only when set. *@
                <label class="settings">
                    Ligging
                    <input type="text" value="@_location" @onchange="SaveLocation" placeholder="bv. Pretoria" maxlength="120" />
                </label>
                <div class="locate">
                    <button class="locate-button" type="button" @onclick="UseMyLocation" disabled="@_locating">
                        <span class="ic i-pin" aria-hidden="true"></span>@(_locating ? "Soek…" : "Gebruik my ligging")
                    </button>
                    <small>Name: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a></small>
                </div>
                <label class="settings">
                    API-sleutel
                    <input type="password" value="@Store.ApiKeyDraft" @onchange="SaveApiKey" placeholder="net as AGENT_API_KEY gestel is" />
                </label>
            </details>
        </div>
    </aside>

    @* Drag to resize the sidebar; double-click to reset (pulsUi in js/chat.js). *@
    <div class="resizer d-none d-lg-block" role="separator" aria-orientation="vertical" title="Sleep om die breedte te verander · dubbelklik om terug te stel"></div>

    <main class="conversation">
        @* The top bar (lg and up): the chat's title and menu, then the Werk panel, Kry Plus, language and profile. *@
        <header class="chat-header d-none d-lg-flex">
            <button class="icon header-sidebar" type="button" onclick="pulsUi.toggleSidebar()" title="Wys die kantbalk" aria-label="Wys die kantbalk">⇥</button>
            <div class="chat-heading">
                @if (_chat is null)
                {
                    <span class="chat-title muted">Nuwe gesprek</span>
                }
                else if (_renaming == _chat.SessionId && _renameInHeader)
                {
                    <input id="rename-input" class="rename-input" @bind="_renameDraft" @bind:event="oninput"
                           @onkeydown="e => RenameKey(e, _chat)" @onblur="() => FinishRename(_chat)" aria-label="Nuwe naam" />
                }
                else
                {
                    <span class="chat-title" title="@_chat.Title">@_chat.Title</span>
                    <div class="dropdown">
                        <button class="icon item-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Meer vir hierdie gesprek">⋯</button>
                        <ul class="dropdown-menu">@ChatMenu(_chat, inHeader: true)</ul>
                    </div>
                }
            </div>
            <div class="header-actions">
                <button class="header-button d-none d-xl-inline-flex work-toggle" type="button" onclick="pulsUi.toggleWork()" title="Wys of versteek die werkpaneel">
                    <span class="ic i-pulse" aria-hidden="true"></span>Werk
                </button>
                <button class="header-button d-xl-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#work" aria-controls="work" title="Wys die werkpaneel">
                    <span class="ic i-pulse" aria-hidden="true"></span>Werk
                </button>
                <button class="pill pill-plus" type="button" @onclick='() => ComingSoon("Puls Plus")'><span class="ic i-sparkle" aria-hidden="true"></span>Kry Plus</button>
                <div class="dropdown">
                    <button class="header-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Taal">
                        <span class="ic i-globe" aria-hidden="true"></span>AF
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Taal</h6></li>
                        <li><button class="dropdown-item active" type="button">Afrikaans <span class="ic i-check ms-auto" aria-hidden="true"></span></button></li>
                        @foreach (string language in Languages)
                        {
                            <li><button class="dropdown-item" type="button" @onclick="() => ComingSoon(language)">@language</button></li>
                        }
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="profile-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Profiel">G</button>
                    <ul class="dropdown-menu dropdown-menu-end profile-menu">
                        <li class="profile-menu-head">
                            <span class="profile-avatar">G</span>
                            <span class="profile-who"><strong>Gas</strong><small>Plaaslik in hierdie blaaier</small></span>
                        </li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Opgradering")'><span class="ic i-sparkle" aria-hidden="true"></span>Opgradeer plan</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">Tema</h6></li>
                        <li><button class="dropdown-item active" type="button"><span class="ic i-moon" aria-hidden="true"></span>Donker <span class="ic i-check ms-auto" aria-hidden="true"></span></button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Die ligte tema")'><span class="ic i-sun" aria-hidden="true"></span>Lig</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Outomatiese tema")'><span class="ic i-auto" aria-hidden="true"></span>Outomaties (stelsel)</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Profiel")'><span class="ic i-user" aria-hidden="true"></span>Profiel</button></li>
                        <li><button class="dropdown-item" type="button" onclick="pulsUi.openSettings()"><span class="ic i-cog" aria-hidden="true"></span>Instellings</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Teken uit")'><span class="ic i-logout" aria-hidden="true"></span>Teken uit</button></li>
                    </ul>
                </div>
            </div>
        </header>
        @* Below lg the Werk panel slides in from this tab (the phone's top bar has the menu and New chat). *@
        <button class="work-tab work-tab-open d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#work" aria-controls="work" title="Wys die werkpaneel">Werk</button>
        <div class="messages" @ref="_messages">
            @if (_chat is null || _chat.Turns.Count == 0)
            {
                <div class="empty">
                    @* The app icon, with the slow pulse spreading out from it. *@
                    <div class="hero-mark" aria-hidden="true">
                        <div class="pulse-bg"><span></span><span></span><span></span><span></span></div>
                        <img src="brand/puls-icon-tile.svg" alt="" width="76" height="76" />
                    </div>
                    <button class="news-pill" type="button" @onclick='() => SetDraft("Lees die dokument wat ek aanheg en som dit in vyf punte op.")'>
                        <span class="news-tag">Nuut</span> Puls lees PDF's, Word en Excel <span aria-hidden="true">→</span>
                    </button>
                    <h1>Hoe kan ek help?</h1>
                    <p class="hint">Vra enigiets. Puls stuur elke taak na 'n spesialis met net die gereedskap wat dit nodig het, en jy kan sien hoe dit werk.</p>
                    <div class="composer composer-centred">@Composer()</div>
                    <div class="topics">
                        @foreach (var (topic, starter) in Topics)
                        {
                            <button class="topic" type="button" @onclick="() => SetDraft(starter)">@topic</button>
                        }
                    </div>
                    <div class="suggestions">
                        @foreach (var (title, detail, prompt) in Suggestions)
                        {
                            <button class="suggestion" @onclick="() => Suggest(prompt)" disabled="@_streaming">
                                <strong>@title</strong>
                                <span>@detail</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var turn in _chat.Turns)
                {
                    <TurnView Turn="turn" Streaming="@(_streaming && turn == _chat.Turns[^1])" Currency="Currency.Current"
                              UserActions="UserActions" AnswerActions="AnswerActions" />
                }
            }
        </div>

        @if (_notice is not null)
        {
            <div class="notice">@_notice <button class="icon" @onclick="() => _notice = null">×</button></div>
        }

        @if (_chat?.Usage() is { } chatUsage)
        {
            <div class="chat-usage" title="@UsageFormat.Detail(chatUsage, Currency.Current)">
                Hierdie gesprek: @chatUsage.Requests versoeke · @UsageFormat.Tokens(chatUsage.TotalTokens) tokens · @UsageFormat.Cost(chatUsage, Currency.Current)
            </div>
        }

        @if (_chat is { Turns.Count: > 0 })
        {
            <div class="composer">@Composer()</div>
        }
    </main>

    <ChatSearch @bind-Open="_searchOpen" Chats="Store.Chats" />

    @if (_toast is not null)
    {
        <div class="toast-pill" role="status" @key="_toast"><span class="ic i-sparkle" aria-hidden="true"></span>@_toast</div>
    }

    <aside class="work offcanvas-xl offcanvas-end" id="work" tabindex="-1" aria-label="Werk">
        <WorkPanel Chat="_chat" Streaming="_streaming" Currency="Currency.Current" />
    </aside>
</div>

@code {
    /// <summary>One chat in the sidebar: its link (or the rename field), and its menu.</summary>
    private RenderFragment ChatItem(Chat chat) => __builder =>
    {
        <div class="chat-item @(chat.SessionId == SessionId ? "active" : "")" @key="chat.SessionId">
            @if (_renaming == chat.SessionId && !_renameInHeader)
            {
                <input id="rename-input" class="rename-input" @bind="_renameDraft" @bind:event="oninput"
                       @onkeydown="e => RenameKey(e, chat)" @onblur="() => FinishRename(chat)" aria-label="Nuwe naam" />
            }
            else
            {
                <a href="gesels/@chat.SessionId" title="@chat.Title">@chat.Title</a>
                <div class="dropdown">
                    <button class="icon item-menu" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
                            aria-expanded="false" aria-label="Meer vir @chat.Title">⋯</button>
                    <ul class="dropdown-menu dropdown-menu-end">@ChatMenu(chat, inHeader: false)</ul>
                </div>
            }
        </div>
    };

    /// <summary>A chat's actions, in the sidebar's menu and the top bar's.</summary>
    private RenderFragment ChatMenu(Chat chat, bool inHeader) => __builder =>
    {
        <li><button class="dropdown-item" type="button" @onclick="() => ToggleFavourite(chat)"><span class="ic i-star" aria-hidden="true"></span>@(chat.Favourite ? "Haal uit gunstelinge" : "Merk as gunsteling")</button></li>
        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Deel")'><span class="ic i-share" aria-hidden="true"></span>Deel</button></li>
        <li><button class="dropdown-item" type="button" @onclick="() => StartRename(chat, inHeader)"><span class="ic i-pencil" aria-hidden="true"></span>Hernoem</button></li>
        <li><button class="dropdown-item" type="button" @onclick="() => ToggleArchive(chat)"><span class="ic i-archive" aria-hidden="true"></span>@(chat.Archived ? "Haal uit argief" : "Argiveer")</button></li>
        <li><hr class="dropdown-divider" /></li>
        <li><button class="dropdown-item danger" type="button" @onclick="() => DeleteChat(chat)"><span class="ic i-trash" aria-hidden="true"></span>Vee uit</button></li>
    };

    /// <summary>Puls's own voice (F21): Skills/personalities/puls.md.</summary>
    private const string Personality = "puls";

    private static readonly string[] Languages = ["English", "Nederlands", "Deutsch", "isiZulu"];

    /// <summary>
    /// The message box: attachments, the text, and a toolbar (Media and Tools on the left; the model, voice and send on the
    /// right). In the middle of an empty chat, at the bottom once it has turns.
    /// </summary>
    private RenderFragment Composer() => __builder =>
    {
        @if (_attachments.Count > 0)
        {
            <div class="attachments">
                @foreach (var attachment in _attachments)
                {
                    <span class="chip">@attachment.Name <button class="icon" @onclick="() => _attachments.Remove(attachment)">×</button></span>
                }
            </div>
        }
        <div class="input-box">
            <textarea id="composer-input" rows="1" @bind="_draft" @bind:event="oninput"
                      disabled="@(_chat?.Ended == true)"
                      placeholder="@(_chat?.Ended == true ? "Hierdie gesprek het geëindig toe die API herbegin het - begin 'n nuwe gesprek" : "Vra enigiets…")"></textarea>
            <div class="composer-tools">
                <div class="dropdown dropup">
                    <button class="tool-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Voeg by">
                        <span class="ic i-plus" aria-hidden="true"></span>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <label class="dropdown-item file-item">
                                <span class="ic i-file" aria-hidden="true"></span>Laai 'n lêer op
                                <InputFile OnChange="AddFiles" multiple />
                            </label>
                        </li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Skermskote")'><span class="ic i-screen" aria-hidden="true"></span>Voeg 'n skermskoot by</button></li>
                    </ul>
                </div>
                <div class="dropdown dropup">
                    <button class="tool-button tool-button-label" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="ic i-sliders" aria-hidden="true"></span>Gereedskap
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" type="button" @onclick='() => SetDraft("Soek aanlyn: ")'><span class="ic i-search" aria-hidden="true"></span>Soek op die web</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => SetDraft("Lees die lêer ")'><span class="ic i-file" aria-hidden="true"></span>Lees 'n lêer</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Skep \u0027n prent")'><span class="ic i-image" aria-hidden="true"></span>Skep 'n prent</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Diep navorsing")'><span class="ic i-compass" aria-hidden="true"></span>Diep navorsing</button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Dink langer")'><span class="ic i-sparkle" aria-hidden="true"></span>Dink langer</button></li>
                    </ul>
                </div>
                <span class="composer-spacer"></span>
                <div class="dropdown dropup">
                    <button class="tool-button tool-button-label model-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Model">
                        @(_model ?? "Model") <span class="ic i-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Model</h6></li>
                        <li><button class="dropdown-item active" type="button">@(_model ?? "Die bediener se model") <span class="ic i-check ms-auto" aria-hidden="true"></span></button></li>
                        <li><button class="dropdown-item" type="button" @onclick='() => ComingSoon("Ander modelle")'>Ander modelle…</button></li>
                    </ul>
                </div>
                <button class="tool-button" type="button" title="Stemboodskap" @onclick='() => ComingSoon("Stemboodskappe")'><span class="ic i-mic" aria-hidden="true"></span></button>
                @if (_streaming)
                {
                    <button class="stop" @onclick="Stop" title="Stop">■</button>
                }
                else
                {
                    <button id="send-button" class="send" @onclick="Send" disabled="@(!CanSend)" title="Stuur (Enter)">↑</button>
                }
            </div>
        </div>
    };

    /// <summary>Under the user's message: copy it, or edit it (to come).</summary>
    private RenderFragment<Turn> UserActions => turn => __builder =>
    {
        <button class="action" type="button" title="Kopieer" @onclick="() => Copy(turn.UserText)"><span class="ic i-copy" aria-hidden="true"></span></button>
        <button class="action" type="button" title="Wysig die boodskap" @onclick='() => ComingSoon("Wysig")'><span class="ic i-pencil" aria-hidden="true"></span></button>
    };

    /// <summary>Under a finished answer: copy, regenerate, good and bad, share (to come), and its sources in the Werk panel.</summary>
    private RenderFragment<Turn> AnswerActions => turn => __builder =>
    {
        <button class="action" type="button" title="Kopieer die antwoord" @onclick="() => Copy(AnswerText(turn))"><span class="ic i-copy" aria-hidden="true"></span></button>
        <button class="action" type="button" title="Probeer weer" @onclick='() => ComingSoon("Probeer weer")'><span class="ic i-refresh" aria-hidden="true"></span></button>
        <button class="action" type="button" title="Goeie antwoord" @onclick='() => ComingSoon("Terugvoer")'><span class="ic i-thumb-up" aria-hidden="true"></span></button>
        <button class="action" type="button" title="Swak antwoord" @onclick='() => ComingSoon("Terugvoer")'><span class="ic i-thumb-down" aria-hidden="true"></span></button>
        <button class="action" type="button" title="Deel" @onclick='() => ComingSoon("Deel")'><span class="ic i-share" aria-hidden="true"></span></button>
        @if (Sources.Of(turn) is { Count: > 0 } sources)
        {
            <button class="action action-sources" type="button" onclick="pulsUi.showWork()" title="Wys die bronne in die werkpaneel">
                @foreach (var site in sources.Select(s => s.Site).Distinct().Take(3))
                {
                    <span class="source-dot">@site[..1].ToUpperInvariant()</span>
                }
                @sources.Count @(sources.Count == 1 ? "bron" : "bronne")
            </button>
        }
    };

    /// <summary>The answer's own words: its text after the last tool call or thought (the reply the user reads).</summary>
    private static string AnswerText(Turn turn)
    {
        int last = turn.Blocks.FindLastIndex(b => b.Kind != BlockKind.Text);
        return string.Join("\n\n", turn.Blocks.Skip(last + 1).Select(b => b.Text).Where(t => t.Length > 0)).Trim();
    }

    private async Task Copy(string text)
    {
        bool copied = await JS.InvokeAsync<bool>("pulsUi.copy", text);
        _ = ShowToast(copied ? "Gekopieer." : "Kon nie kopieer nie.");
    }

    // Topics under the empty chat's message box: each puts a starter in the box to finish and send.
    private static readonly (string Topic, string Starter)[] Topics =
    [
        ("Gesondheid", "Ek wil gesonder eet. Gee my 'n eenvoudige weekplan vir "),
        ("Leer", "Verduidelik vir my, eenvoudig en met 'n voorbeeld: "),
        ("Tegnologie", "Wat is die verskil tussen "),
        ("Lewe", "Help my om te besluit: "),
        ("Wetenskap", "Hoe werk "),
        ("Taal", "Help my om hierdie teks in beter Afrikaans te skryf: "),
    ];

    private string? _model;

    /// <summary>Puts <paramref name="text"/> in the message box, for the user to finish and send.</summary>
    private async Task SetDraft(string text)
    {
        _draft = text;
        StateHasChanged();
        await JS.InvokeVoidAsync("pulsUi.focusEnd", "#composer-input");
    }

    private static string? Pretty(string? id)
    {
        if (string.IsNullOrWhiteSpace(id)) return null;
        var words = id.Split('-', StringSplitOptions.RemoveEmptyEntries);
        var named = words.TakeWhile(w => !char.IsDigit(w[0])).Select(w => char.ToUpperInvariant(w[0]) + w[1..]);
        string version = string.Join(".", words.SkipWhile(w => !char.IsDigit(w[0])));
        return string.Join(" ", named) + (version.Length > 0 ? " " + version : "");
    }

    private bool _searchOpen;
    private bool _renameInHeader;
    private string? _renaming;
    private string _renameDraft = "";
    private bool _focusRename;

    private string? _toast;

    // Where the user is (F22): this browser's setting, sent with a new chat only when set.
    private string? _location;
    private bool _locating;

    private async Task SaveLocation(ChangeEventArgs e)
    {
        string? value = e.Value?.ToString()?.Trim();
        _location = string.IsNullOrEmpty(value) ? null : value;
        await JS.InvokeVoidAsync("pulsUi.saveLocation", _location);
    }

    private async Task UseMyLocation()
    {
        _locating = true;
        try
        {
            var found = await JS.InvokeAsync<LocateResult>("pulsUi.locate");
            if (found.Place is { Length: > 0 } place)
            {
                _location = place;
                await JS.InvokeVoidAsync("pulsUi.saveLocation", place);
                _ = ShowToast($"Ligging: {place}");
            }
            else
            {
                _ = ShowToast(found.Error ?? "Kon nie jou ligging kry nie.");
            }
        }
        finally
        {
            _locating = false;
        }
    }

    private sealed record LocateResult(string? Place, string? Error);

    private async Task ShowToast(string text)
    {
        _toast = text;
        StateHasChanged();
        await Task.Delay(2800);
        if (_toast == text) { _toast = null; StateHasChanged(); }
    }

    /// <summary>A placeholder's answer: a toast that says what's coming, gone after a few seconds.</summary>
    private async Task ComingSoon(string what)
    {
        string toast = $"{what}: kom binnekort.";
        _toast = toast;
        StateHasChanged();
        await Task.Delay(2800);
        if (_toast == toast) _toast = null;
    }

    private void StartRename(Chat chat, bool inHeader = false)
    {
        _renameInHeader = inHeader;
        _renaming = chat.SessionId;
        _renameDraft = chat.Title;
        _focusRename = true;
    }

    private async Task RenameKey(KeyboardEventArgs e, Chat chat)
    {
        if (e.Key == "Enter") await FinishRename(chat);
        else if (e.Key == "Escape") _renaming = null;
    }

    private async Task FinishRename(Chat chat)
    {
        if (_renaming != chat.SessionId) return;
        _renaming = null;
        string title = _renameDraft.Trim();
        if (title.Length == 0 || title == chat.Title) return;
        chat.Title = title.Length > 80 ? title[..80] : title;
        await Store.SaveAsync();
    }

    private async Task ToggleFavourite(Chat chat)
    {
        chat.Favourite = !chat.Favourite;
        await Store.SaveAsync();
    }

    private async Task ToggleArchive(Chat chat)
    {
        chat.Archived = !chat.Archived;
        if (chat.Archived) chat.Favourite = false;
        await Store.SaveAsync();
    }

    [Parameter] public string? SessionId { get; set; }

    private const long MaxAttachmentBytes = 1_000_000;

    private Chat? _chat;
    private string _draft = "";
    private readonly List<Attachment> _attachments = [];
    private bool _streaming;
    private string? _notice;
    private ElementReference _messages;
    private DateTime _lastRender;
    private bool _scrollToEnd;

    // Starters for an empty chat: each one shows a different kind of delegation.
    private static readonly (string Title, string Detail, string Prompt)[] Suggestions =
    [
        ("Soek aanlyn", "Wat is nuut in .NET 10?", "Wat is nuut in .NET 10? Gee my die hoogtepunte, met bronne."),
        ("Lees 'n lêer", "Som die README op", "Lees README.md en som in vyf punte op wat hierdie projek doen."),
        ("Kyk na die geskiedenis", "Wat het onlangs verander?", "Wat is die laaste vyf commits in hierdie repository, en wat het elkeen verander?"),
        ("Tel en reken", "Tel reëls kode", "Tel die reëls C#-kode onder louis-agent.core, per vouer, en wys die top vyf."),
    ];

    private async Task Suggest(string prompt)
    {
        if (_streaming) return;
        await StartTurnAsync(prompt, []);
    }

    private bool CanSend => !_streaming && _chat?.Ended != true && (_draft.Trim().Length > 0 || _attachments.Count > 0);

    protected override async Task OnInitializedAsync()
    {
        Currency.Changed += Redraw;
        if (!Store.Loaded) await Store.LoadAsync();
        _location = await JS.InvokeAsync<string?>("pulsUi.loadLocation");
        try
        {
            var model = await Api.GetAsync<System.Text.Json.JsonElement>("model");
            _model = Pretty(model.GetProperty("model").GetString());
        }
        catch (Exception)
        {
            _model = null;   // An older API without /model: the picker says "Model".
        }
    }

    protected override void OnParametersSet()
    {
        // The chat moved to /gesels (F20); an old /chat/{id} link lands on the same chat at its new address.
        if (SessionId is not null && Nav.ToBaseRelativePath(Nav.Uri).StartsWith("chat/", StringComparison.Ordinal))
        {
            Nav.NavigateTo($"gesels/{SessionId}", replace: true);
            return;
        }
        var chat = Store.Find(SessionId);
        if (!ReferenceEquals(chat, _chat)) _scrollToEnd = true;
        _chat = chat;
        if (SessionId is not null && chat is null && !_streaming)
            _notice = "Daardie gesprek is nie in hierdie blaaier gestoor nie.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await JS.InvokeVoidAsync("pulsUi.focus", "#rename-input", true);
        }
        if (_streaming || _scrollToEnd)
        {
            await JS.InvokeVoidAsync("louisChat.scrollToBottom", _messages, _scrollToEnd);
            _scrollToEnd = false;
        }
    }

    private void NewChat()
    {
        _notice = null;
        Nav.NavigateTo("gesels");
    }

    private async Task Send()
    {
        if (!CanSend) return;

        string text = _draft.Trim();
        var attachments = _attachments.ToList();
        _draft = "";
        _attachments.Clear();
        await StartTurnAsync(text, attachments);
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Currency.Changed -= Redraw;

    private async Task StartTurnAsync(string text, List<Attachment> attachments)
    {
        _notice = null;
        if (_chat is null)
        {
            try
            {
                // Puls delegates (F5): its chats load only the agents toolset, and hand every task to a specialist. An API
                // without a peer offers no agents toolset; the chat then gets every toolset there is, so it still works.
                string[] available = await Api.AvailableToolsetsAsync();
                string? timeZone = _location is null ? null : await JS.InvokeAsync<string?>("pulsUi.timeZone");
                string sessionId = await Api.CreateSessionAsync(available.Contains("agents") ? ["agents"] : available, Personality,
                    _location, timeZone);
                _chat = new Chat { SessionId = sessionId, Title = TitleFor(text, attachments) };
                Store.Chats.Insert(0, _chat);
                Nav.NavigateTo($"gesels/{sessionId}");
            }
            catch (Exception ex)
            {
                _chat = Store.Find(SessionId);
                _draft = text;
                _attachments.AddRange(attachments);
                _notice = Describe(ex);
                return;
            }
        }

        var chat = _chat;
        var turn = new Turn { UserText = text, AttachmentNames = attachments.Select(a => a.Name).ToList() };
        chat.Turns.Add(turn);
        chat.UpdatedAt = DateTimeOffset.Now;
        _streaming = true;
        _scrollToEnd = true;
        StateHasChanged();

        try
        {
            await foreach (var streamEvent in Api.StreamMessageAsync(chat.SessionId, text, attachments))
            {
                TurnStream.Apply(turn, streamEvent);
                RenderThrottled();
            }
        }
        catch (AgentApiException ex) when (ex.Status == HttpStatusCode.NotFound)
        {
            chat.Ended = true;
            turn.Error = "Hierdie gesprek se sessie bestaan nie meer op die bediener nie (die API het herbegin). Begin 'n nuwe gesprek om voort te gaan.";
        }
        catch (Exception ex)
        {
            turn.Error = Describe(ex);
        }
        finally
        {
            _streaming = false;
            await Store.SaveAsync();
            StateHasChanged();
        }
    }

    // Text arrives a few words at a time; re-rendering every 50 ms is smooth without redrawing on every token.
    private void RenderThrottled()
    {
        if ((DateTime.UtcNow - _lastRender).TotalMilliseconds < 50) return;
        _lastRender = DateTime.UtcNow;
        StateHasChanged();
    }

    private async Task Stop()
    {
        if (_chat is null) return;
        try
        {
            await Api.CancelAsync(_chat.SessionId);
        }
        catch (Exception ex)
        {
            _notice = Describe(ex);
        }
    }

    private async Task AddFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
        {
            if (file.Size > MaxAttachmentBytes)
            {
                _notice = $"{file.Name} is larger than 1 MB and was not attached.";
                continue;
            }

            using var reader = new StreamReader(file.OpenReadStream(MaxAttachmentBytes));
            _attachments.Add(new Attachment(file.Name, await reader.ReadToEndAsync()));
        }
    }

    private async Task DeleteChat(Chat chat)
    {
        try
        {
            await Api.DeleteSessionAsync(chat.SessionId);
        }
        catch (Exception)
        {
            // The local copy is removed either way.
        }

        Store.Chats.Remove(chat);
        await Store.SaveAsync();
        if (chat.SessionId == SessionId) Nav.NavigateTo("gesels");
    }

    private async Task SaveApiKey(ChangeEventArgs e)
    {
        await Store.SaveApiKeyAsync(e.Value?.ToString());
        _notice = null;
    }

    private static string TitleFor(string text, List<Attachment> attachments)
    {
        string title = text.Length > 0 ? text.ReplaceLineEndings(" ") : attachments.FirstOrDefault()?.Name ?? "Nuwe gesprek";
        return title.Length > 50 ? title[..50] + "…" : title;
    }

    private static string Describe(Exception ex) => ex switch
    {
        AgentApiException { Status: HttpStatusCode.Unauthorized } => "Die API het 'n sleutel nodig: maak Instellings oop en vul AGENT_API_KEY in.",
        AgentApiException { Status: HttpStatusCode.Conflict } => "Hierdie gesprek antwoord nog; wag daarvoor of druk Stop.",
        AgentApiException api => api.Message,
        HttpRequestException => "Kan nie Puls se API bereik nie. Loop die puls-houer?",
        _ => ex.Message,
    };
}

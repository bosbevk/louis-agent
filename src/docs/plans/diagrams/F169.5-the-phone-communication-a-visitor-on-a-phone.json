      { "id": "F", "icon": "box", "tone": "green", "label": "DiagramFigure" },
      { "id": "R", "icon": "code", "tone": "teal", "label": "DiagramRenderers" },
      { "id": "N", "icon": "code", "tone": "teal", "label": "NarrowFit" }
    ],
    "steps": [
      { "step": "message", "from": "V", "to": "S", "text": "opens Cost and evals" },
      { "step": "message", "from": "S", "to": "F", "text": "the page: Source is CostPath.Source" },
      { "step": "message", "from": "F", "to": "R", "text": "RenderForPage(source, Wide)" },
      { "step": "reply", "from": "R", "to": "F", "text": "the flow to the right, 884 wide" },
      { "step": "message", "from": "F", "to": "R", "text": "RenderForPage(source, Narrow)  (step 7)" },

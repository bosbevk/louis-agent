{
  "kind": "sequence",
  "title": "F164.2: a developer asks about the page they read",
  "caption": "The button puts the question through the door; the docked panel opens beside the page and sends it with the page it is on; the agent reads the docs and answers with a doc link.",
  "sequence": {
    "participants": [
      { "id": "dev", "label": "A developer", "actor": true, "tone": "blue" },
      { "id": "button", "label": "Ask about this page", "icon": "message", "tone": "green" },
      { "id": "door", "label": "GuideDoor", "icon": "branch", "tone": "violet" },
      { "id": "widget", "label": "ChatWidget, docked", "icon": "browser", "tone": "violet" },
      { "id": "host", "label": "The framework's host", "icon": "server", "tone": "green" },
      { "id": "agent", "label": "The framework Orbi", "icon": "chip", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "dev", "to": "button", "text": "a press on How it works" },
      { "step": "message", "from": "button", "to": "door", "text": "Ask(\"Tell me about this page\")" },
      { "step": "message", "from": "door", "to": "widget", "text": "Asked" },
      { "step": "note", "over": [ "widget" ], "text": "the panel opens in the right column, in place of On this page" },
      { "step": "message", "from": "widget", "to": "host", "text": "the question and the page it is on" },
      { "step": "message", "from": "host", "to": "agent", "text": "a turn" },
      { "step": "message", "from": "agent", "to": "host", "text": "SearchDocs, ReadDoc" },
      { "step": "reply", "from": "host", "to": "widget", "text": "the answer, streamed, with a doc link and choices" },
      { "step": "reply", "from": "widget", "to": "dev", "text": "read beside the page" }
    ],
    "numbered": false
  }
}

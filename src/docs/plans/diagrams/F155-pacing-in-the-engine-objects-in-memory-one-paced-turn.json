      { "id": "paced", "icon": "clock", "tone": "teal", "label": "paced : PacedStream\nfor this turn" },
      { "id": "reader", "icon": "box", "tone": "teal", "label": "reader : Task\nreads turn into channel" },
      { "id": "channel", "shape": "data", "icon": "stack", "tone": "teal", "label": "channel : Channel<update>\nunbounded" },
      { "id": "buffer", "shape": "data", "icon": "file", "tone": "teal", "label": "pending : StringBuilder\nshown : double" },
      { "id": "timer", "icon": "clock", "tone": "amber", "label": "timer : PeriodicTimer\n33 ms, on the clock" }
    ],
    "edges": [
      { "from": "engine", "to": "paced", "word": "makes, per turn" },
      { "from": "paced", "to": "turn", "word": "wraps" },

@implements IAsyncDisposable
@* A site's frame: a header with the brand, the menu and the actions, the page, a footer, and a corner that floats
   over every page (a site's chat widget goes there). A slot left empty leaves no gap. Its own root class, not .app:
   a chat's grid rules must not reach here. The frame also draws what every page gets for nothing (F118): the scroll
   progress line, the section index, built from the bands the page puts on the frame's list, and the way back up. *@
<CascadingValue Value="_areas" IsFixed="true">
    <CascadingValue Value="_options" IsFixed="true">
        <div class="@SiteClasses">
            <div class="site-progress" id="site-progress" aria-hidden="true"></div>
            @if (ShowIndex)
            {
                <SectionIndex/>
            }
            <header class="site-header">
                @if (Brand is not null)
                {
                    <a class="site-brand" href="@BrandHref">
                        <span class="site-brand-name">@Brand</span>
                        @if (Tagline is not null)
                        {
                            <span class="site-tagline">@Tagline</span>
                        }
                    </a>
                }
                @* What stage the site is at, beside its name and outside its link, since a press opens a note (FX170). *@
                @Stage
                @if (HasMenu)
                {
                    <button type="button" class="site-menu-button" aria-label="Menu" aria-controls="site-menu"
                            aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="ToggleMenu">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2"
                                  stroke-linecap="round"/>
                        </svg>
                    </button>
                    <div class="site-menu" id="site-menu" data-open="@_menuOpen">
                        @if (Links is not null)
                        {
                            <nav class="site-nav">@Links</nav>
                        }
                        @if (HasActions)
                        {
                            <div class="site-actions">
                                @if (LooksInActions)
                                {
                                    <LookSwitch/>
                                }
                                @Actions
                            </div>
                        }
                    </div>
                }
                @if (HasSettings)
                {
                    <button type="button" class="site-settings-button" aria-label="Settings"
                            aria-controls="site-settings" aria-expanded="@(_settingsOpen ? "true" : "false")"
                            @onclick="ToggleSettings">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2"
                                  stroke-linecap="round"/>
                        </svg>
                    </button>
                }
            </header>
            @if (HasSettings)
            {
                <SiteSettings Open="_settingsOpen" Looks="OffersThemes">@Settings</SiteSettings>
            }

            <main class="site-main" @key="PagePath">
                @ChildContent
            </main>

            @if (ShowWayUp)
            {
                <a class="site-up" href="#top" aria-label="Back to the top">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            }

            @if (Footer is not null)
            {
                <footer class="site-footer">@Footer</footer>
            }

            @if (Corner is not null)
            {
                <div class="site-corner">@Corner</div>
            }
        </div>
    </CascadingValue>
</CascadingValue>

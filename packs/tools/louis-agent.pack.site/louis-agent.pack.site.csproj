<Project Sdk="Microsoft.NET.Sdk">

  <!-- The guide's way to take a visitor to a page of the site, and to an area of it (F117): one toolset, site, with
       one tool that names the page; the web's widget hears the call and moves the browser. References the
       composition's contracts only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Site</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, toolsets/site.md is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.site.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.site.md" Link="docs\louis-agent.pack.site.md" />
    <None Include="..\..\..\src\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

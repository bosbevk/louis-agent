        "tone": "amber",
        "shape": "data"
      },
      {
        "id": "strict",
        "label": "Every field known,\nthe hash current?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "refuse",
        "label": "Refuse it\nsay what to fix",

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The framework's own website (F124): a visitor area built on the framework's web like any customer's site. It may
       use packs and an identity; nothing else in src/ references it (SiteBoundaryTests). -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Site</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles Styles/ into wwwroot/css on every build. Build time only: nothing of it reaches the browser. -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.107.1" PrivateAssets="all" ExcludeAssets="runtime;compile" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\web\louis-agent.web\louis-agent.web.csproj" />
    <!-- The guide's name, for its chat in the corner (F109.3); the guide itself runs on the site's host. -->
    <ProjectReference Include="..\louis-agent.identity.guide\louis-agent.identity.guide.csproj" />
    <!-- F106.3.4: the triage pack's demo, played on /triage-demo. -->
    <ProjectReference Include="..\..\..\packs\web\louis-agent.pack.triage.web\louis-agent.pack.triage.web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The principles every agent reads first, shown on the Identities page as they are (FX74, Louis: "this should be
         public"). The engine's own file, embedded here by link, so the page can never drift from it; a test holds the
         two equal. When the engine ships as a package the page reads the package's copy instead. -->
    <EmbeddedResource Include="..\..\engine\louis-agent.core\prompts\shared\principles.md" Link="Content\principles.md" LogicalName="principles.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Sass compiler's settings are for the build, so they stay out of what's published. -->
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

@* F20: search the chats saved in this browser (Ctrl/⌘ K): their titles, your messages and the answers. Arrow keys
   move, Enter opens, Escape closes. Nothing leaves the browser. *@
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Open)
{
    <div class="search-backdrop" @onclick="Close"></div>
    <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Soek gesprekke">
        <div class="search-input">
            <span class="ic i-search" aria-hidden="true"></span>
            <input id="search-input" placeholder="Soek gesprekke…" autocomplete="off"
                   @bind="_query" @bind:event="oninput" @bind:after="Reset" @onkeydown="Key" @onkeydown:preventDefault="_handled" />
            <kbd>Esc</kbd>
        </div>
        <div class="search-results">
            @if (Results.Count == 0)
            {
                <div class="search-none">Geen gesprekke vir "@_query" nie.</div>
            }
            else
            {
                <div class="search-group">@(_query.Trim().Length == 0 ? "Onlangs" : "Gesprekke")</div>
                @for (int i = 0; i < Results.Count; i++)
                {
                    var (chat, snippet) = Results[i];
                    int index = i;
                    <button class="search-result @(index == _selected ? "selected" : "")" @onclick="() => Go(chat)" @onmouseenter="() => _selected = index">
                        <span class="ic i-chat" aria-hidden="true"></span>
                        <span class="search-text">
                            <strong>@chat.Title</strong>
                            @if (snippet is not null)
                            {
                                <small>@snippet</small>
                            }
                        </span>
                        @if (chat.Archived)
                        {
                            <span class="search-tag">Geargiveer</span>
                        }
                    </button>
                }
            }
        </div>
        <div class="search-foot"><kbd>↑</kbd><kbd>↓</kbd> kies · <kbd>Enter</kbd> maak oop</div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public List<Chat> Chats { get; set; } = [];

    private string _query = "";
    private int _selected;
    private bool _handled;
    private bool _wasOpen;

    /// <summary>The chats that match, newest first, each with the line that matched (null when the title did).</summary>
    private List<(Chat Chat, string? Snippet)> Results
    {
        get
        {
            string q = _query.Trim();
            if (q.Length == 0) return Chats.Take(8).Select(c => (c, (string?)null)).ToList();
            var found = new List<(Chat, string?)>();
            foreach (var chat in Chats)
            {
                if (chat.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) { found.Add((chat, null)); continue; }
                string? line = chat.Turns
                    .SelectMany(t => t.Blocks.Where(b => b.Kind == BlockKind.Text).Select(b => b.Text).Prepend(t.UserText))
                    .Select(text => Snippet(text, q)).FirstOrDefault(s => s is not null);
                if (line is not null) found.Add((chat, line));
            }
            return found.Take(20).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_wasOpen) await JS.InvokeVoidAsync("pulsUi.focus", "#search-input");
        _wasOpen = Open;
    }

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen) { _query = ""; _selected = 0; }
    }

    private void Reset() => _selected = 0;

    private async Task Key(KeyboardEventArgs e)
    {
        _handled = e.Key is "ArrowDown" or "ArrowUp" or "Enter";
        var results = Results;
        switch (e.Key)
        {
            case "Escape": await Close(); break;
            case "ArrowDown": _selected = Math.Min(_selected + 1, Math.Max(results.Count - 1, 0)); break;
            case "ArrowUp": _selected = Math.Max(_selected - 1, 0); break;
            case "Enter" when results.Count > 0: await Go(results[Math.Min(_selected, results.Count - 1)].Chat); break;
        }
    }

    private async Task Go(Chat chat)
    {
        await Close();
        Nav.NavigateTo($"gesels/{chat.SessionId}");
    }

    private Task Close() => OpenChanged.InvokeAsync(false);

    /// <summary>About 80 characters around the first match in <paramref name="text"/>, or null when it doesn't match.</summary>
    private static string? Snippet(string text, string query)
    {
        int at = text.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (at < 0) return null;
        int start = Math.Max(0, at - 30);
        string piece = text.Substring(start, Math.Min(80, text.Length - start)).ReplaceLineEndings(" ");
        return (start > 0 ? "…" : "") + piece + (start + 80 < text.Length ? "…" : "");
    }
}

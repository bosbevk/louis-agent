<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The framework's website's tests (F124): its pages, components, graphs and styles with bUnit (MIT), against the stub
       API, each golden beside its test (LOUIS_UPDATE_GOLDEN=1 regenerates). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Site.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\site\louis-agent.site\louis-agent.site.csproj" />
    <!-- The site's host, for its catalogue (F124). -->
    <ProjectReference Include="..\..\..\site\louis-agent.site-api\louis-agent.site-api.csproj" />
    <ProjectReference Include="..\..\..\site\louis-agent.identity.guide\louis-agent.identity.guide.csproj" />
    <ProjectReference Include="..\..\..\site\louis-agent.identity.showroom\louis-agent.identity.showroom.csproj" />
    <!-- The fixture replay, the stub API and the snapshot helper the web tests share; no test project references another. -->
    <ProjectReference Include="..\..\web\louis-agent.web.testing\louis-agent.web.testing.csproj" />
    <ProjectReference Include="..\..\shared\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Web.Testing" />
    <Using Include="LouisAgent.Web.Testing.Styles" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\..\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

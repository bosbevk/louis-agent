<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The git pack's own web views: Changes and Branches (F59.6, ADR 0086). It references the framework's web, never the pack: the pack runs on the server, and
       this runs in the browser, so the two share only names, which louis-agent.pack.git.web.tests holds together. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Packs.Git.Web</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\web\louis-agent.web\louis-agent.web.csproj" />
  </ItemGroup>

</Project>

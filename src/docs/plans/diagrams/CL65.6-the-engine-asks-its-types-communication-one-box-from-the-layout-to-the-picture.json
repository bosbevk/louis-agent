{
  "kind": "sequence",
  "title": "CL65.6 the engine asks its types: one box, from the layout to the picture",
  "caption": "Nothing is worked out where it stands: the layout and the drawing ask the box, the face and the path writer.",
  "sequence": {
    "participants": [
      { "id": "renderers", "label": "DiagramRenderers", "icon": "code", "tone": "violet" },
      { "id": "layout", "label": "GraphLayout", "icon": "code", "tone": "green" },
      { "id": "face", "label": "Face", "icon": "box", "tone": "teal" },
      { "id": "geometry", "label": "IGeometry", "icon": "box", "tone": "teal" },
      { "id": "drawing", "label": "FlowDrawing", "icon": "code", "tone": "green" },
      { "id": "box", "label": "IBox", "icon": "box", "tone": "teal" },
      { "id": "path", "label": "PathWriter", "icon": "box", "tone": "teal" }
    ],
    "steps": [
      { "step": "message", "from": "renderers", "to": "layout", "text": "Place(spec, geometry), ours unless another is handed in" },
      { "step": "message", "from": "layout", "to": "face", "text": "Width(\"The engine\")" },

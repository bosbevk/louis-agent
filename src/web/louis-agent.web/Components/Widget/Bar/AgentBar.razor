@using LouisAgent.Web.Usage
@using LouisAgent.Web.Components.Widget.Bar.Caption
@using LouisAgent.Web.Components.Widget.Bar.Chips
@using LouisAgent.Web.Components.Widget.Bar.Talk
@using LouisAgent.Web.Components.Widget.Orb
@* The agent bar (F134.3): the guide at the foot of the page, as the J and K mockups have it. In it the orb, a line of
   what the guide is doing, and the box, which is always there to type in. Over it the guide's last answer, or the
   whole talk. It draws what the widget's runner holds and asks the widget to send, so the widget stays the one
   engine and the bar is only its look. *@
<div class="@BarClasses" @ref="_bar">
    @* The chips while the guide waits (F134.3), round the orb while the bar is closed (FX173). *@
    <BarChips Chips="Chips" Show="ChipsShow" OnChoose="OnChoose"/>
    @* The guide's last answer stands as the caption (F134.4), a caption of its own for each answer, and the answers
       on their way out fade beside it before they go (F154). Each is keyed by its answer, so a leaving caption is the
       same caption, told it is leaving. The whole talk takes the standing one's place when the visitor opens it, or
       when the answer holds what only the talk draws. *@
    @foreach (var turn in CaptionTurns)
    {
        var caption = Captioned.Of(turn)!;
        bool leaving = _handOver.IsLeaving(turn);
        <AgentCaption @key="turn" Title="@Title" Words="@caption.Words" Question="@caption.Question"
                      Offer="caption.Offer" Work="caption.Work"
                      Beside="caption.Beside" Currency="Currency" Streaming="@(!leaving && Runner.Streaming)"
                      OnChoose="OnChoose" OnTalk="ToggleTalk" OnClose="PutTheAnswerAway"
                      OnWrite="FocusTheBox" Leaving="leaving" OnLeft="() => Left(turn)"/>
    }
    @if (Caption is null && TalkShows)
    {
        <AgentTalk Chat="Runner.Chat" Streaming="Runner.Streaming" Currency="Currency" ShowWork="ShowWork"
                   ShowCardAnswers="ShowCardAnswers" Chosen="OnChoose" OnClose="ToggleTalk"/>
    }
    @* The piece the visitor selected on the page (F134.5), as the corner's panel shows it: every message carries it
       until its close lets it go. *@
    @if (Piece is not null)
    {
        <div class="piece-chip">
            <span>@Piece</span>
            <button type="button" aria-label="@Text.ClosePiece" @onclick="OnClearPiece">×</button>
        </div>
    }
    @* The dock (FX172) holds the row, draws it in to the orb in the middle when closed, and carries what the site
       stands on each side (FX168), attached to its edges, so the sides sit beside the orb and ride out with the box. *@
    <div class="agent-dock" @onmouseleave="PointerLeftAsync">
    @if (Sides?.Start is { } start)
    {
        <div class="agent-side is-start">@start</div>
    }
    @if (Sides?.End is { } end)
    {
        <div class="agent-side is-end">@end</div>
    }
    <div class="agent-row">
        @* The orb is the way in (FX172): closed, the bar is the orb alone, and a press opens the box and puts the
           visitor in it. *@
        @* On a site that opens its bar under the pointer, only the orb itself opens it (Louis: "hover must only be on
           orb itself"); the pointer leaving the whole dock lets it go, so moving from the orb into the box keeps it. *@
        <button class="agent-open" type="button" aria-label="@Text.OpenTheBar" aria-expanded="@Expanded"
                @onclick="HoldOpenAsync" @onmouseenter="PointerCame">
            <Orb State="State" Label="@Title" Mark="@Initial"/>
        </button>
        @* The box: the line of what the guide is doing over the box itself, and a press on the line lands in the
           box. At its end, before the send button, what the talk has cost so far over how many answers (F134.5): a
           press opens the whole talk. *@
        <div class="agent-box" inert="@(!Opening.Open)" @onfocusin="Entered" @onfocusout="LeftAsync">
            <span class="agent-doing" @onclick="FocusTheBox">@Doing</span>
            <Composer @ref="_box" Draft="@Runner.Draft" DraftChanged="draft => Runner.Draft = draft"
                      Attachments="Runner.Attachments" BoxClass="agent-input"
                      Streaming="Runner.Streaming" CanSend="Runner.CanSend" Placeholder="@Placeholder"
                      OnSend="OnSend" OnStop="Runner.StopAsync" SendLabel="↑" StopLabel="■"
                      SendTitle="@Text.SendTitle" StopTitle="@Text.StopTitle">
                <Tools>
                    @if (Total is { } total)
                    {
                        <button class="agent-total" type="button" title="@UsageFormat.Total(total, Currency)"
                                @onclick="ToggleTalk">
                            <b>@UsageFormat.Cost(total, Currency)</b><span>@Text.Answers(Answers)</span>
                        </button>
                    }
                </Tools>
            </Composer>
        </div>
    </div>
    </div>
</div>

{
  "kind": "classes",
  "title": "F127.4.3 a form the agent draws: the interface design",
  "caption": "AskFor beside Offer in the site pack, ending the turn; the web reads the call and draws a form whose Send answers as the visitor.",
  "classes": {
    "types": [
      { "id": "tools", "name": "CardTools", "kind": "site pack, changed, step 2",
        "members": [ "+Offer(string question, IReadOnlyList<OfferChoice> choices) string", "+AskFor(string question, IReadOnlyList<FormField> fields) string" ] },
      { "id": "field", "name": "FormField", "kind": "record, step 2", "members": [ "string Label", "FieldKind Kind" ] },
      { "id": "kind", "name": "FieldKind", "kind": "enum, step 2", "members": [ "Name", "Phone", "Email", "Text" ] },
      { "id": "check", "name": "FormCheck", "kind": "step 2", "members": [ "+Problem(string question, IReadOnlyList<FormField> fields) string?" ] },
      { "id": "ends", "name": "EndsTurnAttribute", "kind": "composition, FX138", "tone": "violet" },
      { "id": "runner", "name": "TurnRunner", "kind": "core, changed, step 3", "tone": "violet" },
      { "id": "call", "name": "AskForCall", "kind": "web, step 4", "members": [ "+Of(Block call) Asked?" ] },
      { "id": "asked", "name": "Asked", "kind": "record, step 4", "members": [ "string Question", "IReadOnlyList<AskedField> Fields" ] },
      { "id": "card", "name": "FormCard", "kind": "web component, step 4",
        "members": [ "Asked Form", "string? Answer", "EventCallback<string> Sent" ] },
      { "id": "blocks", "name": "BlocksView", "kind": "web, changed, step 5", "tone": "violet" }
    ],
    "relations": [
      { "from": "tools", "to": "field", "kind": "uses" },
      { "from": "field", "to": "kind", "kind": "holds" },
      { "from": "tools", "to": "check", "kind": "uses" },
      { "from": "tools", "to": "ends", "kind": "uses", "word": "marked" },
      { "from": "runner", "to": "ends", "kind": "uses", "word": "any turn-ending tool closes an answer" },
      { "from": "call", "to": "asked", "kind": "creates" },
      { "from": "blocks", "to": "call", "kind": "uses" },
      { "from": "blocks", "to": "card", "kind": "creates", "word": "only that card" }
    ]
  }
}

{
  "kind": "sequence",
  "title": "CL60.4 the classes: drawing one class chart",
  "caption": "The adapter does the work: once a class chart is a flow, everything after it is what the flows already have.",
  "sequence": {
    "participants": [
      { "id": "tool", "label": "doc-diagrams", "icon": "terminal", "tone": "blue" },
      { "id": "reader", "label": "DiagramReader", "icon": "book", "tone": "teal" },
      { "id": "renderer", "label": "ClassesRenderer", "icon": "code", "tone": "violet" },
      { "id": "adapter", "label": "ClassFlow", "icon": "settings", "tone": "violet" },
      { "id": "flow", "label": "GraphLayout and FlowRenderer", "icon": "chart", "tone": "violet" }
    ],
    "steps": [
      { "step": "message", "from": "tool", "to": "reader", "text": "Read(the JSON)" },
      { "step": "reply", "from": "reader", "to": "tool", "text": "a DiagramSource of kind classes, every relation checked" },
      { "step": "message", "from": "tool", "to": "renderer", "text": "RenderTitled(source)" },

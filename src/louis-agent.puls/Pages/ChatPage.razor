@page "/gesels"
@page "/verken"
@page "/studio"
@page "/gesels/{SessionId}"
@page "/chat/{SessionId}"
@implements IDisposable

@* The shell (F20): the sidebar, the top bar, the chat (or Verken or Studio), the message box, the Werk panel. W2: the
   layout only; each piece is a component under Components/Chat, a turn's life is the shared ChatRunner, and the
   page's own state and handlers are in ChatPage.razor.cs. *@

<PageTitle>@(Runner.Chat?.Title ?? "Puls")</PageTitle>

<div class="app">
    @* Below Bootstrap's lg breakpoint (992px) the sidebar is an offcanvas, opened from this bar. *@
    <header class="topbar d-lg-none">
        <button class="icon menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Maak die kieslys oop">☰</button>
        <div class="brand"><PulsLogo /></div>
        <button class="icon" type="button" @onclick="NewChat" aria-label="Nuwe gesprek">＋</button>
    </header>

    <ChatSidebar Chats="Store.Chats" SessionId="@SessionId" View="@View" OnNewChat="NewChat" OnSearch="() => _searchOpen = true" OnComingSoon="ComingSoon"
                 Renaming="@_renaming" RenameInHeader="_renameInHeader" @bind-RenameDraft="_renameDraft" OnRenameKey="RenameKey" OnRenameBlur="FinishRename"
                 OnFavourite="ToggleFavourite" OnRename="StartRename" OnArchive="ToggleArchive" OnDelete="DeleteChat"
                 Location="@_location" Locating="_locating" OnSaveLocation="SaveLocation" OnLocate="UseMyLocation"
                 Motion="_motion" ReducedMotion="_reducedMotion" OnSaveMotion="SaveMotion"
                 ApiKeyDraft="@Store.ApiKeyDraft" OnSaveApiKey="SaveApiKey" />

    @* Drag to resize the sidebar; double-click to reset (pulsUi in js/chat.js). *@
    <div class="resizer d-none d-lg-block" role="separator" aria-orientation="vertical" title="Sleep om die breedte te verander · dubbelklik om terug te stel"></div>

    <main class="conversation">
        <ChatHeader View="@View" Chat="Runner.Chat" Renaming="@_renaming" RenameInHeader="_renameInHeader" @bind-RenameDraft="_renameDraft"
                    OnRenameKey="RenameKey" OnRenameBlur="FinishRename" OnFavourite="ToggleFavourite" OnRename="StartRename" OnArchive="ToggleArchive"
                    OnDelete="DeleteChat" OnComingSoon="ComingSoon" ChatCost="@ChatCost" MonthCost="@MonthCost" MonthChats="MonthChats.Count"
                    Language="@_language" Languages="_languages" OnChooseLanguage="ChooseLanguage" />
        @* Below lg the Werk panel slides in from this tab (the phone's top bar has the menu and New chat). *@
        <button class="work-tab work-tab-open d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#work" aria-controls="work" title="Wys die werkpaneel">Werk</button>
        @* The landing's water, low behind an empty chat (F24): across the column, under the messages. *@
        @if (View is not ("verken" or "studio") && (Runner.Chat is null || Runner.Chat.Turns.Count == 0))
        {
            <Water />
        }
        <MessageList Chat="Runner.Chat" Streaming="Runner.Streaming" Currency="Currency.Current" Content="@(View == "chat" ? null : Views)"
                     UserActions="UserActionsOf" AnswerActions="AnswerActionsOf">
            <Empty><EmptyChat Composer="MessageBox" Streaming="Runner.Streaming" OnDraft="SetDraft" OnSuggest="Suggest" /></Empty>
        </MessageList>

        <Notice Text="@Runner.Notice" OnClose="() => Runner.Notice = null" />

        @* The whole cost, specialists included (pay as you go: what's shown is what's paid). *@
        <ChatUsageBar Usage="@(View == "chat" && Runner.Chat is not null ? ChatTotal(Runner.Chat) : null)" Currency="Currency.Current" Context="chatUsage">Hierdie gesprek: @chatUsage.Requests versoeke · @UsageFormat.Tokens(chatUsage.TotalTokens) tokens · @UsageFormat.Cost(chatUsage, Currency.Current), spesialiste ingesluit</ChatUsageBar>

        @if (View == "chat" && Runner.Chat is { Turns.Count: > 0 })
        {
            <div class="composer">@MessageBox</div>
        }
    </main>

    <ChatSearch @bind-Open="_searchOpen" Chats="Store.Chats" />

    <Toast Text="@_toast" />

    <aside class="work offcanvas-xl offcanvas-end" id="work" tabindex="-1" aria-label="Werk">
        <WorkPanel Chat="Runner.Chat" Streaming="Runner.Streaming" Currency="Currency.Current" />
    </aside>
</div>

@code {
    /// <summary>Verken or Studio in place of the turns (F20).</summary>
    private RenderFragment Views => __builder =>
    {
        @if (View == "verken")
        {
            <ExploreView OnStart="StartTemplate" />
        }
        else if (View == "studio")
        {
            <StudioView Recent="Store.Chats.Where(c => !c.Archived).Take(5).ToList()" OnStart="StartTemplate" OnNewProject='() => ComingSoon("Projekte")' />
        }
    };

    /// <summary>The message box (shared Composer with Puls's toolbar): in the middle of an empty chat, at the bottom once it has turns.</summary>
    private RenderFragment MessageBox => __builder =>
    {
        <Composer @bind-Draft="Runner.Draft" Attachments="Runner.Attachments" Streaming="Runner.Streaming" CanSend="Runner.CanSend" Disabled="@(Runner.Chat?.Ended == true)"
                  Placeholder="@(Runner.Chat?.Ended == true ? "Hierdie gesprek het geëindig toe die API herbegin het - begin 'n nuwe gesprek" : "Vra enigiets…")"
                  OnSend="Runner.SendAsync" OnStop="Runner.StopAsync" BoxClass="input-box" SendLabel="↑" StopLabel="■" SendTitle="Stuur (Enter)" StopTitle="Stop">
            <Tools><ComposerTools Model="@_model" OnFiles="Runner.AddFilesAsync" OnDraft="SetDraft" OnComingSoon="ComingSoon" /></Tools>
        </Composer>
    };

    private RenderFragment<Turn> UserActionsOf => turn => __builder =>
    {
        <UserActions Turn="turn" OnCopy="Copy" OnComingSoon="ComingSoon" />
    };

    private RenderFragment<Turn> AnswerActionsOf => turn => __builder =>
    {
        <AnswerActions Turn="turn" OnCopy="Copy" OnComingSoon="ComingSoon" />
    };
}

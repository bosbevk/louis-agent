@* The theme's component guide (ADR 0125): every control a site configures, live, laid out as the design page's
   controls are. It draws itself from the theme the visitor picked, so switching the look changes every piece here.
   Every control works where it stands, and nothing leads away, since the framework names no site's pages. *@
<div class="theme-guide">
    <div class="guide-grid">
        <div class="panel">
            <Intro Title="Buttons" Summary="The main button is violet. The quiet one is white by day and black by night. Press them." />
            <div class="guide-row">
                <button class="btn btn-fill" type="button" @onclick="Press">Press me</button>
                <button class="btn btn-line" type="button" @onclick="Press">Press me too</button>
            </div>
            <div class="guide-row"><span class="guide-pressed"><StatusPill Text="@PressedText" /></span></div>
            <div class="guide-row">
                <button class="btn btn-fill btn-small" type="button" disabled>Can't press</button>
                <button class="btn btn-line btn-small" type="button" disabled>Can't press</button>
            </div>
        </div>
        <div class="panel">
            <Intro Title="Switch and slider" Summary="Tap a switch to turn it on or off. Drag the slider." />
            <div class="guide-row">
                <Switch Label="A switch that starts on" On="true" />
                <Switch Label="A switch that starts off" />
                <span class="guide-label">locked</span><Switch Label="A locked switch" Disabled="true" />
            </div>
            <div class="guide-row"><Slider Label="A value" /></div>
        </div>
        <div class="panel">
            <Intro Title="Field" Summary="Click into it and type. Its edge turns violet." />
            <div class="guide-row"><PillField Placeholder="Your email" Kind="email" /></div>
            <Well Text="This box holds words to read, not to type in." />
        </div>
        <div class="panel">
            <Intro Title="Tags" Summary="Small labels. A plain one, one for what you picked, and one for what the agent shows." />
            <div class="guide-row">
                <Tag Text="A tag" />
                <Tag Text="You picked this" Kind="TagKind.You" />
                <Tag Text="The agent shows this" Kind="TagKind.Agent" />
            </div>
        </div>
        <div class="panel">
            <Intro Title="Status" Summary="A small pill that says what is happening right now." />
            <div class="guide-row">
                <StatusPill Text="Live" />
                <StatusPill Text="Answered in 2.1 s" />
            </div>
        </div>
        <div class="panel">
            <Intro Title="Focus" Summary="Press Tab to move through the page. A ring of light shows where you are." />
            <div class="guide-row">
                <button class="btn btn-line" type="button" @onclick="Press">Tab to me</button>
                <Switch Label="Tab to me too" />
            </div>
        </div>
    </div>

    <section class="guide-part">
        <Intro Title="Cards" Summary="Point at a card and it lifts. In glass, light runs round its edge." />
        <TileRow>
            <Tile Icon="DiagramIcon.Server" Title="Your server">A container you host.</Tile>
            <Tile Icon="DiagramIcon.Settings" Title="Your model" Delay="1">Hosted, or local.</Tile>
            <Tile Icon="DiagramIcon.Database" Title="Your data" Delay="2">It stays with you.</Tile>
        </TileRow>
    </section>

    <section class="guide-part">
        <Intro Title="The look" Summary="Pick glass or flat, and dark or light. Every part of this page changes with it, and your browser remembers." />
        <div class="guide-row"><LookSwitch /></div>
    </section>

    <section class="guide-part">
        <Intro Title="The agent's mark" Summary="The mark shows what the agent is doing. It plays each state in turn. Press one to hold it." />
        <MarkStates />
    </section>

    <section class="guide-part">
        <Intro Title="Words" Summary="A heading with its summary, a few steps in order, and a list of named things." />
        <Steps Items="StepsExample" />
        <TermList Terms="Terms" />
    </section>

    <section class="guide-part">
        <Intro Title="A chat, playing" Summary="One question to the agent and its answer, played line by line, over and over." />
        <LiveTurn Title="a chat on your website" Label="An example chat, playing" Lines="TurnExample" Cost="2 requests · 4k tokens · **$0.002**" CostAt="5" />
    </section>
</div>

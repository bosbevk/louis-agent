          "AgentAddress Agent",
          "IReadOnlyList<Conversation> Conversations",
          "string? Schema"
        ]
      },
      {
        "id": "conv",
        "name": "Conversation",
        "kind": "record",
        "members": [
          "string Id",
          "IReadOnlyList<Turn> Turns",
          "string? Page"
        ]
      },
      {
        "id": "turn",
        "name": "Turn",
        "kind": "record",
        "members": [
          "string Ask",
          "IReadOnlyList<Fact> Facts",
          "IReadOnlyList<string> Criteria"
        ]
      },
      {
        "id": "fact",
        "name": "Fact",
        "kind": "record",
        "members": [
          "FactKind Kind",
          "string Argument",
          "static Fact Parse(string words)"
        ]
      },
      {
        "id": "kind",
        "name": "FactKind",
        "kind": "enum",
        "members": [
          "NoError, Used, NotUsed, Under,",
          "NeverSays, RoutedTo, Continued"
        ]
      },
      {
        "id": "address",
        "name": "AgentAddress",
        "kind": "record, the engine's",
        "tone": "violet",
        "members": [
          "static bool TryParse(text, out address)"
        ]
      },
      {
        "id": "reader",
        "name": "EvalFileReader",
        "kind": "static",
        "members": [

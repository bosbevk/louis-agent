          "+IReadOnlyList<Conversation> Conversations",
          "+JudgeMode Judge",
          "+Read(path) EvalFile (static)"
        ]
      },
      {
        "id": "Conversation",
        "name": "Conversation",
        "kind": "record",
        "members": [

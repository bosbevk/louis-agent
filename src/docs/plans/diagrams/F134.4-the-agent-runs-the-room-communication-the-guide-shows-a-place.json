      },
      {
        "step": "message",
        "from": "guide",
        "to": "bar",
        "text": "Offer: its choices"
      },
      {
        "step": "note",
        "over": [
          "bar"
        ],
        "text": "the caption: words and choices"
      },
      {
        "step": "message",
        "from": "bar",
        "to": "demo",
        "text": "done: play on"

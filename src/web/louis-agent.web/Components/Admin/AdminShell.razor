@* The admin's frame: a fixed sidebar and a content column, and a page puts its header and cards in the column. Reference: the
   page anatomy AdminLTE and Tabler share (sidebar, page header with actions, cards); none of their files. In English: the admin
   screens are the builder's. Its own root class, not .app: a chat's grid rules must not reach here. *@
<div class="admin-shell">
    <header class="topbar d-lg-none">
        <button class="icon menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#admin-sidebar" aria-controls="admin-sidebar" aria-label="Open the menu">☰</button>
        @if (Brand is not null)
        {
            <div class="brand">@Brand</div>
        }
        @if (BackHref is not null)
        {
            <a class="icon" href="@BackHref" title="@BackLabel" aria-label="@BackLabel">←</a>
        }
    </header>

    <aside class="sidebar offcanvas-lg offcanvas-start" id="admin-sidebar" tabindex="-1" aria-label="Admin">
        <div class="sidebar-top">
            <a class="brand brand-stack" href="./" title="@BrandTitle">@Brand<span class="tagline">Admin</span></a>
            <button class="icon d-lg-none" type="button" data-bs-dismiss="offcanvas" data-bs-target="#admin-sidebar" aria-label="Close the menu">×</button>
        </div>

        @* The overview first (F127.8): what the site's agents did, on every site with an admin. *@
        <nav class="side-nav">
            <NavLink class="side-link" href="admin/overview"><span class="ic i-user" aria-hidden="true"></span>Overview</NavLink>
        </nav>

        @Links

        @* Each named area's links, after the site's own (F127.6): the eval studio's on every site that runs it. *@
        @foreach (var links in AreaLinks)
        {
            <DynamicComponent Type="links" />
        }

        <PackMenu />

        @if (BackHref is not null)
        {
            <div class="side-footer">
                <nav class="side-nav admin-side-back">
                    <a class="side-link" href="@BackHref"><span class="ic i-chat" aria-hidden="true"></span>@BackLabel</a>
                </nav>
            </div>
        }
    </aside>

    <main class="admin-main">
        @Top
        @ChildContent
    </main>
</div>

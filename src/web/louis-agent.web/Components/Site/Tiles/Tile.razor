@* One tile in a row (F118): the theme's pane with a number and its note, or an icon in a glass chip, a title and a
   few words, rising as it enters (FX162, as the design's cards are). *@
<article class="@Classes" data-delay="@DelayValue" id="@PieceAddress" data-piece="@IsPiece" data-tilt="@Tilt"
         data-lens="@LensSwitch" data-water="@Water" data-reflect="@Reflect">
    @if (Icon is { } icon)
    {
        <span class="tile-icon"><LineIconView Icon="icon" /></span>
    }
    @if (Title is not null)
    {
        <h3>@Title</h3>
    }
    @if (Value is not null)
    {
        <span class="stat-value chrome">@Value</span>
    }
    @if (Note is not null)
    {
        <span class="stat-note">@Note</span>
    }
    @if (Text is not null)
    {
        <p>@Markdown.Inline(Text)</p>
    }
    @if (ChildContent is not null)
    {
        <p>@ChildContent</p>
    }
</article>

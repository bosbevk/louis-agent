<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws every doc's diagram (CL60.1): each diagrams/*.json under the docs becomes the SVG beside it. A person (or
       Claude) runs it after changing a diagram; nothing ships it. The drawing is louis-agent.diagrams', the same the
       site's pages use. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.DocDiagrams</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.doc-diagrams.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <ProjectReference Include="..\..\web\louis-agent.diagrams\louis-agent.diagrams.csproj" />
  </ItemGroup>

</Project>

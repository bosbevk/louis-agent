@* One mode's roll-up (F18 step 5c.3): a line per slice, the overall one first. Counts are the runner's; the costs are the ledger's. *@
<div class="summary-mode">
    <h3>@Mode.Mode</h3>
    <div class="table-wrap">
        <table class="run-table summary-table">
            <thead>
                <tr>
                    <th>Slice</th><th title="Trials in the slice">n</th><th>Passed</th><th title="Passed over the counted trials">Pass rate</th>
                    <th title="Passed at least once in its trials: can the agent do this?">pass@k</th>
                    <th title="Passed every time: can a customer rely on it?">pass^k</th>
                    <th>Unknown</th><th title="Left out of the rates: not the agent's failure">Infra</th><th>Cost / trial</th><th>Cost / pass</th><th>Tasks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slice in Mode.Slices)
                {
                    <tr class="summary-row @(slice.Slice == "overall" ? "overall" : "")">
                        <td class="s-slice">@slice.Slice</td>
                        <td class="s-n">@slice.N</td>
                        <td class="s-passed">@SummaryText.Passed(slice)</td>
                        <td class="s-rate">@SummaryText.Rate(slice, slice.PassRate)</td>
                        <td class="s-at-k">@SummaryText.Rate(slice, slice.PassAtK)</td>
                        <td class="s-hat-k">@SummaryText.Rate(slice, slice.PassHatK)</td>
                        <td class="s-unknown">@slice.Unknown</td>
                        <td class="s-infra">@slice.Infrastructure</td>
                        <td class="s-cost-trial">@SummaryText.Cost(slice.CostPerTrial, Currency)</td>
                        <td class="s-cost-pass">@SummaryText.CostPerPass(slice, Currency)</td>
                        <td class="s-tasks">
                            <details>
                                <summary>@slice.Tasks.Count</summary>
                                @foreach (var task in slice.Tasks)
                                {
                                    <a class="s-task" href="admin/benchmarks/@RunId?task=@Uri.EscapeDataString(task)">@task</a>
                                }
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

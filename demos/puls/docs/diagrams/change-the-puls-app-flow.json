{
  "kind": "flow",
  "type": "activity",
  "title": "Change the Puls web app: run, change, test, look",
  "caption": "A golden file you meant to change is regenerated, and its diff read.",
  "flow": {
    "nodes": [
      { "id": "run", "label": "Run it\n5070 or 5071", "icon": "terminal", "tone": "blue", "shape": "terminal" },
      { "id": "change", "label": "Make the change", "icon": "file", "tone": "amber", "shape": "box" },
      { "id": "test", "label": "dotnet test\nLouisAgent.Puls.Tests", "icon": "checks", "tone": "amber", "shape": "box" },
      { "id": "golden", "label": "Golden file\nchanged on purpose?", "tone": "green", "shape": "decision" },
      { "id": "update", "label": "Regenerate it\nthen read the diff", "icon": "file", "tone": "amber", "shape": "box" },
      { "id": "look", "label": "Look at it\n1440, 1100, 420 px", "icon": "browser", "tone": "blue", "shape": "terminal" }
    ],
    "edges": [
      { "from": "run", "to": "change" },
      { "from": "change", "to": "test" },
      { "from": "test", "to": "golden" },
      { "from": "golden", "to": "update", "word": "yes" },
      { "from": "golden", "to": "look", "word": "no" },
      { "from": "update", "to": "look" }
    ],
    "direction": "right"
  }
}

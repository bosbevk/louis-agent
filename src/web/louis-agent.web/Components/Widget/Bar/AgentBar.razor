@using LouisAgent.Web.Usage
@using LouisAgent.Web.Components.Widget.Bar.Caption
@using LouisAgent.Web.Components.Widget.Orb
@* The agent bar (F134.3): the guide at the foot of the page, as the J and K mockups have it. Over it the talk so far,
   folded to its end until the visitor opens it; in it the orb, a line of what the guide is doing, and the box, which
   is always there to type in. It draws what the widget's runner holds and asks the widget to send, so the widget
   stays the one engine and the bar is only its look. *@
<div class="agent-bar">
    @* The site's suggestions while the guide waits: each chip asks its question, and the last word says the box is
       there too, since a chip is a shortcut and never the only way in (F134's rule 3). *@
    @if (Chips is { Count: > 0 } chips && ChipsShow)
    {
        <div class="agent-chips">
            @foreach (string question in chips)
            {
                <button type="button" @onclick="() => OnChoose.InvokeAsync(question)">@question</button>
            }
            <span class="agent-chips-note">@Text.OrTypeYourOwn</span>
        </div>
    }
    @* The last answer showed a place: it stands as the caption (F134.4), and the folded talk gives way to it. *@
    @if (Caption is { } caption)
    {
        <AgentCaption Title="@Title" Words="@caption.Words" Offer="caption.Offer" Work="caption.Work"
                      Currency="Currency" OnChoose="OnChoose" OnTalk="ToggleTalk"/>
    }
    else if (Runner.Chat is { Turns.Count: > 0 })
    {
        <div class="@TalkClasses">
            <MessageList Chat="Runner.Chat" Streaming="Runner.Streaming" Currency="Currency" Class="agent-list"
                         ShowWork="ShowWork" Chosen="OnChoose" ShowCardAnswers="ShowCardAnswers"/>
            @* Opened whole, the talk ends with what it has cost (F134.5), as the chat's usage line says it. *@
            @if (_talkOpen && Total is { } spent)
            {
                <div class="agent-talk-total">@UsageFormat.Total(spent, Currency)</div>
            }
            <button class="agent-talk-toggle" type="button" @onclick="ToggleTalk">@TalkLabel</button>
        </div>
    }
    <div class="agent-row">
        <Orb State="State" Label="@Title"/>
        <div class="agent-box">
            <span class="agent-doing">@Doing</span>
            <Composer Draft="@Runner.Draft" DraftChanged="draft => Runner.Draft = draft"
                      Attachments="Runner.Attachments"
                      Streaming="Runner.Streaming" CanSend="Runner.CanSend" Placeholder="@Placeholder"
                      OnSend="OnSend" OnStop="Runner.StopAsync" SendLabel="↑" StopLabel="■"
                      SendTitle="@Text.SendTitle" StopTitle="@Text.StopTitle"/>
        </div>
        @* What the talk has cost so far, and how many answers (F134.5): a press opens the whole talk. *@
        @if (Total is { } total)
        {
            <button class="agent-total" type="button" title="@UsageFormat.Total(total, Currency)"
                    @onclick="ToggleTalk">
                @UsageFormat.Cost(total, Currency) · @Text.Answers(Answers)
            </button>
        }
    </div>
</div>

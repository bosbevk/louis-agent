@page "/admin/studio"
@layout AdminLayout

@* F49.5: compose an eval from the runner's catalogue, see its file, save it and ask the runner's verdict. A draft
   changes no eval: publishing writes its folder. *@

<PageTitle>Studio · Puls Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Studio</h1>
        <p>Compose an eval from the checks the runner has, check it as a run would, and keep it as a draft until it is published.</p>
    </div>
    <div class="page-actions">
        <button class="header-button studio-new" type="button" @onclick="New"><span class="ic i-plus" aria-hidden="true"></span>New eval</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

<div class="studio">
    <aside class="studio-list card-p">
        <h4>Drafts</h4>
        @if (_drafts.Count == 0)
        {
            <p class="muted small">No eval is being composed yet.</p>
        }
        @foreach (var draft in _drafts)
        {
            <button type="button" class="studio-draft @(draft.Id == _id ? "active" : "")" @onclick="() => Open(draft)">
                <code>@draft.Name</code><small class="muted">for @draft.Identity · @draft.Author</small>
            </button>
        }
        <PromptfooPanel HasDraft="_eval is not null" SaveDraft="SaveDraftAsync" OnImported="ImportedAsync" />
    </aside>

    @if (_eval is { } eval && _catalogue is { } catalogue)
    {
        @* The admin review's finding 6: the steps in the order they are done, numbered (GOV.UK's task list). *@
        <ol class="studio-editor">
            <li class="studio-step">
                <h4><span class="studio-step-n">1</span> Compose</h4>
                <ComposeHead Eval="eval" />
                <ComposeChecks Eval="eval" Catalogue="catalogue" />
                <ComposeRubrics Rubrics="_rubrics" />
                @if (_scenarios.Count > 0)
                {
                    <p class="studio-scenarios muted small">@_scenarios.Count scenario file(s) of its own, as an import brought them: kept with the draft.</p>
                }
                <div class="studio-actions">
                    <button type="button" class="studio-save header-button" disabled="@_busy" @onclick="SaveAsync">Save</button>
                    <button type="button" class="studio-view-json link-button" @onclick="() => _showJson = !_showJson">@JsonLabel</button>
                    @if (_saved is not null)
                    {
                        <span class="muted small">@_saved</span>
                    }
                </div>
                @if (_showJson)
                {
                    <pre class="studio-json">@Json</pre>
                }
            </li>
            <li class="studio-step">
                <h4><span class="studio-step-n">2</span> Check</h4>
                <p class="muted small">The runner loads it as a run would, and names every problem.</p>
                <div class="studio-actions">
                    <button type="button" class="studio-check header-button" disabled="@_busy" @onclick="CheckAsync">Check</button>
                </div>
                <StudioVerdict Verdict="_verdict" />
            </li>
            <li class="studio-step">
                <h4><span class="studio-step-n">3</span> Try</h4>
                <p class="muted small">Replay a recorded run on the draft, on a few samples, at no cost.</p>
                <TryStep Eval="@eval.Name" SaveDraft="SaveDraftAsync" />
            </li>
            <li class="studio-step">
                <h4><span class="studio-step-n">4</span> Publish</h4>
                <p class="muted small">Commit its folder on a branch, for a pull request.</p>
                <div class="studio-actions">
                    <button type="button" class="studio-publish header-button" disabled="@_busy" @onclick="PublishAsync">Publish</button>
                </div>
                @if (_published is not null)
                {
                    <p class="studio-published">@_published</p>
                }
            </li>
        </ol>
    }
</div>

event: content_block_start
data: {"type":"content_block_start","index":24,"content_block":{"type":"tool_use","id":"toolu_01TJJPLYNzbxZU4KpcyEExs2","name":"WriteWorkspaceFile","input":{"relativePath":"InvoiceMatcher/Matcher.cs","content":"using System.Text.RegularExpressions;\n\nnamespace InvoiceMatcher;\n\n/// <summary>Matches the bank's payments to our invoices: the invoice number in the reference, and the full amount.</summary>\npublic static class Matcher\n{\n    /// <summary>Each payment that names an invoice and pays it in full is matched; the rest are left for a person.</summary>\n    public static MatchResult Match(IReadOnlyList<Invoice> invoices, IEnumerable<Payment> payments)\n    {\n        var matched = new List<Match>();\n        var unmatched = new List<Payment>();\n        foreach (var payment in payments)\n        {\n            var invoice = invoices.FirstOrDefault(invoice =>\n                NamesInvoice(payment.Reference, invoice.Number) && invoice.Amount == payment.Amount);\n            if (invoice is null)\n            {\n                unmatched.Add(payment);\n                continue;\n            }\n\n            matched.Add(new Match(invoice, payment));\n        }\n\n        return new MatchResult(matched, unmatched);\n    }\n\n    /// <summary>\n    /// True when the invoice number appears in the reference as a whole token, ignoring case.\n    /// \"INV-104\" must not match inside \"INV-1042\", so the number may not be followed or preceded by a letter or digit.\n    /// </summary>\n    private static bool NamesInvoice(string reference, string invoiceNumber)\n    {\n        var pattern = $@\"(?<![A-Za-z0-9]){Regex.Escape(invoiceNumber)}(?![A-Za-z0-9])\";\n        return Regex.IsMatch(reference, pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);\n    }\n}\n"}}}


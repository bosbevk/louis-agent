FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish "demos/louis-agent/hosts/louis-agent.coding-acp/louis-agent.coding-acp.csproj" -c Release -o /app/publish

# The SDK image is kept for the final stage because the RunDotNet workspace tool shells out to `dotnet build/test`.
FROM mcr.microsoft.com/dotnet/sdk:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl bc git python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish/ .
ENTRYPOINT ["dotnet", "louis-agent.coding-acp.dll"]

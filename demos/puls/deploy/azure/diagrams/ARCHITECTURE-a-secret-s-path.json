{
  "kind": "sequence",
  "title": "Puls in Azure: a secret's path",
  "caption": "Values go one way: from the git-ignored files into the vault, and the app reads them back by reference with its own identity.",
  "sequence": {
    "participants": [
      {
        "id": "L",
        "label": "Louis's PC (config/.env.secrets, .env.mongo, .env.sql)",
        "icon": "folder",
        "tone": "blue"
      },
      {
        "id": "S",
        "label": "deploy.ps1 secrets",
        "icon": "terminal",
        "tone": "green"
      },
      {
        "id": "V",
        "label": "Key Vault puls-keys",
        "icon": "shield",
        "tone": "amber"
      },
      {
        "id": "U",
        "label": "deploy.ps1 update",
        "icon": "terminal",
        "tone": "green"
      },
      {
        "id": "A",
        "label": "puls-app (identity puls-app-identity)",
        "icon": "server",
        "tone": "red"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "L",
        "to": "S",
        "text": "the values, and the VM's IP and the SQL server from the outputs"
      },
      {
        "step": "message",
        "from": "S",
        "to": "V",
        "text": "one secret per value (mongo-url and accounts-sql-url built here)"
      },
      {
        "step": "message",
        "from": "U",
        "to": "V",
        "text": "which names exist?"
      },
      {
        "step": "message",
        "from": "U",
        "to": "A",
        "text": "a secrets block of keyVaultUrl references, env lines only for secrets that exist"
      },
      {
        "step": "message",
        "from": "A",
        "to": "V",
        "text": "read each reference with the identity (Key Vault Secrets User)"
      }
    ]
  }
}

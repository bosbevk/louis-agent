# Sensitive Secrets Template - COPY TO .env.secrets AND FILL IN YOUR VALUES
# This template shows what secrets are needed. Copy to .env.secrets and add real values.
# .env.secrets is git-ignored and should never be committed.

# Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic workspace ID - only needed if the API key is NOT scoped to a workspace
# (error: "must include the anthropic-workspace-id header"). Find it under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Paymo API Key (get from Paymo account settings)
PAYMO_API_KEY=your-paymo-api-key

# DevOps API Key (Azure DevOps personal access token)
DEVOPS_API_KEY=your-devops-pat

# Rider MCP Project Path (local development only - Windows path)
RIDER_MCP_PROJECT_PATH=C:/Users/your-username/RiderProjects/louis-agent-solution

# Google search for the WebSearch tool (optional). Needs BOTH values; without them WebSearch uses keyless DuckDuckGo.
# 1. Create a Programmable Search Engine that searches the entire web: https://programmablesearchengine.google.com
#    and copy its Search engine ID (cx).
# 2. Enable the "Custom Search API" in Google Cloud and create an API key: https://developers.google.com/custom-search/v1/overview
# GOOGLE_SEARCH_API_KEY=...
# GOOGLE_SEARCH_ENGINE_ID=...

# Key for the HTTP API (louis-agent.api, http://127.0.0.1:5080). When set, every call except /health
# must send it as x-api-key or Authorization: Bearer. Without it the API is open to anything that can reach it.
# AGENT_API_KEY=pick-a-long-random-value

# Key for louis-agent.mcp-server when MCP_TRANSPORT=http (same header rules as AGENT_API_KEY above). Separate from
# AGENT_API_KEY so mcp-server access can be rotated/revoked independently of the API's; falls back to AGENT_API_KEY
# when unset, so setting only that one key still protects both services.
# MCP_API_KEY=pick-a-different-long-random-value

# Author for commits made from the web app's Changes tab (git in the container has no identity of its own).
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

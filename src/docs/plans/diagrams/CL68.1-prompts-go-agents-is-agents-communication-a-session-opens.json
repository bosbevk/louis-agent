{
  "kind": "sequence",
  "title": "CL68.1: a session opens on the guide",
  "caption": "The catalogue gathers each provider once and checks every path; the engine reads the guide's voice at agents/louis-agent-guide/voice.md, the path it has in its project.",
  "sequence": {
    "participants": [
      { "id": "host", "label": "LouisAgent.SiteApi", "icon": "server", "tone": "violet" },
      { "id": "catalog", "label": "AgentCatalog", "icon": "stack", "tone": "teal" },
      { "id": "providers", "label": "the providers", "icon": "folder", "tone": "green" },
      { "id": "engine", "label": "the engine", "icon": "chip", "tone": "teal" }
    ],
    "steps": [
      { "step": "message", "from": "host", "to": "catalog", "text": "identities and packs" },
      { "step": "message", "from": "catalog", "to": "providers", "text": "each identity's and pack's Prompts, Distinct()" },
      { "step": "note", "over": ["providers"], "text": "the showroom's three identities: one provider" },
      { "step": "reply", "from": "providers", "to": "catalog", "text": "every path, from each project's root" },
      { "step": "note", "over": ["catalog"], "text": "every path unique, or it stops" },
      { "step": "message", "from": "host", "to": "engine", "text": "open a session on louis-agent-guide" },
      { "step": "message", "from": "engine", "to": "providers", "text": "agents/louis-agent-guide/voice.md" },
      { "step": "reply", "from": "providers", "to": "engine", "text": "the voice, its header, its skills/" }
    ]
  }
}

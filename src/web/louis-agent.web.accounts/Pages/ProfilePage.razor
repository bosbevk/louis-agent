@page "/profile"
@layout AccountFrame
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@* The profile, the same on every site: who the person is, their name, their email, their password, the ways they
   sign in, and the way out. A guest is sent to sign in first. [Authorize] says it is behind a sign-in, so the host
   never draws it for a search engine (F164.1); the sign-in pages beside it are public. *@

<PageTitle>@Text.Profile</PageTitle>

@if (State.Me is { } me)
{
    <h1>@Text.Profile</h1>
    <p>@Text.ProfileIntro</p>
    <ProfileDetails Me="me" />
    <ChangeEmail />
    <ChangePassword Me="me" />
    <SetPassword Me="me" />
    <AccountNotice Message="@(Failed == "link" ? Text.LinkFailed : null)" IsError="true" />
    <LinkedLogins Me="me" />
    <PasskeyList />
    <TwoFactorSection Me="me" />
    <DeleteAccount Me="me" OnDeleted="GoHome" />
    <div class="account-section account-actions">
        <button class="account-button is-plain" type="button" @onclick="SignOutAsync">@Text.SignOut</button>
    </div>
}

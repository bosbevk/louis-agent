<Project Sdk="Microsoft.NET.Sdk">

  <!-- Web access on core (CL33): the implementations of the composition's web contracts, which core's engine takes
       through its IWebAccess seam: the guarded browser on headless Chrome (PuppeteerSharp), the page fetcher, the
       robots.txt policy, the search providers, the page renderers and the recorders for replay. A host opts in by
       handing AgentHost.Build WebAccess.Create in its HostServices; core alone runs on NoWebAccess. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Core.Web</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\louis-agent.core\louis-agent.core.csproj" />
    <ProjectReference Include="..\louis-agent.composition\louis-agent.composition.csproj" />
    <ProjectReference Include="..\louis-agent.choices\louis-agent.choices.csproj" />
    <!-- The browser tells the crash handler which lost-context errors to expect. -->
    <ProjectReference Include="..\louis-agent.core.telemetry\louis-agent.core.telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.core.web.tests" />
    <InternalsVisibleTo Include="louis-agent.pack.web.tests" />
    <PackageReference Include="PuppeteerSharp" Version="25.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc, shown under docs/ in the IDE's solution explorer; nothing is built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.core.web.md" Link="docs\louis-agent.core.web.md" />
  </ItemGroup>

</Project>

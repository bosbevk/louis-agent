{
  "kind": "sequence",
  "title": "F169.1 flat's lines and inks: a topic line in the dark",
  "caption": "The page says flat and dark, the theme's block for that pair answers each name, and the topic's rule reads the purple the block set. Step 5 changes only which name the rule asks for.",
  "sequence": {
    "participants": [
      { "id": "V", "icon": "user", "tone": "blue", "label": "A visitor", "actor": true },
      { "id": "S", "icon": "code", "tone": "violet", "label": "first-paint.js" },
      { "id": "H", "icon": "browser", "tone": "violet", "label": "The page's <html>" },
      { "id": "B", "icon": "file", "tone": "amber", "label": "Flat's dark block" },
      { "id": "T", "icon": "file", "tone": "violet", "label": "The .topic rule" }
    ],
    "steps": [
      { "step": "message", "from": "V", "to": "S", "text": "opens /features, having picked dark before" },
      { "step": "message", "from": "S", "to": "H", "text": "data-style=\"dark\", from site.style; data-theme=\"flat\" is the page's own" },
      { "step": "message", "from": "H", "to": "B", "text": ":root[data-theme=\"flat\"][data-style=\"dark\"] matches" },
      { "step": "reply", "from": "B", "to": "H", "text": "--web-purple: #9282ff, --bs-primary: #6b4dff, --bs-body-bg: #0c0c0e" },
      { "step": "message", "from": "T", "to": "H", "text": "color: var(--web-purple)  (step 5, was var(--bs-primary))" },
      { "step": "reply", "from": "H", "to": "T", "text": "#9282ff" },
      { "step": "note", "over": ["T"], "text": "on #0c0c0e that is 6.38 to 1, where #6b4dff was 3.84" },
      { "step": "reply", "from": "T", "to": "V", "text": "the topic line, readable in the dark" }
    ]
  }
}

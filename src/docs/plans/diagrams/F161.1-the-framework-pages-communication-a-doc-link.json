{
  "kind": "sequence",
  "title": "F161.1 the framework's pages: a visitor follows a doc link",
  "caption": "The page was drawn with the address the site named, so the press is an ordinary link to the doc on GitHub.",
  "sequence": {
    "participants": [
      { "id": "visitor", "label": "Developer", "icon": "user", "tone": "blue" },
      { "id": "host", "label": "Framework site's host", "icon": "server", "tone": "amber" },
      { "id": "page", "label": "FeaturesPage", "icon": "browser", "tone": "amber" },
      { "id": "link", "label": "DocLink", "icon": "book", "tone": "teal" },
      { "id": "address", "label": "DocsAddress", "icon": "settings", "tone": "teal" },
      { "id": "github", "label": "GitHub", "icon": "branch", "tone": "red" }
    ],
    "steps": [
      { "step": "message", "from": "visitor", "to": "host", "text": "GET /features/code" },
      { "step": "reply", "from": "host", "to": "visitor", "text": "the page, prerendered" },
      { "step": "message", "from": "page", "to": "link", "text": "Path: src/docs/adr/0126-….md, \"The naming rule\"" },
      { "step": "message", "from": "link", "to": "address", "text": "For(path)" },
      { "step": "reply", "from": "address", "to": "link", "text": "github.com/bosbevk/louis-agent/blob/main/src/docs/adr/0126-….md" },
      { "step": "message", "from": "visitor", "to": "github", "text": "presses the link: the doc, drawn by GitHub" }
    ]
  }
}

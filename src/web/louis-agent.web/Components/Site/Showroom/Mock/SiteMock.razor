@* A business's website, mocked (F127.1, Louis's pick 3a, made fuller: "a bit bland, we need to sell it"): a browser bar
   with its address, its header with its sample brand (its mark, its name and tagline, its typeface), then its page,
   which scrolls inside the mock: the hero in the business's look with its scene and a call to action, a strip of
   facts and its places. Its agent sits in a widget in the corner, where its customers would meet it, and the place
   it shows is in the bar, lit, and scrolled to. *@
<div class="@Classes" style="@ColourStyle">
    <div class="mock-chrome" aria-hidden="true">
        <i></i><i></i><i></i>
        <span class="mock-address">@Address@Shown</span>
    </div>
    <div class="mock-header">
        @if (Mark is not null)
        {
            <span class="mock-mark" aria-hidden="true">@Mark</span>
        }
        <span class="mock-names">
            <b class="mock-name">@Business</b>
            @if (Tagline is not null)
            {
                <span class="mock-tagline">@Tagline</span>
            }
        </span>
        <span class="mock-nav">
            @foreach (var item in NavItems)
            {
                <span>@item</span>
            }
        </span>
    </div>
    <div class="mock-page" @ref="_page">
        <div class="mock-hero">
            <div class="mock-hero-words">
                <p class="mock-hero-line">@HeroLine</p>
                @if (HeroNote is not null)
                {
                    <p class="mock-hero-note">@HeroNote</p>
                }
                @if (HeroAction is not null)
                {
                    <span class="mock-action">@HeroAction</span>
                }
            </div>
            @if (Scene is not null)
            {
                <div class="mock-scene" aria-hidden="true">@Scene</div>
            }
        </div>
        @if (Facts.Count > 0)
        {
            <ul class="mock-facts">
                @foreach (var fact in Facts)
                {
                    <li>@fact</li>
                }
            </ul>
        }
        <CascadingValue Name="@ShownPlace" Value="Shown">@Places</CascadingValue>
    </div>
    <div class="mock-widget">
        <div class="mock-widget-head">
            @if (Mark is not null)
            {
                <span class="mock-mark" aria-hidden="true">@Mark</span>
            }
            <i class="mock-live" aria-hidden="true"></i>@AgentLabel
        </div>
        <div class="mock-widget-body">@Agent</div>
    </div>
</div>

event: content_block_start
data: {"type":"content_block_start","index":36,"content_block":{"type":"tool_use","id":"toolu_0196cJPf4q4dzth2R7Xvz6iu","name":"WriteWorkspaceFile","input":{"relativePath":"tests/OrderService.Tests/Regression/OrderTotalRetiredCodeTests.cs","content":"using OrderService;\n\nnamespace OrderService.Tests.Regression;\n\n/// <summary>\n/// Regression: order 1003 carries the retired code SUMMER25, which is not in DiscountRates. The total used to throw\n/// KeyNotFoundException. Per the runbook, an unknown or retired code gives no discount: the total is the subtotal.\n/// </summary>\npublic class OrderTotalRetiredCodeTests\n{\n    [Test]\n    public void GetOrderTotal_RetiredCode_IsTheSubtotal() =>\n        // 3 x MUG-2 @ 8.00 + 2 x TEA-7 @ 5.50 = 35.00, no discount applied.\n        Assert.That(OrderApiTests.Api().GetOrderTotal(1003), Is.EqualTo(35.00m));\n\n    [Test]\n    public void GetOrderTotal_VipCode_StillAppliesItsRate() =>\n        // 79.90 with VIP20 (20% off) = 63.92.\n        Assert.That(OrderApiTests.Api().GetOrderTotal(1004), Is.EqualTo(63.92m));\n}\n"}}}


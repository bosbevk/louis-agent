{
  "kind": "sequence",
  "title": "The framework's two sites in Azure: a chat, from the domain to the model",
  "caption": "DNS points a name at its app, the app wakes if it was asleep, the open door lets the visitor talk to its Orbi, and the answer streams back from the model.",
  "sequence": {
    "participants": [
      { "id": "browser", "label": "A visitor's browser", "actor": true, "tone": "blue" },
      { "id": "dns", "label": "Cloudflare DNS", "icon": "world", "tone": "red" },
      { "id": "app", "label": "The site's app", "icon": "server", "tone": "green" },
      { "id": "model", "label": "Anthropic", "icon": "chip", "tone": "red" }
    ],
    "steps": [
      { "step": "message", "from": "browser", "to": "dns", "text": "framework.louis-agent.dev?" },
      { "step": "reply", "from": "dns", "to": "browser", "text": "a CNAME to the app's own address" },
      { "step": "message", "from": "browser", "to": "app", "text": "GET / over HTTPS" },
      { "step": "note", "over": ["app"], "text": "a cold start if nobody was on it" },
      { "step": "reply", "from": "app", "to": "browser", "text": "the page, drawn as HTML" },
      { "step": "message", "from": "browser", "to": "app", "text": "POST /v1/sessions as its Orbi, no key: the open door" },
      { "step": "message", "from": "app", "to": "model", "text": "the turn" },
      { "step": "reply", "from": "model", "to": "app", "text": "the model's answer" },
      { "step": "reply", "from": "app", "to": "browser", "text": "streamed" }
    ]
  }
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Evals.Runner</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- F18 step 4 (ADR 0027): the runner, like the composition root, is the one project that knows every evals project. -->
    <ProjectReference Include="..\louis-agent.evals\louis-agent.evals.csproj" />
    <ProjectReference Include="..\louis-agent.evals.puls\louis-agent.evals.puls.csproj" />
    <!-- F49.2 step 9a: Puls's judge, which needs the harness and so is never reached through the composition. -->
    <ProjectReference Include="..\..\identities\louis-agent.identity.puls.judges\louis-agent.identity.puls.judges.csproj" />
    <!-- F49.2: the one project that knows every identity and pack (ADR 0027): their eval folders reach the runner
         through it, and their checks' lists from step 7. -->
    <ProjectReference Include="..\..\src\louis-agent.composition\louis-agent.composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An eval's files are beside it (Evals/{Folder}/: eval.json, Dataset/, Transcripts/, rubrics, its manual). One item, the same in every
         eval project, copies every one that isn't code to EvalFiles/{this project's path from the repository root}/Evals/{Folder}/..., so a copy's
         path below EvalFiles/ is where it sits in the repository (F49.2). TargetPath, not Link: Link would show the files a second time in the IDE
         under a folder named like the project. -->
    <None Update="Evals\**\*" TargetPath="EvalFiles\evals\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\projects\louis-agent.evals.runner.md" Link="docs\louis-agent.evals.runner.md" />
    <None Include="..\..\docs\guides\add-an-eval-set.md" Link="docs\add-an-eval-set.md" />
  </ItemGroup>

</Project>

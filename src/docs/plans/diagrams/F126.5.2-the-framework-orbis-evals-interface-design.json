{
  "kind": "classes",
  "title": "F126.5.2 the framework Orbi's evals: the types",
  "caption": "The framework host's program takes the evals' services and routes, as louis-agent.dev's does; Orbi's identity holds its eval file, which the catalogue reads at start-up; EvalReplay plays the kept recordings. The number in brackets is the step.",
  "classes": {
    "types": [
      {
        "id": "prog",
        "name": "SiteFrameworkApi Program",
        "kind": "program",
        "members": [
          "AddLouisAgentEvals(host, judge, options) (3)",
          "MapLouisAgentEvals(adminKey) (3)"
        ]
      },
      {
        "id": "start",
        "name": "EvalsStartup",
        "kind": "static",
        "members": [
          "the routes behind the admin key",
          "EvalCatalog.Read(catalog)"
        ]
      },
      {
        "id": "opts",
        "name": "EvalsOptions",
        "kind": "record",
        "members": [
          "SITE_DATA_DIRECTORY (4)",
          "RunsFolder"
        ]
      },
      {
        "id": "cat",
        "name": "FrameworkCatalog",
        "kind": "static",
        "members": [
          "FrameworkIdentity",
          "DocsPack, SitePack"
        ]
      },
      {
        "id": "id",
        "name": "FrameworkIdentity",
        "kind": "class",
        "members": [
          "Prompts: voice, skills",
          "framework.eval.json (5, 6)"
        ]
      },
      {
        "id": "replay",
        "name": "EvalReplay",
        "kind": "static",
        "members": [
          "AssertFactsMetAsync(catalog, ..)",
          "answers the ids replayed"
        ]
      },
      {
        "id": "test",
        "name": "FrameworkEvalReplayTests",
        "kind": "test (7)",
        "members": [
          "recordings/evals/framework",
          "an empty docs folder"
        ]
      }
    ],
    "relations": [
      {
        "from": "prog",
        "to": "start",
        "kind": "uses"
      },
      {
        "from": "start",
        "to": "opts",
        "kind": "uses"
      },
      {
        "from": "prog",
        "to": "cat",
        "kind": "uses"
      },
      {
        "from": "cat",
        "to": "id",
        "kind": "holds"
      },
      {
        "from": "test",
        "to": "replay",
        "kind": "uses"
      },
      {
        "from": "replay",
        "to": "cat",
        "kind": "uses"
      }
    ]
  }
}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Python, PowerShell and bash as tools: run scripts, and keep Python's packages in the agent's own environment. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Shell</RootNamespace>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, the toolset's guide is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LouisAgent.Packs.Shell.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Packs.Shell.IntegrationTests" />
    <InternalsVisibleTo Include="LouisAgent.Coding.Catalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\LouisAgent.Composition\LouisAgent.Composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="skills\**\*.md" />
  </ItemGroup>

</Project>

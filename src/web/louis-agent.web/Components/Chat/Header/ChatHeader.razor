@* The top bar (lg and up): the chat's title and menu, then the work panel, the credits, the language and the profile. *@
<header class="chat-header d-none d-lg-flex">
    <button class="icon header-sidebar" type="button" onclick="chatUi.toggleSidebar()" title="@Text.ShowSidebar" aria-label="@Text.ShowSidebar">⇥</button>
    <div class="chat-heading">
        @if (ViewTitle is not null)
        {
            <span class="chat-title">@ViewTitle</span>
        }
        else if (Chat is null)
        {
            <span class="chat-title muted">@Text.NewChat</span>
        }
        else if (Renaming == Chat.SessionId && RenameInHeader)
        {
            <input id="rename-input" class="rename-input" value="@RenameDraft" @oninput='e => RenameDraftChanged.InvokeAsync(e.Value?.ToString() ?? "")'
                   @onkeydown="e => OnRenameKey.InvokeAsync((e, Chat))" @onblur="() => OnRenameBlur.InvokeAsync(Chat)" aria-label="@Text.NewName" />
        }
        else
        {
            <span class="chat-title" title="@Chat.Title">@Chat.Title</span>
            <div class="dropdown">
                <button class="icon item-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Text.MoreForThisChat">⋯</button>
                <ul class="dropdown-menu"><ChatMenu Chat="Chat" InHeader="true" OnFavourite="OnFavourite" OnRename="OnRename" OnArchive="OnArchive" OnDelete="OnDelete" OnComingSoon="OnComingSoon" /></ul>
            </div>
        }
    </div>
    <div class="header-actions">
        <button class="header-button d-none d-xl-inline-flex work-toggle" type="button" onclick="chatUi.toggleWork()" title="@Text.ToggleWork">
            <span class="ic i-pulse" aria-hidden="true"></span>@Text.Work
        </button>
        <button class="header-button d-xl-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#work" aria-controls="work" title="@Text.ShowWork">
            <span class="ic i-pulse" aria-hidden="true"></span>@Text.Work
        </button>
        <CreditsMenu ChatCost="@ChatCost" MonthCost="@MonthCost" MonthChats="MonthChats" OnComingSoon="OnComingSoon" />
        <LanguageMenu Language="@Language" Languages="Languages" OnChoose="OnChooseLanguage" />
        <ProfileMenu OnComingSoon="OnComingSoon" />
    </div>
</header>

{
  "kind": "sequence",
  "title": "A pack's tool reads a photo the chat was sent",
  "caption": "At start-up the host hands the models to the program's catalogue, which gives the pack one. Later the photo travels as bytes and stays with the session, and the conversation's model sees only its name. The tool makes one call on the model it was given, and the wrapped model writes one ledger row, the tool's.",
  "sequence": {
    "participants": [
      {
        "id": "H",
        "icon": "chip",
        "tone": "violet",
        "label": "AgentHost"
      },
      {
        "id": "P",
        "icon": "settings",
        "tone": "green",
        "label": "The program's catalogue"
      },
      {
        "id": "C",
        "icon": "user",
        "tone": "blue",
        "label": "The caller"
      },
      {
        "id": "A",
        "icon": "server",
        "tone": "green",
        "label": "The API's session"
      },
      {
        "id": "G",
        "icon": "chip",
        "tone": "violet",
        "label": "The agent"
      },
      {
        "id": "T",
        "icon": "folder",
        "tone": "teal",
        "label": "The pack's tool"
      },
      {
        "id": "M",
        "icon": "message",
        "tone": "red",
        "label": "The wrapped model"
      },
      {
        "id": "L",
        "icon": "book",
        "tone": "amber",
        "label": "The ledger"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "H",
        "to": "P",
        "text": "Create(models)"
      },
      {
        "step": "note",
        "over": [
          "P"
        ],
        "text": "new ReadingPack(models.Named(\"haiku\"))"
      },
      {
        "step": "reply",
        "from": "P",
        "to": "H",
        "text": "the catalogue"
      },
      {
        "step": "message",
        "from": "C",
        "to": "A",
        "text": "\"check this\" + account.jpg as bytes, image/jpeg"
      },
      {
        "step": "note",
        "over": [
          "A"
        ],
        "text": "type and size checked, kept as a SessionFile"
      },
      {
        "step": "message",
        "from": "A",
        "to": "G",
        "text": "\"check this\" + \"attached: account.jpg, image/jpeg, 2 KB\""
      },
      {
        "step": "message",
        "from": "G",
        "to": "T",
        "text": "ReadFile(\"account.jpg\")"
      },
      {
        "step": "message",
        "from": "T",
        "to": "A",
        "text": "Files.Find(\"account.jpg\")"
      },
      {
        "step": "reply",
        "from": "A",
        "to": "T",
        "text": "the SessionFile"
      },
      {
        "step": "message",
        "from": "T",
        "to": "M",
        "text": "GetResponseAsync<TRecord>(instructions, DataContent)"
      },
      {
        "step": "message",
        "from": "M",
        "to": "L",
        "text": "one row, purpose \"tool\", with its cost"
      },
      {
        "step": "reply",
        "from": "M",
        "to": "T",
        "text": "the record"
      },
      {
        "step": "reply",
        "from": "T",
        "to": "G",
        "text": "the record as text"
      }
    ]
  }
}

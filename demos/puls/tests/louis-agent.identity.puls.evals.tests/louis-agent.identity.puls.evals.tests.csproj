<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Identities.Puls.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\evals\louis-agent.identity.puls.evals\louis-agent.identity.puls.evals.csproj" />
    <!-- The rules Puls's evals name, by type, so loading an eval file needs them all. -->
    <ProjectReference Include="..\..\..\..\packs-evals\louis-agent.pack.where-to-buy.checks\louis-agent.pack.where-to-buy.checks.csproj" />
    <ProjectReference Include="..\..\..\..\packs-evals\louis-agent.pack.recipes.checks\louis-agent.pack.recipes.checks.csproj" />
    <!-- The cook's eval names Puls's judge, so loading its file needs the judges' list. -->
    <ProjectReference Include="..\..\evals\louis-agent.identity.puls.judges\louis-agent.identity.puls.judges.csproj" />
    <!-- The harness loads the evals from their folders, and the composition says which toolsets Puls has (its identity
         and the packs it names), which the routing eval's baseline lists. -->
    <ProjectReference Include="..\..\..\..\src\evals\louis-agent.evals\louis-agent.evals.csproj" />
    <ProjectReference Include="..\..\hosts\louis-agent.host-packs\louis-agent.host-packs.csproj" />
    <!-- The fakes every test project shares (CL15 step 5). -->
    <ProjectReference Include="..\..\..\..\src\tests\shared\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\..\..\src\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\..\src\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

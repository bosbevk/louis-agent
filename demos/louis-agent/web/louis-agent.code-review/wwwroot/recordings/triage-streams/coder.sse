event: content_block_start
data: {"type":"content_block_start","index":19,"content_block":{"type":"tool_result","tool_use_id":"toolu_013Tp7GUfZnAo4BGEJBXJDxz","content":"using System.Globalization;\r\n\r\nnamespace OrderService;\r\n\r\npublic sealed record OrderItem(string Sku, int Quantity, decimal UnitPrice);\r\n\r\n/// <summary>An order as stored. <see cref=\"Created\"/> is kept as written (an ISO date, sometimes with a time).</summary>\r\npublic sealed record Order(\r\n    int Id, string Customer, IReadOnlyList<OrderItem> Items, string DiscountCode, string PaymentRef, bool Refunded,\r\n    string Created, string Country, string? GiftMessage);\r\n\r\n/// <summary>A client asked for an order that doesn't exist (a 404, not a bug).</summary>\r\npublic sealed class OrderNotFoundException(int id) : Exception($\"Order {id} not found\");\r\n\r\n/// <summary>Reads orders from data/orders.csv: id,customer,items,discount_code,payment_ref,refunded,created,country,gift_message.</summary>\r\npublic sealed class OrderRepository\r\n{\r\n    private readonly Dictionary<int, Order> _orders;\r\n\r\n    public OrderRepository(string csvPath)\r\n    {\r\n        _orders = File.ReadLines(csvPath)\r\n            .Skip(1)\r\n            .Where(line => !string.IsNullOrWhiteSpace(line))\r\n            .Select(Parse)\r\n            .ToDictionary(order => order.Id);\r\n    }\r\n\r\n    public Order Get(int id) => _orders.TryGetValue(id, out var order) ? order : throw new OrderNotFoundException(id);\r\n\r\n    // Items look like \"SKU:quantity:unitPrice|SKU:quantity:unitPrice\".\r\n    private static Order Parse(string line)\r\n    {\r\n        string[] f = line.Split(',');\r\n        var items = f[2].Split('|', StringSplitOptions.RemoveEmptyEntries)\r\n            .Select(item => item.Split(':'))\r\n            .Select(p => new OrderItem(p[0], int.Parse(p[1], CultureInfo.InvariantCulture), decimal.Parse(p[2], CultureInfo.InvariantCulture)))\r\n            .ToList();\r\n        return new Order(int.Parse(f[0], CultureInfo.InvariantCulture), f[1], items, f[3], f[4], bool.Parse(f[5]),\r\n            f[6], f[7], f[8].Length == 0 ? null : f[8]);\r\n    }\r\n}\r\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":19}

event: content_block_start
data: {"type":"content_block_start","index":20,"content_block":{"type":"tool_result","tool_use_id":"toolu_01KzCLRp9FVkA4utEhh66zJG","content":"using System.Globalization;\r\n\r\nnamespace OrderService;\r\n\r\npublic sealed partial class OrderApi\r\n{\r\n    /// <summary>GET /orders/{id}/discount-label - how the receipt shows the code, e.g. \"WELCOME (10% off)\".</summary>\r\n    public string GetDiscountLabel(int id)\r\n    {\r\n        Order order = _orders.Get(id);\r\n        string code = order.DiscountCode;\r\n        if (code.Length == 0) return \"no discount\";\r\n\r\n        int percent = int.Parse(code[^2..], CultureInfo.InvariantCulture);\r\n        return $\"{code[..^2]} ({percent}% off)\";\r\n    }\r\n}\r\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":20}

event: content_block_start
data: {"type":"content_block_start","index":21,"content_block":{"type":"tool_result","tool_use_id":"toolu_0128UZ1eCkTYpYhySXFeqkoc","content":"namespace OrderService;\r\n\r\n/// <summary>\r\n/// The service's API. Each method lives in its own file under Api/ (one per route); exceptions are caught and logged by\r\n/// the host, the way a web framework would turn them into 500 responses.\r\n/// </summary>\r\npublic sealed partial class OrderApi\r\n{\r\n    private readonly OrderRepository _orders;\r\n\r\n    public OrderApi(OrderRepository orders) => _orders = orders;\r\n\r\n    /// <summary>Sum of quantity times unit price, before any discount.</summary>\r\n    internal static decimal Subtotal(Order order) => order.Items.Sum(item => item.Quantity * item.UnitPrice);\r\n}\r\n","is_error":false}}


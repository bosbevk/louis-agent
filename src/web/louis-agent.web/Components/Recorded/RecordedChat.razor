@* A recorded session in a window: the chat's own list of turns, typing out as it did, then the site's ending, the
   theme's button to try the agent live when the site gives its words, and a button that plays it again. Started
   when asked, its first question waits over the theme's Play button. Stopped after a turn, Play on plays the rest. *@
<div class="recorded-chat">
    <div class="recorded-bar"><span class="recorded-dots" aria-hidden="true"><i></i><i></i><i></i></span>@Title</div>
    @* Its turns by number and question, unseen on the page, so the guide can name each as a place to show (F160). *@
    <ol class="recorded-turns" hidden>
        @for (int number = 1; number <= Turns.Count; number++)
        {
            <li data-turn="@number">@Turns[number - 1].Question</li>
        }
    </ol>
    <MessageList Chat="_chat" Streaming="_playing" Currency="Currency" ShowWork="ShowWork" />
    @if (Waiting)
    {
        <div class="recorded-wait">
            <button class="btn btn-fill btn-small" type="button" @onclick="PlayFromStartAsync">@Play</button>
        </div>
    }
    @if (Stopped)
    {
        <div class="recorded-wait">
            <button class="btn btn-fill btn-small" type="button" @onclick="PlayOnAsync">@PlayOn</button>
            <button class="recorded-again" type="button" @onclick="PlayFromStartAsync">@PlayAgain</button>
        </div>
    }
    @if (_ended)
    {
        <div class="recorded-end">
            @Ending
            @if (TryIt is not null)
            {
                <button class="btn btn-fill btn-small" type="button" @onclick="() => Tried.InvokeAsync()">@TryIt</button>
            }
            <button class="recorded-again" type="button" @onclick="PlayFromStartAsync">@PlayAgain</button>
        </div>
    }
</div>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- F49.2 step 9a: Puls's model judge, the cook's meal-for-people. It is built on the harness's judge (EvaluatorCheck,
       JudgeClients), which the identity must never reference (ADR 0027), so it lives here, beside the identity, and only
       the runner references it; the composition never does, so no host carries the harness. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Identities.Puls.Judges</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\evals\LouisAgent.Evals\LouisAgent.Evals.csproj" />
    <!-- The cook's expectations and messages the judge reads, in Puls's evals project (Evals/Checks/). -->
    <ProjectReference Include="..\LouisAgent.Identities.Puls.Evals\LouisAgent.Identities.Puls.Evals.csproj" />
  </ItemGroup>

</Project>

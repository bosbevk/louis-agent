{
  "schema_version": 1,
  "name": "puls-recipes",
  "identity": "puls",
  "version": 5,
  "proves": "Puls's cook reads a recipe from a real page with ReadRecipe, links a site we may read, shows its photo, and writes the amounts and steps the page gave.",
  "manual": "manual.md",
  "modes": [
    { "name": "puls-cook", "role": "puls/voice-af", "toolsets": ["specialists", "web"] }
  ],
  "checks": [
    { "type": "no-error" },
    { "type": "routed-to", "parameters": { "expected_key": "routes_to", "delegating_toolsets": ["specialists"] } },
    { "type": "tool-used", "parameters": { "tool": "ReadRecipe" } },
    { "type": "recipe-from-source", "parameters": { "reader": "recipe-link" } },
    { "type": "image-shown", "name": "recipe-image", "parameters": { "reader": "recipe-photos", "key": "recipe_image" } },
    { "type": "tool-rows-marked", "name": "unpriced-items", "parameters": { "tool": "EstimatePrices", "mark": "?" } },
    {
      "type": "judge",
      "name": "recipe-as-source",
      "parameters": { "rubric": "Rubrics/recipe-as-source.md", "ask": ["serves"], "sources": ["ReadRecipe"], "version": 2 }
    },
    { "type": "human", "parameters": { "reviews": "recipe-as-source" } }
  ]
}

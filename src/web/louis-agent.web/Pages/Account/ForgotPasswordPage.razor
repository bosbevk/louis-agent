@page "/forgot-password"
@layout AccountFrame

@* Forgot the password: an email, and the API mails a code for the reset page. The answer is the same whether or not
   the address has an account, so the page can't be used to find out which addresses do. *@

<PageTitle>@Text.ForgotPassword</PageTitle>

<h1>@Text.ForgotPassword</h1>
<p>@Text.ForgotIntro</p>
@if (_sent)
{
    <AccountNotice Message="@Text.ResetCodeSent" />
    <div class="account-actions">
        <a class="account-button" href="@ResetLink">@Text.ResetPassword</a>
    </div>
}
else
{
    <form class="account-form" @onsubmit="SendAsync">
        <AccountNotice Message="@_error" IsError="true" />
        <label class="account-field">
            @Text.Email
            <input type="email" autocomplete="username" required @bind="_email" />
        </label>
        <div class="account-actions">
            <button class="account-button" type="submit" disabled="@_busy">@Text.SendResetCode</button>
        </div>
    </form>
}
<div class="account-links">
    <a href="login">@Text.BackToSignIn</a>
</div>

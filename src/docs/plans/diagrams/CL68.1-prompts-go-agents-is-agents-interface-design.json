{
  "kind": "classes",
  "title": "CL68.1: the interface design",
  "caption": "EmbeddedPrompts reads a project's root, the role catalogue and the skill files name agents/, and the catalogue reads each provider once.",
  "classes": {
    "types": [
      {
        "id": "Embedded",
        "name": "EmbeddedPrompts",
        "kind": "static",
        "members": [
          "+Of(assembly) IFileProvider: the root (1)",
          "-Folder \"prompts\": goes (1)",
          "-Of(assembly, subfolder): goes (3)"
        ]
      },
      {
        "id": "Identity",
        "name": "IAgentIdentity",
        "kind": "interface",
        "members": [
          "+Name string",
          "+Prompts IFileProvider"
        ]
      },
      {
        "id": "Pack",
        "name": "IAgentPack",
        "kind": "interface",
        "members": [
          "+Prompts IFileProvider"
        ]
      },
      {
        "id": "Showroom",
        "name": "ShowroomIdentity",
        "kind": "class",
        "members": [
          "-Shared IFileProvider: one for the three (3)",
          "+Prompts IFileProvider => Shared (3)"
        ]
      },
      {
        "id": "Catalog",
        "name": "AgentCatalog",
        "kind": "class",
        "members": [
          "+Prompts IReadOnlyList<IFileProvider>: each once (3)",
          "-CheckUnique(paths, \"prompt path\")"
        ]
      },
      {
        "id": "Roles",
        "name": "RoleCatalog",
        "kind": "static",
        "members": [
          "+AgentFolder \"agents\" (2)",
          "+SpecialistsFolder \"specialists\"",
          "+MinionsFolder \"minions\""
        ]
      },
      {
        "id": "Skills",
        "name": "SkillFiles",
        "kind": "static",
        "members": [
          "~FunctionsFolder \"agents/functions\" (2)"
        ]
      }
    ],
    "relations": [
      { "from": "Showroom", "to": "Identity", "kind": "implements" },
      { "from": "Identity", "to": "Embedded", "kind": "uses" },
      { "from": "Pack", "to": "Embedded", "kind": "uses" },
      { "from": "Catalog", "to": "Identity", "kind": "uses" },
      { "from": "Catalog", "to": "Pack", "kind": "uses" },
      { "from": "Catalog", "to": "Roles", "kind": "uses" },
      { "from": "Skills", "to": "Roles", "kind": "uses" }
    ]
  }
}

@* Why no run can start: there is no store, or it doesn't answer. Nothing when it does. *@

@if (!Store.Configured)
{
    <section class="card-p store-banner">
        <strong>No store, so no run starts.</strong>
        <p>A paid run whose results are lost is the worst outcome. Set <code>BENCHMARKS_MONGO_URL</code> in <code>config/.env.secrets</code> and recreate the container (<code>up -d</code>).</p>
    </section>
}
else if (Store.Error is { } storeError)
{
    <section class="card-p store-banner">
        <strong>The store doesn't answer.</strong>
        <p>@storeError</p>
    </section>
}

@page "/admin/maatstawwe/{RunId}"
@layout AdminLayout
@using System.Net
@using System.Text.Json
@using LouisAgent.Web.Shared
@using LouisAgent.Web.Shared.Services
@inject AgentApi Api
@inject ChatStore Store
@inject CurrencyState Currency
@implements IDisposable

@* F31 step 10: one stored run: what it ran with, and its explorer (RunExplorer), read from the benchmark store. *@

<PageTitle>Lopie @RunId · Puls Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>@(_title ?? "Lopie")</h1>
        <p>
            <code>@RunId</code>
            @if (_run is { } head)
            {
                <span> · @Started(head) · @Status(head) · @Repeat(head)</span>
                @if (Total(head) is { } total) { <span> · @total</span> }
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="header-button" href="admin/maatstawwe"><span class="ic i-chart" aria-hidden="true"></span>Maatstawwe</a>
    </div>
</div>

@if (_error is { } error)
{
    <section class="card-p admin-gate"><strong>@error</strong></section>
}
else if (_run is null)
{
    <section class="card-p"><span class="muted">Laai…</span></section>
}
else
{
    var run = _run.Value;
    @if (S(run.GetProperty("run"), "store_error") is { } storeError)
    {
        <section class="card-p store-banner"><strong>Nie alles van hierdie lopie is gestoor nie.</strong><p>@storeError</p></section>
    }
    <section class="card-p">
        <RunExplorer Run="run" Currency="Currency.Current" />
    </section>
    <section class="card-p">
        <details class="admin-details">
            <summary>Waarmee dit geloop het</summary>
            <dl class="explorer-fields">
                @if (run.TryGetProperty("settings", out var settings) && settings.ValueKind == JsonValueKind.Object)
                {
                    foreach (var p in settings.EnumerateObject()) { <dt>@p.Name</dt><dd><code>@p.Value.GetString()</code></dd> }
                }
                @foreach (var m in run.GetProperty("modes").EnumerateArray())
                {
                    <dt>@m.GetProperty("name").GetString() · @m.GetProperty("repeat").GetInt32()</dt>
                    <dd><code>@string.Join(", ", m.GetProperty("toolsets").EnumerateArray().Select(t => t.GetString()))</code>@(S(m, "personality") is { } p ? $" · {p}" : "")@(S(m, "llm") is { } l ? $" · {l}" : "")</dd>
                }
            </dl>
        </details>
        @if (run.TryGetProperty("log", out var log) && log.ValueKind == JsonValueKind.Array)
        {
            <details class="admin-details"><summary>Die skrip se eie reëls (@log.GetArrayLength())</summary><pre class="admin-pre run-log">@string.Join("\n", log.EnumerateArray().Select(l => l.GetString()))</pre></details>
        }
    </section>
}

@code {
    [Parameter] public string RunId { get; set; } = "";

    private JsonElement? _run;
    private string? _title, _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!Store.Loaded) await Store.LoadAsync();
        Currency.Changed += StateHasChanged;
        await Currency.LoadAsync();
        _run = null;
        _error = null;
        try
        {
            var run = await Api.GetAsync<JsonElement>($"admin/benchmarks/runs/{Uri.EscapeDataString(RunId)}");
            var list = await Api.GetAsync<JsonElement>("admin/benchmarks");
            string check = run.GetProperty("run").GetProperty("check").GetString()!;
            _title = list.GetProperty("checks").EnumerateArray().Where(c => c.GetProperty("id").GetString() == check)
                .Select(c => c.GetProperty("title").GetString()).FirstOrDefault() ?? check;
            _run = run;
        }
        catch (AgentApiException ex)
        {
            _error = ex.Status == HttpStatusCode.NotFound ? $"Geen lopie {RunId} in die stoor nie." : ex.Message;
        }
    }

    public void Dispose() => Currency.Changed -= StateHasChanged;

    private static string? S(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

    private static string Started(JsonElement run) => run.GetProperty("run").GetProperty("started_at").GetDateTimeOffset().ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string Status(JsonElement run) => S(run.GetProperty("run"), "status") switch { "running" => "besig", "done" => "klaar", _ => "misluk" };

    private static string Repeat(JsonElement run) => run.GetProperty("run").GetProperty("repeat").GetInt32() is var n && n == 1 ? "1 herhaling" : $"{n} herhalings";

    private string? Total(JsonElement run) =>
        run.GetProperty("run").TryGetProperty("total", out var t) && t.ValueKind == JsonValueKind.Object
            ? $"{(t.TryGetProperty("cost", out var c) && c.ValueKind == JsonValueKind.Number ? UsageFormat.Money(c.GetDecimal(), "USD", Currency.Current) : "—")}, {t.GetProperty("requests").GetInt32()} versoeke"
            : null;
}

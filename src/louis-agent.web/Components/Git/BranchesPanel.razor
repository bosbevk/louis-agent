@* Branches and history: what's waiting to be merged into the checked-out branch, what's merged, and every commit. *@
@inject GitHistory History

<div class="changes-panel">
    <div class="changes-head">
        <span class="branch" title="Checked-out branch: merges go into it">⎇ @(History.Branches?.Current ?? "…")</span>
        <button class="icon" title="Refresh" disabled="@History.Busy" @onclick="History.RefreshAsync">⟳</button>
    </div>

    @if (History.Error is not null)
    {
        <div class="tree-error">@History.Error</div>
    }
    @if (History.Message is not null)
    {
        <div class="committed">@History.Message</div>
    }
    @if (History.QueuedCount > 0)
    {
        <div class="working">@History.QueuedCount more queued…</div>
    }

    @if (History.Branches is { } branches)
    {
        var unmerged = branches.Branches.Where(b => !b.Current && !b.Merged).ToList();
        var merged = branches.Branches.Where(b => b.Merged).ToList();

        <div class="change-group">
            <div class="group-head">To merge <span class="count">@unmerged.Count</span></div>
            @if (unmerged.Count == 0)
            {
                <div class="tree-loading">Nothing to merge into @branches.Current.</div>
            }
            @foreach (var branch in unmerged)
            {
                var pending = History.Pending(branch.Name);
                <div @key="branch.Name" class="change-row history-row @(OpenKey == BranchKey(branch.Name) ? "selected" : "")">
                    <button class="change-file history-item" title="@branch.Subject" @onclick="() => OnOpenBranch.InvokeAsync(branch.Name)">
                        <span class="change-name">@branch.Name</span>
                        <span class="change-folder">@branch.Ahead commit@(branch.Ahead == 1 ? "" : "s") · @branch.Subject</span>
                    </button>
                    <button class="secondary small" disabled="@(pending is not null)" title="Merge into @branches.Current" @onclick="() => History.MergeAsync(branch.Name)">
                        @(pending is null ? "Merge" : pending.Value.Running ? "Merging…" : "Queued")
                    </button>
                </div>
            }
        </div>

        @if (merged.Count > 0)
        {
            <div class="change-group">
                <div class="group-head">Merged <span class="count">@merged.Count</span></div>
                @foreach (var branch in merged)
                {
                    var pending = History.Pending(branch.Name);
                    <div @key="branch.Name" class="change-row history-row @(OpenKey == BranchKey(branch.Name) ? "selected" : "")">
                        <button class="change-file history-item" title="@branch.Subject" @onclick="() => OnOpenBranch.InvokeAsync(branch.Name)">
                            <span class="change-name merged">✓ @branch.Name</span>
                        </button>
                        @if (pending is null)
                        {
                            <button class="icon" title="Delete this merged branch" @onclick="() => History.DeleteAsync(branch.Name)">×</button>
                        }
                        else
                        {
                            <span class="pending-label">@(pending.Value.Running ? "deleting…" : "queued")</span>
                        }
                    </div>
                }
            </div>
        }

        <div class="change-group">
            <div class="group-head">All commits <span class="count">@History.Commits.Count</span></div>
            @foreach (var commit in History.Commits)
            {
                <div @key="commit.Sha" class="change-row history-row @(OpenKey == CommitKey(commit.Sha) ? "selected" : "")">
                    <button class="change-file history-item" title="@commit.Subject" @onclick="() => OnOpenCommit.InvokeAsync(commit.Sha)">
                        <span class="change-name"><span class="sha">@commit.ShortSha</span> @commit.Subject</span>
                        <span class="change-folder">
                            @commit.Author · @RelativeTime.Ago(commit.Date)
                            @foreach (string reference in commit.Refs)
                            {
                                <span class="ref">@reference</span>
                            }
                        </span>
                    </button>
                </div>
            }
        </div>
    }
    else if (History.Error is null)
    {
        <div class="tree-loading">Loading…</div>
    }
</div>

{
  "kind": "flow",
  "type": "activity",
  "title": "Add a skill: from the chat that made it to every chat",
  "caption": "CreateSkill keeps a draft its own chat can use; /approve gives it to every chat, /reject deletes it.",
  "flow": {
    "nodes": [
      { "id": "agent", "label": "The agent makes it\nCreateSkill, its example run", "icon": "chip", "tone": "blue", "shape": "terminal" },
      { "id": "draft", "label": "drafts/{name}/\nits own chat only", "icon": "folder", "tone": "amber", "shape": "data" },
      { "id": "pick", "label": "/approve or /reject?", "tone": "green", "shape": "decision" },
      { "id": "live", "label": "{name}/\nevery chat, through UseSkill", "icon": "folder", "tone": "amber", "shape": "data" },
      { "id": "gone", "label": "Deleted", "icon": "file", "tone": "green", "shape": "terminal" },
      { "id": "chat", "label": "Told on its next message;\nlisted from the next chat", "icon": "message", "tone": "blue", "shape": "terminal" }
    ],
    "edges": [
      { "from": "agent", "to": "draft" },
      { "from": "draft", "to": "pick", "word": "/skills lists it" },
      { "from": "pick", "to": "live", "word": "approve" },
      { "from": "pick", "to": "gone", "word": "reject" },
      { "from": "live", "to": "chat" }
    ],
    "direction": "right"
  }
}

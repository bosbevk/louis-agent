@* The message box: the Composer with its toolbar; in the middle of an empty chat, at the bottom once it has turns. The
   draft, the attachments and sending are the runner's. *@
<Composer @bind-Draft="Runner.Draft" Attachments="Runner.Attachments" Streaming="Runner.Streaming" CanSend="Runner.CanSend" Disabled="@(Runner.Chat?.Ended == true)"
          Placeholder="@(Runner.Chat?.Ended == true ? Text.ChatEnded : Text.AskAnything)"
          OnSend="Runner.SendAsync" OnStop="Runner.StopAsync" BoxClass="input-box" SendLabel="↑" StopLabel="■" SendTitle="@Text.SendTitle" StopTitle="@Text.StopTitle">
    <Tools><ComposerTools Model="@Model" OnFiles="Runner.AddFilesAsync" OnDraft="OnDraft" OnComingSoon="OnComingSoon" Unfinished="Unfinished" /></Tools>
</Composer>

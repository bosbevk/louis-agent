@* F18 step 5a: each mode's pass@k and pass^k, labelled with the k they are over, from the run's JSON. A trial that failed for the infrastructure is left out of k and
   said apart. A run from before the rates has none, and says so. *@
@if (Rates.All(rate => rate.K is null))
{
    <p class="muted mode-rates-none">This run has no pass rates (it ran before they were recorded).</p>
}
else
{
    <ul class="mode-rates">
        @foreach (var rate in Rates)
        {
            <li class="mode-rate">
                <span class="mode-rate-name">@rate.Mode</span>
                <span class="chip pass-at" title="Passed at least once in its k trials: can the agent do this?">@RatesText.PassAt(rate.K) @RatesText.Share(rate.PassAtK)</span>
                <span class="chip pass-hat" title="Passed every time in its k trials: can a customer rely on it?">@RatesText.PassHat(rate.K) @RatesText.Share(rate.PassHatK)</span>
                @if (rate.Infrastructure > 0) { <span class="chip left-out" title="Failed for the infrastructure, not the agent: neither a pass nor a fail.">@RatesText.LeftOut(rate.Infrastructure)</span> }
                @if (rate.Retried > 0) { <span class="chip retried" title="Run a second time after a transport failure.">@RatesText.Retried(rate.Retried)</span> }
            </li>
        }
    </ul>
}

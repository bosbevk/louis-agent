FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish "src/louis-agent.cli/louis-agent.cli.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/sdk:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl bc git python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish/ .
# Skill files are mounted by docker-compose; secrets come from env_file, never from the image.
COPY Skills/ ./
ENTRYPOINT ["dotnet", "louis-agent.cli.dll"]

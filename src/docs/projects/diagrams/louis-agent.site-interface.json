{
  "kind": "classes",
  "title": "louis-agent.site: the interface design",
  "caption": "The site holds only its words, places, demos and diagrams: the pages sit on the framework's shell, each diagram is data held to the code by a test. Its CV is one record, drawn by one view that the admin edits where it stands.",
  "classes": {
    "types": [
      {
        "id": "places",
        "name": "SitePlaces",
        "kind": "a SectionPage, every page's places"
      },
      {
        "id": "pages",
        "name": "The pages",
        "kind": "Razor, a Band per section",
        "members": [
          "/, /what-we-build, /pricing, /demos, /contact, /cv",
          "/framework/... , /csharp-ai-agent-framework"
        ]
      },
      {
        "id": "facts",

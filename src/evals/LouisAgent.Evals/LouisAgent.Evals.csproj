<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Evals</RootNamespace>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- F18 step 2a: the commit a run was built from, stamped at build (dotnet build -p:EvalCommit=$(git rev-parse HEAD)); "unknown" when absent. -->
    <EvalCommit Condition="'$(EvalCommit)' == ''">unknown</EvalCommit>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Commit</_Parameter1>
      <_Parameter2>$(EvalCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 2: the harness, sold with the engine (ADR 0029): the engine's message helpers and the session stream's reader. -->
    <ProjectReference Include="..\..\engine\LouisAgent.Core\LouisAgent.Core.csproj" />
    <ProjectReference Include="..\..\engine\LouisAgent.SessionStream\LouisAgent.SessionStream.csproj" />
    <!-- F18 step 7c: the eval protocol's records and kinds, the contract the API reads too. -->
    <ProjectReference Include="..\LouisAgent.Evals.Protocol\LouisAgent.Evals.Protocol.csproj" />
    <!-- F49.1 step 2: the check contract, what a check reads (a trial) and returns (a grade), so a pack can use it
         without the harness (ADR 0056). -->
    <ProjectReference Include="..\LouisAgent.Evals.Checks\LouisAgent.Evals.Checks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\projects\LouisAgent.Evals.md" Link="docs\LouisAgent.Evals.md" />
    <None Include="..\..\docs\guides\add-an-eval.md" Link="docs\add-an-eval.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.10.0" />
  </ItemGroup>

</Project>

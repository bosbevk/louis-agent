<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one place that knows every identity and pack (CL15, ADR 0027): a host calls Plugins.FromEnvironment() once at
       start-up and hands the catalogue to AgentHost. Core never references an identity or a pack; this project references
       them all. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Composition</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.composition.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\louis-agent.core\louis-agent.core.csproj" />
    <ProjectReference Include="..\..\identities\louis-agent.identity.puls\louis-agent.identity.puls.csproj" />
    <ProjectReference Include="..\..\packs\louis-agent.pack.shops\louis-agent.pack.shops.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.composition.md" Link="docs\louis-agent.composition.md" />
    <None Include="..\..\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
    <None Include="..\..\docs\guides\build-an-identity.md" Link="docs\build-an-identity.md" />
  </ItemGroup>

</Project>

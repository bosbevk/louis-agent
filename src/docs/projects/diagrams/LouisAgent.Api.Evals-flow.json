{
  "kind": "flow",
  "type": "activity",
  "title": "LouisAgent.Api.Evals: a start, step by step",
  "caption": "Every reason to refuse a start is asked before anything runs, each with its own answer; then the desk takes its one slot, and the start answers 202 with the run's address.",
  "flow": {
    "direction": "down",
    "nodes": [
      {
        "id": "start",
        "label": "POST /v1/admin/evals/{name}/runs",
        "icon": "user",
        "tone": "blue",
        "shape": "terminal"
      },
      {
        "id": "known",
        "label": "An eval this\nhost has?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "asked",
        "label": "Live or replay,\n1 or 3 repeats?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "keep",
        "label": "A data folder, and\nrecordings for a live run?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "replayed",
        "label": "For a replay, a live\nrun that finished?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "slot",
        "label": "The desk's one\nslot free?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "accepted",
        "label": "202, Location: the run's\naddress; it plays on",
        "icon": "play",
        "tone": "green",
        "shape": "terminal"
      },
      {
        "id": "refused",
        "label": "404, 400 or 409\nwith its reason",
        "icon": "shield",
        "tone": "red",
        "shape": "terminal"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "known"
      },
      {
        "from": "known",
        "to": "asked",
        "word": "yes"
      },
      {
        "from": "known",
        "to": "refused",
        "word": "no, 404"
      },
      {
        "from": "asked",
        "to": "keep",
        "word": "yes"
      },
      {
        "from": "asked",
        "to": "refused",
        "word": "no, 400"
      },
      {
        "from": "keep",
        "to": "replayed",
        "word": "yes"
      },
      {
        "from": "keep",
        "to": "refused",
        "word": "no, 400"
      },
      {
        "from": "replayed",
        "to": "slot",
        "word": "yes"
      },
      {
        "from": "replayed",
        "to": "refused",
        "word": "no, 400"
      },
      {
        "from": "slot",
        "to": "accepted",
        "word": "yes"
      },
      {
        "from": "slot",
        "to": "refused",
        "word": "no, 409"
      }
    ]
  }
}

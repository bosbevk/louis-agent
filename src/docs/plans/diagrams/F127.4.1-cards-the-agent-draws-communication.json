{
  "kind": "sequence",
  "title": "F127.4.1 cards the agent draws: a booking",
  "caption": "Only the visitor's click books: the agent draws the request, offers the choices, and sends nothing until the click comes back as the visitor's words.",
  "sequence": {
    "participants": [
      { "id": "visitor", "label": "The visitor", "actor": true, "tone": "blue" },
      { "id": "widget", "label": "The widget", "icon": "browser", "tone": "green" },
      { "id": "agent", "label": "Seemeeu's agent", "icon": "chip", "tone": "green" },
      { "id": "site", "label": "SiteTools", "icon": "box", "tone": "violet" },
      { "id": "leads", "label": "LeadTools", "icon": "mail", "tone": "violet" }
    ],
    "steps": [
      { "step": "message", "from": "visitor", "to": "agent", "text": "Anna, anna@example.com" },
      { "step": "message", "from": "agent", "to": "site", "text": "ShowCard(Booking request, the garden room, rows...)" },
      { "step": "reply", "from": "site", "to": "agent", "text": "shown, or why the card was refused" },
      { "step": "message", "from": "agent", "to": "site", "text": "Offer(Shall I send it?, Book it, Change something, Not now)" },
      { "step": "message", "from": "widget", "to": "visitor", "text": "the ticket, then the cards" },
      { "step": "message", "from": "visitor", "to": "widget", "text": "clicks Book it" },
      { "step": "message", "from": "widget", "to": "agent", "text": "\"Book it\" as the visitor's message" },
      { "step": "message", "from": "agent", "to": "leads", "text": "SendLead(Anna, anna@example.com, the garden room...)" },
      { "step": "message", "from": "agent", "to": "site", "text": "ShowCard(the same, status Sent)" },
      { "step": "message", "from": "widget", "to": "visitor", "text": "the cards fold to Book it, the ticket says Sent" }
    ]
  }
}

      { "id": "runrow", "name": "RunRow", "kind": "record, changed in step 3", "members": ["Cost, JudgeCost, Currency", "static RunRow Of(EvalRun run)"] },
      { "id": "evalrow", "name": "EvalRow", "kind": "record, changed in step 3", "members": ["RunRow? LastLiveRun", "decimal? EstimateLive(int repeats)", "bool CanReplay()"] },

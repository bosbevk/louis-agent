{
  "schema_version": 1,
  "name": "puls-recipes-long",
  "identity": "puls",
  "version": 3,
  "proves": "Puls's cook does on thirty more dishes, baking among them, what the recipes eval asks on ten: reads a real page with ReadRecipe, links it, shows its photo, and writes the amounts and steps the page gave.",
  "manual": "manual.md",
  "modes": [
    {
      "name": "puls-cook",
      "role": "puls/voice-af",
      "toolsets": [
        "agents",
        "web"
      ]
    }
  ],
  "checks": [
    {
      "type": "no-error"
    },
    {
      "type": "routed-to",
      "parameters": {
        "expected_key": "routes_to",
        "delegating_toolsets": [
          "agents"
        ]
      }
    },
    {
      "type": "tool-used",
      "parameters": {
        "tool": "ReadRecipe"
      }
    },
    {
      "type": "recipe-from-source",
      "parameters": {
        "reader": "recipe-link"
      }
    },
    {
      "type": "image-shown",
      "name": "recipe-image",
      "parameters": {
        "reader": "recipe-photos",
        "key": "recipe_image"
      }
    },
    {
      "type": "tool-rows-marked",
      "name": "unpriced-items",
      "parameters": {
        "tool": "EstimatePrices",
        "mark": "?"
      }
    },
    {
      "type": "judge",
      "name": "recipe-as-source",
      "parameters": {
        "rubric": "Rubrics/recipe-as-source.md",
        "ask": [
          "serves"
        ],
        "sources": [
          "ReadRecipe"
        ],
        "version": 2
      }
    },
    {
      "type": "human",
      "parameters": {
        "reviews": "recipe-as-source"
      }
    }
  ]
}

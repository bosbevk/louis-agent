# LLM profile: the orchestrator's triage on a local model, with louis-agent's fixes on LLM_PROFILE's (Claude):
#   .\samples\run-demo.ps1 -Short -OrchestratorProfile ollama-triage
# Measured in samples/sample-output-short-local-triage: the same fixes and escalation as Claude, triage free.
#
# Start Ollama and pull the model first:
#   docker compose -f docker/docker-compose.yml --env-file config/.env --profile ollama-nvidia up -d ollama-nvidia
#   docker exec louis_ollama_nvidia ollama pull qwen3:4b-instruct-2507-q4_K_M

LLM_PROVIDER=ollama
# The instruct variant answers without thinking; plain qwen3:4b thinks before every reply and is too slow on a small
# GPU, and llama3.1 writes tool calls as text (docs/features/README.md, Local triage).
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Ollama's published port, from the containers and from the host (see .env.ollama).
LLM_ENDPOINT=http://host.docker.internal:11434
{
  "kind": "classes",
  "title": "F144 the admin is a frame: the interface design",
  "caption": "An area brings its card beside its links; the areas list keeps the cards in the order named; the home draws them; the builder names the frame and each admin area.",
  "classes": {
    "types": [
      {
        "id": "area",
        "name": "SiteArea",
        "kind": "louis-agent.web, record",
        "members": [
          "+AdminLinks Type?",
          "+AdminCard Type?"
        ]
      },
      {
        "id": "areas",
        "name": "SiteAreas",
        "kind": "louis-agent.web, registered once",
        "members": [
          "+AdminLinks IReadOnlyList<Type>",
          "+AdminCards IReadOnlyList<Type>"
        ]
      },
      {
        "id": "builder",
        "name": "SiteAreasBuilder",
        "kind": "louis-agent.web",
        "members": [
          "+Admin(Type layout)",
          "+Overview(counts)",
          "+Packs(views)"
        ]
      },
      {
        "id": "home",
        "name": "AdminHome",
        "kind": "louis-agent.web, /admin",
        "tone": "violet"
      },
      {
        "id": "card",
        "name": "AdminCard",
        "kind": "louis-agent.web, a card's frame",
        "members": [
          "+Title string",
          "+Open string",
          "+ChildContent"
        ]
      }
    ],
    "relations": [
      { "from": "builder", "to": "area", "kind": "creates" },
      { "from": "areas", "to": "area", "kind": "holds" },
      { "from": "home", "to": "areas", "kind": "uses" },
      { "from": "home", "to": "card", "kind": "uses" }
    ]
  }
}

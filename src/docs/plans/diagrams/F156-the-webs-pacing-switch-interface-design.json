{
  "kind": "classes",
  "title": "F156 the web's pacing switch: the interface design",
  "caption": "The API says on each turn's stream whether the engine paced it; the page reads it as the turn opens and leaves its own pacer off for that turn.",
  "classes": {
    "types": [
      { "id": "headers", "name": "ApiHeaders", "kind": "static class, changed in step 2", "tone": "amber",
        "members": [ "const string StreamPaced = \"Stream-Paced\"", "const string StreamPacedOn = \"on\"" ] },
      { "id": "handlers", "name": "SessionHandlers", "kind": "API, changed in step 2", "tone": "violet",
        "members": [ "TurnAnswer SendMessage(id, request, sessions, http)", "sets Stream-Paced: on when STREAM_PACE is on" ] },
      { "id": "options", "name": "AgentOptions", "kind": "unchanged (F155)", "tone": "violet",
        "members": [ "bool StreamPace" ] },
      { "id": "api", "name": "AgentApi", "kind": "web, changed in step 3", "tone": "blue",
        "members": [ "StreamMessageAsync(..., Action? onServerPaced)", "calls it once when the header says on" ] },
      { "id": "runner", "name": "ChatRunner", "kind": "web, changed in step 3", "tone": "blue",
        "members": [ "marks the turn ServerPaced" ] },
      { "id": "turn", "name": "Turn", "kind": "web, changed in step 3", "tone": "blue",
        "members": [ "bool ServerPaced" ] },
      { "id": "caption", "name": "AgentCaption", "kind": "web, changed in step 4", "tone": "teal",
        "members": [ "[Parameter] bool ServerPaced", "paces only when streaming and not server paced" ] },
      { "id": "bar", "name": "AgentBar", "kind": "web, changed in step 4", "tone": "teal",
        "members": [ "hands the caption its turn's ServerPaced" ] }
    ],
    "relations": [
      { "from": "handlers", "to": "options", "kind": "uses", "word": "reads StreamPace" },
      { "from": "handlers", "to": "headers", "kind": "uses", "word": "the header's name" },
      { "from": "api", "to": "headers", "kind": "uses", "word": "reads the header" },
      { "from": "runner", "to": "api", "kind": "uses", "word": "streams a turn" },
      { "from": "runner", "to": "turn", "kind": "uses", "word": "sets ServerPaced" },
      { "from": "bar", "to": "turn", "kind": "uses", "word": "reads it" },
      { "from": "bar", "to": "caption", "kind": "creates", "word": "ServerPaced" }
    ],
    "direction": "down"
  }
}

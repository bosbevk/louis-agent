@page "/login"
@layout AccountFrame

@* Sign in, the same on every site: the form, then the other ways in. A person already signed in is sent on. *@

<PageTitle>@Text.SignIn</PageTitle>

<h1>@Text.SignIn</h1>
<p>@Text.SignInIntro</p>
<AccountNotice Message="@(Failed == "external" ? Text.ExternalFailed : null)" IsError="true" />
<LoginForm OnSignedIn="GoOn" />
<ProviderButtons ReturnUrl="@ReturnUrl" />

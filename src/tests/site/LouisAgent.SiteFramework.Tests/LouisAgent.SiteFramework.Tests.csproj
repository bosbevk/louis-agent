<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The framework's own site's tests (F164.1): its pages and its host's page list, with bUnit (MIT). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.SiteFramework.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\site\LouisAgent.SiteFramework\LouisAgent.SiteFramework.csproj" />
    <!-- The site's host, for the list of what a page it draws is handed. -->
    <ProjectReference Include="..\..\..\site\LouisAgent.SiteFrameworkApi\LouisAgent.SiteFrameworkApi.csproj" />
    <!-- The framework Orbi's eval file read as an eval, and replayed from its recordings (F126.5.2). -->
    <ProjectReference Include="..\..\..\evals\LouisAgent.Evals\LouisAgent.Evals.csproj" />
    <ProjectReference Include="..\..\hosts\LouisAgent.Api.Evals.Testing\LouisAgent.Api.Evals.Testing.csproj" />
    <ProjectReference Include="..\..\shared\LouisAgent.Testing\LouisAgent.Testing.csproj" />
    <!-- The web's test helpers, for the stylesheet the build made. -->
    <ProjectReference Include="..\..\web\LouisAgent.Web.Testing\LouisAgent.Web.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

</Project>

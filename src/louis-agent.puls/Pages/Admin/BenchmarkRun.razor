@page "/admin/benchmarks/{RunId}"
@* The Afrikaans address the portal had first, so links already shared still open. *@
@page "/admin/maatstawwe/{RunId}"
@layout AdminLayout
@using System.Net
@using System.Text.Json
@using LouisAgent.Web.Shared
@inject AgentApi Api
@inject ChatStore Store
@inject CurrencyState Currency
@implements IDisposable

@* F31 step 10: one stored run: what it ran with, and its explorer (RunExplorer), read from the benchmark store. *@

<PageTitle>Run @RunId · Puls Admin</PageTitle>

@* The head (the rework of 2026-10-26): the check's name as the title, the sentence it proves under it, then the run's facts in one line with a status pill. *@
<div class="page-head run-head">
    <div>
        <h1><code>@(_check ?? "run")</code></h1>
        @if (_title is { } title) { <p class="run-proves">@title</p> }
        <p class="run-facts">
            <code>@RunId</code>
            @if (_run is { } head)
            {
                <span class="status-pill @S(head.GetProperty("run"), "status")">@Status(head)</span>
                <span>@Started(head)</span><span class="muted">·</span><span>@Repeat(head)</span>
                @if (Total(head) is { } total) { <span class="muted">·</span><span>@total</span> }
                @if (S(head.GetProperty("run"), "rescore_of") is { } source) { <RescoredFrom Id="@source" /> }
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="header-button" href="admin/benchmarks"><span class="ic i-chart" aria-hidden="true"></span>All benchmarks</a>
    </div>
</div>

@if (_error is { } error)
{
    <section class="card-p admin-gate"><strong>@error</strong></section>
}
else if (_run is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else
{
    var run = _run.Value;
    @if (S(run.GetProperty("run"), "store_error") is { } storeError)
    {
        <section class="card-p store-banner"><strong>Not all of this run was stored.</strong><p>@storeError</p></section>
    }
    @* The sections in reading order (the rework of 2026-10-26): the roll-up first, the explorer to drill into a conversation, then the rates and the trends folded,
       since they are long, and last what the run ran with. *@
    <section class="card-p">
        <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Results by category<span class="fold-note">per mode: overall, then each category</span></summary>
            <SummaryPanel Run="run" Currency="Currency.Current" />
        </details>
    </section>
    @* No entrance animation on this card: a filled transform animation makes it the frame of every fixed child, so the
       explorer's chats modal would be clipped to the card and painted under the cards after it. *@
    <section class="card-p holds-modal">
        <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Explore the run<span class="fold-note">the modes side by side: conversations, turns, requests</span></summary>
            <RunExplorer Run="run" Currency="Currency.Current" OpenTask="@FocusTask" />
        </details>
    </section>
    <AgreementPanel Run="run" RunId="@RunId" />
    <section class="card-p">
        <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Pass rates per mode<span class="fold-note">as the runner wrote them on the last repeat</span></summary>
            <ModeRatesList Run="run" />
        </details>
    </section>
    @if (_trend is { } trend)
    {
        <section class="card-p">
            <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Trend<span class="fold-note">this check over its runs, this run marked</span></summary>
                <TrendChart Trend="trend" Highlight="@RunId" Labels="_labels" ShowTitle="false" Currency="Currency.Current" />
            </details>
        </section>
        <section class="card-p">
            <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Trend by category<span class="fold-note">pass@k and pass^k per category, per model</span></summary>
                <CategoryTrends Trend="trend" Highlight="@RunId" Currency="Currency.Current" />
            </details>
        </section>
    }
    <section class="card-p">
        <details class="fold"><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>What it ran with<span class="fold-note">the eval, its graders, the settings, the modes</span></summary>
            <GraderList Run="run" />
            <dl class="explorer-fields">
                @if (run.TryGetProperty("settings", out var settings) && settings.ValueKind == JsonValueKind.Object)
                {
                    foreach (var p in settings.EnumerateObject()) { <dt>@p.Name</dt><dd><code>@p.Value.GetString()</code></dd> }
                }
                @foreach (var m in run.GetProperty("modes").EnumerateArray())
                {
                    <dt>@m.GetProperty("name").GetString() · @m.GetProperty("repeat").GetInt32()</dt>
                    <dd><code>@string.Join(", ", m.GetProperty("toolsets").EnumerateArray().Select(t => t.GetString()))</code>@(S(m, "role") is { } p ? $" · {p}" : "")@(S(m, "llm") is { } l ? $" · {l}" : "")</dd>
                }
            </dl>
        </details>
        @if (run.TryGetProperty("log", out var log) && log.ValueKind == JsonValueKind.Array)
        {
            <details class="admin-details"><summary>The script's own lines (@log.GetArrayLength())</summary><pre class="admin-pre run-log">@string.Join("\n", log.EnumerateArray().Select(l => l.GetString()))</pre></details>
        }
    </section>
}

@code {
    [Parameter] public string RunId { get; set; } = "";

    /// <summary>A task a category's line linked to (<c>?task=</c>): its conversation opens in the explorer.</summary>
    [SupplyParameterFromQuery(Name = "task")] public string? FocusTask { get; set; }

    private JsonElement? _run, _trend;
    private Dictionary<string, string> _labels = [];

    /// <summary>Who each mode is, as the explorer names it: Puls with the roles it handed to, or Puls alone.</summary>
    private static Dictionary<string, string> Labels(JsonElement run) =>
        run.GetProperty("turns").EnumerateArray()
            .GroupBy(t => t.GetProperty("mode").GetString()!)
            .ToDictionary(g => g.Key, g => g.Select(t => S(t, "role")).Where(r => !string.IsNullOrEmpty(r)).Distinct().ToList() is { Count: > 0 } roles
                ? $"Puls with {string.Join(" and ", roles)}" : "Puls alone");
    private string? _title, _check, _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!Store.Loaded) await Store.LoadAsync();
        Currency.Changed += StateHasChanged;
        await Currency.LoadAsync();
        _run = null;
        _error = null;
        try
        {
            var run = await Api.GetAsync<JsonElement>($"v1/admin/benchmarks/runs/{Uri.EscapeDataString(RunId)}");
            var list = await Api.GetAsync<JsonElement>("v1/admin/benchmarks");
            string check = _check = run.GetProperty("run").GetProperty("check").GetString()!;
            _title = list.GetProperty("checks").EnumerateArray().Where(c => c.GetProperty("id").GetString() == check)
                .Select(c => c.GetProperty("title").GetString()).FirstOrDefault();
            _run = run;
            _labels = Labels(run);
            try { _trend = await Api.GetAsync<JsonElement>($"v1/admin/benchmarks/checks/{Uri.EscapeDataString(check)}/trend"); }
            catch (AgentApiException) { _trend = null; }
        }
        catch (AgentApiException ex)
        {
            _error = ex.Status == HttpStatusCode.NotFound ? $"No run {RunId} in the store." : ex.Message;
        }
    }

    public void Dispose() => Currency.Changed -= StateHasChanged;

    private static string? S(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

    private static string Started(JsonElement run) => run.GetProperty("run").GetProperty("started_at").GetDateTimeOffset().ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string Status(JsonElement run) => S(run.GetProperty("run"), "status") switch { "running" => "running", "done" => "done", _ => "failed" };

    private static string Repeat(JsonElement run) => run.GetProperty("run").GetProperty("repeat").GetInt32() is var n && n == 1 ? "1 repeat" : $"{n} repeats";

    private string? Total(JsonElement run) =>
        run.GetProperty("run").TryGetProperty("total", out var t) && t.ValueKind == JsonValueKind.Object
            ? $"{(t.TryGetProperty("cost", out var c) && c.ValueKind == JsonValueKind.Number ? UsageFormat.Money(c.GetDecimal(), "USD", Currency.Current) : "—")}, {t.GetProperty("requests").GetInt32()} requests"
            : null;
}

@inject SiteAreas Areas

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="Areas.PageAssemblies" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(ChatLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="#composer-input" />
    </Found>
</Router>

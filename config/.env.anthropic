# LLM profile: Claude through the Anthropic API. Selected with LLM_PROFILE=anthropic in config/.env.
# Needs ANTHROPIC_API_KEY in .env.secrets. Every request costs money; see ../docs/MODELS.md for the models and prices.
# A setting in config/.env or the shell overrides the same setting here.

LLM_PROVIDER=anthropic
# Claude Haiku 5.5: about 7.5x cheaper than Haiku 4.5 for the same work (measured with tools/louis-agent.usage-probe).
# Prompts over 100,000 tokens cost 5x per token. claude-haiku-4-5-20251001 still works here.
LLM_MODEL=claude-haiku-5-5

# Visible thinking, streamed to Rider and the CLI: off | low | medium | high (default: medium for anthropic).
# Higher = more reasoning, slower and more tokens. Haiku 5.5 decides per request whether to think at all.
# LLM_THINKING=medium

@* One eval (CL26): its name, whose it is and what it proves; its latest run as a scorecard, the runs before it as a
   timeline, and what it checks in a fold. An eval that never ran shows only what it checks. *@

<section class="card-p eval-card">
    <header class="eval-head">
        <div class="eval-title">
            <code>@Eval.Name</code>
            <span class="eval-version">@EvalText.Version(Eval.Version)</span>
            <span class="eval-whose">for @EvalText.Whose(Eval.Identity)</span>
        </div>
        <span class="status-pill @(Eval.NeverRun == true ? "never-run" : "")">@EvalText.Runs(Eval.NeverRun, Eval.Runs.Count)</span>
    </header>
    <p class="eval-proves">@Eval.Proves</p>

    @if (View.Latest is { } latest)
    {
        <EvalScorecard Line="latest" Currency="Currency" />
    }

    @if (View.Runs.Count > 0)
    {
        <EvalRunTimeline Runs="View.Runs" Currency="Currency" />
    }

    <EvalChecks Eval="Eval" Graders="View.Graders" />

    @if (Eval.Runs.Count > 0)
    {
        <a class="eval-trend" href="admin/benchmarks">The trend and the category lines are on the Benchmarks page ›</a>
    }
</section>

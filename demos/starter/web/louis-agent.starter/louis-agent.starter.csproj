<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The smallest site on the framework's web, and what `dotnet new louis-site` makes. It holds only what makes a site
       that site: its name, its address, its colours if it wants its own, and which packs' views it uses. The paths
       below are from demos/{site}/web/{site}/, so a new site goes there until the framework ships as packages. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Starter</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles Styles/ into wwwroot/css on every build. Build time only: nothing of it reaches the browser. -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.107.1" PrivateAssets="all" ExcludeAssets="runtime;compile" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\web\louis-agent.web\louis-agent.web.csproj" />
    <!-- CL30: the account pages and their client; a site that has accounts opts in here. -->
    <ProjectReference Include="..\..\..\..\src\web\louis-agent.web.accounts\louis-agent.web.accounts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Sass compiler's settings are for the build, so they stay out of what's published. The template's settings
         are for `dotnet new`. -->
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove=".template.config\**" />
    <None Remove=".template.config\**" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Who Puls is (CL15, ADR 0027): its modes, its specialists and its minion roles, as embedded prompts, and the packs it
       uses by name. The web app the user sees stays src/louis-agent.puls; this is what the agent loads. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Identities.Puls</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded prompts' folder paths (ManifestEmbeddedFileProvider), as core's csproj does. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\louis-agent.core\louis-agent.core.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step 3 moves Puls's prompts here from core's Prompts/, byte for byte. -->
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- F49.2: Puls's evals are folders of files (Evals/{Folder}/: eval.json, Dataset/, Transcripts/, its manual),
         copied as every eval project's are, to EvalFiles/{this project's path from the repository root}/Evals/{Folder}/,
         where the runner finds them through the composition. Files only: the identity references no harness. -->
    <None Update="Evals\**\*" TargetPath="EvalFiles\identities\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.identity.puls.md" Link="docs\louis-agent.identity.puls.md" />
    <None Include="..\..\docs\guides\change-puls.md" Link="docs\change-puls.md" />
    <None Include="..\..\docs\guides\build-an-identity.md" Link="docs\build-an-identity.md" />
  </ItemGroup>

</Project>

{
  "kind": "sequence",
  "title": "F134.8 flows in the new look: an arrow is routed",
  "caption": "Two questions are asked of the rule for every forward arrow: which track its source has in the gap, and which point on the target's side is its own.",
  "sequence": {
    "participants": [
      { "id": "renderer", "label": "FlowRenderer", "icon": "code", "tone": "green" },
      { "id": "layout", "label": "GraphLayout", "icon": "code", "tone": "green" },
      { "id": "router", "label": "EdgeRouter", "icon": "code", "tone": "green" },
      { "id": "rule", "label": "ApartArrows", "icon": "code", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "renderer", "to": "layout", "text": "Place(spec, an ApartArrows)" },
      { "step": "message", "from": "layout", "to": "rule", "text": "TracksRoom(a gap's arrows)" },
      { "step": "reply", "from": "rule", "to": "layout", "text": "a step for each source after the first" },
      { "step": "note", "over": ["layout"], "text": "a gap is as wide as its words and its tracks need" },
      { "step": "message", "from": "layout", "to": "router", "text": "Route(arrows, boxes, the rule)" },
      { "step": "block", "block": "loop", "label": "each forward arrow",
        "steps": [
          { "step": "message", "from": "router", "to": "rule", "text": "TrackOf(arrow)" },
          { "step": "reply", "from": "rule", "to": "router", "text": "its source's track in the gap" },
          { "step": "message", "from": "router", "to": "rule", "text": "EntryOf(arrow)" },
          { "step": "reply", "from": "rule", "to": "router", "text": "its own point on the target's outline" }
        ] },
      { "step": "reply", "from": "router", "to": "layout", "text": "every arrow's path" },
      { "step": "reply", "from": "layout", "to": "renderer", "text": "the placed graph" },
      { "step": "note", "over": ["renderer"], "text": "draws boxes by their shape, lines with their dots, the title and the key" }
    ],
    "numbered": false
  }
}

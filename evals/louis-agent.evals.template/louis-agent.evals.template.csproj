<Project Sdk="Microsoft.NET.Sdk">

  <!-- F18 step 5.4c: a project to copy when you start a new eval set (docs/guides/add-an-eval-set.md): the layout of an eval project, with every member
       present and empty. The runner doesn't reference it, so no run and no portal ever shows it; F49.2 step 10 makes it a folder of files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Evals.Template</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- An eval's files are beside it (Evals/{Folder}/: eval.json, Dataset/, Transcripts/, rubrics, its manual). One item, the same in every
         eval project, copies every one that isn't code to EvalFiles/{this project's path from the repository root}/Evals/{Folder}/..., so a copy's
         path below EvalFiles/ is where it sits in the repository (F49.2). TargetPath, not Link: Link would show the files a second time in the IDE
         under a folder named like the project. -->
    <None Update="Evals\**\*" TargetPath="EvalFiles\evals\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness (ADR 0029) names no identity: an eval project references it and nothing of any identity's. -->
    <ProjectReference Include="..\louis-agent.evals\louis-agent.evals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\guides\add-an-eval-set.md" Link="docs\add-an-eval-set.md" />
    <None Include="..\..\docs\guides\run-the-evals.md" Link="docs\run-the-evals.md" />
  </ItemGroup>

</Project>

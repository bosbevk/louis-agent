<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="FrameworkPages.With(AccountLibrary.Assembly, EvalLibrary.Assembly)" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="#composer-input" />
    </Found>
</Router>

{
  "kind": "sequence",
  "title": "F153 Reset my session: one reset",
  "caption": "The sessions are ended before the lists that name them are cleared, and the admin key is the one thing put back.",
  "sequence": {
    "participants": [
      { "id": "button", "label": "ResetSession", "icon": "stack", "tone": "teal" },
      { "id": "reset", "label": "SessionReset", "icon": "chip", "tone": "green" },
      { "id": "module", "label": "The module", "icon": "file", "tone": "amber" },
      { "id": "store", "label": "ChatStore", "icon": "message", "tone": "violet" },
      { "id": "api", "label": "AgentApi", "icon": "cloud", "tone": "violet" },
      { "id": "nav", "label": "NavigationManager", "icon": "box", "tone": "blue" }
    ],
    "steps": [
      { "step": "message", "from": "button", "to": "reset", "text": "RunAsync()" },
      { "step": "message", "from": "reset", "to": "module", "text": "chatKeys()" },
      { "step": "reply", "from": "module", "to": "reset", "text": "louis-agent.chats, louis-agent.widget-chats, …" },
      { "step": "message", "from": "reset", "to": "store", "text": "LoadAsync(), one store per key" },
      { "step": "reply", "from": "store", "to": "reset", "text": "its chats, each with its SessionId" },
      { "step": "message", "from": "reset", "to": "api", "text": "DeleteSessionAsync(id), for each" },
      { "step": "reply", "from": "api", "to": "reset", "text": "ended, or already gone" },
      { "step": "message", "from": "reset", "to": "module", "text": "forget(\"louis-agent.adminKey\")" },
      { "step": "note", "over": ["module"], "text": "both storages cleared, the admin key put back" },
      { "step": "message", "from": "reset", "to": "nav", "text": "Refresh(forceReload: true)" }
    ],
    "numbered": false
  }
}

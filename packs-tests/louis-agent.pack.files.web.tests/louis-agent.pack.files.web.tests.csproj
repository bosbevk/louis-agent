<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Sees both sides, the pack and its web views, because neither may reference the other: this is what holds the
       names they share together. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Files.Web.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packs\louis-agent.pack.files\louis-agent.pack.files.csproj" />
    <ProjectReference Include="..\..\packs-web\louis-agent.pack.files.web\louis-agent.pack.files.web.csproj" />
    <!-- The fakes every test project shares (CL15 step 5). -->
    <ProjectReference Include="..\..\src\tests\shared\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

</Project>

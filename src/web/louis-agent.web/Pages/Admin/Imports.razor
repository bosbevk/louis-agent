@page "/admin/imports"
@layout AdminFrame

@* The packs' data uploads, from GET /v1/admin/imports: a card for each, or a view of a pack's own where one is
   registered. Preview shows what the files hold and what they would change; Save keeps them. *@

<PageTitle>Uploads · Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Uploads</h1>
        <p>Data the packs take from a file: preview what it holds and changes, then save it.</p>
    </div>
    <div class="page-actions">
        <button class="header-button" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Reload</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

@if (_loading && _forms is null)
{
    <section class="card-p imports-loading"><span class="muted">Loading…</span></section>
}
else if (_forms is { Count: 0 })
{
    <section class="card-p"><span class="muted">No pack on this instance takes an upload.</span></section>
}
else if (_forms is { } forms)
{
    @foreach (var form in forms)
    {
        <DynamicComponent @key="form.Upload.Name" Type="Views.ImportView(form.Upload.Name)" Parameters="ParametersFor(form)" />
    }
}

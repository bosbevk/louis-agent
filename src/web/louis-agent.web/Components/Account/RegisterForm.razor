@* The registration form: an email, a password twice, and what didn't pass. *@
<form class="account-form" @onsubmit="RegisterAsync">
    <AccountNotice Message="@_error?.Message" Details="_error?.Details ?? []" IsError="true" />
    <label class="account-field">
        @Text.Email
        <input type="email" autocomplete="username" required @bind="_email" />
    </label>
    <PasswordField Label="@Text.Password" @bind-Value="_password" Autocomplete="new-password" Hint="@Text.PasswordRules" />
    <PasswordField Label="@Text.ConfirmPassword" @bind-Value="_again" Autocomplete="new-password" />
    <div class="account-actions">
        <button class="account-button" type="submit" disabled="@_busy">@Text.Register</button>
    </div>
    <div class="account-links">
        <a href="login">@Text.HaveAnAccount @Text.SignIn</a>
    </div>
</form>

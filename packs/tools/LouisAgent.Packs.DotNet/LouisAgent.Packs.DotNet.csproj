<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET SDK as tools: build, test, run and restore projects, list packages, SDK information. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.DotNet</RootNamespace>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, the toolset's guide is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LouisAgent.Packs.DotNet.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Packs.DotNet.IntegrationTests" />
    <InternalsVisibleTo Include="LouisAgent.Coding.Catalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\LouisAgent.Composition\LouisAgent.Composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.md" />
  </ItemGroup>

</Project>

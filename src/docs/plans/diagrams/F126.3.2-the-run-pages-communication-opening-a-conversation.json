{
  "kind": "sequence",
  "title": "F126.3.2 the run pages: opening a conversation",
  "caption": "A failed conversation is opened from a run's page with no repeat in the address. The page reads the run once, asks the records which repeat failed first, and draws that repeat's turns. Next failed is a link the run itself answers.",
  "sequence": {
    "participants": [
      { "id": "P", "icon": "user", "tone": "blue", "label": "The reader" },
      { "id": "C", "icon": "book", "tone": "green", "label": "ConversationPage" },
      { "id": "A", "icon": "server", "tone": "green", "label": "EvalsApi" },
      { "id": "H", "icon": "chip", "tone": "violet", "label": "The site's API" },
      { "id": "R", "icon": "code", "tone": "teal", "label": "The run's records" }
    ],
    "steps": [
      { "step": "message", "from": "P", "to": "C", "text": "opens /admin/evals/guide/runs/{run}/guide-invoices" },
      { "step": "message", "from": "C", "to": "A", "text": "FindRunAsync(the run's id)" },
      { "step": "message", "from": "A", "to": "H", "text": "GET /v1/admin/evals/runs/{id}, with the admin key" },
      { "step": "reply", "from": "H", "to": "A", "text": "the run's JSON, as it is kept" },
      { "step": "note", "over": ["A"], "text": "read with RunJson.Options, the options it was written with" },
      { "step": "reply", "from": "A", "to": "C", "text": "the EvalRun, or none when the host has no such run" },
      { "step": "message", "from": "C", "to": "R", "text": "the conversation guide-invoices: FindFirstFailedRepeat()" },
      { "step": "reply", "from": "R", "to": "C", "text": "repeat 2" },
      { "step": "message", "from": "C", "to": "R", "text": "repeat 2: CountFacts(), CountCriteria(), SumCost(), SumTime()" },
      { "step": "reply", "from": "R", "to": "C", "text": "the figures of this repeat" },
      { "step": "message", "from": "C", "to": "R", "text": "the run: FindNextFailed(guide-invoices), FindPrevious(…)" },
      { "step": "reply", "from": "R", "to": "C", "text": "the two conversations the links open, or none" },
      { "step": "reply", "from": "C", "to": "P", "text": "the repeat switch on 2, a card per turn with its marks" },
      { "step": "message", "from": "P", "to": "C", "text": "picks repeat 3: the address ends /3, nothing is fetched again" }
    ]
  }
}

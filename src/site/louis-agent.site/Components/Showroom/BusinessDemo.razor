@* A showroom business's demo (F128.2): what the business is and what to watch for on the left, its conversation
   recorded once and played as its customer would see it on the right, then the offer. *@
<Band Id="top" Kicker="@Kicker">
    <div class="watch-grid">
        <div class="watch-text">
            <BandTitle Class="chrome">@Heading</BandTitle>
            <p class="lede">@Lede</p>
            <ul class="rules">@Points</ul>
            <p class="band-note">@Business is a made-up business, here to show what a website with an agent does. The conversation is real, recorded once and played back. Nothing runs while you watch.</p>
        </div>
        <RecordedChat Turns="Turns" Title="@Title" PlayAgain="Play it again" ShowWork="false">
            <Ending>
                <p class="recorded-offer">Want an agent like this on your own website? <a href="/contact">Ask for yours</a>, from R500 a month.</p>
            </Ending>
        </RecordedChat>
    </div>
</Band>

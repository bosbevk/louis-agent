<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Evals.Puls</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- F18 step 3a.2: the datasets are data, copied beside the assembly so the runner can load them (how it finds them is step 4's decision). -->
    <None Update="Datasets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 3: Puls's rules, which name Puls's shops and its cook; the harness (ADR 0029) names no identity. -->
    <ProjectReference Include="..\louis-agent.evals\louis-agent.evals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\guides\add-an-eval-set.md" Link="docs\add-an-eval-set.md" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- CL57: the eval studio's tests, moved with it out of the framework web's tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Web.Evals.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\web\louis-agent.web.evals\louis-agent.web.evals.csproj" />
    <ProjectReference Include="..\louis-agent.web.testing\louis-agent.web.testing.csproj" />
    <ProjectReference Include="..\..\shared\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Web.Testing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

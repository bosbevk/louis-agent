        "icon": "message",
        "tone": "green",
        "label": "StreamTurnAsync"
      },
      {
        "id": "Engine",
        "icon": "chip",
        "tone": "violet",
        "label": "AgentEngine.StreamPromptAsync"
      },
      {
        "id": "SSE",
        "icon": "cloud",
        "tone": "teal",
        "label": "ITurnStreamFormat\n(Streaming/Claude) \u2192 SSE\nevents"
      },
      {
        "id": "WS",
        "icon": "server",
        "tone": "green",
        "label": "WorkspaceEndpoints"
      },
      {
        "id": "Files",
        "icon": "folder",
        "tone": "amber",
        "label": "Workspace"
      },
      {
        "id": "Git",
        "icon": "branch",
        "tone": "amber",
        "label": "Endpoints/Git"
      },
      {
        "id": "Static",
        "icon": "world",
        "tone": "green",
        "label": "MapStaticAssets \u002B\nMapLouisAgentSite\n(each page as HTML)"
      }
    ],
    "edges": [
      {
        "from": "Client",
        "to": "Turn",
        "word": "POST\n/v1/sessions/{id}/messages"
      },
      {
        "from": "Turn",
        "to": "Engine"
      },
      {
        "from": "Engine",

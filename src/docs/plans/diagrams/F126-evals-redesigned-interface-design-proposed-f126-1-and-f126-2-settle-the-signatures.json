      {
        "id": "PerCriterionJudge",
        "name": "PerCriterionJudge"
      },
      {
        "id": "PerConversationJudge",
        "name": "PerConversationJudge"
      },
      {
        "id": "EvalRun",
        "name": "EvalRun",
        "members": [

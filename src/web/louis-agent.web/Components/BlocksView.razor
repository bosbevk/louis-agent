@* The blocks of an answer: thinking, text and tool calls, in order. An AskAgent call is drawn as a delegation card,
   with the asked agent's own blocks inside it (F5). Used by TurnView and, nested, by DelegationCard. With its work
   hidden (F128.1), thinking is its label alone and no tool call is drawn. The cards the agent drew and the choices it
   offered sit under its words (F127.4.1). *@

@inject ChatText Text

@foreach (var block in CardsLast.Of(Blocks))
{
    switch (block.Kind)
    {
        case BlockKind.Thinking when !ShowWork:
            <div class="thinking-label">@ThinkingLabel(block)</div>
            break;

        case BlockKind.Thinking:
            <details class="thinking" open="@(Streaming && block.ThinkingSeconds is null)">
                <summary>@ThinkingLabel(block)</summary>
                <div class="thinking-text">@block.Text</div>
            </details>
            break;

        case BlockKind.Text:
            <div class="markdown">@Markdown.ToHtml(block.Text, Shown)</div>
            break;

        case BlockKind.Tool when CardCall.SourceOf(block) is { } card:
            <DrawnCard Source="card" />
            break;

        case BlockKind.Tool when OfferCall.Of(block) is { } offer:
            <OfferCards Offer="offer" Answer="@Answer" Streaming="Streaming" Chosen="Chosen" />
            break;

        case BlockKind.Tool when block.InWindow:
            <div class="in-window">@Text.AnswersInItsWindow</div>
            break;

        case BlockKind.Tool when !ShowWork:
            break;

        case BlockKind.Tool when Delegation.From(block) is { } delegation:
            <DelegationCard Delegation="delegation" Block="block" Streaming="Streaming" Currency="Currency" Shown="Shown" />
            break;

        case BlockKind.Tool:
            <details class="tool @(block.ToolFailed ? "failed" : "")">
                <summary>
                    <span class="tool-status">@(block.ToolResult is null ? "⋯" : block.ToolFailed ? "✗" : "✓")</span>
                    <span class="tool-name">@block.ToolName</span>
                    @if (block.ToolInput is not null)
                    {
                        <span class="tool-args">@ToolArgs.Summarise(block.ToolInput)</span>
                    }
                </summary>
                @if (block.ToolInput is not null)
                {
                    <div class="tool-label">@Text.Input</div>
                    <pre>@block.ToolInput</pre>
                }
                @if (block.ToolResult is not null)
                {
                    <div class="tool-label">@Text.Result</div>
                    <pre>@block.ToolResult</pre>
                }
            </details>
            break;
    }
}

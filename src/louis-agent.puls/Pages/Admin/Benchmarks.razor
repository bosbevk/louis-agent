@page "/admin"
@page "/admin/benchmarks"
@* The Afrikaans address the portal had first, so links already shared still open. *@
@page "/admin/maatstawwe"
@layout AdminLayout

@* F31 step 9: the Benchmarks page as the plan lays it out. The store's state, a card per check (repeats, Loop), the run
   in progress and the stored runs, newest first. The explorer of one run is step 10. *@

<PageTitle>Benchmarks · Puls Admin</PageTitle>

<BenchmarksHead Store="_data?.Store" Loading="_loading" OnReload="LoadAsync" />

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

@if (_loading && _data is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else if (_data is { } data)
{
    <StoreBanner Store="data.Store" />

    <ChecksList Checks="data.Checks" Runs="_runs" Trends="_trends" Selected="@_selected" Running="Running"
                CanRun="StoreStatus.Up(data.Store)" Currency="Currency.Current"
                OnSelect="Select" OnManual="OpenManualAsync" OnRun="StartAsync" />

    @if (_run is { } live)
    {
        <LiveRunPanel Run="live" FromStore="_fromStore" Title="@TitleOf(live.Check)" Currency="Currency.Current"
                      OnEnded="RunEndedAsync" OnError="ShowError" />
    }

    @if (_manual is { } manual)
    {
        <ManualDialog Manual="manual" OnClose="CloseManual" />
    }

    <RunsList Check="Chosen" Runs="_runs" Running="Running" Currency="Currency.Current" OnRescored="FollowRescoreAsync" OnReplay="StartAsync" />
}

{
  "kind": "sequence",
  "title": "CL68.2: the triage manager asks its sorter",
  "caption": "The address is the role's name: AgentAddresses resolves triage.sorter, RoleCatalog finds its voice under the triage agent, and its header says subagent.",
  "sequence": {
    "participants": [
      { "id": "manager", "label": "the triage manager", "icon": "message", "tone": "green" },
      { "id": "ask", "label": "AskAgent", "icon": "exchange", "tone": "violet" },
      { "id": "addresses", "label": "AgentAddresses", "icon": "search", "tone": "teal" },
      { "id": "roles", "label": "RoleCatalog", "icon": "folder", "tone": "teal" },
      { "id": "sorter", "label": "triage.sorter", "icon": "users", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "manager", "to": "ask", "text": "AskAgent(\"triage.sorter\", the case)" },
      { "step": "message", "from": "ask", "to": "addresses", "text": "Resolve(triage.sorter)" },
      { "step": "message", "from": "addresses", "to": "roles", "text": "FileName(\"triage.sorter\", Subagent)" },
      { "step": "reply", "from": "roles", "to": "addresses", "text": "agents/triage/subagents/sorter/voice.md, level: subagent" },
      { "step": "reply", "from": "addresses", "to": "ask", "text": "the subagent, role triage.sorter" },
      { "step": "message", "from": "ask", "to": "sorter", "text": "a sub-session at depth 1, its toolsets" },
      { "step": "reply", "from": "sorter", "to": "manager", "text": "SortCase(...), its typed result" }
    ]
  }
}

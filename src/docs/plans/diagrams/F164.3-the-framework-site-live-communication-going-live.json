{
  "kind": "sequence",
  "title": "F164.3: going live, after the merge",
  "caption": "The merge creates the app; the domain verb prints the records, Louis adds them, and the certificate binds once they resolve. Until then the new links lead nowhere (pick C).",
  "sequence": {
    "participants": [
      { "id": "louis", "label": "Louis", "actor": true, "tone": "blue" },
      { "id": "actions", "label": "GitHub Actions", "icon": "play", "tone": "violet" },
      { "id": "azure", "label": "Azure", "icon": "server", "tone": "red" },
      { "id": "cloudflare", "label": "Cloudflare", "icon": "world", "tone": "red" }
    ],
    "steps": [
      { "step": "message", "from": "louis", "to": "actions", "text": "merges #403" },
      { "step": "message", "from": "actions", "to": "azure", "text": "release louis-agent-app" },
      { "step": "message", "from": "actions", "to": "azure", "text": "release louis-agent-framework-app" },
      { "step": "reply", "from": "azure", "to": "louis", "text": "the app's own address" },
      { "step": "message", "from": "louis", "to": "azure", "text": "deploy.ps1 domain -App louis-agent-framework-app" },
      { "step": "reply", "from": "azure", "to": "louis", "text": "CNAME framework, TXT asuid.framework" },
      { "step": "message", "from": "louis", "to": "cloudflare", "text": "adds the two records, DNS-only" },
      { "step": "message", "from": "louis", "to": "azure", "text": "deploy.ps1 domain again" },
      { "step": "reply", "from": "azure", "to": "louis", "text": "certificate bound: framework.louis-agent.dev answers" }
    ]
  }
}

@* The Puls logo (wwwroot/brand/puls-logo.svg) inline: the ripple mark, then "puls" beside it in the charcoal-tinted white (Puls is dark, F20). The mark is a
   solid orange disc with rings cut out of it (a mask), so the background shows through them. In Afrikaans a puls is a
   disturbance that travels away from its source: a faint glow crosses each ring in turn, outward from the green
   source (.puls-glow in app.css). Ids are per instance: a page can hold two logos (the top bar and the sidebar), and a
   gradient or mask inside a hidden copy doesn't paint. *@
<svg class="puls-logo" viewBox="0 0 300 120" role="img" aria-label="Puls">
    <defs>
        <linearGradient id="@(_id)bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f7952f" />
            <stop offset="1" stop-color="#d9660b" />
        </linearGradient>
        <mask id="@(_id)cut" maskUnits="userSpaceOnUse" x="0" y="0" width="120" height="120">
            <circle cx="60" cy="60" r="58" fill="#fff" />
            @foreach (var (radius, width) in Rings)
            {
                <circle cx="30" cy="92" r="@radius" fill="none" stroke="#000" stroke-width="@width" />
            }
        </mask>
        <clipPath id="@(_id)disc"><circle cx="60" cy="60" r="58" /></clipPath>
    </defs>
    <rect width="120" height="120" fill="url(#@(_id)bg)" mask="url(#@(_id)cut)" />
    <g clip-path="url(#@(_id)disc)">
        @foreach (var (radius, width) in Rings)
        {
            <circle class="puls-glow" cx="30" cy="92" r="@radius" fill="none" stroke="#fff" stroke-width="@width" />
        }
    </g>
    <circle class="puls-source" cx="30" cy="92" r="7.5" fill="#38b449" />
    <g transform="translate(140 19) scale(.9)">
        <path d="M14 26V84M14 44a18 18 0 1 0 36 0a18 18 0 1 0-36 0M64 26v18a18 18 0 0 0 36 0M100 26v36M118 8v54M163 31c-4-4-9-5-13-5c-8 0-13 4-13 9c0 6 6 8 13 9c8 1 14 3 14 9c0 6-6 9-14 9c-6 0-11-2-15-6"
              fill="none" stroke="#efefeb" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
    </g>
</svg>

@code {
    /// <summary>Radius and width of each ring cut out of the disc: the first clear from the green source's edge to the first orange band (no orange ring around the source), each after it thinner, with a thin even band of orange (3.5) between them.</summary>
    private static readonly (string Radius, string Width)[] Rings =
    [
        ("19.5", "28"), ("41.5", "9"), ("53.3", "7.6"),
        ("63.75", "6.3"), ("72.95", "5.1"), ("81", "4"), ("88", "3"),
    ];

    private readonly string _id = "puls-" + Guid.NewGuid().ToString("N")[..8] + "-";
}

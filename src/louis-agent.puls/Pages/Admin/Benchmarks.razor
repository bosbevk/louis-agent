@page "/admin"
@page "/admin/maatstawwe"
@layout AdminLayout
@using System.Net
@using System.Text.Json
@using LouisAgent.Web.Shared
@using LouisAgent.Web.Shared.Services
@inject AgentApi Api
@inject ChatStore Store
@inject CurrencyState Currency
@implements IDisposable

@* F27 step 2: the first admin page. The checks the portal knows, and every run saved under samples/, newest first;
   a run opens to its summary table, its README and its numbers. Running one from here is step 4. *@

<PageTitle>Maatstawwe · Puls Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Maatstawwe</h1>
        <p>Die kontroles wat Puls meet, en elke lopie wat onder <code>samples/</code> gestoor is.</p>
    </div>
    <div class="page-actions">
        <button class="header-button" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Herlaai</button>
    </div>
</div>

@if (_error is { } error)
{
    <section class="card-p admin-gate">
        <strong>@error</strong>
        @if (_needsKey)
        {
            <p>Die portaal se sleutel is <code>ADMIN_API_KEY</code> (of <code>AGENT_API_KEY</code>) in <code>config/.env.secrets</code>. Vul dit hier in; dit word in hierdie blaaier gehou, soos in Instellings.</p>
            <form class="admin-key" @onsubmit="SaveKeyAsync">
                <input type="password" placeholder="die sleutel" @bind="_keyDraft" />
                <button class="header-button" type="submit">Stoor en herlaai</button>
            </form>
        }
    </section>
}
else if (_loading && _data is null)
{
    <section class="card-p"><span class="muted">Laai…</span></section>
}
else if (_data is { } data)
{
  @* Two columns (Louis: the list "will get long, move it to the right"): the checks, the live run and the opened run
     in the main column; the saved runs as a compact list in a side column that scrolls on its own. *@
  <div class="admin-cols">
  <div class="admin-col-main">
    <div class="cards">
        @foreach (var check in data.Checks)
        {
            @* Rolls up and down (Louis): the header stays, with the chip and the last run's cost. *@
            var last = data.Runs.FirstOrDefault(r => r.Check == check.Id);
            <details class="card-p check-card" open>
                <summary class="card-head">
                    <strong>@check.Title</strong>
                    <span class="check-card-meta">@(last is null ? "" : Cost(last.Cost)) <span class="toolset-chip">@check.Id</span><span class="chevron" aria-hidden="true"></span></span>
                </summary>
                <p class="muted"><code>@check.Script</code></p>
                <p class="muted">@(last is null ? "Nog geen gestoorde lopie nie." : $"Laaste lopie: {last.SavedAt.ToLocalTime():yyyy-MM-dd HH:mm}, {Cost(last.Cost)}")</p>
                <div class="run-controls">
                    <span class="muted">Herhalings</span>
                    @* A segmented control, not a native select: the browser's dropdown ignores the theme. *@
                    <div class="segmented" role="radiogroup" aria-label="Herhalings">
                        @for (int n = 1; n <= 5; n++)
                        {
                            int count = n;
                            <button type="button" role="radio" aria-checked="@(_repeat == count)" class="@(_repeat == count ? "active" : "")" disabled="@Running" @onclick="() => _repeat = count">@count</button>
                        }
                    </div>
                    <button class="header-button" type="button" disabled="@Running" title="Spandeer geld: elke lopie vra die model" @onclick="() => StartAsync(check.Id)">
                        <span class="ic i-pulse" aria-hidden="true"></span>Hardloop
                    </button>
                </div>
            </details>
        }
    </div>

    @if (_run is { } live)
    {
        <section class="card-p run-panel @(live.Status)">
            <div class="card-head">
                <strong>@(data.Checks.FirstOrDefault(c => c.Id == live.Check)?.Title ?? live.Check) · <code>@live.Folder</code></strong>
                <span class="work-status">@(live.Status switch { "running" => "Besig", "done" => "Klaar", _ => "Misluk" })</span>
            </div>
            <p class="muted">@live.Repeat @(live.Repeat == 1 ? "herhaling" : "herhalings") · begin @live.StartedAt.ToLocalTime().ToString("HH:mm:ss")@(live.ExitCode is { } code && code != 0 ? $" · die skrip het met kode {code} geëindig" : "")</p>

            @if (_events.Count > 0)
            {
                @* The script's structured progress ('@' + JSON per event): a row per turn, a summary row per conversation, a line per mode. *@
                <table class="admin-table run-table">
                    <thead><tr><th>Modus</th><th>Gesprek</th><th>Beurt</th><th>Rol</th><th>Vervolg</th><th class="num">Puls</th><th class="num">Spesialis</th><th>Bronne</th><th class="num">Sek</th></tr></thead>
                    <tbody>
                        @foreach (var e in _events)
                        {
                            string kind = Str(e, "event") ?? "";
                            if (kind == "turn")
                            {
                                <tr class="@(Str(e, "error") is not null ? "failed" : "")" title="@Str(e, "question")">
                                    <td>@Str(e, "mode")</td>
                                    <td><code>@Str(e, "task")</code></td>
                                    <td class="num">@Str(e, "turn")</td>
                                    <td>@(Str(e, "role") ?? (Str(e, "continued") is null ? "Puls self" : ""))</td>
                                    <td>@(Str(e, "continued") is { } h ? $"vervolg · {h}" : "")</td>
                                    <td class="num">@Str(e, "puls_calls")</td>
                                    <td class="num">@Str(e, "specialist_calls")</td>
                                    <td class="hosts">@Hosts(e)</td>
                                    <td class="num">@Str(e, "seconds")</td>
                                </tr>
                            }
                            else if (kind == "conversation")
                            {
                                <tr class="summary">
                                    <td>@Str(e, "mode")</td>
                                    <td><code>@Str(e, "task")</code></td>
                                    <td class="num">Σ</td>
                                    <td>@(Str(e, "role") ?? "Puls self") @(Bool(e, "routed_right") ? "✓" : "✗")</td>
                                    <td>@(Str(e, "follow_up") ?? "—")</td>
                                    <td class="num" colspan="2">R-bedrae @Str(e, "rand_amounts") · onbevestig @Str(e, "unconfirmed_marks")</td>
                                    <td class="hosts">winkels @Count(e, "shop_hosts") / @Count(e, "hosts")@(Bool(e, "sources_local") ? " · net SA" : "")</td>
                                    <td class="num">@Str(e, "seconds")</td>
                                </tr>
                            }
                            else if (kind == "mode_done")
                            {
                                <tr class="mode"><td colspan="9"><strong>@Str(e, "mode")</strong>: @Cost(Dec(e, "cost")) · @Str(e, "tokens") tokens · @Str(e, "requests") versoeke</td></tr>
                            }
                            else if (kind == "mode")
                            {
                                <tr class="mode"><td colspan="9"><strong>@Str(e, "mode")</strong> begin: @Str(e, "conversations") gesprekke met @Hosts(e, "toolsets")</td></tr>
                            }
                        }
                    </tbody>
                </table>
            }
            @{
                // When the run ends the script prints its report (markdown, from its first heading): rendered, not raw.
                int report = live.Status == "running" ? -1 : _log.FindIndex(l => l.StartsWith("# "));
                var plain = report < 0 ? _log : _log.Take(report).ToList();
            }
            @if (report >= 0)
            {
                <div class="markdown admin-markdown run-report">@Markdown.ToHtml(string.Join("\n", _log.Skip(report)))</div>
            }
            <details class="admin-details" open="@(_events.Count == 0 && report < 0)"><summary>Die skrip se eie reëls (@plain.Count)</summary><pre class="admin-pre run-log">@string.Join("\n", plain)</pre></details>
        </section>
    }

    @if (_open is { } open)
    {
        <section class="card-p">
            <div class="card-head"><strong>@open.Run.Folder</strong><span class="muted">@Cost(open.Run.Cost)</span></div>
            @if (open.Summary is { } summary)
            {
                <div class="markdown admin-markdown">@Markdown.ToHtml(summary)</div>
            }
            @if (open.Readme is { } readme)
            {
                <details class="admin-details"><summary>README</summary><div class="markdown admin-markdown">@Markdown.ToHtml(readme)</div></details>
            }
            @* The conversations themselves: the questions sent, the calls, and the answers, one transcript per mode. *@
            @foreach (var transcript in open.Transcripts)
            {
                <details class="admin-details"><summary>Gesprekke · @transcript.Name</summary><div class="markdown admin-markdown run-transcript">@Markdown.ToHtml(transcript.Markdown)</div></details>
            }
            @if (open.Results is { } results)
            {
                <details class="admin-details"><summary>Die syfers (JSON)</summary><pre class="admin-pre">@results</pre></details>
            }
        </section>
    }
  </div>

  <aside class="admin-col-side">
    <section class="card-p runs-list">
        <div class="card-head"><strong>Gestoorde lopies</strong><span class="muted">@data.Runs.Count</span></div>
        @if (data.Runs.Count == 0)
        {
            <p class="muted">Niks onder <code>samples/</code> met 'n <code>summary.json</code> of <code>results.json</code> nie.</p>
        }
        else
        {
            <ol class="runs">
                @foreach (var run in data.Runs)
                {
                    <li class="run-row @(run.Folder == _open?.Run.Folder ? "selected" : "")" @onclick="() => OpenAsync(run.Folder)" title="@run.Folder">
                        <div class="run-row-main">
                            <code>@run.Folder</code>
                            <small>@(data.Checks.FirstOrDefault(c => c.Id == run.Check)?.Title ?? "—") · @run.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @run.Repeats×</small>
                        </div>
                        <strong class="run-row-cost">@Cost(run.Cost)</strong>
                    </li>
                }
            </ol>
        }
    </section>
  </aside>
  </div>
}

@code {
    private sealed record Check(string Id, string Title, string Script);
    private sealed record Run(string Folder, string? Check, DateTimeOffset SavedAt, int Repeats, decimal? Cost);
    private sealed record Page(List<Check> Checks, List<Run> Runs);
    private sealed record Transcript(string Name, string Markdown);
    private sealed record Opened(Run Run, string? Summary, string? Readme, string? Results, List<Transcript> Transcripts);
    private sealed record LiveRun(string Id, string Check, string Folder, int Repeat, string Status, int? ExitCode, DateTimeOffset StartedAt);

    private Page? _data;
    private Opened? _open;
    private LiveRun? _run;
    private readonly List<string> _log = [];
    private readonly List<JsonElement> _events = [];

    private static string? Str(JsonElement e, string name) =>
        e.TryGetProperty(name, out var v) ? v.ValueKind switch
        {
            JsonValueKind.String => v.GetString(),
            JsonValueKind.Number => v.GetRawText(),
            JsonValueKind.True => "ja",
            JsonValueKind.False => "nee",
            _ => null,
        } : null;

    private static bool Bool(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.True;

    private static int Count(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Array ? v.GetArrayLength() : 0;

    private static string Hosts(JsonElement e, string name = "hosts") =>
        e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Array ? string.Join(", ", v.EnumerateArray().Select(h => h.GetString())) : "";
    private string? _error;
    private bool _needsKey, _loading;
    private string _keyDraft = "";
    private int _repeat = 1;

    private bool Running => _run?.Status == "running";

    protected override async Task OnInitializedAsync()
    {
        // The key lives in the browser's storage; the chat page loads the store, but /admin can be opened directly.
        if (!Store.Loaded) await Store.LoadAsync();
        // Costs in the browser's currency (F14), as everywhere in Puls; the ledger's are USD.
        Currency.Changed += StateHasChanged;
        await Currency.LoadAsync();
        await LoadAsync();
        await ResumeAsync();
    }

    public void Dispose() => Currency.Changed -= StateHasChanged;

    private static decimal? Dec(JsonElement e, string name) =>
        e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : null;

    /// <summary>A run started before this page opened (a reload): pick it up and follow it.</summary>
    private async Task ResumeAsync()
    {
        if (_data is null) return;
        try
        {
            var current = ReadLive(await Api.GetAsync<JsonElement>("admin/benchmarks/runs/current"));
            if (current.Status == "running") await FollowAsync(current);
        }
        catch (AgentApiException ex) when (ex.Status == HttpStatusCode.NotFound)
        {
            // No run yet.
        }
    }

    private async Task StartAsync(string check)
    {
        _error = null;
        try
        {
            var started = ReadLive(await Api.PostAsync($"admin/benchmarks/{check}/runs", new { repeat = _repeat }));
            await FollowAsync(started);
        }
        catch (AgentApiException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Shows the run's lines as they arrive; when it ends, lists it among the saved runs and opens it.</summary>
    private async Task FollowAsync(LiveRun run)
    {
        _run = run;
        _log.Clear();
        _events.Clear();
        StateHasChanged();
        try
        {
            await foreach (var (type, line) in Api.StreamLinesAsync($"admin/benchmarks/runs/{run.Id}/events"))
            {
                if (type == "done")
                {
                    _run = ReadLive(JsonDocument.Parse(line).RootElement);
                    break;
                }
                if (line.StartsWith('@') && TryParse(line[1..], out var e)) _events.Add(e);
                else _log.Add(line);
                StateHasChanged();
            }
        }
        catch (AgentApiException ex)
        {
            _error = ex.Message;
            return;
        }
        await LoadAsync();
        if (_run?.Status == "done") await OpenAsync(_run.Folder);
    }

    private static bool TryParse(string json, out JsonElement element)
    {
        try
        {
            element = JsonDocument.Parse(json).RootElement.Clone();
            return element.ValueKind == JsonValueKind.Object;
        }
        catch (JsonException)
        {
            element = default;
            return false;
        }
    }

    private static LiveRun ReadLive(JsonElement r) => new(
        r.GetProperty("id").GetString()!, r.GetProperty("check").GetString()!, r.GetProperty("folder").GetString()!,
        r.GetProperty("repeat").GetInt32(), r.GetProperty("status").GetString()!,
        r.TryGetProperty("exit_code", out var e) && e.ValueKind == JsonValueKind.Number ? e.GetInt32() : null,
        r.GetProperty("started_at").GetDateTimeOffset());

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var json = await Api.GetAsync<JsonElement>("admin/benchmarks");
            _data = new Page(
                json.GetProperty("checks").EnumerateArray().Select(c => new Check(c.GetProperty("id").GetString()!, c.GetProperty("title").GetString()!, c.GetProperty("script").GetString()!)).ToList(),
                json.GetProperty("runs").EnumerateArray().Select(ReadRun).ToList());
        }
        catch (AgentApiException ex)
        {
            _needsKey = ex.Status is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden;
            _error = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private static Run ReadRun(JsonElement r) => new(
        r.GetProperty("folder").GetString()!,
        r.TryGetProperty("check", out var c) && c.ValueKind == JsonValueKind.String ? c.GetString() : null,
        r.GetProperty("saved_at").GetDateTimeOffset(),
        r.GetProperty("repeats").GetInt32(),
        r.TryGetProperty("cost", out var cost) && cost.ValueKind == JsonValueKind.Number ? cost.GetDecimal() : null);

    private async Task OpenAsync(string folder)
    {
        try
        {
            var json = await Api.GetAsync<JsonElement>($"admin/benchmarks/runs/{Uri.EscapeDataString(folder)}");
            var transcripts = json.TryGetProperty("transcripts", out var ts) && ts.ValueKind == JsonValueKind.Array
                ? ts.EnumerateArray().Select(t => new Transcript(t.GetProperty("name").GetString()!, t.GetProperty("markdown").GetString() ?? "")).ToList()
                : [];
            _open = new Opened(ReadRun(json.GetProperty("run")), Text(json, "summary"), Text(json, "readme"), Text(json, "results"), transcripts);
        }
        catch (AgentApiException ex)
        {
            _error = ex.Message;
        }
    }

    private static string? Text(JsonElement json, string name) =>
        json.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

    private async Task SaveKeyAsync()
    {
        await Store.SaveApiKeyAsync(_keyDraft);
        _keyDraft = "";
        await LoadAsync();
    }

    // The checks' costs are USD in the ledger; shown in the browser's currency at the app's rate (F14), as the chat does.
    private string Cost(decimal? cost) => cost is { } c ? UsageFormat.Money(c, "USD", Currency.Current) : "—";
}

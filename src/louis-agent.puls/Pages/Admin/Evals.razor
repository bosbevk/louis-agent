@page "/admin/evals"
@layout AdminLayout
@implements IDisposable

@* F18 step 7b (i): every eval the runner's catalogue has, from GET /v1/admin/evals; one that never ran is listed as
   never run, not hidden. F53.2: list and details: the list pane names every eval with its last result, the details
   pane holds the chosen one (the eval in the address, `?eval=`; none opens the eval that ran last). *@

<PageTitle>Evals · Puls Admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Evals</h1>
        <p>Every eval the runner has: what it proves, how it is graded, and every run the store kept.</p>
    </div>
    <div class="page-actions">
        <button class="header-button" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Reload</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

@if (_loading && _data is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else if (_data is { } data)
{
    <StoreBanner Store="data.Store" />

    <div class="eval-split">
        <EvalList Evals="EvalListView.Of(data).Evals" Selected="@Chosen?.Name" />
        @if (Chosen is { } chosen)
        {
            <EvalDetails Eval="chosen" Currency="Currency.Current" OnChanged="LoadAsync" />
        }
    </div>
}

{
  "kind": "sequence",
  "title": "The framework's two sites in Azure: a secret's path",
  "caption": "A value goes from a git-ignored file on the PC into the vault; the release writes only references to it, and the app reads each one with the shared identity.",
  "sequence": {
    "participants": [
      { "id": "pc", "label": "Louis's PC", "actor": true, "tone": "blue" },
      { "id": "script", "label": "deploy.ps1", "icon": "terminal", "tone": "violet" },
      { "id": "vault", "label": "puls-keys", "icon": "shield", "tone": "amber" },
      { "id": "app", "label": "The app", "icon": "server", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "pc", "to": "script", "text": "secrets -App: the app's own secrets file" },
      { "step": "message", "from": "script", "to": "vault", "text": "one secret per value, its own suffixed" },
      { "step": "message", "from": "script", "to": "vault", "text": "update: which names exist?" },
      { "step": "reply", "from": "vault", "to": "script", "text": "the names, never a value" },
      { "step": "message", "from": "script", "to": "app", "text": "a secrets block of keyVaultUrl references" },
      { "step": "message", "from": "app", "to": "vault", "text": "each reference, with louis-agent-app-identity" },
      { "step": "reply", "from": "vault", "to": "app", "text": "the value, held while the revision runs" }
    ]
  }
}

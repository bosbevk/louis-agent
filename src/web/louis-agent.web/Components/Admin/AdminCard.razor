@* One area's card on the admin's home (F144): its title, what the area puts in it, and the way to its pages. *@

<section class="card-p admin-card">
    <h2 class="admin-card-title">@Title</h2>
    <div class="admin-card-body">@ChildContent</div>
    <a class="admin-card-open" href="@Open">Open →</a>
</section>

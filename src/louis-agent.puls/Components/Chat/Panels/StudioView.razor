@* Studio (F20): your recent chats as projects, and the starters as templates with a category filter (Preline's Studio).
   Projects of their own are to come. *@
<div class="page-view">
    <header class="page-head">
        <span class="eyebrow">Studio</span>
        <h1>Jou werkruimte</h1>
        <p>Jou onlangse gesprekke, en sjablone om groter take mee te begin.</p>
    </header>

    <section class="page-section">
        <h2>Onlangse projekte</h2>
        <div class="project-grid">
            <button class="project-card project-new" type="button" @onclick="OnNewProject">
                <span class="ic i-plus" aria-hidden="true"></span>
                <strong>Nuwe projek</strong>
            </button>
            @foreach (var chat in Recent)
            {
                <a class="project-card" href="gesels/@chat.SessionId">
                    <span class="ic i-chat" aria-hidden="true"></span>
                    <strong>@chat.Title</strong>
                    <small>@Ago(chat.UpdatedAt)</small>
                </a>
            }
        </div>
    </section>

    <section class="page-section">
        <h2>Sjablone</h2>
        <nav class="page-tabs">
            <button type="button" class="@(_category is null ? "active" : "")" @onclick="() => _category = null">Alles</button>
            @foreach (string category in Templates.Categories)
            {
                <button type="button" class="@(_category == category ? "active" : "")" @onclick="() => _category = category">@category</button>
            }
        </nav>
        <div class="template-grid">
            @foreach (var template in Templates.All.Where(t => _category is null || t.Category == _category))
            {
                <TemplateCard Template="template" OnStart="OnStart" />
            }
        </div>
    </section>
</div>

@* An eval's runs, newest first: when, its outcome, its repeats, its cost from the ledger and each mode's rates. A run
   opens its own page. *@

<div class="table-wrap">
    <table class="run-table eval-runs">
        <thead>
            <tr><th>Run</th><th>Started</th><th>Outcome</th><th>Repeats</th><th class="num">Cost</th><th>Rates</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Runs)
            {
                <tr>
                    <td><a href="admin/benchmarks/@row.Run.Id"><code>@RunText.Short(row.Run.Id)</code></a></td>
                    <td>@row.Run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="status-pill @RunText.Status(row.Run.Status)">@RunText.Status(row.Run.Status)</span></td>
                    <td>@RunText.Repeats(row.Run.Repeat)</td>
                    <td class="num">@RunText.Money(row.Run.Total?.Cost, Currency)</td>
                    <td>
                        @foreach (var mode in row.Modes)
                        {
                            <span class="eval-rate">@EvalText.Rates(mode)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* A diagram drawn from data (F111): the boxes and arrows of a GraphSpec as one SVG that scales to its box. The root
   carries reveal, so the frame's module adds .in when it enters and the styles beside this file make the arrows draw
   themselves and the boxes rise, column by column, once. Fully drawn at rest, so a page with no module still reads. *@

<figure class="graph reveal" role="img" aria-label="@Title">
    <svg viewBox="@ViewBox" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <marker id="@ArrowId" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                <path class="arrow" d="M 0 0 L 10 5 L 0 10 z" />
            </marker>
        </defs>
        @foreach (var edge in Placed.Edges)
        {
            <path class="edge" d="@edge.Path" style="@EdgeStyle(edge)" marker-end="@ArrowRef" />
        }
        @* A word stands on its own line, on a ground that hides the line behind it. Every word is drawn after every
           line, so none runs over a word. *@
        @foreach (var edge in Placed.Edges.Where(edge => edge.Edge.Word is not null))
        {
            @WordGround(edge)
            @Word(edge, edge.Edge.Word!)
        }
        @foreach (var node in Placed.Nodes)
        {
            <g class="node" transform="@Translate(node)" style="@NodeStyle(node)">
                @if (Outline(node) is { } outline)
                {
                    <path d="@outline" />
                }
                else
                {
                    <rect width="@N(node.W)" height="@N(node.H)" rx="@Corner(node)" />
                }
                @Label(node)
                @if (node.Node.Note is { } note)
                {
                    @Note(node, note)
                }
            </g>
        }
    </svg>
    <figcaption>@Title</figcaption>
</figure>

@page "/admin/evals/{Eval}/runs/{Run}/{Conversation}"
@page "/admin/evals/{Eval}/runs/{Run}/{Conversation}/{Repeat:int}"
@layout AdminFrame

@* A conversation's page (F126.3.2): one repeat at a time, turn by turn, with a switch to pick the repeat and the
   repeat's own figures under its turns. Previous and Next failed walk the run in its page's order, and one link opens
   the same conversation in the run before. A criterion's mark is flipped where it stands (F126.4), and the run read
   again. A run or a conversation the host doesn't have is one line. *@

<PageTitle>@Conversation · Admin</PageTitle>

<nav class="conversation-crumbs" aria-label="Breadcrumb"><a href="@EvalAddress.EvalsPage">Evals</a> / @Eval / <a href="@RunPage">@if (_run is { } read)
    {
        <span>run of @EvalsWords.FormatLocal(read.StartedAt)</span>
    }
    else
    {
        @Run
    }</a></nav>

<div class="page-head">
    <div>
        <h1>@Conversation</h1>
        @if (Held is { } held && Open is { } open)
        {
            <p>@HeadOf(held, open)</p>
        }
    </div>
    <div class="page-actions">
        @if (Previous is { } previous)
        {
            <a class="header-button conversation-previous" href="@PageOf(previous)">@Word(EvalsPart.Previous)</a>
        }
        @if (Next is { } next)
        {
            <a class="header-button conversation-next" href="@PageOf(next)">@Word(EvalsPart.NextFailed)</a>
        }
        <button class="header-button conversation-reload" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>@Word(EvalsPart.Reload)</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync"/>
}

@if (_refused is { } refused)
{
    <p class="conversation-refused text-danger">@refused</p>
}

@if (_missing)
{
    <section class="card-p conversation-missing">@EvalsWords.Fill(EvalsPart.NoRun, Run)</section>
}
else if (_loading && _run is null)
{
    <section class="card-p conversation-loading"><span class="muted">Loading…</span></section>
}
else if (_run is not null && Held is null)
{
    <section class="card-p conversation-missing">@EvalsWords.Fill(EvalsPart.NoConversation, Conversation)</section>
}
else if (Held is not null && Open is null)
{
    <section class="card-p conversation-missing">@EvalsWords.Fill(EvalsPart.NoRepeat, Repeat ?? 0)</section>
}
else if (Held is { } conversation && Open is { } repeat)
{
    @if (conversation.Repeats.Count > 1)
    {
        <RepeatSwitch Eval="@Eval" Run="@Run" Conversation="conversation" Open="repeat.Number"/>
    }

    @foreach (var (turn, number) in repeat.Turns.Select((turn, at) => (turn, at + 1)))
    {
        <TurnCard @key="number" Number="number" Turn="turn" Run="@Run" Conversation="@Conversation" Repeat="repeat.Number" OnFlip="FlipAsync" OnUndo="UndoFlipAsync" History="History"/>
    }

    @if (Before is { } before)
    {
        <p class="mb-3"><a class="conversation-before" href="@BeforePageOf(before)">@Word(EvalsPart.InTheRunBefore)</a></p>
    }

    <section class="card-p conversation-repeat">
        <h2>@Word(EvalsPart.ThisRepeat)</h2>
        <RunFigures>
            <RunFigure Name="@Word(EvalsPart.Took)">@EvalsWords.FormatTime(repeat.SumTime())</RunFigure>
            <RunFigure Name="@Word(EvalsPart.AgentCostName)">@Cost</RunFigure>
            <RunFigure Name="@Word(EvalsPart.FactsMet)">@MetOf(repeat.CountFacts())</RunFigure>
            <RunFigure Name="@Word(EvalsPart.CriteriaMet)">@MetOf(repeat.CountCriteria())</RunFigure>
            @if (repeat.CountFlips() > 0)
            {
                <RunFigure Name="@Word(EvalsPart.YourFlips)"><span class="conversation-flips">@repeat.CountFlips()</span></RunFigure>
            }
        </RunFigures>
    </section>
}

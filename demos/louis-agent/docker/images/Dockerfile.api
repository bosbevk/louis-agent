FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# The commit the runner stamps on every run's first line (F18 step 2a): the compose file passes EVAL_COMMIT; "unknown" when it is not set.
ARG EVAL_COMMIT=unknown
WORKDIR /src
COPY . .
RUN dotnet publish "demos/louis-agent/hosts/louis-agent.coding-api/louis-agent.coding-api.csproj" -c Release -o /app/publish
# The eval runner (F18 step 4.3) publishes to its own folder: it ships its own copies of core and the session-stream reader,
# and beside the API's they would overwrite each other.
RUN dotnet publish "demos/louis-agent/hosts/louis-agent.coding-eval-runner/louis-agent.coding-eval-runner.csproj" -c Release -p:EvalCommit=$EVAL_COMMIT -o /app/evals-publish

# The SDK image is kept for the final stage because the RunDotNet workspace tool shells out to `dotnet build/test`.
FROM mcr.microsoft.com/dotnet/sdk:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl bc git python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish/ .
# The C# evals (F18): the API lists them with `dotnet /app/evals/louis-agent.coding-eval-runner.dll --list` and starts one with `run`.
COPY --from=build /app/evals-publish/ /app/evals/
ENV EVAL_RUNNER=/app/evals/louis-agent.coding-eval-runner.dll
# The docs the expert reads (F109.3), laid out as the repo lays them so their links hold: the framework's, each demo's
# and the packs', with the repo's own front page; the films are pictures the guide never reads, and 20 MB.
COPY --from=build /src/README.md /src/ROADMAP.md /src/TODO.md /app/docs/
COPY --from=build /src/src/docs/ /app/docs/src/docs/
COPY --from=build /src/demos/louis-agent/docs/ /app/docs/demos/louis-agent/docs/
COPY --from=build /src/demos/puls/docs/ /app/docs/demos/puls/docs/
COPY --from=build /src/packs/docs/ /app/docs/packs/docs/
RUN rm -rf /app/docs/src/docs/films
ENV DOCS_ROOT=/app/docs
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fs http://localhost:8080/health || exit 1
ENTRYPOINT ["dotnet", "louis-agent.coding-api.dll"]

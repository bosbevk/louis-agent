event: content_block_start
data: {"type":"content_block_start","index":15,"content_block":{"type":"tool_result","tool_use_id":"toolu_01FMsQeFBcWwDcVUPimNRS3d","content":"namespace InvoiceMatcher;\n\n/// <summary>Matches the bank's payments to our invoices: the invoice number in the reference, and the full amount.</summary>\npublic static class Matcher\n{\n    /// <summary>Each payment that names an invoice and pays it in full is matched; the rest are left for a person.</summary>\n    public static MatchResult Match(IReadOnlyList<Invoice> invoices, IEnumerable<Payment> payments)\n    {\n        var matched = new List<Match>();\n        var unmatched = new List<Payment>();\n        foreach (var payment in payments)\n        {\n            var invoice = invoices.FirstOrDefault(invoice =>\n                payment.Reference.Contains(invoice.Number) && invoice.Amount == payment.Amount);\n            if (invoice is null)\n            {\n                unmatched.Add(payment);\n                continue;\n            }\n\n            matched.Add(new Match(invoice, payment));\n        }\n\n        return new MatchResult(matched, unmatched);\n    }\n}\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":15}

event: content_block_start
data: {"type":"content_block_start","index":16,"content_block":{"type":"tool_result","tool_use_id":"toolu_0134CAxM4UQNDdYvb4TaudzB","content":"namespace InvoiceMatcher;\n\n/// <summary>An invoice we sent: its number, who it is for and what they owe.</summary>\npublic sealed record Invoice(string Number, string Customer, decimal Amount);\n\n/// <summary>A payment from the bank statement: the reference the customer typed, and the amount.</summary>\npublic sealed record Payment(string Reference, decimal Amount);\n\n/// <summary>A payment and the invoice it pays.</summary>\npublic sealed record Match(Invoice Invoice, Payment Payment);\n\n/// <summary>What matched, and the payments left for a person to look at.</summary>\npublic sealed record MatchResult(IReadOnlyList<Match> Matched, IReadOnlyList<Payment> Unmatched);\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":16}

event: content_block_start
data: {"type":"content_block_start","index":17,"content_block":{"type":"tool_result","tool_use_id":"toolu_015e5dBPEH7c7ar1eMLkyeDu","content":"namespace InvoiceMatcher.Tests;\n\n/// <summary>How the bank's payments find their invoices, with references the way customers really type them.</summary>\npublic class MatcherTests\n{\n    private static readonly Invoice Acme = new(\"INV-1042\", \"Acme Plumbing\", 1250.00m);\n    private static readonly Invoice Karoo = new(\"INV-104\", \"Karoo Farm Stall\", 1250.00m);\n\n    /// <summary>A reference that names the invoice and pays it in full matches.</summary>\n    [Test]\n    public void AnExactReference_Matches()\n    {\n        var result = Matcher.Match([Acme], [new Payment(\"INV-1042\", 1250.00m)]);\n\n        Assert.That(result.Matched.Single().Invoice, Is.EqualTo(Acme));\n    }\n\n    /// <summary>A payment short of the invoice is left for a person.</summary>\n    [Test]\n    public void APartPayment_IsLeftForAPerson()\n    {\n        var result = Matcher.Match([Acme], [new Payment(\"INV-1042\", 1000.00m)]);\n\n        Assert.That(result.Unmatched, Has.Count.EqualTo(1));\n    }\n\n    /// <summary>Customers type the number in lower case, with words around it.</summary>\n    [Test]\n    public void ALowerCaseReference_StillMatches()\n    {\n        var result = Matcher.Match([Acme], [new Payment(\"acme inv-1042 thanks\", 1250.00m)]);\n\n        Assert.That(result.Matched.Single().Invoice, Is.EqualTo(Acme));\n    }\n\n    /// <summary>One invoice number inside a longer one is a different invoice.</summary>\n    [Test]\n    public void AShorterNumber_DoesNotTakeALongerOnesPayment()\n    {\n        var result = Matcher.Match([Karoo, Acme], [new Payment(\"INV-1042\", 1250.00m)]);\n\n        Assert.That(result.Matched.Single().Invoice, Is.EqualTo(Acme));\n    }\n}\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":17}


<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Puls: the general assistant's web app (chat only). louis-agent.api serves it instead of louis-agent.web when built
       with -p:WebApp=puls (docker/images/Dockerfile.puls). -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Puls</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\louis-agent.web.shared\louis-agent.web.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.puls.md" Link="docs\louis-agent.puls.md" />
    <None Include="..\..\docs\guides\change-the-puls-app.md" Link="docs\change-the-puls-app.md" />
  </ItemGroup>

</Project>

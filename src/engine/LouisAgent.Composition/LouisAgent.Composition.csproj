<Project Sdk="Microsoft.NET.Sdk">

  <!-- What everything agrees on (CL29): the contracts a pack, an identity and the engine share. It names no pack and no
       identity, and references only the small enum-name package and abstractions, so a tool author takes it and nothing
       else comes along. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Composition</RootNamespace>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LouisAgent.Choices\LouisAgent.Choices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LouisAgent.Core.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Core.Web.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Packs.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
    <!-- The embedded provider every identity and pack reads its prompts through (EmbeddedPrompts, F129). -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Where to buy (F50.2, ADR 0027, 0028, 0069): a shop's branches near the user's town from OpenStreetMap's
       Nominatim. It took the place of the shops pack. References core alone; the rules that prove it are the project
       beside it, louis-agent.pack.where-to-buy.checks (ADR 0073). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.WhereToBuy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, toolsets/where-to-buy.md is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.where-to-buy.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.where-to-buy.md" Link="docs\louis-agent.pack.where-to-buy.md" />
    <None Include="..\..\..\src\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

@page "/admin/review"
@layout AdminFrame
@implements IDisposable

@* F53.3: grading as one job. The answers waiting for this reviewer, from the queue the API keeps, one at a time:
   where it is from, then the blind review panel; a grade opens the next, Skip moves on. *@

<PageTitle>Review · Admin</PageTitle>

@* The keys 1, 2 and 3 grade the open answer: the page listens on its own box, which takes the focus when an answer
   opens; the panel's note and name fields keep their keys to themselves (stopPropagation), so typing never grades. *@
<div class="review-page" tabindex="-1" @ref="_box" @onkeydown="KeyAsync">
<div class="page-head">
    <div>
        <h1>Review</h1>
        <p>The answers waiting for your grade, one at a time: pass, fail or unsure, and the next one opens.</p>
    </div>
    <div class="page-actions">
        @if (_view is { } progress)
        {
            <span class="review-progress">@ReviewQueueText.Progress(progress)</span>
        }
        <button class="header-button" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Reload</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync" />
}

@if (_loading && _view is null)
{
    <section class="card-p"><span class="muted">Loading…</span></section>
}
else if (_view?.Current is { } item)
{
    <section class="card-p review-item" @key="Key(item)">
        <ReviewItemHead Item="item" Place="@ReviewQueueText.Place(_view)" OnSkip="SkipAsync" />
        <ReviewPanel @ref="_panel" Conversation="Where(item)" Review="ReviewOf(item)" Asked="item.Asked" Answer="@item.Answer"
                     Grades="ConversationGrades.Of(item.Conversation)" OnGraded="GradedAsync" />
    </section>
}
else if (_view is not null)
{
    <section class="card-p review-empty"><p>@ReviewQueueText.Empty(Reviewer.Name)</p></section>
}
</div>

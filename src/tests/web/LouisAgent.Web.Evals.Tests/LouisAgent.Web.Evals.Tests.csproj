<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- F126.3.2: the eval pages' tests. The client and the addresses with plain NUnit, the pages and their parts with
       bUnit over a stub of the API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Web.Evals.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <!-- F126.3.4: the run page's timer is tested on a clock the test moves (Louis's pick, 2026-11-23). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\web\LouisAgent.Web.Evals\LouisAgent.Web.Evals.csproj" />
    <!-- The web pages' test helpers, as the admin pages' tests use them. -->
    <ProjectReference Include="..\LouisAgent.Web.Testing\LouisAgent.Web.Testing.csproj" />
    <!-- The stub handler and the repo paths the test projects share; no test project references another. -->
    <ProjectReference Include="..\..\shared\LouisAgent.Testing\LouisAgent.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\..\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

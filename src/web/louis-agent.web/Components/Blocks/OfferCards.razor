@* Choices the agent offered (F127.4.1): the question, then a card per choice the visitor clicks to send its label, or
   (FX147) writes in, when the choice holds a box; once answered, the cards fold to the one chosen, showing what was
   written in it, or away when the visitor wrote their own answer. *@
@inject ChatText Text

<div class="offer">
    <div class="offer-question">@Offer.Question</div>
    @foreach (var choice in Shown)
    {
        @if (Answer is null && choice.Writes is not null)
        {
            <OfferBox Choice="choice" Question="@Offer.Question" Waiting="Waiting" Sent="Chosen"/>
        }
        else if (Answer is null)
        {
            <button class="offer-card @(choice.Suggested ? "is-suggested" : "")" type="button" disabled="@Waiting"
                    @onclick="() => Chosen.InvokeAsync(choice.Label)">
                <span class="offer-label">@choice.Label</span>
                @if (choice.Why is not null)
                {
                    <span class="offer-why">@choice.Why</span>
                }
                @if (choice.Suggested)
                {
                    <span class="offer-tag">@Text.Suggested</span>
                }
            </button>
        }
        else
        {
            <div class="offer-card is-chosen"><span class="offer-label">@ChosenWords(choice)</span></div>
        }
    }
</div>

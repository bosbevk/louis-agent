<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Evals</RootNamespace>
    <!-- Not a package yet (ADR 0130): no product outside this repository reads an eval before F171.4. -->
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LouisAgent.Evals.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Evals.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- F126.2: the evals stand on the engine alone, for the model client, an agent's address and the ledger's
         scope; no pack and no identity knows them (ADR 0134). -->
    <ProjectReference Include="..\..\engine\LouisAgent.Core\LouisAgent.Core.csproj" />
    <!-- F126.3.1: the records of a run, which a page in the browser reads too. -->
    <ProjectReference Include="..\LouisAgent.Evals.Contracts\LouisAgent.Evals.Contracts.csproj" />
    <!-- F126.3.1: the API's error record, so a refusal is read as the API writes it; it references nothing. -->
    <ProjectReference Include="..\..\hosts\LouisAgent.Api.Contracts\LouisAgent.Api.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc, shown under docs/ in the IDE's solution explorer; nothing is built or copied. -->
    <None Include="..\..\docs\projects\LouisAgent.Evals.md" Link="docs\LouisAgent.Evals.md" />
  </ItemGroup>

</Project>

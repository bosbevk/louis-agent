<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- What both web apps share (louis-agent.web for code review, louis-agent.puls for the general assistant): the chat
       models, the API client's core, the turn view (with the delegation card), markdown, usage and currency. Each app keeps
       its own pages, look (CSS) and JavaScript; the shared components only emit class names. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Web.Shared</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 1b: the web apps read the session stream through the one reader (CL11). -->
    <ProjectReference Include="..\..\louis-agent.session-stream\louis-agent.session-stream.csproj" />
    <!-- F18 step 7.5.2: the browser parses and writes wire names too, through the same parser as the server. -->
    <ProjectReference Include="..\..\louis-agent.choices\louis-agent.choices.csproj" />
    <!-- The API's replies as records (ADR 0045): the client reads what the API writes, never a JSON picked apart. -->
    <ProjectReference Include="..\louis-agent.api.contracts\louis-agent.api.contracts.csproj" />
    <!-- F18 step 7c.3 (decision A): the eval protocol's kinds, so the portal reads a grader's kind by its wire name. -->
    <ProjectReference Include="..\..\evals\louis-agent.evals.protocol\louis-agent.evals.protocol.csproj" />

    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.web.shared.md" Link="docs\louis-agent.web.shared.md" />
    <None Include="..\..\docs\guides\change-the-web-shared.md" Link="docs\change-the-web-shared.md" />
  </ItemGroup>

</Project>

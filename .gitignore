# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# .NET / NuGet
*.user
*.suo
*.userosscache
*.sln.docstates
*.pidb
*.svclog
*.pdb
*.cache
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / IntelliJ
.idea/
.idea/**
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# What a demo's running stack keeps (F31: puls-mongo's data folder); a folder named data elsewhere is code's
/demos/*/data/

# Secrets and local configuration, in any demo's config/ (see its .env.secrets.example)
**/config/.env
**/config/.env.secrets
**/config/.env.mongo
**/config/.env.searxng
**/config/.env.secrets.local
**/config/.env.local

# Agent-built tools and skill files awaiting /approve (approved ones in a demo's skills/ are committed)
**/skills/tools/pending/
**/skills/agent/functions/pending/

# Python bytecode (the sample scripts)
__pycache__/

# What the build makes from a web app's Styles/
demos/puls/web/louis-agent.puls/wwwroot/css/

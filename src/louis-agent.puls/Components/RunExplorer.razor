@* F31 step 10: a stored run as charts you drill into, ported from F27's explorer onto the benchmark store. The modes are
   the columns at every level, in the run's order, so the same conversation, turn and transcript sit side by side
   (Louis, F27): the run (tiles that count up: cost, requests, tokens, seconds, score; cost per conversation as bars
   that grow in a cascade; each mode's token mix as a donut that sweeps); the conversations of each mode (cost split
   between Puls and the specialist, their scores); a conversation's turns on a timeline of model requests; a turn's
   requests and its transcript, replayed from the stored events through the chat's TurnStream, every mode at once; one
   request's record. One repeat at a time. Motion is off for people who ask for less (the explorer's CSS). *@
@using System.Text.Json
@using LouisAgent.Web.Shared
@using LouisAgent.Web.Shared.Services
@inject AgentApi Api
@inject IJSRuntime Js
@implements IDisposable

<div class="explorer">
    @if (_repeats > 1)
    {
        <div class="run-controls">
            <span class="muted">Repeat</span>
            <div class="segmented" role="radiogroup" aria-label="Herhaling">
                @for (int n = 1; n <= _repeats; n++)
                {
                    int r = n;
                    <button type="button" role="radio" aria-checked="@(_repeat == r)" class="@(_repeat == r ? "active" : "")" @onclick="() => ShowRepeat(r)">@r</button>
                }
            </div>
        </div>
    }

    <nav class="crumbs" aria-label="Pad">
        <button type="button" class="crumb @(_level == 0 ? "here" : "")" @onclick="() => Go(0)">Run</button>
        @if (_level >= 1) { <span class="crumb-sep">›</span><button type="button" class="crumb @(_level == 1 ? "here" : "")" @onclick="() => Go(1)">Conversations</button> }
        @if (_level >= 2) { <span class="crumb-sep">›</span><button type="button" class="crumb @(_level == 2 ? "here" : "")" @onclick="() => Go(2)"><code>@_task</code></button> }
        @if (_level >= 3) { <span class="crumb-sep">›</span><button type="button" class="crumb @(_level == 3 ? "here" : "")" @onclick="() => Go(3)">Beurt @_turn</button> }
        @if (_level == 4 && _request is { } rq) { <span class="crumb-sep">›</span><span class="crumb here">@_requestMode?.Name · request at @rq.At.ToLocalTime().ToString("HH:mm:ss")</span> }
        @* Louis: the chats side by side in a modal, Puls alone against Puls with its cook. *@
        <button type="button" class="header-button chat-open" @onclick="() => OpenChatsAsync(_task)"><span class="ic i-chat" aria-hidden="true"></span>Replay conversations</button>
    </nav>

    @if (_chatOpen)
    {
        <div class="search-backdrop" @onclick="CloseChats"></div>
        <div class="search-dialog chats-dialog" id="chats-dialog" role="dialog" aria-modal="true" aria-label="The conversations side by side" tabindex="-1" @onkeydown="ChatsKey">
            <div class="manual-head">
                <strong>The conversations side by side</strong>
                <div class="segmented" role="radiogroup" aria-label="Gesprek">
                    @foreach (string task in Tasks())
                    {
                        string t = task;
                        <button type="button" role="radio" aria-checked="@(_chatTask == t)" class="@(_chatTask == t ? "active" : "")" @onclick="() => OpenChatsAsync(t)">@t</button>
                    }
                </div>
                @if (_chatPlaying) { <span class="muted working">replaying…</span> }
                else { <button type="button" class="header-button" @onclick="() => OpenChatsAsync(_chatTask)"><span class="ic i-pulse" aria-hidden="true"></span>Replay again</button> }
                <kbd>Esc</kbd>
                <button type="button" class="icon" aria-label="Maak toe" @onclick="CloseChats">×</button>
            </div>
            <div class="chats-body compare">
                @foreach (var (m, i) in Columns)
                {
                    <section class="compare-col" style="--i: @i">
                        <h3 class="compare-head"><span class="sw" style="background: @Series(i)"></span>@Who(m) <code class="mode-name">@m.Name</code>
                            <span class="muted">@(m.Conversations.FirstOrDefault(c => c.Task == _chatTask) is { } c ? $"{c.Turns.Count} turns · {Money(c.Cost)}" : "not in this mode")</span></h3>
                        @if (_chats.TryGetValue(m.Name, out var turns))
                        {
                            <div class="xreplay">
                                @foreach (var turn in turns)
                                {
                                    <TurnView Turn="turn" Streaming="@(_chatPlaying && turn == turns[^1])" Currency="Currency" />
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        </div>
    }

    <div class="lvl @(_dir)" @key="LevelKey">
    @if (_level == 0)
    {
        @* Louis: every section rolls up (its head folds it), the overview, the cost per conversation and the charts. *@
        <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Overview</summary>
        <div class="tiles">
            @foreach (var (m, i) in Columns)
            {
                <button type="button" class="tile" style="--i: @i" @onclick="() => Open(() => _level = 1)">
                    <span class="tile-label"><span class="sw" style="background: @Series(i)"></span>@Who(m)<span class="muted">· <code>@m.Name</code> · @string.Join(", ", m.Toolsets)</span></span>
                    <strong class="tile-value" data-count="@Money(m.Cost)">@Money(m.Cost)</strong>
                    <span class="tile-meta">@m.Rows.Count requests · @UsageFormat.Tokens(m.Tokens) tokens · @Secs(m.Seconds) s</span>
                    <span class="tile-meta">score: <strong>@m.Right / @m.Conversations.Count</strong> routed right@(m.Errors > 0 ? $" · {m.Errors} errors" : "")</span>
                    <span class="tile-split"><span class="sw" style="background: @Own"></span>Puls @Money(Part(m.Rows, specialist: false)) <span class="sw" style="background: @Spec"></span>@Roles(m) @Money(Part(m.Rows, specialist: true))</span>
                </button>
            }
        </div>
        </details>

        <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Cost per conversation</summary>
        <section class="chart">
            <div class="chart-head"><span class="legend">@foreach (var (m, i) in Columns) { <span><span class="sw" style="background: @Series(i)"></span>@Who(m)</span> }</span></div>
            @{ var tasks = _modes.SelectMany(m => m.Conversations.Select(c => c.Task)).Distinct().ToList(); decimal top = Math.Max(0.000001m, _modes.SelectMany(m => m.Conversations).Select(c => c.Cost ?? 0m).DefaultIfEmpty(0m).Max()); int row = 0; }
            <div class="xbars">
                @foreach (string task in tasks)
                {
                    @* Louis: the row's buttons say what they do (play the chats, or go into its turns), and the cost pops: a
                       figure of its own per mode, with the mode's dot as in the legend, not a grey label at the bar's end. *@
                    <div class="xbar-row drill" style="--i: @(row++)" title="@Question(task)">
                        <span class="xbar-label"><code>@task</code><small>@Blurb(Question(task))</small></span>
                        <span class="xbar-group">
                            @foreach (var (m, i) in Columns)
                            {
                                var c = m.Conversations.FirstOrDefault(x => x.Task == task);
                                decimal? cost = c?.Cost;
                                <span class="xbar" title="@($"{Who(m)} · {task}: {Money(cost)}")">
                                    <span class="xbar-fill" style="width: @Pct(cost ?? 0, top)%; background: @Series(i)"></span>
                                </span>
                            }
                        </span>
                        <span class="row-costs">
                            @foreach (var (m, i) in Columns)
                            {
                                decimal? cost = m.Conversations.FirstOrDefault(x => x.Task == task)?.Cost;
                                <span class="row-cost small" title="@Who(m)"><span class="sw" style="background: @Series(i)"></span><span data-count="@Money(cost)">@Money(cost)</span></span>
                            }
                        </span>
                        @Actions(task, null)
                    </div>
                }
            </div>
        </section>
        </details>

        <details class="fold" open><summary class="fold-head"><span class="fold-chevron" aria-hidden="true"></span>Per mode</summary>
        @* Louis: the cost per mode beside the tokens per mode. Each mode's bar is split between Puls's own requests and
           the specialist's, against the dearest mode, so the bars compare. *@
        <div class="chart-pair">
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="cost" Title="Cost per mode" /><span class="legend"><span><span class="sw" style="background: @Own"></span>Puls itself</span><span><span class="sw" style="background: @Spec"></span>@Roles()</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        decimal? own = Part(m.Rows, specialist: false), spec = Part(m.Rows, specialist: true);
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([(double)(own ?? 0), (double)(spec ?? 0)], [Own, Spec], [$"Puls {Money(own)}", $"{Roles(m)} {Money(spec)}"], Money(m.Cost), $"{m.Rows.Count} requests")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                        </figure>
                    }
                </div>
            </section>

            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="tokens" Title="Tokens per mode" />@TokenLegend()</div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        <figure class="donut-fig" style="--i: @i">
                            @Donut(m.Rows)
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                        </figure>
                    }
                </div>
            </section>

            @* Louis: a performance graph, the fourth. The model's time per mode, Puls's own requests and the specialist's,
               the seconds a turn took on average in its middle (the turns' wall time, as the run table shows). *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="time" Title="Performance per mode" /><span class="legend"><span><span class="sw" style="background: @Own"></span>Puls itself</span><span><span class="sw" style="background: @Spec"></span>@Roles()</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        double own = m.Rows.Where(r => !r.Specialist).Sum(r => r.DurationMs) / 1000.0, spec = m.Rows.Where(r => r.Specialist).Sum(r => r.DurationMs) / 1000.0;
                        var turns = m.Conversations.SelectMany(c => c.Turns).ToList();
                        string perTurn = turns.Count == 0 ? "—" : $"{Secs(turns.Average(t => t.Seconds))} s";
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([own, spec], [Own, Spec], [$"Puls {Secs(own)} s", $"{Roles(m)} {Secs(spec)} s"], perTurn, "per turn")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                            <small class="muted">model @Secs(own + spec) s · @turns.Count turns</small>
                        </figure>
                    }
                </div>
            </section>

            @* Louis: routing, the ring that was "accuracy" first, kept under its own name: the conversations Puls sent where
               they should go (green) and where they shouldn't (red), the share in its middle. *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="routing" Title="Routing per mode" /><span class="legend"><span><span class="sw" style="background: @Right"></span>routed right</span><span><span class="sw" style="background: @Wrong"></span>wrong</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        int total = m.Conversations.Count, right = m.Right;
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([right, total - right], [Right, Wrong], [$"routed right {right}", $"wrong {total - right}"],
                                total == 0 ? "—" : $"{(double)right / total:0%}", $"{right} / {total}")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                        </figure>
                    }
                </div>
            </section>

            @* Louis: accuracy is the answer, not the routing ("this is not true" of a 100 % ring over a run that priced
               nothing). Where the check lists ingredients (the cook check): each priced with its source (green), guessed
               without one (orange) or unknown (red), the share sourced in its middle, and the meals that came without a
               list under it. A check without ingredients has routing as its accuracy, so no second ring. *@
            @if (_modes.Any(m => Priced(m) is not null))
            {
                <section class="chart">
                    <div class="chart-head"><ChartInfo Topic="accuracy" Title="Accuracy per mode" /><span class="legend"><span><span class="sw" style="background: @Right"></span>sourced</span><span><span class="sw" style="background: @Guess"></span>guessed</span><span><span class="sw" style="background: @Wrong"></span>unknown</span></span></div>
                    <div class="donuts">
                        @foreach (var (m, i) in Columns)
                        {
                            <figure class="donut-fig" style="--i: @i">
                                @if (Priced(m) is { } priced)
                                {
                                    int unknown = priced.Ingredients - priced.Priced - priced.Guessed;
                                    @Ring([priced.Priced, priced.Guessed, unknown], [Right, Guess, Wrong],
                                        [$"sourced {priced.Priced}", $"guessed {priced.Guessed}", $"unknown {unknown}"],
                                        $"{(double)priced.Priced / priced.Ingredients:0%}", $"{priced.Priced} / {priced.Ingredients}")
                                }
                                else
                                {
                                    @Ring([0], [Wrong], ["no list"], "—", "no list")
                                }
                                <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                                @if (Unlisted(m) is > 0 and var none) { <small class="muted">@none @(none == 1 ? "meal" : "meals") without a list</small> }
                            </figure>
                        }
                    </div>
                </section>
            }

            @* Louis: three more, to fill the rows. The cache: the input each mode read from the prompt cache against what it
               sent fresh (F4: the biggest cost lever), the hit share in its middle. *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="cache" Title="Cache per mode" /><span class="legend"><span><span class="sw" style="background: @Series(2)"></span>from the cache</span><span><span class="sw" style="background: @Series(0)"></span>sent fresh</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        long cached = m.Rows.Sum(r => r.CacheRead ?? 0), fresh = m.Rows.Sum(r => (r.Input ?? 0) + (r.CacheWrite ?? 0));
                        long all = cached + fresh;
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([cached, fresh], [Series(2), Series(0)], [$"from the cache {cached:N0}", $"fresh {fresh:N0}"],
                                all == 0 ? "—" : $"{(double)cached / all:0%}", "from the cache")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                        </figure>
                    }
                </div>
            </section>

            @* The tools: calls that worked against those refused or failed (Puls's and the specialist's), the failures in
               its middle and the commonest reason under it, so a run like 11b's (every search refused) shows at a glance. *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="tools" Title="Tools per mode" /><span class="legend"><span><span class="sw" style="background: @Right"></span>worked</span><span><span class="sw" style="background: @Wrong"></span>refused or failed</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        var turns = m.Conversations.SelectMany(c => c.Turns).ToList();
                        int calls = turns.Sum(t => t.ToolCalls), failed = turns.Sum(t => t.ToolsFailed);
                        var topReason = turns.SelectMany(t => t.ToolReasons).GroupBy(r => (r.Tool, r.Reason)).Select(g => (g.Key.Tool, g.Key.Reason, Count: g.Sum(r => r.Count)))
                            .OrderByDescending(r => r.Count).FirstOrDefault();
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([calls - failed, failed], [Right, Wrong], [$"gewerk {calls - failed}", $"geweier {failed}"],
                                calls == 0 ? "—" : failed.ToString(), $"of {calls}")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                            @if (topReason.Count > 0)
                            {
                                <small class="ring-note" title="@topReason.Reason"><strong>@topReason.Tool × @topReason.Count</strong><span class="clamp">@topReason.Reason</span></small>
                            }
                        </figure>
                    }
                </div>
            </section>

            @* Louis: a ninth, to fill the rows. The sources: the sites each mode read pages from (Puls's and the specialist's),
               South African shops, other South African sites and the rest, how many different ones in its middle. *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="sources" Title="Sources per mode" /><span class="legend"><span><span class="sw" style="background: @Right"></span>SA shops</span><span><span class="sw" style="background: @Series(0)"></span>other SA</span><span><span class="sw" style="background: @Other"></span>elsewhere</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        var hosts = m.Conversations.SelectMany(c => c.Turns).SelectMany(t => t.Hosts).Distinct().ToList();
                        int shops = hosts.Count(IsShop), za = hosts.Count(h => h.EndsWith(".za") && !IsShop(h)), rest = hosts.Count - shops - za;
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([shops, za, rest], [Right, Series(0), Other], [$"SA shops {shops}", $"other SA {za}", $"elsewhere {rest}"],
                                hosts.Count.ToString(), hosts.Count == 1 ? "site" : "sites")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                            @if (hosts.Count > 0) { <small class="muted" title="@string.Join(", ", hosts)">@Blurb(string.Join(", ", hosts))</small> }
                        </figure>
                    }
                </div>
            </section>

            @* The value: the cost of conversations that got a real answer (routed right, and where the check lists
               ingredients, at least 80 % of them priced with a source) against the cost of those that didn't, what one
               real answer cost in its middle. *@
            <section class="chart">
                <div class="chart-head"><ChartInfo Topic="value" Title="Value per mode" /><span class="legend"><span><span class="sw" style="background: @Right"></span>with an answer</span><span><span class="sw" style="background: @Wrong"></span>without</span></span></div>
                <div class="donuts">
                    @foreach (var (m, i) in Columns)
                    {
                        var answered = m.Conversations.Where(Answered).ToList();
                        // Unknown stays unknown (ADR 0007): no priced request, no amount; the ring draws what is known.
                        decimal? good = UsageFormat.KnownSum(answered.Select(c => c.Cost)), bad = m.Cost - (good ?? 0);
                        <figure class="donut-fig" style="--i: @i">
                            @Ring([(double)(good ?? 0), (double)(bad ?? 0)], [Right, Wrong], [$"with an answer {Money(good)}", $"without {Money(bad)}"],
                                answered.Count == 0 ? "—" : Money(good / answered.Count), answered.Count == 0 ? "no answer" : "per answer")
                            <figcaption><span class="sw" style="background: @Series(i)"></span>@Who(m)</figcaption>
                            <small class="muted">@answered.Count / @m.Conversations.Count with an answer</small>
                        </figure>
                    }
                </div>
            </section>
        </div>
        </details>
    }
    else if (_level == 1)
    {
        @* One grid, a row per conversation with every mode's cell in it (Louis: "this must always align"): a row is as
           tall as its tallest cell, so the same conversation sits level across the modes, and one scale for both
           modes' bars, so a longer bar is a dearer conversation whichever side it is on. *@
        <div class="chart-head lead"><strong>Conversations</strong><span class="legend"><span><span class="sw" style="background: @Own"></span>Puls itself</span><span><span class="sw" style="background: @Spec"></span>@Roles()</span></span></div>
        var tasks = Tasks();
        decimal topConv = Math.Max(0.000001m, _modes.SelectMany(m => m.Conversations).Select(c => c.Cost ?? 0m).DefaultIfEmpty(0m).Max());
        long topTok = Math.Max(1, _modes.SelectMany(m => m.Conversations).Select(c => c.Rows.Sum(r => r.Tokens)).DefaultIfEmpty(0L).Max());
        <div class="compare-grid" style="--cols: @_modes.Count">
            @foreach (var (m, i) in Columns)
            {
                <h3 class="compare-head" style="--i: @i"><span class="sw" style="background: @Series(i)"></span>@Who(m) <code class="mode-name">@m.Name</code><span class="muted">@m.Conversations.Count conversations · @m.Rows.Count requests · @Money(m.Cost)</span></h3>
            }
            @foreach (var (task, row) in tasks.Select((t, r) => (t, r)))
            {
                foreach (var (m, i) in Columns)
                {
                    var c = m.Conversations.FirstOrDefault(x => x.Task == task);
                    <div class="compare-cell" style="--i: @row">
                        @if (c is null)
                        {
                            <span class="muted"><code>@task</code> · not in this mode</span>
                        }
                        else
                        {
                            decimal? own = Part(c.Rows, specialist: false), spec = Part(c.Rows, specialist: true);
                            <div class="conv-row">
                                <span class="xbar-label" title="@Question(c.Task)">
                                    <code>@c.Task</code><small>@Blurb(Question(c.Task))</small>
                                    <span class="tree-chips">@foreach (var chip in Chips(c)) { <span class="chip @chip.Kind">@chip.Text</span> }</span>
                                </span>
                                <span class="xbar stacked" title="@($"{c.Task}: Puls {Money(own)}, {Roles(m)} {Money(spec)}")">
                                    <span class="xbar-fill" style="width: @Pct(own ?? 0, topConv)%; background: @Own"></span><span class="xbar-fill" style="width: @Pct(spec ?? 0, topConv)%; background: @Spec"></span>
                                </span>
                                <span class="row-cost" data-count="@Money(c.Cost)">@Money(c.Cost)</span>
                                @Actions(c.Task, null)
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <section class="chart">
            <div class="chart-head"><strong>Tokens per conversation</strong>@TokenLegend()</div>
            <div class="compare-grid tokens" style="--cols: @_modes.Count">
                @foreach (var (m, i) in Columns)
                {
                    <span class="compare-sub"><span class="sw" style="background: @Series(i)"></span>@Who(m)</span>
                }
                @foreach (var (task, row) in tasks.Select((t, r) => (t, r)))
                {
                    foreach (var (m, i) in Columns)
                    {
                        var c = m.Conversations.FirstOrDefault(x => x.Task == task);
                        <div class="token-row" style="--i: @row">
                            <code>@task</code>
                            @if (c is not null)
                            {
                                <span class="xstack-wrap">@Stack(c.Rows, topTok)</span>
                                <span class="token-total">@UsageFormat.Tokens(c.Rows.Sum(r => r.Tokens))</span>
                            }
                            else { <span class="muted">—</span><span></span> }
                        </div>
                    }
                }
            </div>
        </section>
    }
    else if (_level == 2)
    {
        <div class="chart-head lead"><strong><code>@_task</code></strong><span class="muted">@Blurb(Question(_task!))</span><span class="legend"><span><span class="sw" style="background: @Own"></span>Puls itself</span><span><span class="sw" style="background: @Spec"></span>@Roles()</span></span></div>
        <div class="compare">
            @foreach (var (m, i) in Columns)
            {
                var c = ConversationIn(m);
                <section class="compare-col" style="--i: @i">
                    <h3 class="compare-head"><span class="sw" style="background: @Series(i)"></span>@Who(m) <code class="mode-name">@m.Name</code><span class="muted">@(c is null ? "not in this mode" : $"{c.Turns.Count} turns · {c.Rows.Count} requests · {Money(c.Cost)}")</span></h3>
                    @if (c is not null)
                    {
                        foreach (var (tu, j) in c.Turns.Select((x, j) => (x, j)))
                        {
                            <section class="chart turn-chart" style="--i: @j">
                                <div class="turn-head">
                                    <span class="tree-turn-n">Beurt @tu.N</span><span class="tree-question">@tu.Question</span>
                                    <span class="chip">@(tu.Role ?? (tu.Continued is { } h ? $"continued · {h}" : "Puls itself"))</span>
                                    <span class="chip">@tu.Rows.Count requests</span><span class="chip">@Secs(tu.Seconds) s</span>
                                    <span class="row-cost turn-cost" data-count="@Money(tu.Cost)">@Money(tu.Cost)</span>
                                    @if (tu.Error is not null) { <span class="chip bad" title="@tu.Error">error</span> }
                                    @Actions(_task!, tu.N)
                                </div>
                                @Timeline(tu, null)
                            </section>
                        }
                    }
                </section>
            }
        </div>
    }
    else if (_level == 3)
    {
        <div class="chart-head lead"><strong>Beurt @_turn</strong><span class="muted"><code>@_task</code></span>
            <span class="legend"><span><span class="sw" style="background: @Own"></span>Puls itself</span><span><span class="sw" style="background: @Spec"></span>@Roles()</span></span></div>
        <div class="replay-bar">
            @if (_replaying) { <button type="button" class="header-button" @onclick="StopReplay"><span class="ic i-pulse" aria-hidden="true"></span>Stop</button><span class="muted working">replaying as typed…</span> }
            else { <button type="button" class="header-button" @onclick="ReplayAsync"><span class="ic i-pulse" aria-hidden="true"></span>Replay as typed</button> }
        </div>
        <div class="compare">
            @foreach (var (m, i) in Columns)
            {
                var tu = TurnIn(m);
                <section class="compare-col" style="--i: @i">
                    <h3 class="compare-head"><span class="sw" style="background: @Series(i)"></span>@Who(m) <code class="mode-name">@m.Name</code><span class="muted">@(tu is null ? "no turn in this mode" : $"{Money(tu.Cost)} · {tu.Rows.Count} requests · {Secs(tu.Seconds)} s")</span></h3>
                    @if (tu is not null)
                    {
                        @Timeline(tu, r => Open(() => { _level = 4; _request = r; _requestMode = m; }))
                        <div class="explorer-turn">
                            <div class="xreplay"><TurnView Turn="@(_replays.GetValueOrDefault(m.Name) ?? tu.Shown)" Streaming="_replaying" Currency="Currency" /></div>
                            @if (tu.Hosts.Count > 0) { <p class="muted">Gelees: @string.Join(", ", tu.Hosts)</p> }
                        </div>
                    }
                </section>
            }
        </div>
    }
    else if (_request is { } r)
    {
        <div class="tiles small">
            <div class="tile" style="--i: 0"><span class="tile-label">cost</span><strong class="tile-value" data-count="@Money(r.Cost)">@Money(r.Cost)</strong></div>
            <div class="tile" style="--i: 1"><span class="tile-label">tokens</span><strong class="tile-value">@UsageFormat.Tokens(r.Tokens)</strong></div>
            <div class="tile" style="--i: 2"><span class="tile-label">time</span><strong class="tile-value">@Secs(r.DurationMs / 1000.0) s</strong></div>
            <div class="tile" style="--i: 3"><span class="tile-label">model</span><strong class="tile-value model">@(r.Model ?? "—")</strong><span class="tile-meta">@_requestMode?.Name · @r.Purpose</span></div>
        </div>
        <section class="chart">
            <div class="chart-head"><strong>Tokens</strong>@TokenLegend()</div>
            <div class="xbars"><div class="xbar-row" style="--i: 0"><span class="xbar-label">@(r.Specialist ? (_requestMode is { } rm ? Roles(rm) : Roles()) : "Puls")</span><span class="xstack-wrap">@Stack([r], r.Tokens)</span><span class="xbar-value">@UsageFormat.Tokens(r.Tokens)</span></div></div>
            <dl class="explorer-fields">
                <dt>input</dt><dd>@Count(r.Input)</dd><dt>cache written</dt><dd>@Count(r.CacheWrite)</dd><dt>cache read</dt><dd>@Count(r.CacheRead)</dd><dt>output</dt><dd>@Count(r.Output)</dd>
                <dt>when</dt><dd>@r.At.ToLocalTime().ToString("HH:mm:ss.fff")</dd><dt>session</dt><dd><code>@r.Session</code></dd>
                @if (r.Parent is { } p) { <dt>parent</dt><dd><code>@p</code></dd> }
            </dl>
        </section>
    }
    </div>
</div>

@code {
    /// <summary>The run as GET /admin/benchmarks/runs/{id} answers it.</summary>
    [Parameter, EditorRequired] public JsonElement Run { get; set; }
    [Parameter] public CurrencyChoice? Currency { get; set; }

    // The dataviz reference palette's dark column, in its validated order: slots 1–4 for the token kinds, slots 1–3 for
    // modes side by side. Puls's own and the specialist's requests: slot 1 and Puls's orange.
    private static readonly string[] Palette = ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300"];
    private const string Own = "#3987e5", Spec = "#f58220";
    // Right and wrong: Puls's own green and danger red, which read on its dark surface.
    private const string Right = "#38b449", Wrong = "#f26b4f", Guess = "#f58220", Other = "#8a8f98";

    /// <summary>The shops the cook prices at (its role's list, F25).</summary>
    private static readonly string[] Shops = ["checkers.co.za", "pnp.co.za", "woolworths.co.za", "spar.co.za", "shoprite.co.za", "usave.co.za"];

    private static bool IsShop(string host) => Shops.Any(s => host == s || host.EndsWith("." + s));
    private static string Series(int i) => Palette[i % Palette.Length];

    private sealed record Request(DateTimeOffset At, string Purpose, string? Session, string? Parent, string? Model,
        long? Input, long? CacheWrite, long? CacheRead, long? Output, decimal? Cost, long DurationMs)
    {
        public bool Specialist => Parent is not null;
        public long Tokens => (Input ?? 0) + (CacheWrite ?? 0) + (CacheRead ?? 0) + (Output ?? 0);
        public DateTimeOffset Start => At - TimeSpan.FromMilliseconds(DurationMs);
    }

    private sealed class TurnNode
    {
        public int N; public string Question = ""; public string? Answer, Role, Continued, Error; public double Seconds;
        public List<string> Hosts = []; public List<Request> Rows = [];
        /// <summary>What its tools did (calls, failed, the reasons grouped), as the API read it from the stored events.</summary>
        public int ToolCalls, ToolsFailed; public List<(string Tool, string Reason, int Count)> ToolReasons = [];
        /// <summary>The transcript before a replay: the question and the answer.</summary>
        public Turn Shown = new();
        public decimal? Cost => UsageFormat.KnownSum(Rows.Select(r => r.Cost));
    }

    private sealed class ConversationNode
    {
        public string Task = ""; public string? Role; public JsonElement Scores; public int Errors; public List<TurnNode> Turns = [];
        public List<Request> Rows => Turns.SelectMany(t => t.Rows).ToList();
        public decimal? Cost => UsageFormat.KnownSum(Rows.Select(r => r.Cost));
        public bool Right => Scores.ValueKind == JsonValueKind.Object && Scores.TryGetProperty("routed_right", out var v) && v.ValueKind == JsonValueKind.True;
    }

    private sealed class ModeNode
    {
        public string Name = ""; public List<string> Toolsets = []; public List<ConversationNode> Conversations = [];
        public List<Request> Rows => Conversations.SelectMany(c => c.Rows).ToList();
        public decimal? Cost => UsageFormat.KnownSum(Rows.Select(r => r.Cost));
        public long Tokens => Rows.Sum(r => r.Tokens);
        public double Seconds => Conversations.SelectMany(c => c.Turns).Sum(t => t.Seconds);
        public int Right => Conversations.Count(c => c.Right);
        public int Errors => Conversations.Sum(c => c.Errors);
    }

    private sealed record Chip(string Text, string Kind = "");

    private List<ModeNode> _modes = [];
    private string _runId = "";
    private int _repeats = 1, _repeat = 1;

    private int _level;
    private string? _task; private int? _turn; private Request? _request; private ModeNode? _requestMode;
    private string _dir = "in";
    private string LevelKey => $"{_repeat}|{_level}|{_task}|{_turn}|{_request?.At:O}";

    private IEnumerable<(ModeNode Mode, int I)> Columns => _modes.Select((m, i) => (m, i));
    private ConversationNode? ConversationIn(ModeNode m) => _task is null ? null : m.Conversations.FirstOrDefault(c => c.Task == _task);
    private TurnNode? TurnIn(ModeNode m) => _turn is null ? null : ConversationIn(m)?.Turns.FirstOrDefault(t => t.N == _turn);

    private readonly Dictionary<string, Turn> _replays = [];
    private bool _replaying;
    private CancellationTokenSource? _replayStop;

    protected override void OnParametersSet()
    {
        _runId = Run.GetProperty("run").GetProperty("id").GetString()!;
        _repeats = Math.Max(1, Run.GetProperty("run").GetProperty("repeat").GetInt32());
        _repeat = Math.Clamp(_repeat, 1, _repeats);
        Build();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChats && _chatOpen)
        {
            _focusChats = false;
            try { await Js.InvokeVoidAsync("pulsUi.focus", "#chats-dialog"); } catch (JSException) { }
        }
        // The numbers count up to their value (the landing page's pulsUi.countCosts, keyed on data-count).
        try { await Js.InvokeVoidAsync("pulsUi.countCosts"); } catch (JSException) { }
    }

    public void Dispose() { _replayStop?.Cancel(); _chatStop?.Cancel(); }

    private void ShowRepeat(int repeat) { _repeat = repeat; Build(); Go(0); }

    private void Open(Action set) { _dir = "in"; ResetReplay(); set(); }

    private void OpenConversation(string task) => Open(() => { _level = 2; _task = task; });

    /// <summary>
    /// A conversation's or a turn's two ways on (Louis: "the button is enough, why not just open the modal"; "this must be
    /// just another button"): *Speel af* opens the chats side by side on its conversation; *Beurte* (a conversation's
    /// turns) or *Versoeke* (a turn's requests) goes into what the modal doesn't show.
    /// </summary>
    private RenderFragment Actions(string task, int? turn) => __builder =>
    {
        <span class="row-actions">
            <button type="button" class="turn-open" @onclick="() => OpenChatsAsync(task)"><span class="ic i-chat" aria-hidden="true"></span>Replay</button>
            @if (turn is { } n)
            {
                <button type="button" class="turn-open quiet" @onclick="() => Open(() => { _level = 3; _turn = n; })">Requests <span aria-hidden="true">›</span></button>
            }
            else
            {
                <button type="button" class="turn-open quiet" @onclick="() => OpenConversation(task)">Turns <span aria-hidden="true">›</span></button>
            }
        </span>
    };

    private void Go(int level)
    {
        _dir = "out"; ResetReplay();
        _level = level;
        if (level < 2) _task = null;
        if (level < 3) _turn = null;
        if (level < 4) { _request = null; _requestMode = null; }
    }

    private void ResetReplay() { _replayStop?.Cancel(); _replayStop = null; _replays.Clear(); _replaying = false; }

    /// <summary>The run's tree for the shown repeat: modes in the run's order, their conversations, turns and requests.</summary>
    private void Build()
    {
        var modes = new List<ModeNode>();
        foreach (var m in Run.GetProperty("modes").EnumerateArray().Where(m => m.GetProperty("repeat").GetInt32() == _repeat))
            modes.Add(new ModeNode { Name = m.GetProperty("name").GetString()!, Toolsets = m.GetProperty("toolsets").EnumerateArray().Select(t => t.GetString()!).ToList() });

        ModeNode ModeOf(string name)
        {
            var mode = modes.FirstOrDefault(x => x.Name == name);
            if (mode is null) modes.Add(mode = new ModeNode { Name = name });
            return mode;
        }

        foreach (var c in Run.GetProperty("conversations").EnumerateArray().Where(c => c.GetProperty("repeat").GetInt32() == _repeat))
            ModeOf(c.GetProperty("mode").GetString()!).Conversations.Add(new ConversationNode
            {
                Task = c.GetProperty("task").GetString()!, Role = S(c, "role"), Scores = c.GetProperty("scores").Clone(),
                Errors = c.TryGetProperty("errors", out var e) && e.ValueKind == JsonValueKind.Number ? e.GetInt32() : 0,
            });

        foreach (var t in Run.GetProperty("turns").EnumerateArray().Where(t => t.GetProperty("repeat").GetInt32() == _repeat))
        {
            var mode = ModeOf(t.GetProperty("mode").GetString()!);
            string task = t.GetProperty("task").GetString()!;
            var conversation = mode.Conversations.FirstOrDefault(c => c.Task == task);
            if (conversation is null) mode.Conversations.Add(conversation = new ConversationNode { Task = task });
            var turn = new TurnNode
            {
                N = t.GetProperty("turn").GetInt32(), Question = S(t, "question") ?? "", Answer = S(t, "answer"), Role = S(t, "role"),
                Continued = S(t, "continued"), Error = S(t, "error"),
                Seconds = t.TryGetProperty("seconds", out var s) && s.ValueKind == JsonValueKind.Number ? s.GetDouble() : 0,
                Hosts = t.TryGetProperty("hosts", out var h) && h.ValueKind == JsonValueKind.Array ? h.EnumerateArray().Select(x => x.GetString()!).ToList() : [],
            };
            if (t.TryGetProperty("tools", out var tools) && tools.ValueKind == JsonValueKind.Object)
            {
                turn.ToolCalls = tools.GetProperty("calls").GetInt32();
                turn.ToolsFailed = tools.GetProperty("failed").GetInt32();
                turn.ToolReasons = tools.GetProperty("reasons").EnumerateArray()
                    .Select(r => (r.GetProperty("tool").GetString()!, r.GetProperty("reason").GetString()!, r.GetProperty("count").GetInt32())).ToList();
            }
            turn.Shown = new Turn { UserText = turn.Question, Error = turn.Error };
            if (turn.Answer is { Length: > 0 } answer) turn.Shown.Blocks.Add(new Block { Kind = BlockKind.Text, Text = answer });
            conversation.Turns.Add(turn);
        }

        foreach (var r in Run.GetProperty("requests").EnumerateArray())
        {
            if (!r.TryGetProperty("turn", out var key) || key.ValueKind != JsonValueKind.Object || key.GetProperty("repeat").GetInt32() != _repeat) continue;
            var turn = modes.FirstOrDefault(m => m.Name == key.GetProperty("mode").GetString())?.Conversations
                .FirstOrDefault(c => c.Task == key.GetProperty("task").GetString())?.Turns.FirstOrDefault(t => t.N == key.GetProperty("turn").GetInt32());
            turn?.Rows.Add(new Request(r.GetProperty("at").GetDateTimeOffset(), S(r, "purpose") ?? "", S(r, "session"), S(r, "parent"), S(r, "model"),
                L(r, "input_tokens"), L(r, "cache_write_tokens"), L(r, "cache_read_tokens"), L(r, "output_tokens"), D(r, "cost"),
                L(r, "duration_ms") ?? 0));
        }

        foreach (var c in modes.SelectMany(m => m.Conversations)) c.Turns.Sort((a, b) => a.N.CompareTo(b.N));
        _modes = modes;
    }

    /// <summary>Replays the turn as it was typed, in every mode at once: the stored events, at their own pace (capped), through the chat's TurnStream.</summary>
    private async Task ReplayAsync()
    {
        if (_task is null || _turn is null) return;
        var plays = new List<(string Mode, string Question, List<(DateTimeOffset? At, string Type, JsonElement Data)> Events)>();
        foreach (var m in _modes)
        {
            if (TurnIn(m) is not { } tu) continue;
            try
            {
                var json = await Api.GetAsync<JsonElement>(
                    $"admin/benchmarks/runs/{_runId}/turns/{Uri.EscapeDataString(m.Name)}/{_repeat}/{Uri.EscapeDataString(_task)}/{_turn}/events");
                var events = json.GetProperty("events").EnumerateArray()
                    .Select(e => (e.TryGetProperty("at", out var at) && at.ValueKind == JsonValueKind.String ? at.GetDateTimeOffset() : (DateTimeOffset?)null,
                        e.GetProperty("type").GetString()!, e.GetProperty("data").Clone()))
                    .ToList();
                if (events.Count > 0) plays.Add((m.Name, tu.Question, events));
            }
            catch (AgentApiException) { }
        }
        if (plays.Count == 0) return;

        var stop = _replayStop = new CancellationTokenSource();
        _replays.Clear();
        foreach (var (mode, question, _) in plays) _replays[mode] = new Turn { UserText = question };
        _replaying = true;
        StateHasChanged();
        try { await Task.WhenAll(plays.Select(p => PlayAsync(_replays[p.Mode], p.Events, stop.Token))); }
        catch (OperationCanceledException) { }
        _replaying = false;
        StateHasChanged();
    }

    private async Task PlayAsync(Turn turn, List<(DateTimeOffset? At, string Type, JsonElement Data)> events, CancellationToken stop)
    {
        DateTimeOffset? last = events[0].At;
        int since = 0;
        foreach (var (at, type, data) in events)
        {
            // Its own rhythm, three times faster, with no pause longer than a quarter second (a tool call's wait).
            int wait = at is { } now && last is { } before ? (int)Math.Clamp((now - before).TotalMilliseconds / 3, 0, 250) : 15;
            last = at ?? last;
            if (wait > 0) await Task.Delay(wait, stop);
            TurnStream.Apply(turn, new AgentStreamEvent(type, data));
            if (++since % 3 == 0 || wait > 0) { StateHasChanged(); since = 0; }
        }
    }

    private void StopReplay() { _replayStop?.Cancel(); _replaying = false; }

    // The chats side by side (Louis): one conversation of every mode, each turn after the other, the modes at once.
    private bool _chatOpen, _chatPlaying, _focusChats;
    private string? _chatTask;
    private readonly Dictionary<string, List<Turn>> _chats = [];
    private CancellationTokenSource? _chatStop;

    private List<string> Tasks() => _modes.SelectMany(m => m.Conversations.Select(c => c.Task)).Distinct().ToList();

    private async Task OpenChatsAsync(string? task)
    {
        _chatStop?.Cancel();
        var stop = _chatStop = new CancellationTokenSource();
        _chatTask = task ?? Tasks().FirstOrDefault();
        _focusChats = !_chatOpen;
        _chatOpen = true;
        _chats.Clear();
        if (_chatTask is null) return;

        // Every turn's stored events, per mode, fetched before anything plays, so the modes start together.
        var plays = new List<(string Mode, List<(string Question, List<(DateTimeOffset? At, string Type, JsonElement Data)> Events)> Turns)>();
        foreach (var m in _modes)
        {
            if (m.Conversations.FirstOrDefault(c => c.Task == _chatTask) is not { } conversation) continue;
            var turns = new List<(string, List<(DateTimeOffset?, string, JsonElement)>)>();
            foreach (var tu in conversation.Turns)
            {
                var events = new List<(DateTimeOffset?, string, JsonElement)>();
                try
                {
                    var json = await Api.GetAsync<JsonElement>(
                        $"admin/benchmarks/runs/{_runId}/turns/{Uri.EscapeDataString(m.Name)}/{_repeat}/{Uri.EscapeDataString(_chatTask)}/{tu.N}/events");
                    events = json.GetProperty("events").EnumerateArray()
                        .Select(e => (e.TryGetProperty("at", out var at) && at.ValueKind == JsonValueKind.String ? at.GetDateTimeOffset() : (DateTimeOffset?)null,
                            e.GetProperty("type").GetString()!, e.GetProperty("data").Clone()))
                        .ToList();
                }
                catch (AgentApiException) { }
                turns.Add((tu.Question, events));
            }
            plays.Add((m.Name, turns));
        }
        if (stop.IsCancellationRequested) return;

        foreach (var (mode, _) in plays) _chats[mode] = [];
        _chatPlaying = true;
        StateHasChanged();
        try
        {
            await Task.WhenAll(plays.Select(async p =>
            {
                foreach (var (question, events) in p.Turns)
                {
                    var turn = new Turn { UserText = question };
                    _chats[p.Mode].Add(turn);
                    if (events.Count > 0) await PlayAsync(turn, events, stop.Token);
                    StateHasChanged();
                }
            }));
        }
        catch (OperationCanceledException) { }
        if (!stop.IsCancellationRequested) { _chatPlaying = false; StateHasChanged(); }
    }

    private void CloseChats()
    {
        _chatStop?.Cancel();
        _chatOpen = false;
        _chatPlaying = false;
        _chats.Clear();
    }

    private void ChatsKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseChats();
    }

    private static IEnumerable<Chip> Chips(ConversationNode c)
    {
        if (c.Scores.ValueKind != JsonValueKind.Object) yield break;
        if (c.Scores.TryGetProperty("routed_right", out var right))
            yield return new Chip($"{c.Role ?? "Puls itself"} {(right.ValueKind == JsonValueKind.True ? "✓" : "✗")}", right.ValueKind == JsonValueKind.True ? "ok" : "bad");
        if (S(c.Scores, "follow_up") is { } follow) yield return new Chip(follow, follow == "continued" ? "ok" : "");
        if (c.Scores.TryGetProperty("ingredients", out var items) && items.ValueKind == JsonValueKind.Number)
        {
            decimal ratio = D(c.Scores, "priced_ratio") ?? 0;
            yield return new Chip($"priced {c.Scores.GetProperty("priced").GetRawText()} / {items.GetRawText()}", ratio >= 0.8m ? "ok" : ratio < 0.5m ? "bad" : "");
            // A price without its source is a guess (Louis): orange, never counted as priced.
            if (c.Scores.TryGetProperty("unsourced", out var guessed) && guessed.ValueKind == JsonValueKind.Number && guessed.GetInt32() > 0)
                yield return new Chip($"guessed {guessed.GetInt32()}", "warn");
        }
        if (c.Errors > 0) yield return new Chip($"errors {c.Errors}", "bad");
    }

    /// <summary>
    /// Who a mode is (Louis: "be more specific, say Puls with puls-cook"): Puls with the roles it handed to, from the
    /// run's own turns, or Puls alone when it handed nothing on.
    /// </summary>
    private static string Who(ModeNode m) =>
        RolesOf(m) is { Count: > 0 } roles ? $"Puls with {string.Join(" and ", roles)}" : "Puls alone";

    private static List<string> RolesOf(ModeNode m) =>
        m.Conversations.SelectMany(c => c.Turns).Select(t => t.Role).Where(r => !string.IsNullOrEmpty(r)).Distinct().ToList()!;

    /// <summary>The specialists' name for a legend: the roles in the mode (or the run), "spesialis" only when there's none.</summary>
    private string Roles(ModeNode? m = null)
    {
        var roles = (m is null ? _modes.SelectMany(RolesOf) : RolesOf(m)).Distinct().ToList();
        return roles.Count == 0 ? "specialist" : string.Join(" / ", roles);
    }

    /// <summary>A mode's ingredients priced over ingredients listed, summed over its conversations; null where the check counts none.</summary>
    private static (int Priced, int Ingredients, int Guessed)? Priced(ModeNode m)
    {
        int priced = 0, items = 0, guessed = 0;
        foreach (var c in m.Conversations)
        {
            if (c.Scores.ValueKind != JsonValueKind.Object || !c.Scores.TryGetProperty("ingredients", out var n) || n.ValueKind != JsonValueKind.Number) continue;
            items += n.GetInt32();
            priced += c.Scores.TryGetProperty("priced", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetInt32() : 0;
            guessed += c.Scores.TryGetProperty("unsourced", out var g) && g.ValueKind == JsonValueKind.Number ? g.GetInt32() : 0;
        }
        return items == 0 ? null : (priced, items, guessed);
    }

    /// <summary>A meal the check expected a list for that came without one (its ingredients unknown, not counted).</summary>
    private static int Unlisted(ModeNode m) =>
        m.Conversations.Count(c => c.Task.StartsWith("cook") && c.Scores.ValueKind == JsonValueKind.Object
                                   && c.Scores.TryGetProperty("ingredients", out var n) && n.ValueKind == JsonValueKind.Null);

    /// <summary>
    /// A real answer (Louis: "the idea is to get an actual answer"): routed right, and where the check lists ingredients,
    /// at least 80 % of them priced with their source. A meal that came without a list is no answer.
    /// </summary>
    private static bool Answered(ConversationNode c)
    {
        if (!c.Right) return false;
        if (c.Scores.ValueKind != JsonValueKind.Object || !c.Scores.TryGetProperty("ingredients", out var n)) return true;
        if (n.ValueKind != JsonValueKind.Number) return !c.Task.StartsWith("cook");
        return c.Scores.TryGetProperty("priced_ratio", out var r) && r.ValueKind == JsonValueKind.Number && r.GetDouble() >= 0.8;
    }

    /// <summary>Puls's own part of some requests' cost, or the specialists': unknown when none of them was priced, never 0.</summary>
    private static decimal? Part(IEnumerable<Request> rows, bool specialist) =>
        UsageFormat.KnownSum(rows.Where(r => r.Specialist == specialist).Select(r => r.Cost));

    private string Money(decimal? usd) => usd is { } c ? UsageFormat.Money(c, "USD", Currency) : "—";

    private string? Question(string task) =>
        _modes.SelectMany(m => m.Conversations).Where(c => c.Task == task).SelectMany(c => c.Turns).Select(t => t.Question).FirstOrDefault(q => q.Length > 0);

    private static string Blurb(string? question) => string.IsNullOrEmpty(question) ? "" : question.Length <= 56 ? question : question[..55].TrimEnd() + "…";

    /// <summary>The turn's requests on a timeline: Puls's lane and the specialist's, each a bar from its start to its end; a click opens one when <paramref name="open"/> is given.</summary>
    private RenderFragment Timeline(TurnNode turn, Action<Request>? open) => __builder =>
    {
        if (turn.Rows.Count == 0) { <p class="muted">No requests in the ledger.</p> return; }
        var start = turn.Rows.Min(r => r.Start); double span = Math.Max(1, (turn.Rows.Max(r => r.At) - start).TotalMilliseconds);
        <div class="timeline">
            @foreach (var (label, specialist) in new[] { ("Puls", false), (turn.Role ?? "specialist", true) })
            {
                <div class="lane">
                    <span class="lane-label"><span class="sw" style="background: @(specialist ? Spec : Own)"></span>@label</span>
                    <div class="lane-track">
                        @foreach (var (r, i) in turn.Rows.Where(r => r.Specialist == specialist).Select((r, i) => (r, i)))
                        {
                            double left = (r.Start - start).TotalMilliseconds / span * 100, width = Math.Max(0.6, r.DurationMs / span * 100);
                            <button type="button" class="tl-bar" style="--i: @i; left: @F(left)%; width: @F(width)%; background: @(specialist ? Spec : Own)" title="@($"{Money(r.Cost)} · {UsageFormat.Tokens(r.Tokens)} tokens · {r.DurationMs} ms")" disabled="@(open is null)" @onclick="() => open?.Invoke(r)">
                                <span class="tl-tip"><strong>@Money(r.Cost)</strong> · @UsageFormat.Tokens(r.Tokens) tokens · @r.DurationMs ms</span>
                            </button>
                        }
                    </div>
                </div>
            }
            <div class="lane axis"><span class="lane-label"></span><div class="lane-track"><span class="axis-l">0 s</span><span class="axis-r">@Secs(span / 1000) s</span></div></div>
        </div>
    };

    private static long[] Parts(IEnumerable<Request> rows)
    {
        var list = rows.ToList();
        return [list.Sum(r => r.Input ?? 0), list.Sum(r => r.CacheWrite ?? 0), list.Sum(r => r.CacheRead ?? 0), list.Sum(r => r.Output ?? 0)];
    }

    private static readonly string[] TokenNames = ["input", "cache written", "cache read", "output"];

    /// <summary>The four token kinds stacked, in the palette's fixed order, with a 2px surface gap; widths against <paramref name="top"/> so siblings compare.</summary>
    private static RenderFragment Stack(IEnumerable<Request> rows, long top) => __builder =>
    {
        long[] parts = Parts(rows);
        long scale = Math.Max(1, top);
        <span class="xstack" title="@string.Join(" · ", TokenNames.Select((n, i) => $"{n} {parts[i]:N0}"))">
            @for (int i = 0; i < 4; i++)
            {
                if (parts[i] > 0) { <span class="xseg" style="--i: @i; width: @Pct(parts[i], scale)%; background: @Series(i)"></span> }
            }
        </span>
    };

    /// <summary>
    /// The token mix as a donut: one arc per kind in the palette's order, each sweeping in after the one before (a
    /// circle's stroke-dasharray, the arc's length out of the circumference). An empty ring when nothing was counted.
    /// </summary>
    private static RenderFragment Donut(IEnumerable<Request> rows) => __builder =>
    {
        long[] parts = Parts(rows);
        @Ring(parts.Select(p => (double)p).ToArray(), TokenNames.Select((_, i) => Series(i)).ToArray(),
            TokenNames.Select((n, i) => $"{n} {parts[i]:N0}").ToArray(), UsageFormat.Tokens(parts.Sum()), "tokens")
    };

    /// <summary>
    /// A ring of <paramref name="parts"/> in their colours, each arc sweeping in after the one before, with
    /// <paramref name="centre"/> in its middle (the total: it pops). An empty track when every part is 0, the total
    /// still in its middle, so a run without costs still reads as a graph.
    /// </summary>
    private static RenderFragment Ring(double[] parts, string[] colours, string[] titles, string centre, string unit) => __builder =>
    {
        double total = parts.Sum();
        const double r = 15.915494, circumference = 100;   // a circumference of 100, so lengths are percentages
        double offset = 25;                                 // start at twelve o'clock
        <div class="donut-wrap">
            <svg class="donut" viewBox="0 0 42 42" role="img" aria-label="@string.Join(", ", titles)">
                <circle class="donut-track" cx="21" cy="21" r="@F(r)" />
                @for (int i = 0; i < parts.Length; i++)
                {
                    if (total <= 0 || parts[i] <= 0) continue;
                    double length = parts[i] / total * circumference;
                    <circle class="donut-arc" cx="21" cy="21" r="@F(r)" style="--i: @i; --len: @F(length); stroke: @colours[i]; stroke-dashoffset: @F(offset)">
                        <title>@titles[i]</title>
                    </circle>
                    offset -= length;
                }
            </svg>
            <span class="donut-centre"><strong data-count="@centre">@centre</strong><small>@unit</small></span>
        </div>
    };

    private static RenderFragment TokenLegend() => __builder =>
    {
        <span class="legend">@for (int i = 0; i < 4; i++) { <span><span class="sw" style="background: @Series(i)"></span>@TokenNames[i]</span> }</span>
    };

    private static string? S(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
    private static long? L(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetInt64() : null;
    private static decimal? D(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDecimal() : null;
    private static string Count(long? n) => n is { } v ? v.ToString("N0") : "—";
    private static string Secs(double s) => s.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    private static string F(double v) => Math.Round(v, 3).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string Pct(decimal part, decimal whole) => whole <= 0 ? "0" : Math.Round(part / whole * 100, 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string Pct(long part, long whole) => Pct((decimal)part, whole);
}

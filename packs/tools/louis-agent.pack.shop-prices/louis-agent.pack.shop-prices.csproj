<Project Sdk="Microsoft.NET.Sdk">

  <!-- What an agent can do with shop prices (F50.2, ADR 0027, 0028, 0069): a shopping list's cost estimated from Stats
       SA's average prices, the user's province first, with our own rows for what Stats SA doesn't price; the scaling
       and the total in code. Reads no shop's site; the prices come from MongoDB when SHOP_PRICES_MONGO_URL is set,
       else from the tables it ships. References core only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.ShopPrices</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, toolsets/shop-prices.md is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.shop-prices.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <!-- The price store (SHOP_PRICES_MONGO_URL), the same driver as the API's eval store. -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.md" />
    <!-- The price tables as content: Stats SA's month, refreshed when it publishes the next, and our own rows. -->
    <EmbeddedResource Include="Prices\Data\*.json" LogicalName="ShopPrices.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.shop-prices.md" Link="docs\louis-agent.pack.shop-prices.md" />
    <None Include="..\..\..\src\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

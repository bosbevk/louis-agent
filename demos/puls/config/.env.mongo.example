# The benchmark store's root user (F31): copy to config/.env.mongo (git-ignored). Only puls-mongo reads this file, so
# the database container never sees the keys in config/.env.secrets. The user is created the first time the container
# starts with an empty data/mongo folder; changing it later needs the folder emptied (or the user changed in mongosh).
# EVALS_MONGO_URL in config/.env.secrets uses the same user and password.
MONGO_INITDB_ROOT_USERNAME=louis
MONGO_INITDB_ROOT_PASSWORD=pick-a-long-random-value

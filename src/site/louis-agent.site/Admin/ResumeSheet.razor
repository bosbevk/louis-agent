@using LouisAgent.Site.Content
@* The CV's page inside the editor (F142): the page's own view inside the site's own look, made smaller where the
   screen is too narrow for it, and redrawn from the draft on every edit. *@
<section class="resume-sheet" aria-label="The CV's page">
    <div class="resume-sheet-bar">
        <span class="resume-sheet-name">The page</span>
        <a class="resume-sheet-saved" href="cv" target="_blank" rel="noopener">Open the saved page</a>
    </div>
    <div class="resume-sheet-frame">
        <div class="resume-sheet-page site">
            <ResumeView Resume="Resume" Photo="@Cv.Photo" Availability="@Cv.Availability" />
        </div>
    </div>
</section>

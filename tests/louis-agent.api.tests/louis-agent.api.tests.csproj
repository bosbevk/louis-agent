<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- CL20: the route tests run the API in memory (no port, no Docker); the same 10.0.x as the API's other ASP.NET packages. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\louis-agent.api\louis-agent.api.csproj" />
    <!-- CL15: the API's tests open Puls's sessions, so they register Puls's prompts as the Puls stack does (IDENTITIES=puls). -->
    <ProjectReference Include="..\..\identities\louis-agent.identity.puls\louis-agent.identity.puls.csproj" />
    <ProjectReference Include="..\..\packs\louis-agent.pack.shops\louis-agent.pack.shops.csproj" />
    <!-- F18 step 1e: the scripted turns of the stream golden run on the shared fake model. -->
    <ProjectReference Include="..\louis-agent.testing\louis-agent.testing.csproj" />
    <!-- F18 step 7.6.3: the in-memory API host, the built dlls and the store contracts both the unit and the integration tests use. -->
    <ProjectReference Include="..\louis-agent.api.testing\louis-agent.api.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 5.2: the stub's expected protocol lines (the runner's own fixture), which the export is read back against. -->
    <!-- F18 step 7c.2c: the stub's run as protocol version 1, frozen, since the API reads v1 until step 7c.3, which
         points these tests back at the runner's own golden (now v2). -->
    <None Include="Fixtures\stub-run.v1.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>
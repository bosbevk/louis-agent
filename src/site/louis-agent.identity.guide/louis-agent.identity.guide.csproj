<Project Sdk="Microsoft.NET.Sdk">

  <!-- Who the framework's guide is (F109.3, the expert until F124): the guide in the site's corner, its voice as an
       embedded prompt, and the packs it uses by name: the docs, the leads and the site. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Identities.Guide</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded prompts' folder paths, or they are never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc, shown under docs/ in the IDE's solution explorer; nothing is built or copied. -->
    <None Include="..\..\..\demos\louis-agent\docs\projects\louis-agent.identity.expert.md" Link="docs\louis-agent.identity.expert.md" />
  </ItemGroup>

</Project>

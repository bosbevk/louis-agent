@* The Puls wordmark (wwwroot/brand/puls-wordmark.svg) inline, so its letters take the text colour and its pulse line can
   animate. The gradient's id is per instance: a page can hold two (the top bar and the sidebar), and a gradient inside a
   hidden copy doesn't paint. *@
<svg class="puls-logo" viewBox="0 0 200 104" role="img" aria-label="Puls">
    <defs>
        <linearGradient id="@_gradient" x1="14" y1="0" x2="190" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#f58220" />
            <stop offset=".55" stop-color="#f58220" />
            <stop offset="1" stop-color="#38b449" />
        </linearGradient>
    </defs>
    <path d="M14 26V88M14 44a18 18 0 1 0 36 0a18 18 0 1 0-36 0M64 26v18a18 18 0 0 0 36 0M100 26v36M118 8v54M163 31c-4-4-9-5-13-5c-8 0-13 4-13 9c0 6 6 8 13 9c8 1 14 3 14 9c0 6-6 9-14 9c-6 0-11-2-15-6"
          fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
    <path class="puls-logo-line" d="M14 88H96C106 88 109 74 118 74C127 74 130 88 140 88H180" pathLength="1"
          fill="none" stroke="url(#@_gradient)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    <circle class="puls-logo-dot" cx="190" cy="88" r="5.5" />
</svg>

@code {
    private readonly string _gradient = "puls-line-" + Guid.NewGuid().ToString("N")[..8];
}

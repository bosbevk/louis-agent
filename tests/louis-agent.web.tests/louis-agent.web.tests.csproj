<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- T1b (CL15, the web layout review): the code-review app's page pinned before W2 splits it, with bUnit (MIT): the
       chat page rendered against the stub API, empty and with the recorded turn, each a golden beside its test
       (LOUIS_UPDATE_GOLDEN=1 regenerates). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Web.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\louis-agent.web\louis-agent.web.csproj" />
    <!-- The fixture replay, the stub API and the snapshot helper the web tests share; no test project references another. -->
    <ProjectReference Include="..\louis-agent.web.testing\louis-agent.web.testing.csproj" />
    <ProjectReference Include="..\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Web.Testing" />
  </ItemGroup>

</Project>

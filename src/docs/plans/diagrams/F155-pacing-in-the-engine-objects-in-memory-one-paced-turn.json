      { "from": "reader", "to": "channel", "word": "writes" },
      { "from": "paced", "to": "channel", "word": "reads" },
      { "from": "paced", "to": "buffer", "word": "holds" },
      { "from": "paced", "to": "timer", "word": "ticks" }
    ],
    "direction": "down"
  }

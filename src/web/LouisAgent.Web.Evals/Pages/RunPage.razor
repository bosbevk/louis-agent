@page "/admin/evals/{Eval}/runs/{Run}"
@layout AdminFrame

@* A run's page (F126.3.2): the number first, then what the run ran with, then its conversations, the failed ones
   first, and the eval's other runs at the foot. A run that stopped gives its reason first, one still running shows
   what is graded so far, and a run the host doesn't have is one line. *@

<PageTitle>@Eval · Run · Admin</PageTitle>

<nav class="run-crumbs" aria-label="Breadcrumb"><a href="@EvalAddress.EvalsPage">Evals</a> / @Eval</nav>

<div class="page-head">
    <div>
        <h1>@Eval@if (_run is { } shown)
            {
                <span> · run of @EvalsWords.FormatLocal(shown.StartedAt)</span>
            }</h1>
        @switch (_run?.Status)
        {
            case RunStatus.Finished:
                <p>@Passed of @Graded conversations passed. A conversation passes only when every one of its repeats does.</p>
                break;
            case RunStatus.CouldNotFinish:
                <p>@Graded of @Held conversations were graded, then the run could not go on.</p>
                break;
            case RunStatus.Running:
                <p class="run-running">The run is still going. @Graded of @Held conversations are graded so far, and Reload reads what is graded since.</p>
                break;
        }
    </div>
    <div class="page-actions">
        <button class="header-button run-reload" type="button" @onclick="LoadAsync" disabled="@_loading"><span class="ic i-refresh" aria-hidden="true"></span>Reload</button>
    </div>
</div>

@if (_error is { } error)
{
    <AdminGate Error="@error" NeedsKey="_needsKey" OnSaved="LoadAsync"/>
}

@if (_missing)
{
    <section class="card-p run-missing">This host has no run @Run.</section>
}
else if (_loading && _run is null)
{
    <section class="card-p run-loading"><span class="muted">Loading…</span></section>
}
else if (_run is { } run)
{
    @if (run.Status == RunStatus.CouldNotFinish)
    {
        <section class="card-p run-stopped">
            <h2>The run could not finish</h2>
            <p>@run.StoppedBecause</p>
            <p>@NotRun did not run.</p>
        </section>
    }

    <section class="card-p run-this">
        <h2>This run</h2>
        <RunFigures>
            <p class="run-score col-12 col-lg-auto"><span class="run-passed">@run.Passed</span> <span class="run-of">of @run.Conversations.Count @(run.Status == RunStatus.Finished ? "passed" : "graded passed")</span></p>
            <RunFigure Name="Kind">@Kind</RunFigure>
            <RunFigure Name="Repeats">@run.Repeats</RunFigure>
            <RunFigure Name="Took">@Took</RunFigure>
            <RunFigure Name="The agent's cost"><span class="run-cost">@Cost</span></RunFigure>
            <RunFigure Name="Facts met">@run.CountFacts().Met of @run.CountFacts().Of</RunFigure>
            <RunFigure Name="Criteria met">@run.CountCriteria().Met of @run.CountCriteria().Of</RunFigure>
        </RunFigures>
        @if (run.PageSent)
        {
            <p class="run-asked">Asked as <code>@run.Agent</code>, with the page a visitor's message carries.</p>
        }
        else
        {
            <p class="run-asked">Asked as <code>@run.Agent</code>, without the page a visitor's message carries.</p>
        }
    </section>

    <section class="card-p run-conversations">
        <h2>Conversations</h2>
        @foreach (var conversation in run.OrderFailedFirst())
        {
            <ConversationRow @key="conversation.Id" Eval="@Eval" Run="@run.Id" Conversation="conversation"/>
        }
    </section>

    <RunRows Eval="@Eval" Rows="_runs" Open="@run.Id"/>
}

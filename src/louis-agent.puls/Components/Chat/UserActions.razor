@* Under the user's message: copy it, or edit it (to come). *@
<button class="action" type="button" title="Kopieer" @onclick="() => OnCopy.InvokeAsync(Turn.UserText)"><span class="ic i-copy" aria-hidden="true"></span></button>
<button class="action" type="button" title="Wysig die boodskap" @onclick='() => OnComingSoon.InvokeAsync("Wysig")'><span class="ic i-pencil" aria-hidden="true"></span></button>

@code {
    [Parameter, EditorRequired] public Turn Turn { get; set; } = default!;
    [Parameter] public EventCallback<string> OnCopy { get; set; }
    [Parameter] public EventCallback<string> OnComingSoon { get; set; }
}

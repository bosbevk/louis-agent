@* A new password, with the current one to prove it's the person. An account that signs in only through a provider
   has no password to change; setting one from nothing is a later step. *@
@if (Me.HasPassword)
{
    <section class="account-section">
        <h2>@Text.ChangePassword</h2>
        <form class="account-form" @onsubmit="ChangeAsync">
            <AccountNotice Message="@_notice?.Message" Details="_notice?.Details ?? []" IsError="@_isError" />
            <PasswordField Label="@Text.CurrentPassword" @bind-Value="_current" />
            <PasswordField Label="@Text.NewPassword" @bind-Value="_password" Autocomplete="new-password" Hint="@Text.PasswordRules" />
            <PasswordField Label="@Text.ConfirmPassword" @bind-Value="_again" Autocomplete="new-password" />
            <div class="account-actions">
                <button class="account-button is-plain" type="submit" disabled="@_busy">@Text.ChangePassword</button>
            </div>
        </form>
    </section>
}

@inject IJSRuntime JS
@inject ChatText Text

<div class="turn @(Streaming ? "streaming" : "")">
    @if (HasUserMessage)
    {
        <div class="user-message">
            @if (ShowsUserText)
            {
                <div class="user-text">@Turn.UserText</div>
            }
            @if (Turn.AttachmentNames.Count > 0)
            {
                <div class="attachments">
                    @foreach (var name in Turn.AttachmentNames)
                    {
                        <span class="chip">📄 @name</span>
                    }
                </div>
            }
        </div>
        @if (UserActions is not null && !Streaming)
        {
            <div class="message-actions user-actions">@UserActions(Turn)</div>
        }
    }

    <div class="assistant-message" @ref="_answer">
        <BlocksView Blocks="Turn.Blocks" Streaming="Streaming" Currency="Currency" Shown="Shown" ShowWork="ShowWork"
                    Answer="@Answer" Chosen="Chosen"/>

        @if (Streaming && (Turn.Blocks.Count == 0 || Turn.Blocks[^1] is { Kind: BlockKind.Tool }))
        {
            <div class="working"><span class="spinner" aria-hidden="true"></span>@WorkStatus.Label(Turn, Text)</div>
        }
        @if (Turn.StopReason == "cancelled")
        {
            <div class="stopped">@Text.Stopped</div>
        }
        @if (Turn.Error is not null)
        {
            <div class="error">@Turn.Error</div>
        }
        @if (ShowUsage && Turn.Usage is { } usage)
        {
            <div class="usage" title="@UsageFormat.Detail(usage, Currency)">@UsageFormat.Line(usage, Currency)</div>
        }
        @if (AnswerActions is not null && !Streaming)
        {
            <div class="message-actions">@AnswerActions(Turn)</div>
        }
    </div>
</div>

{
  "kind": "classes",
  "title": "F97.1 one skill, used in the chat that made it: the interface design",
  "caption": "Each new type is marked with the step that builds it; ScriptTool, ScriptToolDefinition, MarkdownSkillLoader's runnable half, ExecuteSkill, CreateTool and CreateSkillFile go in step 14.",
  "classes": {
    "types": [
      {
        "id": "skill",
        "name": "Skill",
        "kind": "record, step 1",
        "members": [
          "string Name",
          "string Description",
          "string Instructions",
          "string ScriptPath",
          "ScriptLanguage Language",
          "JsonElement Parameters",
          "SkillState State"
        ]
      },
      {
        "id": "reader",
        "name": "SkillReader",
        "kind": "static, step 1",
        "members": [
          "Skill Read(string folder, SkillState state)",
          "refuses with what to change"
        ]
      },
      {
        "id": "headers",
        "name": "PromptHeaders",
        "kind": "changed in step 2",
        "members": [
          "metadata.script read as a string"
        ]
      },
      {
        "id": "check",
        "name": "SkillArguments",
        "kind": "static, step 3",
        "members": [
          "IReadOnlyList<string> Problems(JsonElement schema, JsonElement args)"
        ]
      },
      {
        "id": "runner",
        "name": "SkillRunner",
        "kind": "class, step 4",
        "members": [
          "string Run(Skill skill, JsonElement args)"
        ]
      },
      {
        "id": "files",
        "name": "SkillFiles",
        "kind": "changed in step 5",
        "members": [
          "string Folder(string name)",
          "string Draft(string name)",
          "string DraftsFolder",
          "string SchemaFile"
        ]
      },
      {
        "id": "library",
        "name": "SkillLibrary",
        "kind": "class, steps 6 and 9",
        "members": [
          "IReadOnlyList<Skill> Approved",
          "Skill? Find(string name, Conversation chat)",
          "void Draft(Skill skill, Conversation chat)",
          "string Approve(string name)",
          "string Reject(string name)"
        ]
      },
      {
        "id": "tool",
        "name": "SkillListing",
        "kind": "static, step 7",
        "members": [
          "string LinesFor(IReadOnlyList<Skill> approved)",
          "one line each: name and description"
        ]
      },
      {
        "id": "own",
        "name": "SkillTools (the engine's own)",
        "kind": "rewritten, steps 8, 10, 13",
        "members": [
          "string CreateSkill(name, skillMarkdown, parametersSchema, script, scriptFile, example)",
          "string UseSkill(string name, JsonElement? arguments)",
          "string ListSkills()",
          "string ReloadSkills()"
        ]
      },
      {
        "id": "commands",
        "name": "UserCommands",
        "kind": "changed in steps 11 and 12",
        "members": [
          "/skills  /approve  /reject",
          "the note for the next message"
        ]
      }
    ],
    "relations": [
      { "from": "reader", "to": "skill", "kind": "creates" },
      { "from": "reader", "to": "headers", "kind": "uses" },
      { "from": "library", "to": "reader", "kind": "uses" },
      { "from": "library", "to": "files", "kind": "uses" },
      { "from": "own", "to": "tool", "kind": "uses" },
      { "from": "tool", "to": "skill", "kind": "uses" },
      { "from": "own", "to": "library", "kind": "uses" },
      { "from": "own", "to": "check", "kind": "uses" },
      { "from": "own", "to": "runner", "kind": "uses" },
      { "from": "commands", "to": "library", "kind": "uses" }
    ]
  }
}

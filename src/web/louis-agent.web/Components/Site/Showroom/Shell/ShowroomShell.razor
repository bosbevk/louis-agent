@* The showroom's frame (F127.1): a slim bar of its own, the demos as chips on a phone, the rail beside the stage on a
   wider screen, and the corner. It wears the colour of the demo on screen, so everything in it is lit in it. The
   corner stands beside the frame, not in it: the frame is a layer of its own, and the guide's spotlight would dim a
   corner inside it. *@
<div class="@Classes">
    <header class="showroom-bar">
        <a class="showroom-brand" href="@BrandHref">@Brand</a>
        <span class="showroom-pill">@Text.Demos</span>
        <span class="showroom-grow"></span>
        @* On a demo, a way back to all of them (F127.2); the start is all of them, so it has none. *@
        @if (Current is not null)
        {
            <a class="showroom-demos" href="@DemosHref">← @Text.AllDemos</a>
        }
        <a class="showroom-back" href="@BackHref">← @Text.BackToSite</a>
        @Offer
    </header>
    <DemoChips Demos="Demos" Current="Current" Text="Text" />
    <div class="showroom-body">
        <DemoRail Demos="Demos" Current="Current" Text="Text" />
        <main class="showroom-stage">@ChildContent</main>
    </div>
</div>
@if (Corner is not null)
{
    <div class="showroom-corner">@Corner</div>
}

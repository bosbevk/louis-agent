{
  "kind": "sequence",
  "title": "CL65.3 every picture says its type: a flow's type, from its file to its picture",
  "caption": "A flow says its own type and the reader checks it: no other kind has to write one.",
  "sequence": {
    "participants": [
      { "id": "tool", "label": "doc-diagrams", "icon": "terminal", "tone": "violet" },
      { "id": "reader", "label": "DiagramReader", "icon": "code", "tone": "teal" },
      { "id": "types", "label": "DiagramTypes", "icon": "code", "tone": "teal" },
      { "id": "drawing", "label": "FlowDrawing", "icon": "code", "tone": "green" },
      { "id": "builder", "label": "PictureBuilder", "icon": "box", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "tool", "to": "reader", "text": "Read(json), \"type\": \"activity\"" },
      { "step": "message", "from": "reader", "to": "types", "text": "may a flow be an activity diagram?" },
      { "step": "reply", "from": "types", "to": "reader", "text": "yes" },
      { "step": "note", "over": [ "reader" ], "text": "no type on a flow, or one that is not a flow's: refused, saying which it may be" },
      { "step": "reply", "from": "reader", "to": "tool", "text": "DiagramSource, Type = Activity" },
      { "step": "message", "from": "tool", "to": "drawing", "text": "Of(source), through its renderer" },
      { "step": "message", "from": "drawing", "to": "builder", "text": "Type(\"Activity diagram\")" },
      { "step": "reply", "from": "builder", "to": "drawing", "text": "the SVG, its type at the right of the title's line" }
    ]
  }
}

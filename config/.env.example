# LLM Configuration - see ../docs/MODELS.md for the models and what they cost
#
# LLM_PROFILE picks the file with the LLM settings: config/.env.anthropic (Claude, needs ANTHROPIC_API_KEY in
# .env.secrets) or config/.env.ollama (local, free). Switch here, or for one run from the shell:
#   LLM_PROFILE=ollama dotnet run --project src/louis-agent.cli
# A LLM_* setting written in this file overrides the profile's, so leave them out unless you mean to pin one.
LLM_PROFILE=anthropic

# Usage ledger: one JSON line per model request (tokens, model, timing; never prompt text) in
# {LOG_DIRECTORY}/usage-YYYY-MM.jsonl. On by default; the containers set LOG_DIRECTORY themselves (logs/ on the host).
# For dotnet run outside Docker, set LOG_DIRECTORY too, or the ledger is off with a warning.
# USAGE_LEDGER=off
# LOG_DIRECTORY=logs
# (absolute is safer: Rider and dotnet run start in different folders, e.g. C:\path\to\louis-agent\logs)
# Rider: add each turn's usage line (tokens, cost, session total) to the chat after the answer. Off when unset.
# USAGE_IN_CHAT=true
# Each record is priced from config/prices.json (tracked; update it when prices change). Another table:
# PRICES_FILE=C:\path\to\prices.json
# Or fetch it from louis-agent.api (falls back to the file if it can't be reached):
# PRICES_URL=http://127.0.0.1:5080/prices
# Costs are shown in the PC's currency (F14): the containers can't see Windows' region, so write it here once with
#   dotnet run --project tools/louis-agent.usage-probe -- --host-culture
# HOST_CULTURE=en-ZA
# Or choose a currency yourself (overrides HOST_CULTURE):
# DISPLAY_CURRENCY=EUR
# Exchange rates: fetched at start-up (default Frankfurter, the ECB's reference rates), mapped into our rates.json
# format; config/rates.json (tracked) when the URL can't be reached. RATES_URL=off uses the file only.
# RATES_URL=https://api.frankfurter.dev/v1/latest?base=USD
# RATES_FORMAT=frankfurter
# RATES_FILE=C:\path\to\rates.json

# Agent Configuration

# Web search engine for the WebSearch tool: tavily | google | searxng | duckduckgo
# Unset = Tavily when TAVILY_API_KEY is set (config/.env.secrets), else Google when GOOGLE_SEARCH_API_KEY and
# GOOGLE_SEARCH_ENGINE_ID are, else SearXNG when SEARXNG_URL is, else DuckDuckGo (keyless, but it refuses repeated
# searches). SearXNG is the one we run in the Puls stack (F32), for development and benchmarks only: the sold endpoint
# keeps a licensed API (ADR 0023).
# WEB_SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://puls-searxng:8080

# Page renderer for ReadRenderedPage (and VerifyQuote's fallback): chrome | tavily. Unset = the headless Chrome we run
# when BROWSER_URL is set (the Puls stack sets it), else Tavily Extract when TAVILY_API_KEY is.
# PAGE_RENDERER=chrome
# BROWSER_URL=http://puls-browser:9222
# What that browser tells every site it reads for a user (FX21): who reads, where to learn more, and why; the Puls
# compose and Azure yaml set it to name Puls. Unset, Chrome's own. Never a person's name or place: it reaches every
# site and tracker a page touches.
# BROWSER_USER_AGENT=Puls/1.0 (+https://github.com/bosbevk/louis-agent/blob/main/docs/SITE_OWNERS.md; reads a page on a user's behalf)
# The browser and Mongo stay on 127.0.0.1 here. puls-app on Azure reaches them over Tailscale: `tailscale serve` on this
# PC forwards the two tailnet ports to loopback (deploy/azure/README.md, "The tunnel"); no compose setting is involved.

# The shops pack's own settings (CL15 step 4; the pack loads with Puls or with PACKS=shops). The shops whose own
# catalogue the shops toolset may read (F33), comma-separated: checkers. Unset, the toolset is off.
# It reads the shop's site through the browser above, so it needs BROWSER_URL too. For development and benchmarks until
# the shops' terms are checked (ADR 0023).
# SHOP_CATALOGUES=checkers
# Where each town's store at a shop is kept, a day, across restarts (F34); unset keeps it in memory only. The Puls
# compose file sets it to /data/shop-stores.json (the host's data/puls).
# SHOP_STORE_CACHE=

# Where a benchmark started from the admin portal (F27) reaches this API: the script runs inside the container and
# calls it back. Default: the container's own port.
# BENCHMARK_API_URL=http://127.0.0.1:8080/

# The benchmark store's database (F31; the store itself is BENCHMARKS_MONGO_URL in config/.env.secrets). Default:
# puls_benchmarks. The Mongo contract tests use puls_benchmarks_test on the same server.
# BENCHMARKS_MONGO_DATABASE=puls_benchmarks

# The C# eval runner's dll (F18 step 4.3): the API lists the evals with `dotnet {EVAL_RUNNER} --list` and starts one with `run`.
# Unset, it is the image's path, /app/evals/louis-agent.evals.runner.dll; set it only to run the API outside a container.
# EVAL_RUNNER=/app/evals/louis-agent.evals.runner.dll

# Peer agents this one may hand a task to with StartSubSession (the "specialists" toolset, F5): name=url pairs, comma
# separated. Puls (docker/docker-compose.puls.yml) sets its own; the code-review api has none unless set here.
# AGENT_PEERS=coder=http://some-peer:8080
# Who the agent is and what it can do (CL15, ADR 0027): the identities (puls) and the packs (shops) a host loads at
# start-up, comma separated. An identity's packs load with it (Puls names shops); PACKS adds one on its own, so the
# coding agent gets the shops toolset with PACKS=shops and the two shop settings below. Leave both unset here: every
# compose file passes this file to its containers, and only the Puls compose sets IDENTITIES=puls, so the code-review
# stack never carries Puls.
# IDENTITIES=puls
# PACKS=shops
# The time zone GetToday and the API's place line use when the user shared none (CL15: core names no country), an IANA
# name; one this machine doesn't know stops the host at start-up. Unset: the machine's own. The Puls compose sets
# Africa/Johannesburg in both its agent containers.
# HOST_TIME_ZONE=Africa/Johannesburg
# The roles this instance may use (F29), comma separated; a session or sub-session asking for another is
# refused as for an unknown one. Empty: every built-in one (louis-agent.core/Prompts). Puls's compose reads this for both its
# containers and defaults to puls/voice-af,puls/voice-en,puls-cook,puls-minion-web-price-lookup when it's unset: only a role that has
# passed its check is on. To turn one on, add it here (…,puls-researcher) and `docker compose … up -d`; set it empty to turn every role on.
# PERSONALITIES_ENABLED, its name before CL14, is still read when this is unset, with a warning.
# ROLES_ENABLED=puls/voice-af,puls/voice-en,puls-cook,puls-minion-web-price-lookup
# The LLM profiles a session may name besides this instance's model (F30), each a config/.env.{name} file: a session
# opened with "llm": "ollama-puls" runs on that profile's model, every other on LLM_PROFILE's.
# LLM_SESSION_PROFILES=ollama-puls
# The model a minion runs on (F30): role=profile entries, * for every other role, "instance" for this instance's own
# model, and > for a cascade, cheapest first (the specialist asks for the next one after a failed check). Every profile
# must be in LLM_SESSION_PROFILES; unset, there is no minions toolset. Puls's compose sets neither (CL19: one container);
# set both here to turn the minions on.
# MINION_LLMS=*=instance                 (Puls's default: Claude Haiku 5.5; *=ollama-puls>instance tries the local model first)
# The most tokens a sub-session's prompt should reach (FX14): when the next request is expected to pass it, the
# specialist answers from what it has instead of calling more tools. Default 80000, below 100000 (Haiku 5.5's long-prompt price
# starts there), so the forced last request, with its last tool results, stays under the step; 0 turns it off.
# SUB_SESSION_PROMPT_BUDGET=80000

# louis-agent.mcp-server transport: stdio (default, local subprocess clients like Rider/Claude Desktop) or http
# (Streamable HTTP, for a remote MCP client such as an agent built on another provider's SDK). http needs
# MCP_API_KEY (falls back to AGENT_API_KEY) set in .env.secrets - it exposes the same shell/git/file-write tools
# over the network.
# MCP_TRANSPORT=http
# MCP_PORT=5090

# Whether a host that serves over the network may start without a key (FX18): required (the default; the API, and
# the MCP server over HTTP, refuse to start without AGENT_API_KEY or MCP_API_KEY) or off (they start without one, on
# purpose, with a warning; a key that is set is still checked). Set off only on a machine where the port stays on
# 127.0.0.1, in this file, never in a compose file.
# AGENT_AUTH=required

# Rider MCP Integration - LOCAL DEVELOPMENT ONLY
# Discovery lists Rider's MCP tools in the log; the agent can't call them yet (see docs/ARCHITECTURE.md)
# MCP cannot work in Docker (Rider only accepts localhost connections)
# For local dev, run the proxy: dotnet run -p services/rider-mcp-proxy
RIDER_MCP_ENDPOINT=http://127.0.0.1:64482
RIDER_MCP_AUTO_DISCOVER=false

# Multi-repo Support (Docker)
# Path to mount additional repositories in containers
REPOSITORIES_PATH=C:\Repositories

# ACP Mount Mappings - How Windows paths map to Docker container paths
# Format: HOST_PATH=/container/path
ACP_MOUNT_MAPPINGS=C:\Repositories=/repositories

# Secrets Configuration
# Copy .env.secrets.example to .env.secrets and fill in actual values:
# - ANTHROPIC_API_KEY (get from https://console.anthropic.com)
# - PAYMO_API_KEY (get from Paymo account settings)
# - DEVOPS_API_KEY (Azure DevOps personal access token)
# - RIDER_MCP_PROJECT_PATH (local development only)

# Azure DevOps (the DevOps tools also need DEVOPS_API_KEY in .env.secrets)
# Sprints are iterations under the project, or under the team when DEVOPS_TEAM is set.
# DEVOPS_ORGANIZATION=your-organisation      # dev.azure.com/<organisation>
# DEVOPS_PROJECT=Your Project
# DEVOPS_TEAM=Your Team

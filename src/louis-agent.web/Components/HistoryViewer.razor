@* A branch (its commits and what merging it would bring) or a single commit, with its diff. *@

<div class="file-viewer">
    <header class="file-header">
        @if (Branch is { } b)
        {
            <div class="file-title">
                <span class="file-path" title="@b.Branch.Name">⎇ @b.Branch.Name</span>
                <span class="file-meta">
                    @if (b.Branch.Merged)
                    {
                        <text>merged into @b.Into</text>
                    }
                    else
                    {
                        <text>@b.Branch.Ahead commit@(b.Branch.Ahead == 1 ? "" : "s") to merge into @b.Into</text>
                        @if (b.Branch.Behind > 0) { <text> · @b.Into is @b.Branch.Behind ahead of where it started</text> }
                    }
                    · last commit by @b.Branch.Author, @BranchesPanel.Ago(b.Branch.Date)
                </span>
            </div>
            <div class="file-actions">
                @if (!b.Branch.Merged && !b.Branch.Current)
                {
                    <button class="send" disabled="@Busy" @onclick="() => OnMerge.InvokeAsync(b.Branch.Name)">Merge into @b.Into</button>
                }
                else if (b.Branch.Merged)
                {
                    <button class="secondary" disabled="@Busy" @onclick="() => OnDelete.InvokeAsync(b.Branch.Name)">Delete branch</button>
                }
                <button class="icon" title="Close" @onclick="OnClose">×</button>
            </div>
        }
        else if (Commit is { } c)
        {
            <div class="file-title">
                <span class="file-path" title="@c.Commit.Sha"><span class="sha">@c.Commit.ShortSha</span> @c.Commit.Subject</span>
                <span class="file-meta">
                    @c.Commit.Author · @BranchesPanel.Ago(c.Commit.Date)
                    @if (c.Commit.IsMerge) { <text> · merge commit (diff against its first parent)</text> }
                    @foreach (string reference in c.Commit.Refs)
                    {
                        <span class="ref">@reference</span>
                    }
                </span>
            </div>
            <div class="file-actions">
                <button class="icon" title="Close" @onclick="OnClose">×</button>
            </div>
        }
    </header>

    <div class="diff-body">
        @if (Branch is { Commits.Count: > 0 } withCommits)
        {
            <div class="history-commits">
                @foreach (var commit in withCommits.Commits)
                {
                    <button class="history-commit" title="Show this commit" @onclick="() => OnOpenCommit.InvokeAsync(commit.Sha)">
                        <span class="sha">@commit.ShortSha</span> @commit.Subject <span class="change-folder">@commit.Author · @BranchesPanel.Ago(commit.Date)</span>
                    </button>
                }
            </div>
        }
        @if (Commit is { Body.Length: > 0 } withBody && withBody.Body.Trim() != withBody.Commit.Subject)
        {
            <pre class="commit-body">@withBody.Body</pre>
        }
        <PatchView Diff="@(Branch?.Diff ?? Commit?.Diff ?? "")" Truncated="@(Branch?.Truncated ?? Commit?.Truncated ?? false)" />
    </div>
</div>

@code {
    [Parameter] public GitBranchDetail? Branch { get; set; }
    [Parameter] public GitCommitDetail? Commit { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnMerge { get; set; }
    [Parameter] public EventCallback<string> OnDelete { get; set; }
    [Parameter] public EventCallback<string> OnOpenCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}

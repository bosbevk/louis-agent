{
  "kind": "sequence",
  "title": "FX216 one address per page: Google asks for www.louis-agent.dev/home/does/",
  "caption": "A page on another host is sent on for good; at the site's own address a section answers its page, naming the page as the original.",
  "sequence": {
    "participants": [
      { "id": "G", "icon": "user", "tone": "blue", "label": "Googlebot" },
      { "id": "H", "icon": "chip", "tone": "violet", "label": "SitePageHandler" },
      { "id": "R", "icon": "settings", "tone": "violet", "label": "SiteRoutes" },
      { "id": "S", "icon": "file", "tone": "violet", "label": "PageShell" }
    ],
    "steps": [
      { "step": "message", "from": "G", "to": "H", "text": "GET https://www.louis-agent.dev/home/does/" },
      { "step": "message", "from": "H", "to": "R", "text": "PageFor(\"/home/does/\")" },
      { "step": "reply", "from": "R", "to": "H", "text": "route \"/\", HomePage" },
      { "step": "reply", "from": "H", "to": "G", "text": "301 Location: https://louis-agent.dev/home/does/  (step 4)" },
      { "step": "message", "from": "G", "to": "H", "text": "GET https://louis-agent.dev/home/does/" },
      { "step": "message", "from": "H", "to": "S", "text": "Fill(index, rendered, site address, address, route \"/\")" },
      { "step": "reply", "from": "S", "to": "H", "text": "canonical https://louis-agent.dev/  (step 1)" },
      { "step": "reply", "from": "H", "to": "G", "text": "200, the landing's HTML" },
      { "step": "note", "over": ["G"], "text": "the sitemap names only https://louis-agent.dev/ (step 2), so nothing points Google at the section" }
    ]
  }
}

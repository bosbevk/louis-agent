{
  "kind": "classes",
  "title": "F127.4.1 cards the agent draws: the interface design",
  "caption": "A ticket is one more diagram kind: the site pack's tools check what the agent wrote, and the widget draws what the stream carries.",
  "classes": {
    "types": [
      {
        "id": "ticket",
        "name": "TicketSpec",
        "kind": "record, louis-agent.diagrams, step 2",
        "members": [
          "+Kicker, Title, Subtitle?",
          "+TicketStatus? Status",
          "+IReadOnlyList<TicketRow> Rows",
          "+Note?"
        ]
      },
      {
        "id": "row",
        "name": "TicketRow, TicketStatus",
        "kind": "records, step 2",
        "members": [
          "+Row: DiagramIcon Icon, Label, Value",
          "+Status: Label, DiagramTone Tone"
        ]
      },
      {
        "id": "source",
        "name": "DiagramSource",
        "kind": "record, changed in step 2",
        "members": [
          "+Ticket TicketSpec?",
          "DiagramKind.Ticket"
        ]
      },
      {
        "id": "layout",
        "name": "TicketLayout",
        "kind": "static, step 4",
        "members": [
          "+Place(TicketSpec, width) PlacedTicket"
        ]
      },
      {
        "id": "renderer",
        "name": "TicketRenderer",
        "kind": "IDiagramRenderer, step 4",
        "members": [
          "+Render(source) string: colours as CSS variables"
        ]
      },
      {
        "id": "tools",
        "name": "SiteTools",
        "kind": "louis-agent.pack.site, changed",
        "members": [
          "+ShowPage(path)",
          "+ShowCard(kicker, title, subtitle?, status?, rows, note?) step 5",
          "+Offer(question, choices) step 6"
        ]
      },
      {
        "id": "choice",
        "name": "OfferChoice",
        "kind": "record, step 6",
        "members": [
          "+Label, Why?, Suggested"
        ]
      },
      {
        "id": "reader",
        "name": "DiagramReader",
        "kind": "louis-agent.diagrams, kept",
        "tone": "violet",
        "members": [
          "+Read(json) DiagramSource"
        ]
      },
      {
        "id": "calls",
        "name": "CardCall, OfferCall",
        "kind": "louis-agent.web, steps 7 and 8",
        "members": [
          "+SourceOf(Block) DiagramSource?",
          "+ChoicesOf(Block) Offered?"
        ]
      },
      {
        "id": "views",
        "name": "DrawnCard, OfferCards",
        "kind": "components, steps 7 and 8",
        "members": [
          "+the card's SVG, shown with the work hidden too",
          "+Chosen EventCallback<string>, folded once answered"
        ]
      },
      {
        "id": "runner",
        "name": "ChatRunner",
        "kind": "louis-agent.web, kept",
        "tone": "violet",
        "members": [
          "+Draft, SendAsync()"
        ]
      }
    ],
    "relations": [
      { "from": "ticket", "to": "row", "kind": "holds" },
      { "from": "source", "to": "ticket", "kind": "holds" },
      { "from": "renderer", "to": "layout", "kind": "uses", "word": "places" },
      { "from": "tools", "to": "reader", "kind": "uses", "word": "checks the card" },
      { "from": "tools", "to": "choice", "kind": "uses" },
      { "from": "calls", "to": "source", "kind": "creates" },
      { "from": "views", "to": "calls", "kind": "uses", "word": "reads the block" },
      { "from": "views", "to": "renderer", "kind": "uses", "word": "draws" },
      { "from": "views", "to": "runner", "kind": "uses", "word": "a click sends" }
    ]
  }
}

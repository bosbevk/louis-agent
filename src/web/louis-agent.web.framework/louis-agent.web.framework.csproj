<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The framework's pages (F160.1): the framework told to a developer, page by page, as a package a site turns on
       with .Framework(), as it turns on the accounts. framework.louis-agent.dev is the site that names it. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Web.Framework</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The framework's web: the parts the pages are configured from, and the areas a site names. -->
    <ProjectReference Include="..\louis-agent.web\louis-agent.web.csproj" />
    <!-- The docs' parts: each section ends with links to its docs by their paths. -->
    <ProjectReference Include="..\louis-agent.web.docs\louis-agent.web.docs.csproj" />
  </ItemGroup>

</Project>

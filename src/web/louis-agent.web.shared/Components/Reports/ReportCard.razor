@* F35.7: one report: its name, what its numbers are, and its table, or a line saying nothing's been counted yet. *@
<section class="card-p report-card">
    <div class="card-head">
        <strong><code>@Report.Name</code></strong>
    </div>
    <p class="muted">@Report.Description</p>

    @if (Report.Rows.Count == 0)
    {
        <p class="muted">Nothing counted yet.</p>
    }
    else
    {
        <div class="prompts">
            <table class="prompts-table report-table">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var column in Report.Columns)
                        {
                            <th>@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Report.Rows)
                    {
                        <tr class="report-row">
                            <td>@row.Label</td>
                            @foreach (var count in row.Counts)
                            {
                                <td>@count</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

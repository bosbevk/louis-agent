<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the site's CSS films to animated WebP for the README, frame by frame. A person runs it after changing a film;
       nothing ships it. ffmpeg runs from a Docker image, so nobody installs it and it never reaches a product. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.FilmExport</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\engine\louis-agent.composition\louis-agent.composition.csproj" />
    <PackageReference Include="PuppeteerSharp" Version="25.14.0" />
  </ItemGroup>

</Project>

@* A showroom business's demo (F128.2, in the showroom since F127.1): its stage in its colour, its conversation played
   on a mock of its own website with its sample brand, the cues of what to watch lit as the play reaches them, and the
   offer. The business is made up and says so; the conversation is real, recorded once, and once it has played the
   visitor can try the agent live (F127.2). *@
<DemoStage Accent="Accent" Kicker="@KickerLine">
    <Title>@Heading</Title>
    <Lede>
        @Lede <span class="stage-made-up">@Business is a made-up business. The conversation is real, recorded once
            and played back. Nothing runs while you watch.</span>
    </Lede>
    <Player>
        <SiteMock Address="@Address" Business="@Business" Colours="Colours" Font="Font" Mark="Mark" Tagline="@Tagline"
                  HeroLine="@HeroLine" HeroNote="@HeroNote" AgentLabel="@AgentLabel" Look="Look"
                  HeroPhoto="@HeroPhoto" HeroPhotoAlt="@HeroPhotoAlt" HeroAction="@HeroAction" Facts="Facts"
                  Pages="Pages" Shown="@_shown" Went="Go" Live="_trying" Header="Header">
            <Agent>
                @* Trying it (F127.2): the business's agent live in the same corner, until the visitor goes back. *@
                @if (_trying)
                {
                    <MockLiveChat Identity="@Identity" Hint="@Hint" Placeholder="@($"Ask {Business}…")"
                                  ToolCalled="Show" Left="Watch" />
                }
                else
                {
                    @* At a person's pace (Louis: "slow it down like realtime"): the agent writes at an easy reading
                       speed, and the visitor's next question comes after a breath, as they read and type. Once it has
                       played, the visitor can try it themselves. *@
                    <RecordedChat @ref="_chat" Turns="Turns" Title="@Address" PlayAgain="Play it again"
                                  ShowWork="false" Pace="2.5" TurnGap="2200" TurnStarted="Reach" ToolCalled="Show">
                        <Ending>
                            <button class="demo-try" type="button" @onclick="Try">@Words.TryItYourself</button>
                        </Ending>
                    </RecordedChat>
                }
            </Agent>
        </SiteMock>
    </Player>
    <Cues>
        <DemoCues Cues="Cues" Reached="_reached" Heading="What to watch" Hint="Watch from here"
                  Chosen="PlayFrom" Waiting="_trying" />
    </Cues>
    <Notes>
        <DemoNotes Kicker="Make it yours" Heading="@($"A custom agent for your {KindOf} could also")"
                   Notes="CustomNotes" />
    </Notes>
    <Offer>
        <span>Want an agent like this on your own website? From R500 a month.</span>
        <a href="/contact">Ask for yours →</a>
    </Offer>
</DemoStage>

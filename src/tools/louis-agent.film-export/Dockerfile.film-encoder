# libwebp's own tools, for louis-agent.film-export: a person runs it after changing a film, and nothing ships it. Pinned, so a
# re-export months later encodes the same way (ADR 0077).
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache libwebp-tools=1.3.2-r0

{
  "kind": "classes",
  "title": "F167: the rename tool's interface design",
  "caption": "The run reads every project's new name, rewrites the tracked files' words, then moves the folders and files; what it can't be sure of comes out in its report.",
  "classes": {
    "types": [
      { "id": "run", "name": "RenameRun", "kind": "step 5",
        "members": [ "RenameReport Run(bool check)" ] },
      { "id": "report", "name": "RenameReport", "kind": "record, step 5",
        "members": [ "int Projects", "int FilesRewritten", "int FilesMoved", "IReadOnlyList<LeftoverWord> Leftovers" ] },
      { "id": "map", "name": "NameMap", "kind": "step 2",
        "members": [ "IReadOnlyList<ProjectRename> Renames", "static NameMap Read(string repoRoot)" ] },
      { "id": "rename", "name": "ProjectRename", "kind": "record, step 2",
        "members": [ "string OldName", "string NewName", "string Folder" ] },
      { "id": "listed", "name": "ListedNames", "kind": "static, step 2",
        "members": [ "IReadOnlyDictionary<string, string> ByOldName" ] },
      { "id": "rewriter", "name": "NameRewriter", "kind": "step 3",
        "members": [ "RewriteOutcome Rewrite(string text)", "string RenameFile(string fileName)" ] },
      { "id": "outcome", "name": "RewriteOutcome", "kind": "record, step 3",
        "members": [ "string Text", "int Replaced" ] },
      { "id": "leftovers", "name": "LeftoverWords", "kind": "step 3",
        "members": [ "IReadOnlyList<LeftoverWord> Find(string text, string path)" ] },
      { "id": "leftover", "name": "LeftoverWord", "kind": "record, step 3",
        "members": [ "string Word", "string Path", "int Line" ] },
      { "id": "tracked", "name": "TrackedFiles", "kind": "static, step 4",
        "members": [ "IReadOnlyList<string> Read(string repoRoot)" ] },
      { "id": "mover", "name": "FileMover", "kind": "step 4",
        "members": [ "int Move(string repoRoot, NameRewriter rewriter)" ] }
    ],
    "relations": [
      { "from": "run", "to": "map", "kind": "holds" },
      { "from": "run", "to": "rewriter", "kind": "holds" },
      { "from": "run", "to": "leftovers", "kind": "holds" },
      { "from": "run", "to": "mover", "kind": "holds" },
      { "from": "run", "to": "tracked", "kind": "uses" },
      { "from": "run", "to": "report", "kind": "creates" },
      { "from": "map", "to": "rename", "kind": "holds", "word": "one per project" },
      { "from": "map", "to": "listed", "kind": "uses", "word": "the eight it can't read" },
      { "from": "rewriter", "to": "map", "kind": "uses", "word": "longest first" },
      { "from": "rewriter", "to": "outcome", "kind": "creates" },
      { "from": "leftovers", "to": "leftover", "kind": "creates" },
      { "from": "mover", "to": "rewriter", "kind": "uses" }
    ]
  }
}

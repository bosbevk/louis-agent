{
  "kind": "sequence",
  "title": "CL65.5 the pictures a project needs: one doc is held to its floor",
  "caption": "The rule reads a doc, asks the floor what its kind needs, adds the doc's own list, and compares that with the types of the pictures it shows.",
  "sequence": {
    "participants": [
      {
        "id": "test",
        "label": "ProjectDocsTests",
        "icon": "checks",
        "tone": "violet"
      },
      {
        "id": "doc",
        "label": "ProjectDoc",
        "icon": "file",
        "tone": "teal"
      },
      {
        "id": "reader",
        "label": "DiagramReader",
        "icon": "code",
        "tone": "blue"
      },
      {
        "id": "floor",
        "label": "ProjectFloor",
        "icon": "box",
        "tone": "green"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "test",
        "to": "doc",
        "text": "Read(path)"
      },
      {
        "step": "note",
        "over": [
          "doc"
        ],
        "text": "the kind line: its kind, and what it also shows"
      },
      {
        "step": "message",
        "from": "doc",
        "to": "reader",
        "text": "Read(json), for each picture the doc links"
      },
      {
        "step": "reply",
        "from": "reader",
        "to": "doc",
        "text": "its kind and its type"
      },
      {
        "step": "reply",
        "from": "doc",
        "to": "test",
        "text": "Kind, Own, Shown"
      },
      {
        "step": "message",
        "from": "test",
        "to": "floor",
        "text": "Asked(doc)"
      },
      {
        "step": "reply",
        "from": "floor",
        "to": "test",
        "text": "the kind's floor and the doc's own list"
      },
      {
        "step": "note",
        "over": [
          "test"
        ],
        "text": "asked and shown must be the same set"
      }
    ]
  }
}

@* Search the chats saved in this browser: their titles, your messages and the answers. Arrow keys move, Enter opens,
   Escape closes. Nothing leaves the browser. *@
@inject NavigationManager Nav

@if (Open)
{
    <div class="search-backdrop" @onclick="Close"></div>
    <div class="search-dialog" role="dialog" aria-modal="true" aria-label="@Text.SearchChats">
        <div class="search-input">
            <span class="ic i-search" aria-hidden="true"></span>
            <input id="search-input" placeholder="@Text.SearchPlaceholder" autocomplete="off" @ref="_input"
                   @bind="_query" @bind:event="oninput" @bind:after="Reset" @onkeydown="Key" @onkeydown:preventDefault="_handled" />
            <kbd>Esc</kbd>
        </div>
        <div class="search-results">
            @if (Results.Count == 0)
            {
                <div class="search-none">@string.Format(Text.NoChatsFor, _query)</div>
            }
            else
            {
                <div class="search-group">@(_query.Trim().Length == 0 ? Text.Recent : Text.Chats)</div>
                @for (int i = 0; i < Results.Count; i++)
                {
                    var (chat, snippet) = Results[i];
                    int index = i;
                    <button class="search-result @(index == _selected ? "selected" : "")" @onclick="() => Go(chat)" @onmouseenter="() => _selected = index">
                        <span class="ic i-chat" aria-hidden="true"></span>
                        <span class="search-text">
                            <strong>@chat.Title</strong>
                            @if (snippet is not null)
                            {
                                <small>@snippet</small>
                            }
                        </span>
                        @if (chat.Archived)
                        {
                            <span class="search-tag">@Text.Archived</span>
                        }
                    </button>
                }
            }
        </div>
        <div class="search-foot"><kbd>↑</kbd><kbd>↓</kbd> @Text.SearchChoose · <kbd>Enter</kbd> @Text.SearchOpen</div>
    </div>
}

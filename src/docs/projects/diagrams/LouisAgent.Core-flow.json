{
  "kind": "flow",
  "type": "activity",
  "title": "LouisAgent.Core: one turn, step by step",
  "caption": "A turn appends the message, asks the model, runs each tool call it asks for behind the guards, round after round, and appends the whole turn at the end. Every request is written to the ledger, priced.",
  "flow": {
    "direction": "down",
    "nodes": [
      {
        "id": "start",
        "label": "A message\nfrom a host",
        "icon": "message",
        "tone": "blue",
        "shape": "terminal"
      },
      {
        "id": "append",
        "label": "Append it\nto the history",
        "icon": "stack",
        "tone": "green"
      },
      {
        "id": "ask",
        "label": "Ask the model\nhistory, tools, reasoning",
        "icon": "chip",
        "tone": "violet"
      },
      {
        "id": "ledger",
        "label": "Write the request\nto the ledger, priced",
        "icon": "chart",
        "tone": "amber",
        "shape": "data"
      },
      {
        "id": "calls",
        "label": "Tool calls\nasked for?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "cut",
        "label": "Cut off by\nthe output limit?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "skip",
        "label": "Never run it\nask the model to go on",
        "icon": "shield",
        "tone": "green"
      },
      {
        "id": "run",
        "label": "Run the tool\nits failure goes back",
        "icon": "settings",
        "tone": "green"
      },
      {
        "id": "big",
        "label": "Over 50,000\ncharacters?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "sum",
        "label": "Summarise it\na tool-less call",
        "icon": "file",
        "tone": "green"
      },
      {
        "id": "rounds",
        "label": "Fewer than\n10 rounds?",
        "icon": "branch",
        "tone": "green",
        "shape": "decision"
      },
      {
        "id": "end",
        "label": "Append the whole turn\nthinking included",
        "icon": "stack",
        "tone": "green",
        "shape": "terminal"
      }

{
  "kind": "sequence",
  "title": "F171.1 a photo or a PDF reaches a tool: a tool reads an upload",
  "caption": "The photo travels as bytes to the API and stays with the session. The model that runs the conversation sees only its name. The tool hands the file to the reader, which makes one model call and writes one ledger row.",
  "sequence": {
    "participants": [
      { "id": "C", "icon": "user", "tone": "blue", "label": "The caller" },
      { "id": "A", "icon": "server", "tone": "green", "label": "The API's session" },
      { "id": "G", "icon": "chip", "tone": "violet", "label": "The agent" },
      { "id": "T", "icon": "folder", "tone": "teal", "label": "A pack's tool" },
      { "id": "R", "icon": "search", "tone": "violet", "label": "The reader" },
      { "id": "M", "icon": "message", "tone": "violet", "label": "The model" },
      { "id": "L", "icon": "book", "tone": "green", "label": "The ledger" }
    ],
    "steps": [
      { "step": "message", "from": "C", "to": "A", "text": "\"check this\" + account.jpg as bytes, image/jpeg" },
      { "step": "note", "over": ["A"], "text": "type and size checked, kept as a SessionFile" },
      { "step": "message", "from": "A", "to": "G", "text": "\"check this\" + \"attached: account.jpg, image/jpeg, 2.1 MB\"" },
      { "step": "message", "from": "G", "to": "T", "text": "ReadSample(\"account.jpg\")" },
      { "step": "message", "from": "T", "to": "A", "text": "Files.Find(\"account.jpg\")" },
      { "step": "reply", "from": "A", "to": "T", "text": "the SessionFile" },
      { "step": "message", "from": "T", "to": "R", "text": "ReadAsync<SampleAccount>(file, instructions)" },
      { "step": "message", "from": "R", "to": "M", "text": "the instructions, the bytes, the record's schema" },
      { "step": "reply", "from": "M", "to": "R", "text": "JSON that fits the schema" },
      { "step": "message", "from": "R", "to": "L", "text": "one row, purpose \"reading\", with its cost" },
      { "step": "reply", "from": "R", "to": "T", "text": "a SampleAccount" },
      { "step": "reply", "from": "T", "to": "G", "text": "the record as text" }
    ]
  }
}

@* A site's hero (F118, ADR 0106): the words on the left, in the slots a site fills, and what the site puts beside them
   on the right. It marks its place in the section index. The topic, chrome, summary and muted classes are the site's own
   words' look, as a band's topic is; the layout is this component's and sits beside it. *@
<section id="@Id" class="@Classes">
    <AreaMark Id="@Id" Label="@Label" />
    <div class="hero-text">
        @if (Art is not null)
        {
            <div class="hero-art">@Art</div>
        }
        @if (Topic is not null)
        {
            <span class="topic">@Topic</span>
        }
        <h1 class="@HeadlineClasses">
            @if (Lines is not null)
            {
                @for (int at = 0; at < Lines.Count; at++)
                {
                    @* A space between the lines, so the heading still reads as one sentence after another. *@
                    @if (at > 0)
                    {
                        @(" ")
                    }
                    <span class="headline-line">@Lines[at]</span>
                }
            }
            else
            {
                @Headline
            }
        </h1>
        @if (Summary is not null)
        {
            <p class="summary">@Summary</p>
        }
        @if (Note is not null)
        {
            <p class="muted">@Note</p>
        }
        @if (Actions is not null)
        {
            <div class="actions">@Actions</div>
        }
    </div>
    @if (Aside is not null)
    {
        <div class="hero-aside">@Aside</div>
    }
</section>

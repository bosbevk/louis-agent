{
  "kind": "classes",
  "title": "F97 a skill usable in its chat: the interface design",
  "caption": "One kind of thing, a Skill read from its folder; one runner; the engine's own tools CreateSkill and UseSkill over it; the old tool and skill-file types go.",
  "classes": {
    "types": [
      {
        "id": "skill",
        "name": "Skill",
        "kind": "record, F97.1",
        "members": [
          "string Name",
          "string Description",
          "IReadOnlyList<SkillParameter> Parameters",
          "ScriptLanguage Language",
          "string Script",
          "SkillState State",
          "static Skill Parse(string folder)"
        ]
      },
      {
        "id": "parameter",
        "name": "SkillParameter",
        "kind": "record, F97.1 (was ScriptToolParameter)",
        "members": [
          "string Name",
          "string Type",
          "bool Required",
          "string Description"
        ]
      },
      {
        "id": "state",
        "name": "SkillState",
        "kind": "enum, F97.1",
        "members": [
          "Drafted",
          "Approved"
        ]
      },
      {
        "id": "folders",
        "name": "SkillFiles",
        "kind": "changed in F97.1: every path",
        "members": [
          "string Folder(string name)",
          "string Draft(string name)",
          "const string DraftsFolder",
          "const string Marker = SKILL.md"
        ]
      },
      {
        "id": "library",
        "name": "SkillLibrary",
        "kind": "F97.1, replaces the two loaders",
        "members": [
          "IReadOnlyList<Skill> Approved",
          "IReadOnlyList<Skill> DraftsOf(chat)",
          "Skill? Find(string name, chat)"
        ]
      },
      {
        "id": "runner",
        "name": "SkillRunner",
        "kind": "F97.1, JSON on stdin",
        "members": [
          "Task<string> RunAsync(Skill, JsonObject arguments)"
        ]
      },
      {
        "id": "tool",
        "name": "SkillTool : AIFunction",
        "kind": "F97.1 (was ScriptTool)",
        "members": [
          "Skill Skill",
          "the skill under its own name, approved only"
        ]
      },
      {
        "id": "create",
        "name": "CreateSkill",
        "kind": "engine tool, F97.2 (replaces CreateTool, CreateSkillFile)",
        "members": [
          "string CreateSkill(string skillMarkdown, string script)"
        ]
      },
      {
        "id": "door",
        "name": "UseSkill",
        "kind": "engine tool, F97.2 (replaces ExecuteSkill)",
        "members": [
          "Task<string> UseSkill(string name, JsonObject arguments)"
        ]
      },
      {
        "id": "commands",
        "name": "UserCommands",
        "kind": "changed in F97.2",
        "members": [
          "/skills  /approve  /reject",
          "a note for the next message"
        ]
      }
    ],
    "relations": [
      { "from": "skill", "to": "parameter", "kind": "holds" },
      { "from": "skill", "to": "state", "kind": "holds" },
      { "from": "library", "to": "folders", "kind": "uses" },
      { "from": "library", "to": "skill", "kind": "creates" },
      { "from": "tool", "to": "runner", "kind": "uses" },
      { "from": "create", "to": "library", "kind": "uses" },
      { "from": "door", "to": "library", "kind": "uses" },
      { "from": "door", "to": "runner", "kind": "uses" },
      { "from": "commands", "to": "library", "kind": "uses" }
    ]
  }
}

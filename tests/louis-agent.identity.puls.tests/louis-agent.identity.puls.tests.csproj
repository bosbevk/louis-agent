<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Identities.Puls.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\identities\louis-agent.identity.puls\louis-agent.identity.puls.csproj" />
    <!-- The packs Puls names, so its golden builds the cook with them as the Puls stack does. -->
    <ProjectReference Include="..\..\packs\louis-agent.pack.where-to-buy\louis-agent.pack.where-to-buy.csproj" />
    <ProjectReference Include="..\..\packs\louis-agent.pack.shop-prices\louis-agent.pack.shop-prices.csproj" />
    <!-- The other pack Puls names (F35.2 step 1): the catalogue the tests build holds it. -->
    <ProjectReference Include="..\..\packs\louis-agent.pack.recipes\louis-agent.pack.recipes.csproj" />
    <!-- The fakes every test project shares (CL15 step 5). -->
    <ProjectReference Include="..\louis-agent.testing\louis-agent.testing.csproj" />
    <!-- The name enums Puls's prompts tests read, kept with its evals (Evals/Checks/Shared/). -->
    <ProjectReference Include="..\..\evals\identities\louis-agent.identity.puls.evals\louis-agent.identity.puls.evals.csproj" />
    <!-- The composition says which toolsets Puls has (its identity and the packs it names). -->
    <ProjectReference Include="..\..\src\hosts\louis-agent.composition\louis-agent.composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

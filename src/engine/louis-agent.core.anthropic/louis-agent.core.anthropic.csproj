<Project Sdk="Microsoft.NET.Sdk">

  <!-- Anthropic on core (CL57): the provider strategy that builds the Claude client from the settings, the usage mapper
       that reads its cache writes, and its two prompt-cache markers. A program hands AnthropicProvider.Instance to
       AgentHost.Build in its HostServices; a host on another provider ships none of this. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Core.Anthropic</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\louis-agent.core\louis-agent.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.core.anthropic.tests" />
    <PackageReference Include="Anthropic" Version="12.53.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc, shown under docs/ in the IDE's solution explorer; nothing is built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.core.anthropic.md" Link="docs\louis-agent.core.anthropic.md" />
  </ItemGroup>

</Project>

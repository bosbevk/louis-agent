@inherits LayoutComponentBase
@* The framework's admin frame, filled with what's Puls's own: its logo, its live strip, its links and the way back to the chat. *@

<AdminShell BrandTitle="Puls home" BackHref="gesels" BackLabel="Back to Puls">
    <Brand><PulsLogo /></Brand>
    <Top><LiveRunStrip /></Top>
    <Links>
        @* The sidebar by job: Measure holds the evals and their runs, and the answers to grade; Build what makes them better. *@
        <div class="sidebar-label">Measure</div>
        <nav class="side-nav">
            <NavLink class="side-link" href="admin" Match="NavLinkMatch.All"><span class="ic i-check" aria-hidden="true"></span>Evals</NavLink>
            <NavLink class="side-link" href="admin/review"><span class="ic i-user" aria-hidden="true"></span>Review<ReviewCountBadge /></NavLink>
        </nav>

        <div class="sidebar-label">Build</div>
        <nav class="side-nav">
            <NavLink class="side-link" href="admin/studio"><span class="ic i-sparkle" aria-hidden="true"></span>Studio</NavLink>
            <NavLink class="side-link" href="admin/prompts"><span class="ic i-file" aria-hidden="true"></span>Prompts</NavLink>
        </nav>
    </Links>
    <ChildContent>@Body</ChildContent>
</AdminShell>

@using LouisAgent.Web.Components.Site.Showroom.Mock.Foot
@using LouisAgent.Web.Components.Site.Showroom.Mock.Head
@using LouisAgent.Web.Components.Site.Showroom.Mock.Hero
@* A business's website, mocked (F127.1, Louis's pick 3a, made fuller: "a bit bland, we need to sell it"): a browser bar
   with its address, its header with its sample brand (its mark, its name and tagline, its typeface) and its menu, then
   its page, which scrolls inside the mock: on home the hero in the business's look and a band of facts, then its
   pages (F127.2), only the one it's on showing, and its foot. Its agent's chat stands in a column beside the
   website, where its customers would meet it, and the place it shows is in the bar, lit, and scrolled to. It says
   whose website it is, by its address, so a site's sheet can set that business's own values under it. *@
<div class="@Classes" style="@ColourStyle" data-site="@Address">
    @* A page change loads like a browser (F127.2): its address glows and a loading line runs under the bar, both drawn
       afresh on each change, so they play again. *@
    <div class="mock-chrome" aria-hidden="true">
        <i></i><i></i><i></i>
        <span class="@AddressClass" @key="AddressKey">@Address@Here</span>
        @if (_pageChanges > 0)
        {
            <span class="mock-loading" @key="LoadingKey"></span>
        }
    </div>
    <MockHead Mark="Mark" Business="@Business" Tagline="@Tagline" Menu="MenuPages" Current="@CurrentPage"
              Went="GoAsync" />
    <div class="mock-page" @ref="_page">
        @if (ShowsHome)
        {
            <MockHero Line="@HeroLine" Note="@HeroNote" Action="@HeroAction" Photo="@HeroPhoto"
                      PhotoAlt="@HeroPhotoAlt" Scene="Scene" Mark="Mark" Business="@Business" Facts="Facts" />
        }
        @* Its pages learn their mock and the page it's on; their places, the place its agent showed. *@
        <CascadingValue Name="@ShownPlace" Value="Shown">
            <CascadingValue Value="this" IsFixed="true">
                <CascadingValue Name="@CurrentPageName" Value="CurrentPage">@Pages</CascadingValue>
            </CascadingValue>
        </CascadingValue>
        <MockFoot Mark="Mark" Business="@Business" Tagline="@Tagline" Menu="MenuPages" Facts="Facts"
                  Went="GoAsync" />
    </div>
    @* Its agent learns its mock too, so a live one can read the website (F127.2). *@
    <CascadingValue Value="this" IsFixed="true">
        <MockWidget Mark="Mark" Label="@AgentLabel" Live="Live">@Agent</MockWidget>
    </CascadingValue>
</div>

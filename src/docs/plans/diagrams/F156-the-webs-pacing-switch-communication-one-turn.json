{
  "kind": "sequence",
  "title": "F156 the web's pacing switch: one turn on louis-agent.dev",
  "caption": "The header comes before the first word, so the caption knows before it draws whether to pace.",
  "sequence": {
    "participants": [
      { "id": "caption", "label": "AgentCaption", "icon": "browser", "tone": "teal" },
      { "id": "runner", "label": "ChatRunner", "icon": "code", "tone": "blue" },
      { "id": "agentapi", "label": "AgentApi", "icon": "code", "tone": "blue" },
      { "id": "api", "label": "The site's API", "icon": "server", "tone": "violet" },
      { "id": "engine", "label": "The engine", "icon": "chip", "tone": "violet" }
    ],
    "steps": [
      { "step": "message", "from": "runner", "to": "agentapi", "text": "StreamMessageAsync(session, the question, onServerPaced)" },
      { "step": "message", "from": "agentapi", "to": "api", "text": "POST /v1/sessions/{id}/messages" },
      { "step": "message", "from": "api", "to": "engine", "text": "StreamPromptAsync, paced: STREAM_PACE is on" },
      { "step": "reply", "from": "api", "to": "agentapi", "text": "headers: Stream-Paced: on" },
      { "step": "reply", "from": "agentapi", "to": "runner", "text": "onServerPaced(): the turn is ServerPaced" },
      { "step": "reply", "from": "api", "to": "agentapi", "text": "the events, the text already even" },
      { "step": "reply", "from": "runner", "to": "caption", "text": "the words as they come, ServerPaced: true" },
      { "step": "note", "over": ["caption"], "text": "shows them as they come: no second pacing" }
    ]
  }
}

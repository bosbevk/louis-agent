<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\hosts\LouisAgent.Api\LouisAgent.Api.csproj" />
    <ProjectReference Include="..\..\..\..\src\tests\shared\LouisAgent.Testing\LouisAgent.Testing.csproj" />
    <!-- F18 step 7.6.3: the in-memory API host the unit tests share. -->
    <ProjectReference Include="..\LouisAgent.Api.Testing\LouisAgent.Api.Testing.csproj" />
    <!-- The Anthropic provider, so the whole path's live test builds the model as a host does (F171.1 step 10). -->
    <ProjectReference Include="..\..\..\..\src\engine\LouisAgent.Core.Anthropic\LouisAgent.Core.Anthropic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The made-up account the core's proof reads, linked rather than copied, as a photo and as a PDF. -->
    <None Include="..\..\engine\LouisAgent.Core.IntegrationTests\Llm\Documents\sample-account.*"
          Link="Documents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\src\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\..\src\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

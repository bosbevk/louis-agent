@page "/"
@page "/chat"
@page "/chat/{SessionId}"
@layout ChatLayout

@* The code-review app on the framework's chat frame: its name, its links to the packs' screens, and its theme picker. *@

<ChatShell @ref="_shell" SessionId="@SessionId" ChatPath="chat" Title="Louis Agent" OpenSession="OpenSessionAsync" VoicePrefix="" DefaultLanguage="en"
           BrandTitle="Louis Agent" Features="Features">
    <Logo>LOUIS AGENT</Logo>
    <Views>
        <nav class="side-nav">
            <a class="side-link" href="admin/screens/workspace-files"><span class="ic i-file" aria-hidden="true"></span>Files</a>
            <a class="side-link" href="admin/screens/git-changes"><span class="ic i-check" aria-hidden="true"></span>Changes</a>
            <a class="side-link" href="admin/screens/git-branches"><span class="ic i-folder" aria-hidden="true"></span>Branches</a>
        </nav>
    </Views>
    <Settings><ThemeSwitcher /></Settings>
    <Empty Context="empty"><EmptyChat Composer="empty.MessageBox" /></Empty>
</ChatShell>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- F18 step 7.4: a stand-in for the eval runner, for the API's tests of how it starts one (arguments, environment, stdin, lines, exit codes, a slow run). It is a real child process on every
       platform, with no Python and no shell: the check's id picks what it does. It is built with the API's tests (a project reference that brings no assembly) and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api.StandIn</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>

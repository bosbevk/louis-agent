@inherits LayoutComponentBase
@* The framework's site frame, filled with what's this site's own: its name, its pages, the way to the chat and its
   footer lines. The router draws every page in it but the chat's, which keeps its own full-screen layout. *@

<SiteShell Layout="PageLayout.Slides">
    <Brand><img class="site-mark" src="brand/mark.svg" alt="" width="22" height="22" />louis-agent</Brand>
    <Tagline>100% C#, because you can</Tagline>
    <Links>
        <SiteMenu Label="The framework">
            <a href="/how-it-works">How it works</a>
            <a href="/architecture">Architecture</a>
            <a href="/identities">Identities</a>
            <a href="/packs">Packs</a>
            <a href="/build-your-own">Build your own</a>
        </SiteMenu>
        <a href="/proof">Measured</a>
        <a href="/built-on-it">Built on it</a>
        <a href="/whats-coming">What's coming</a>
        <a href="/contact">Contact</a>
        @* The demos in one menu (F122), where "Watch it work" stood. *@
        <SiteMenu Label="Demos">
            <a href="/demos">All demos</a>
            <a href="/coding-agent">The coding agent</a>
            <a href="/triage-demo">The triage team</a>
        </SiteMenu>
    </Links>
    <Footer>
        <span>louis-agent · all rights reserved · <a class="footer-link" href="https://www.linkedin.com/in/louismarais86" target="_blank" rel="noopener"><LinkedInMark /> LinkedIn</a></span>
        <span>100% C#, because you can</span>
    </Footer>
    <Corner><ExpertChat /></Corner>
    <ChildContent>@Body</ChildContent>
</SiteShell>

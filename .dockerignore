# Every image is built with the repository root as its context, so this file - not one in a demo's docker/ - decides
# what reaches the build. Secrets, git history, build output and local state stay out.
.git
.idea
.vs
.vscode
demos/*/logs
demos/*/data
**/bin
**/obj
**/config/.env
**/config/.env.*
!**/config/.env.example
!**/config/.env.secrets.example

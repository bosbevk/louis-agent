{
  "kind": "classes",
  "title": "LouisAgent.Web.Framework: the interface design",
  "caption": "Framework() brings the pages and their reading order to a site; each page only configures the framework's parts from records that name the code and the docs they were written from.",
  "classes": {
    "types": [
      { "id": "area", "name": "FrameworkArea", "kind": "static, what a site calls",
        "members": [ "+Framework(areas) SiteAreasBuilder" ] },
      { "id": "library", "name": "FrameworkLibrary", "kind": "static, the pages' assembly",
        "members": [ "+Assembly" ] },
      { "id": "contents", "name": "FrameworkContents", "kind": "static, the reading order",
        "members": [ "+All DocsContents" ] },
      { "id": "docs", "name": "DocsContents", "kind": "record, LouisAgent.Web.Docs", "tone": "violet" },
      { "id": "pages", "name": "OverviewPage, GettingStartedPage, HowItWorksPage, FeaturesPage...",
        "kind": "the pages" },
      { "id": "family", "name": "FrameworkFamily", "kind": "record, one of the five families",
        "members": [ "+Id, Name, Folder, Summary", "+Icon, Tone", "+Projects", "+All" ] },
      { "id": "feature", "name": "FrameworkFeature", "kind": "record, one thing it does",
        "members": [ "+Area, Name, Code, What, Doc" ] },
      { "id": "claim", "name": "ComparisonClaim", "kind": "record, one row of the comparison" },
      { "id": "cost", "name": "CostExample", "kind": "record, one request worked to rand" },
      { "id": "example", "name": "FrameworkExample", "kind": "record, one agent it runs" },
      { "id": "graphs", "name": "FrameworkAtAGlance, FamilyOverview, OneTurn, CostPath...",
        "kind": "static, each a DiagramSource" },
      { "id": "figure", "name": "DiagramFigure", "kind": "LouisAgent.Web", "tone": "violet" }
    ],
    "relations": [
      { "from": "area", "to": "library", "kind": "uses", "word": "brings the pages of" },
      { "from": "area", "to": "contents", "kind": "uses", "word": "registers" },
      { "from": "contents", "to": "docs", "kind": "holds" },
      { "from": "pages", "to": "family", "kind": "uses", "word": "reads" },
      { "from": "pages", "to": "feature", "kind": "uses", "word": "reads" },
      { "from": "pages", "to": "claim", "kind": "uses", "word": "reads" },
      { "from": "pages", "to": "cost", "kind": "uses", "word": "reads" },
      { "from": "pages", "to": "example", "kind": "uses", "word": "reads" },
      { "from": "pages", "to": "figure", "kind": "uses", "word": "draws with" },
      { "from": "figure", "to": "graphs", "kind": "uses", "word": "draws" }
    ]
  }
}

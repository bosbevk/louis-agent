{
  "kind": "sequence",
  "title": "F172 what we are building: a visitor opens /now",
  "caption": "The host asks GitHub only when its answer is older than 15 minutes; otherwise the page gets the kept report at once.",
  "sequence": {
    "participants": [
      {
        "id": "V",
        "icon": "user",
        "tone": "blue",
        "label": "a visitor"
      },
      {
        "id": "P",
        "icon": "browser",
        "tone": "green",
        "label": "the /now page"
      },
      {
        "id": "H",
        "icon": "server",
        "tone": "violet",
        "label": "the host: NowRoute"
      },
      {
        "id": "C",
        "icon": "settings",
        "tone": "violet",
        "label": "NowCache"
      },
      {
        "id": "G",
        "icon": "folder",
        "tone": "amber",
        "label": "GitHub"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "V",
        "to": "P",
        "text": "opens /now"
      },
      {
        "step": "message",
        "from": "P",
        "to": "H",

@* The showroom's start (F127.1, step 9): a big start for the site's main demo in its colour (its kicker, the page's one
   h1, a line, the way in and a look at its website), then a glowing cover for every demo, grouped as the rail groups
   them. Each part is a section with a heading, so the guide's tour stops at both. *@
<section id="top" class="@FeatureClasses">
    <div class="start-words">
        <span class="start-kicker">@Kicker</span>
        <h1 class="start-title">@Title</h1>
        @if (Lede is not null)
        {
            <p class="start-lede">@Lede</p>
        }
        <a class="start-play" href="@Featured"><span aria-hidden="true">▶</span> @Play</a>
    </div>
    @if (Preview is not null)
    {
        <a class="start-preview" href="@Featured" aria-hidden="true" tabindex="-1">
            <span class="start-dots"><i></i><i></i><i></i></span>
            @Preview
        </a>
    }
</section>
<section id="every-demo" class="start-all">
    <h2 class="start-all-heading">@Text.AllDemos</h2>
    @foreach (var group in Demos.Groups)
    {
        <h3 class="start-group">@Text.NameOf(group.Key)</h3>
        <div class="start-covers">
            @foreach (var demo in group)
            {
                <a class="@CoverClasses(demo)" href="@demo.Address">
                    <span class="start-sign" aria-hidden="true"><LineIconView Icon="demo.Icon"/></span>
                    <span class="start-name">@demo.Name</span>
                    <span class="start-line">@demo.Line</span>
                </a>
            }
        </div>
    }
</section>

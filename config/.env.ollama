# LLM profile: a local model through Ollama. Selected with LLM_PROFILE=ollama in config/.env. Free, no API key.
# A setting in config/.env or the shell overrides the same setting here.
#
# Start Ollama natively, or in Docker (pulls LLM_MODEL on first start):
#   docker compose -f docker/docker-compose.yml --env-file config/.env --profile ollama up -d ollama

LLM_PROVIDER=ollama
# A model with tool support (see ../docs/MODELS.md); qwen2* models run without tools.
LLM_MODEL=llama3.1

# host.docker.internal reaches the host's port 11434 from the host itself (Docker Desktop adds it to the hosts file)
# and from the agent containers, so the same endpoint works for `dotnet run` and Docker. Native Ollama without
# Docker Desktop: http://localhost:11434.
LLM_ENDPOINT=http://host.docker.internal:11434

# Thinking is off by default for Ollama; only some local models support it.
# LLM_THINKING=off

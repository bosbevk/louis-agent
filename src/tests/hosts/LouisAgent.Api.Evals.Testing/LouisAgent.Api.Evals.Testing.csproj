<Project Sdk="Microsoft.NET.Sdk">

  <!-- F126.3.1: an eval replayed from recordings kept in git, as one test a site's test project runs, with no key
       and no model. A class library, not a test project, so a site's tests reference it as they do Api.Testing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api.Evals.Testing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\hosts\LouisAgent.Api.Evals\LouisAgent.Api.Evals.csproj" />
    <!-- The API in memory, as the eval routes' own tests run it. -->
    <ProjectReference Include="..\LouisAgent.Api.Testing\LouisAgent.Api.Testing.csproj" />
  </ItemGroup>

</Project>

@* The chat's turns, or what a site shows instead: its own content when given, else
   the empty slot while the chat has no turn, else one TurnView per turn. Scrolled to the end through JS when the chat
   changes, a turn starts or the list comes back into view, as the pages did. *@
@inject IJSRuntime JS

<div class="@("messages" + (Class is null ? "" : " " + Class))" @ref="_messages">
    @if (Content is not null)
    {
        @Content
    }
    else if (Chat is null || Chat.Turns.Count == 0)
    {
        @Empty
    }
    else
    {
        @foreach (var turn in Chat.Turns)
        {
            <TurnView Turn="turn" Streaming="@(Streaming && turn == Chat.Turns[^1])" Currency="Currency"
                      UserActions="UserActions" AnswerActions="AnswerActions" ShowWork="ShowWork"
                      ShowUsage="ShowUsage" />
        }
    }
</div>

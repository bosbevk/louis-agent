<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The starter's API (CL57): the smallest program that serves a site on the framework's API, with the accounts
         and the eval studio opted in. A new site copies this beside its web project and names its identity and packs. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>LouisAgent.Starter.Api</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's API; this program says what it loads, and serves what this project references. -->
        <ProjectReference Include="..\..\..\..\src\engine\louis-agent.core.web\louis-agent.core.web.csproj" />
        <ProjectReference Include="..\..\..\..\src\engine\louis-agent.core.telemetry\louis-agent.core.telemetry.csproj" />
        <!-- CL57: the model providers this program composes; core ships no SDK. -->
        <ProjectReference Include="..\..\..\..\src\engine\louis-agent.core.anthropic\louis-agent.core.anthropic.csproj" />
        <ProjectReference Include="..\..\..\..\src\engine\louis-agent.core.ollama\louis-agent.core.ollama.csproj" />
        <ProjectReference Include="..\..\..\..\src\engine\louis-agent.core.openai\louis-agent.core.openai.csproj" />
        <ProjectReference Include="..\..\..\..\src\hosts\louis-agent.api\louis-agent.api.csproj" />
        <!-- CL57: the eval studio, a library on the API a program opts into. -->
        <ProjectReference Include="..\..\..\..\src\hosts\louis-agent.api.evals\louis-agent.api.evals.csproj" />
        <!-- The framework's accounts (F61): sign-in, registration and profiles, on when ACCOUNTS_SQL_URL is set. -->
        <ProjectReference Include="..\..\..\..\src\hosts\louis-agent.accounts\louis-agent.accounts.csproj" />
        <!-- The web app this program serves. Its files reach this project's output through this reference. -->
        <ProjectReference Include="..\..\web\louis-agent.starter\louis-agent.starter.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- What everything agrees on (CL29): the contracts a pack, an identity and the engine share. It names no pack and no
       identity, and references only the small enum-name package and abstractions, so a tool author takes it and nothing
       else comes along. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Composition</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\louis-agent.choices\louis-agent.choices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.core.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>

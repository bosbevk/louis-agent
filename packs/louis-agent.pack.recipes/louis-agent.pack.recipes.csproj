<Project Sdk="Microsoft.NET.Sdk">

  <!-- What an agent can do with recipes (F35, ADR 0027, 0028): a recipe read from a page's own schema.org data, and
       later from the text sources that carry none. References core only; no check contract until the pack ships
       checks. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Recipes</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.pack.recipes.tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\louis-agent.core\louis-agent.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\**\*.md" />
    <!-- The recipe sites as content (J2, ADR 0011): a row is a site, so a site turning noai is a content change. -->
    <EmbeddedResource Include="Sources\Sites\recipe-sites.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.recipes.md" Link="docs\louis-agent.pack.recipes.md" />
    <None Include="..\..\docs\guides\build-a-pack.md" Link="docs\build-a-pack.md" />
  </ItemGroup>

</Project>

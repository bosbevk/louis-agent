@* Under the user's message: copy it, or edit it (to come). *@
<button class="action" type="button" title="@Text.Copy" @onclick="() => OnCopy.InvokeAsync(Turn.UserText)"><span class="ic i-copy" aria-hidden="true"></span></button>
<button class="action" type="button" title="@Text.EditMessage" @onclick="() => OnComingSoon.InvokeAsync(Text.EditSoon)"><span class="ic i-pencil" aria-hidden="true"></span></button>

@page "/restaurant-demo"
@layout ShowroomLayout

<PageTitle>A restaurant's agent · louis-agent</PageTitle>
<PageHead Description="Watch a restaurant's website agent answer a family about Sunday lunch and pass their table request on, recorded once and played back." />

<BusinessDemo Accent="TileAccent.Green" Kicker="A restaurant" Business="Wheatfield Kitchen" Turns="Conversation" Cues="WhatToWatch"

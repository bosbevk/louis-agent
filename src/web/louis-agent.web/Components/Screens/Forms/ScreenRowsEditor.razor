@* A list, a row per line: a box per cell, and buttons to move a row, remove it, or add one at the end. *@
<div class="screen-rows">
    @for (var at = 0; at < Rows.Count; at++)
    {
        var place = at;
        var row = Rows[place];
        <div class="screen-row" @key="row">
            @for (var cell = 0; cell < row.Count; cell++)
            {
                var column = cell;
                <input type="text" value="@row[column]" placeholder="@Columns[column]" aria-label="@Columns[column]" @onchange="e => row[column] = e.Value?.ToString() ?? string.Empty" />
            }
            <button class="header-button screen-row-up" type="button" title="Move up" aria-label="Move up" disabled="@(place == 0)" @onclick="() => Move(place, -1)">↑</button>
            <button class="header-button screen-row-down" type="button" title="Move down" aria-label="Move down" disabled="@(place == Rows.Count - 1)" @onclick="() => Move(place, 1)">↓</button>
            <button class="header-button screen-row-remove" type="button" title="Remove" aria-label="Remove" @onclick="() => Remove(place)">×</button>
        </div>
    }
    <button class="header-button screen-row-add" type="button" @onclick="Add">Add a row</button>
</div>

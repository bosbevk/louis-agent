@* A slider (FX162, the design's control): the groove, the part filled to its value and the knob are the theme's
   drawings; a range input over them takes the pointer and the keys. *@
<div class="slider" style="--at: @Percent">
    <i aria-hidden="true"></i>
    <b aria-hidden="true"></b>
    <input type="range" min="0" max="100" value="@Value" aria-label="@Label" @oninput="Slide" />
</div>

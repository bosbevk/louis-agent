{
  "kind": "sequence",
  "title": "F131 the chat on any website: the guide moves a visitor",
  "caption": "Nothing lost on a page load: the turn keeps running on the server, and the new frame picks up the events it missed.",
  "sequence": {
    "participants": [
      {
        "id": "P",
        "icon": "world",
        "tone": "blue",
        "label": "embed.js (host page)"
      },
      {
        "id": "F",
        "icon": "browser",
        "tone": "green",
        "label": "Frame (ChatWidget)"
      },
      {
        "id": "A",
        "icon": "server",
        "tone": "violet",
        "label": "API (site door)"
      }
    ],
    "steps": [
      {
        "step": "message",
        "from": "P",
        "to": "F",
        "text": "open (first click)"
      },
      {
        "step": "message",
        "from": "F",
        "to": "P",
        "text": "send: give me the page"
      },
      {
        "step": "reply",
        "from": "P",
        "to": "F",
        "text": "page text and areas (private parts left out)"
      },
      {
        "step": "message",
        "from": "F",
        "to": "A",
        "text": "POST /v1/sessions/{id}/messages \u002B page, site key"
      },
      {
        "step": "reply",
        "from": "A",
        "to": "F",
        "text": "SSE: text, ShowPage(\u0022/menu#specials\u0022)"
      },
      {
        "step": "message",
        "from": "F",
        "to": "P",
        "text": "ShowPage input"
      },
      {
        "step": "message",
        "from": "P",
        "to": "P",
        "text": "full page load of /menu (WordPress)"
      },
      {
        "step": "note",
        "over": [
          "A"
        ],
        "text": "the turn keeps running (F131.3)"
      },
      {
        "step": "message",
        "from": "P",
        "to": "F",
        "text": "new frame on /menu, chat still open"
      },
      {
        "step": "message",
        "from": "F",
        "to": "A",
        "text": "GET /v1/sessions/{id}/stream"
      },
      {
        "step": "reply",
        "from": "A",
        "to": "F",
        "text": "missed events, then live to the end"
      },
      {
        "step": "message",
        "from": "P",
        "to": "P",
        "text": "scroll to #specials and glow"
      }
    ]
  }
}

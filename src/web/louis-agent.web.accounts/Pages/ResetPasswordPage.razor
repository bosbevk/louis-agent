@page "/reset-password"
@layout AccountFrame

@* Set a new password with the code from the mail. *@

<PageTitle>@Text.ResetPassword</PageTitle>

<h1>@Text.ResetPassword</h1>
@if (_done)
{
    <AccountNotice Message="@Text.PasswordReset" />
    <div class="account-actions">
        <a class="account-button" href="login">@Text.SignIn</a>
    </div>
}
else
{
    <form class="account-form" @onsubmit="ResetAsync">
        <AccountNotice Message="@_error?.Message" Details="_error?.Details ?? []" IsError="true" />
        <label class="account-field">
            @Text.Email
            <input type="email" autocomplete="username" required @bind="_email" />
        </label>
        <label class="account-field">
            @Text.ResetCode
            <input type="text" autocomplete="one-time-code" required @bind="_code" />
        </label>
        <PasswordField Label="@Text.NewPassword" @bind-Value="_password" Autocomplete="new-password" Hint="@Text.PasswordRules" />
        <PasswordField Label="@Text.ConfirmPassword" @bind-Value="_again" Autocomplete="new-password" />
        <div class="account-actions">
            <button class="account-button" type="submit" disabled="@_busy">@Text.ResetPassword</button>
        </div>
    </form>
    <div class="account-links">
        <a href="login">@Text.BackToSignIn</a>
    </div>
}

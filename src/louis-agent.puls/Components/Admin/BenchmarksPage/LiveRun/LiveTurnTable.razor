@* A row per turn, grouped by conversation; a click opens the turn below the table. *@

<div class="table-wrap">
    <table class="run-table">
        <thead>
            <tr><th>Mode</th><th>Conversation</th><th>Turn</th><th>Role</th><th>Calls</th><th>Sec</th><th>Cost</th></tr>
        </thead>
        <tbody>
            @foreach (var group in Turns.Conversations())
            {
                foreach (var row in group)
                {
                    var rowKey = row.Key;
                    <tr class="@(row == Turns.Open ? "selected" : "") @(row.Error is not null ? "failed" : "")" @onclick="() => OnOpen.InvokeAsync(rowKey)" style="cursor: pointer">
                        <td>@row.Mode@(Run.Repeat > 1 ? $" ·{row.Repeat}" : "")</td>
                        @* Louis: what was asked, beside the conversation's name; turn 2's row shows its follow-up. *@
                        <td class="conv-cell"><code>@row.Task</code><small title="@row.Turn.UserText">@RunText.Blurb(row.Turn.UserText)</small></td>
                        <td>@row.N</td>
                        <td>@row.RoleText</td>
                        <td>@(row.Done ? $"{row.AgentCalls} · {row.SpecialistCalls}" : "")</td>
                        <td>@row.SecondsText</td>
                        <td>@(row.Done ? RunText.Money(Turns.CostOf(rowKey), Currency) : "")</td>
                    </tr>
                    @if (!row.Done && Run.Status == "running")
                    {
                        <tr><td colspan="7"><span class="chip busy">typing…</span></td></tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

# The guide's model: Claude through the Anthropic API. Needs ANTHROPIC_API_KEY in .env.secrets; every request costs
# money (src/docs/MODELS.md has the models and prices). A setting in config/.env or the shell overrides the same one here.
LLM_PROVIDER=anthropic
# Claude Haiku 5.5, as louis-agent.dev runs it: the guide answers from the docs, so a small model does.
LLM_MODEL=claude-haiku-5-5

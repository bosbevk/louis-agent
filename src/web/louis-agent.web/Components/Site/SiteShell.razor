@implements IAsyncDisposable
@* A site's frame: a header with the brand, the menu and the actions, the page, a footer, and a corner that floats
   over every page (a site's chat widget goes there). A slot left empty leaves no gap. Its own root class, not .app:
   a chat's grid rules must not reach here. The frame also draws what every page gets for nothing (F118): the scroll
   progress line and the section index, built from the bands the page puts on the frame's list. *@
<CascadingValue Value="_areas" IsFixed="true">
<div class="site">
    <div class="site-progress" id="site-progress" aria-hidden="true"></div>
    <SectionIndex />
    <header class="site-header">
        @if (Brand is not null)
        {
            <a class="site-brand" href="@BrandHref">
                <span class="site-brand-name">@Brand</span>
                @if (Tagline is not null)
                {
                    <span class="site-tagline">@Tagline</span>
                }
            </a>
        }
        @if (Links is not null)
        {
            <nav class="site-nav">@Links</nav>
        }
        @if (Actions is not null)
        {
            <div class="site-actions">@Actions</div>
        }
    </header>

    <main class="site-main">
        @ChildContent
    </main>

    @if (Footer is not null)
    {
        <footer class="site-footer">@Footer</footer>
    }

    @if (Corner is not null)
    {
        <div class="site-corner">@Corner</div>
    }
</div>
</CascadingValue>

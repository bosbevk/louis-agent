@* The design's running tape (FX163): one line of what the agents did, the items a site gives as records (ADR 0125),
   written twice so the line loops without a seam. It is for the eye only, so a reader skips it. *@
<div class="tape" aria-hidden="true">
    <div class="tape-run">
        @for (var pass = 0; pass < 2; pass++)
        {
            @foreach (var item in Items)
            {
                if (item.Mark is null)
                {
                    <span>@item.Text</span>
                }
                else
                {
                    <span>@item.Text <i>@item.Mark</i></span>
                }
            }
        }
    </div>
</div>

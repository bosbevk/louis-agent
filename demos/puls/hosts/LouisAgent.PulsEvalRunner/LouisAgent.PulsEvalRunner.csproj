<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LouisAgent.PulsEvalRunner</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's eval runner; this program only says what Puls's evals can name. -->
        <ProjectReference Include="..\..\..\..\src\evals\LouisAgent.Evals.Runner\LouisAgent.Evals.Runner.csproj" />
        <!-- CL57: the program, not the runner library, decides the telemetry. -->
        <ProjectReference Include="..\..\..\..\src\engine\LouisAgent.Core.Telemetry\LouisAgent.Core.Telemetry.csproj" />
        <!-- CL57: the model providers this program composes; core ships no SDK. -->
        <ProjectReference Include="..\..\..\..\src\engine\LouisAgent.Core.Anthropic\LouisAgent.Core.Anthropic.csproj" />
        <ProjectReference Include="..\..\..\..\src\engine\LouisAgent.Core.Ollama\LouisAgent.Core.Ollama.csproj" />
        <ProjectReference Include="..\..\..\..\src\engine\LouisAgent.Core.OpenAi\LouisAgent.Core.OpenAi.csproj" />
        <!-- ADR 0073: what proves Puls and its packs. Only this program references them, so no host carries a check, and
             their eval folders reach this program's output through these references. -->
        <ProjectReference Include="..\..\evals\LouisAgent.Identities.Puls.Judges\LouisAgent.Identities.Puls.Judges.csproj" />
        <ProjectReference Include="..\..\evals\LouisAgent.Identities.Puls.Evals\LouisAgent.Identities.Puls.Evals.csproj" />
        <ProjectReference Include="..\..\..\..\packs\evals\LouisAgent.Packs.WhereToBuy.Checks\LouisAgent.Packs.WhereToBuy.Checks.csproj" />
        <ProjectReference Include="..\..\..\..\packs\evals\LouisAgent.Packs.Recipes.Checks\LouisAgent.Packs.Recipes.Checks.csproj" />
        <!-- F49.2: Puls's list of identities and packs, for the toolsets an eval's modes name. -->
        <ProjectReference Include="..\LouisAgent.HostPacks\LouisAgent.HostPacks.csproj" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Git as tools: status, diffs, branches, staging, commits, merges and history for the workspace repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Git</RootNamespace>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps the embedded guide's folder path: without it, the toolset's guide is never found. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LouisAgent.Packs.Git.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Packs.Git.IntegrationTests" />
    <InternalsVisibleTo Include="LouisAgent.Coding.Catalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\engine\LouisAgent.Composition\LouisAgent.Composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="toolsets\**\*.md" />
  </ItemGroup>

</Project>

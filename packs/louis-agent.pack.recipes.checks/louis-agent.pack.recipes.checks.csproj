<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rule that proves the recipes pack's answers (ADR 0073): the recipe's link is on a site of the pack's table.
       Beside the pack and apart from it, so the pack stands on core alone and follows the engine into a package; only
       the runner references this, so no host carries it. The arrow points at the pack, for its table of sites. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Packs.Recipes</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\louis-agent.pack.recipes\louis-agent.pack.recipes.csproj" />
    <ProjectReference Include="..\..\evals\louis-agent.evals.checks\louis-agent.evals.checks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc, shown under docs/ in the IDE's solution explorer; nothing is built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.pack.recipes.md" Link="docs\louis-agent.pack.recipes.md" />
  </ItemGroup>

</Project>

@* One step of a subagent's work: a tool call, or a lookup agent it handed one page to, with the lookup agent's
   address, tool and model, its own steps and what it cost, nested under the subagent's steps. *@
@if (Delegation.From(Step) is { Lookup: true } lookup)
{
    var lookupSteps = Step.SubTurn?.Blocks.Where(b => b.Kind == BlockKind.Tool).ToList() ?? [];
    <li class="work-step lookup @StepMarks.StateOf(Step)">
        <span class="work-step-mark">@StepMarks.MarkOf(Step)</span>
        <div class="work-lookup">
            <div class="work-lookup-head">
                <span class="work-step-name">@Text.LookupLabel</span>
                <span class="work-lookup-role">@(lookup.Role ?? Step.ToolName)</span>
                @foreach (string tool in lookup.Toolsets)
                {
                    <span class="toolset-chip">@tool</span>
                }
                @if (lookup.Llm is { } llm)
                {
                    <span class="toolset-chip model">@Text.OnModel @llm</span>
                }
            </div>
            @if (lookup.Task is { Length: > 0 } lookupTask)
            {
                <div class="work-lookup-task" title="@lookupTask">@lookupTask</div>
            }
            @if (lookupSteps.Count > 0)
            {
                <ol class="work-steps nested">
                    @foreach (var inner in lookupSteps)
                    {
                        <li class="work-step @StepMarks.StateOf(inner)">
                            <span class="work-step-mark">@StepMarks.MarkOf(inner)</span>
                            <span class="work-step-name">@inner.ToolName</span>
                            @if (Summarise(inner.ToolInput) is { Length: > 0 } innerArgs)
                            {
                                <span class="work-step-args">@innerArgs</span>
                            }
                        </li>
                    }
                </ol>
            }
            @if (Step.SubTurn?.Usage is { } lookupUsage)
            {
                <div class="work-lookup-cost" title="@UsageFormat.Detail(lookupUsage, Currency)">@UsageFormat.Cost(lookupUsage, Currency) · @lookupUsage.Requests @Text.Requests</div>
            }
        </div>
    </li>
}
else
{
    <li class="work-step @StepMarks.StateOf(Step)">
        <span class="work-step-mark">@StepMarks.MarkOf(Step)</span>
        <span class="work-step-name">@Step.ToolName</span>
        @if (Summarise(Step.ToolInput) is { Length: > 0 } args)
        {
            <span class="work-step-args">@args</span>
        }
    </li>
}

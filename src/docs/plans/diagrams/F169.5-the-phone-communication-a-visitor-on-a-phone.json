      { "step": "reply", "from": "S", "to": "V", "text": "the sheet: the nine pages first, then Ask Orbi and the settings" },
      { "step": "message", "from": "V", "to": "S", "text": "presses Features" },
      { "step": "note", "over": ["S"], "text": "the address changes, so the frame shuts its menu" },
      { "step": "reply", "from": "S", "to": "V", "text": "Features, its words 24 from the edge  (step 3)" }

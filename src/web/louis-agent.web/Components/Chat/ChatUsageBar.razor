@* The line under a chat with what it cost so far (F3), in the display currency (F14): the shared total by default, or
   the site's own words for it. Nothing until a turn was priced. *@
@if (Usage is { } usage)
{
    <div class="chat-usage" title="@UsageFormat.Detail(usage, Currency)">@if (ChildContent is null) { @UsageFormat.Total(usage, Currency) } else { @ChildContent(usage) }</div>
}

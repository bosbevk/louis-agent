@inherits LayoutComponentBase
@* The framework's site frame, filled with what's this site's own: its name, its pages, the way to the chat and its
   footer lines. The router draws every page in it but the chat's, which keeps its own full-screen layout. *@

<SiteShell Layout="PageLayout.Flow" MovingPage="true" AnswerUnder="true" ShowIndex="false" ShowWayUp="false">
    <Brand><Wordmark Before="l" After="uis-agent" /></Brand>
    <Tagline>The website that answers.</Tagline>
    <Stage><StageFlag Label="beta-1" Note="This is version beta-1. It works, and it is still being polished." LinkText="Tell us what you find" Href="/contact" /></Stage>
    <Links>
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
        <SiteMenu Label="Demos">
            <NavLink href="/demos" Match="NavLinkMatch.All">All demos</NavLink>
            <NavLink href="/guesthouse-demo" Match="NavLinkMatch.All">A guesthouse</NavLink>
            <NavLink href="/restaurant-demo" Match="NavLinkMatch.All">A restaurant</NavLink>
            <NavLink href="/law-practice-demo" Match="NavLinkMatch.All">A law practice</NavLink>
        </SiteMenu>
        @* The framework's own site (F164.3), a link of its own between the demos and the theme (Louis's pick B). *@
        <NavLink href="https://framework.louis-agent.dev">Framework</NavLink>
        <NavLink href="/framework/theme" Match="NavLinkMatch.All">Theme</NavLink>
        @* How we work with a client, as slides (F177), before the step it ends on. *@
        <NavLink href="/work-with-us" Match="NavLinkMatch.All">Work with us</NavLink>
        <NavLink href="/contact" Match="NavLinkMatch.All">Contact</NavLink>
    </Links>
    <Settings></Settings>
    <Footer>
        <span><Wordmark Before="l" After="uis-agent" /> · all rights reserved · <a class="footer-link" href="https://www.linkedin.com/in/louismarais86" target="_blank" rel="noopener"><LinkedInMark /> LinkedIn</a> · <a class="footer-link" href="/privacy">Privacy</a> · <a class="footer-link" href="/trust">Trust</a></span>
        <span>The website that answers.</span>
    </Footer>
    <Corner><ExpertChat /></Corner>
    <ChildContent>@Body</ChildContent>
</SiteShell>

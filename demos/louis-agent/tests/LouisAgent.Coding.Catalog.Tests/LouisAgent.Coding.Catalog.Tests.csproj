<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the coding agent sends the model, pinned: its golden files hold every toolset this demo names. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Coding.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\hosts\LouisAgent.Coding.Catalog\LouisAgent.Coding.Catalog.csproj" />
    <!-- The triage team's eval read as an eval, and replayed from its recordings (F126.5.3). -->
    <ProjectReference Include="..\..\..\..\src\evals\LouisAgent.Evals\LouisAgent.Evals.csproj" />
    <ProjectReference Include="..\..\..\..\src\tests\hosts\LouisAgent.Api.Evals.Testing\LouisAgent.Api.Evals.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\src\tests\shared\LouisAgent.Testing\LouisAgent.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- What holds the starter site: it opens the framework's pages through its own router, and its template says what it
       should. louis-agent.starter.integration-tests really makes a site from it and builds it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Starter.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\web\louis-agent.starter\louis-agent.starter.csproj" />
    <!-- The stub API and the helpers the web tests share; no test project references another. -->
    <ProjectReference Include="..\..\..\..\src\tests\web\louis-agent.web.testing\louis-agent.web.testing.csproj" />
    <ProjectReference Include="..\..\..\..\src\tests\shared\louis-agent.testing\louis-agent.testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Bunit" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Web.Testing" />
    <Using Include="LouisAgent.Web.Testing.Styles" />
  </ItemGroup>

</Project>

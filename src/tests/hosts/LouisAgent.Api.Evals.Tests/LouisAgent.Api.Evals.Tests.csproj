<Project Sdk="Microsoft.NET.Sdk">

  <!-- CL57: the eval studio's tests, moved with it out of the API's tests. They sit beside the API's because, like
       them, they open the test agent's sessions (F166.1). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api.Evals.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\hosts\LouisAgent.Api.Evals\LouisAgent.Api.Evals.csproj" />
    <!-- What the browser side shares, which these tests check against the API. -->
    <ProjectReference Include="..\..\..\..\src\web\LouisAgent.Web\LouisAgent.Web.csproj" />
    <ProjectReference Include="..\..\..\..\src\tests\shared\LouisAgent.Testing\LouisAgent.Testing.csproj" />
    <!-- The in-memory API host with the studio mapped, shared with the API's tests. -->
    <ProjectReference Include="..\LouisAgent.Api.Testing\LouisAgent.Api.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="LouisAgent.Testing" />
    <Using Include="LouisAgent.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 7c.3: the runner's own golden of the stub's run and the contract's golden, which the API records and
         exports; linked, so there is one copy of each. -->
    <None Include="..\..\..\..\src\tests\evals\LouisAgent.Evals.Runner.Tests\Fixtures\stub-run.txt" Link="Fixtures\stub-run.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\src\tests\evals\LouisAgent.Evals.Protocol.Tests\Fixtures\eval-protocol.jsonl"
          Link="Fixtures\eval-protocol.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\src\docs\projects\tests.md" Link="docs\tests.md" />
    <None Include="..\..\..\..\src\docs\guides\write-tests.md" Link="docs\write-tests.md" />
  </ItemGroup>

</Project>

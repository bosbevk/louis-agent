      },
      {
        "step": "reply",
        "from": "C",
        "to": "H",
        "text": "NowReport: busy items, shipped days, made at"
      },
      {
        "step": "reply",
        "from": "H",
        "to": "P",
        "text": "200 with the report, or 503 when none was ever read"
      },
      {
        "step": "reply",
        "from": "P",
        "to": "V",
        "text": "Busy with, Shipped lately, and when it was read"
      }

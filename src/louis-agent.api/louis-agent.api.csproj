<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\louis-agent.core\louis-agent.core.csproj" />
    <!-- CL15: the identities and packs this host may load, chosen by IDENTITIES and PACKS at start-up. -->
    <ProjectReference Include="..\louis-agent.composition\louis-agent.composition.csproj" />
    <!-- The web app it serves: the code-review app (louis-agent.web) by default, Puls with -p:WebApp=puls (Dockerfile.puls).
         Same API either way; only the static files differ. -->
    <ProjectReference Include="..\louis-agent.web\louis-agent.web.csproj" Condition="'$(WebApp)' != 'puls'" />
    <ProjectReference Include="..\louis-agent.puls\louis-agent.puls.csproj" Condition="'$(WebApp)' == 'puls'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="louis-agent.api.tests" />
    <InternalsVisibleTo Include="louis-agent.api.integration-tests" />
    <InternalsVisibleTo Include="louis-agent.api.testing" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LouisAgent.Api</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.api.md" Link="docs\louis-agent.api.md" />
    <None Include="..\..\docs\guides\change-the-api.md" Link="docs\change-the-api.md" />
  </ItemGroup>

</Project>

@* The app icon (wwwroot/brand/puls-icon-tile.svg) inline, so it can move (F24): the ripple mark on its charcoal tile,
   with the same glow crossing the rings outward from the green source as the logo has (.puls-glow, .puls-source in
   app.css), and the source beating. Used where the icon stands for the app itself: the landing page's hero and the
   empty chat. Ids are per instance, as the logo's are; the rings are the logo's (PulsMark.Rings). *@
<svg class="puls-tile" viewBox="0 0 160 160" aria-hidden="true">
    <defs>
        <linearGradient id="@(_id)tile" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3a3f45" />
            <stop offset="1" stop-color="#24282c" />
        </linearGradient>
        <linearGradient id="@(_id)bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f7952f" />
            <stop offset="1" stop-color="#d9660b" />
        </linearGradient>
        <mask id="@(_id)cut" maskUnits="userSpaceOnUse" x="0" y="0" width="120" height="120">
            <circle cx="60" cy="60" r="58" fill="#fff" />
            @foreach (var (radius, width) in PulsMark.Rings)
            {
                <circle cx="30" cy="92" r="@radius" fill="none" stroke="#000" stroke-width="@width" />
            }
        </mask>
        <clipPath id="@(_id)disc"><circle cx="60" cy="60" r="58" /></clipPath>
    </defs>
    <rect width="160" height="160" rx="36" fill="url(#@(_id)tile)" />
    <g transform="translate(20 20)">
        <rect width="120" height="120" fill="url(#@(_id)bg)" mask="url(#@(_id)cut)" />
        <g clip-path="url(#@(_id)disc)">
            @foreach (var (radius, width) in PulsMark.Rings)
            {
                <circle class="puls-glow" cx="30" cy="92" r="@radius" fill="none" stroke="#fff" stroke-width="@width" />
            }
        </g>
        <circle class="puls-source" cx="30" cy="92" r="7.5" fill="#38b449" />
    </g>
</svg>

@code {
    private readonly string _id = "tile-" + Guid.NewGuid().ToString("N")[..8] + "-";
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>LouisAgent.CodeReview</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles Styles/ into wwwroot/css on every build. Build time only: nothing of it reaches the browser. -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.107.1" PrivateAssets="all" ExcludeAssets="runtime;compile" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\web\louis-agent.web\louis-agent.web.csproj" />
    <!-- CL30: the account pages and their client; a site that has accounts opts in here. -->
    <ProjectReference Include="..\..\..\..\src\web\louis-agent.web.accounts\louis-agent.web.accounts.csproj" />
    <!-- CL57: the eval studio's pages and their client; a site that has the studio opts in here. -->
    <ProjectReference Include="..\..\..\..\src\web\louis-agent.web.evals\louis-agent.web.evals.csproj" />
    <ProjectReference Include="..\..\..\..\packs\web\louis-agent.pack.files.web\louis-agent.pack.files.web.csproj" />
    <ProjectReference Include="..\..\..\..\packs\web\louis-agent.pack.git.web\louis-agent.pack.git.web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Sass compiler's settings are for the build, so they stay out of what's published. -->
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.code-review.md" Link="docs\louis-agent.code-review.md" />
    <None Include="..\..\docs\guides\change-the-web-app.md" Link="docs\change-the-web-app.md" />
  </ItemGroup>

</Project>

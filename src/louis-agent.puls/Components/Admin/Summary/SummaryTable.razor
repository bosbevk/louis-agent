@* One mode's roll-up (F18 step 5c.3): a line per slice, the overall one first. Counts are the runner's; the costs are the ledger's.
   Reworked 2026-10-26 (Louis: "too flat"): each row a rounded card and a bar behind each rate, in the pass-rates list's shape; the columns stay. *@
<div class="summary-mode">
    <h3>@Mode.Mode</h3>
    <div class="table-wrap">
        <table class="run-table summary-table">
            <thead>
                <tr>
                    <th>Slice</th><th class="num" title="Trials in the slice">n</th><th>Passed</th><th class="num" title="Passed over the counted trials">Pass rate</th>
                    <th class="num" title="Passed at least once in its trials: can the agent do this?">pass@k</th>
                    <th class="num" title="Passed every time: can a customer rely on it?">pass^k</th>
                    <th class="num">Unknown</th><th class="num" title="Left out of the rates: not the agent's failure">Infra</th><th class="num">Cost / trial</th><th class="num">Cost / pass</th><th>Tasks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slice in Mode.Slices)
                {
                    <tr class="summary-row @(slice.Slice == "overall" ? "overall" : "")">
                        <td class="s-slice">@slice.Slice</td>
                        <td class="s-n num">@slice.N</td>
                        <td class="s-passed">@SummaryText.Passed(slice)</td>
                        <td class="s-rate num">@Bar(slice, slice.PassRate, hat: false)@SummaryText.Rate(slice, slice.PassRate)</td>
                        <td class="s-at-k num">@Bar(slice, slice.PassAtK, hat: false)@SummaryText.Rate(slice, slice.PassAtK)</td>
                        <td class="s-hat-k num">@Bar(slice, slice.PassHatK, hat: true)@SummaryText.Rate(slice, slice.PassHatK)</td>
                        <td class="s-unknown num">@slice.Unknown</td>
                        <td class="s-infra num">@slice.Infrastructure</td>
                        <td class="s-cost-trial num">@SummaryText.Cost(slice.CostPerTrial, Currency)</td>
                        <td class="s-cost-pass num">@SummaryText.CostPerPass(slice, Currency)</td>
                        <td class="s-tasks">
                            <details>
                                <summary>@slice.Tasks.Count</summary>
                                @foreach (var task in slice.Tasks)
                                {
                                    <a class="s-task" href="admin/benchmarks/@RunId?task=@Uri.EscapeDataString(task)">@task</a>
                                }
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

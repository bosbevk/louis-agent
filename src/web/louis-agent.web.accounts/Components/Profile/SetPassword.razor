@* A first password for an account that came in through a provider; an account with one sees nothing here. *@
@if (!Me.HasPassword)
{
    <section class="account-section">
        <h2>@Text.SetPassword</h2>
        <p>@Text.SetPasswordIntro</p>
        <form class="account-form" @onsubmit="SetAsync">
            <AccountNotice Message="@_notice?.Message" Details="_notice?.Details ?? []" IsError="@_isError" />
            <PasswordField Label="@Text.NewPassword" @bind-Value="_password" Autocomplete="new-password" Hint="@Text.PasswordRules" />
            <PasswordField Label="@Text.ConfirmPassword" @bind-Value="_again" Autocomplete="new-password" />
            <div class="account-actions">
                <button class="account-button is-plain" type="submit" disabled="@_busy">@Text.SetPassword</button>
            </div>
        </form>
    </section>
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The framework's web: what every site built on it shares. The chat models, the API client's core, the turn view (with
       the delegation card), markdown, usage and currency. Each site keeps its own pages, look (CSS) and JavaScript for now;
       the shared components only emit class names. -->
  <PropertyGroup>
    <RootNamespace>LouisAgent.Web</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A component Razor can't find would be drawn as a plain HTML tag, and the build would still pass. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CL58: a library has no page to watch; left unset, the Sass package compiles its watcher attribute into us. -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <!-- CL58: a component's own X.razor.scss, compiled to the X.razor.css Blazor scopes and bundles; sasscompiler.json. -->
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.107.1" PrivateAssets="all" ExcludeAssets="runtime;compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- F18 step 1b: the web apps read the session stream through the one reader (CL11). -->
    <ProjectReference Include="..\..\engine\louis-agent.session-stream\louis-agent.session-stream.csproj" />
    <!-- F18 step 7.5.2: the browser parses and writes wire names too, through the same parser as the server. -->
    <ProjectReference Include="..\..\engine\louis-agent.choices\louis-agent.choices.csproj" />
    <!-- The API's replies as records (ADR 0045): the client reads what the API writes, never a JSON picked apart. -->
    <ProjectReference Include="..\..\hosts\louis-agent.api.contracts\louis-agent.api.contracts.csproj" />
    <!-- CL60.1: the diagrams GraphView draws, in their own plain-C# library, which the docs' tool draws with too. -->
    <ProjectReference Include="..\louis-agent.diagrams\louis-agent.diagrams.csproj" />
    <!-- F144: the web's own messages, filled as every project's are (MessageText, [Holes]; ADR 0009, 0119). -->
    <ProjectReference Include="..\..\engine\louis-agent.composition\louis-agent.composition.csproj" />

    <!-- The Sass compiler's settings are read at build time only; published, the three libraries' copies would land
         on one path and dotnet publish refuses (FX62). -->
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="false" />
    <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
         built or copied. -->
    <None Include="..\..\docs\projects\louis-agent.web.md" Link="docs\louis-agent.web.md" />
    <None Include="..\..\docs\guides\change-the-web.md" Link="docs\change-the-web.md" />
  </ItemGroup>

</Project>

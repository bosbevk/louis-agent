@* Where the user is (F22): typed, or found by the browser (to ~1 km) and named by OpenStreetMap's Nominatim.
   Kept in this browser; sent with a new chat only when set (the time zone is sent always). *@
<label class="settings">
    Ligging
    <input type="text" value="@Location" @onchange="e => OnSave.InvokeAsync(e.Value?.ToString())" placeholder="bv. Pretoria" maxlength="120" />
</label>
<div class="locate">
    <button class="locate-button" type="button" @onclick="OnLocate" disabled="@Locating">
        <span class="ic i-pin" aria-hidden="true"></span>@(Locating ? "Soek…" : "Gebruik my ligging")
    </button>
    <small>Name: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a></small>
</div>

@code {
    [Parameter] public string? Location { get; set; }
    [Parameter] public bool Locating { get; set; }

    /// <summary>The typed place, as typed; the page trims it and keeps it in this browser.</summary>
    [Parameter] public EventCallback<string?> OnSave { get; set; }
    [Parameter] public EventCallback OnLocate { get; set; }
}

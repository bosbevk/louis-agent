<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LouisAgent.PulsEvalRunner</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's eval runner; this program only says what Puls's evals can name. -->
        <ProjectReference Include="..\..\..\..\src\evals\louis-agent.evals.runner\louis-agent.evals.runner.csproj" />
        <!-- ADR 0073: what proves Puls and its packs. Only this program references them, so no host carries a check, and
             their eval folders reach this program's output through these references. -->
        <ProjectReference Include="..\..\evals\louis-agent.identity.puls.judges\louis-agent.identity.puls.judges.csproj" />
        <ProjectReference Include="..\..\evals\louis-agent.identity.puls.evals\louis-agent.identity.puls.evals.csproj" />
        <ProjectReference Include="..\..\..\..\packs-evals\louis-agent.pack.where-to-buy.checks\louis-agent.pack.where-to-buy.checks.csproj" />
        <ProjectReference Include="..\..\..\..\packs-evals\louis-agent.pack.recipes.checks\louis-agent.pack.recipes.checks.csproj" />
        <!-- F49.2: Puls's list of identities and packs, for the toolsets an eval's modes name. -->
        <ProjectReference Include="..\louis-agent.host-packs\louis-agent.host-packs.csproj" />
    </ItemGroup>

</Project>

@* F20: the Werk panel, the dashboard's right column. The work Puls handed out in this chat, newest first: who did it,
   with which toolsets, the task, the specialist's steps as they happen, and what it cost. The same data as the
   delegation card in the answer (Block.SubTurn), kept beside the chat so the answer stays readable. *@
@inject ChatText Text

<div class="work-head">
    <span class="work-title">Werk</span>
    @if (Items.Count > 0)
    {
        <span class="work-count">@Items.Count</span>
    }
    <button class="icon d-none d-xl-inline-grid" type="button" onclick="pulsUi.toggleWork()" title="Versteek die werkpaneel" aria-label="Versteek die werkpaneel">⇥</button>
    <button class="icon d-xl-none" type="button" data-bs-dismiss="offcanvas" data-bs-target="#work" aria-label="Maak die werkpaneel toe">×</button>
</div>

<div class="work-body">
    @if (Items.Count == 0)
    {
        <div class="work-empty">
            <img src="brand/puls-mark.svg" alt="" width="56" height="56" />
            <strong>Nog geen werk nie</strong>
            <p>Wanneer Puls 'n taak oordra, sien jy hier die spesialis se stappe, gereedskap en koste, terwyl dit gebeur.</p>
        </div>
    }
    @foreach (var item in Items)
    {
        var sub = item.Block.SubTurn;
        var steps = sub?.Blocks.Where(b => b.Kind == BlockKind.Tool).ToList() ?? [];
        int thoughts = sub?.Blocks.Count(b => b.Kind == BlockKind.Thinking) ?? 0;
        <section class="work-item @item.Status">
            <div class="work-item-head">
                <img src="brand/puls-icon-tile.svg" alt="" class="work-avatar" />
                <div class="work-who">
                    <small>@Text.DelegatedTo</small>
                    <strong>@item.Who</strong>
                </div>
                <span class="work-status">@(item.Status switch { "running" => Text.Working, "failed" => Text.Failed, _ => Text.Done })</span>
            </div>

            @if (item.Delegation.Toolsets.Count > 0 || item.Delegation.Continued)
            {
                <div class="work-chips">
                    @if (item.Delegation.Continued)
                    {
                        <span class="toolset-chip follow-up">@Text.FollowUp</span>
                    }
                    @foreach (string toolset in item.Delegation.Toolsets)
                    {
                        <span class="toolset-chip">@toolset</span>
                    }
                </div>
            }

            @if (item.Delegation.Task is { Length: > 0 } task)
            {
                <p class="work-task" title="@task">@task</p>
            }

            <div class="work-label">Stappe</div>
            @if (steps.Count == 0 && thoughts == 0)
            {
                <div class="work-step waiting">@(item.Status == "running" ? Text.Starting + "…" : "—")</div>
            }
            <ol class="work-steps">
                @foreach (var step in steps)
                {
                    string state = step.ToolResult is null ? "waiting" : step.ToolFailed ? "failed" : "ok";
                    @if (Delegation.From(step) is { Minion: true } minion)
                    {
                        @* F30 step 6b (Louis: "display when a minion was called"): the specialist handed one page to a minion;
                           its role, tool and model, its own step and what it cost, nested under the specialist's steps. *@
                        var minionSteps = step.SubTurn?.Blocks.Where(b => b.Kind == BlockKind.Tool).ToList() ?? [];
                        <li class="work-step minion @state">
                            <span class="work-step-mark">@(step.ToolResult is null ? "⋯" : step.ToolFailed ? "✗" : "✓")</span>
                            <div class="work-minion">
                                <div class="work-minion-head">
                                    <span class="work-step-name">@Text.MinionLabel</span>
                                    <span class="work-minion-role">@(minion.Role ?? step.ToolName)</span>
                                    @if (minion.Continued)
                                    {
                                        <span class="toolset-chip follow-up">@Text.FollowUp</span>
                                    }
                                    @foreach (string tool in minion.Toolsets)
                                    {
                                        <span class="toolset-chip">@tool</span>
                                    }
                                    @if (minion.Llm is { } llm)
                                    {
                                        <span class="toolset-chip model">@Text.OnModel @llm</span>
                                    }
                                </div>
                                @if (minion.Task is { Length: > 0 } minionTask)
                                {
                                    <div class="work-minion-task" title="@minionTask">@minionTask</div>
                                }
                                @if (minionSteps.Count > 0)
                                {
                                    <ol class="work-steps nested">
                                        @foreach (var inner in minionSteps)
                                        {
                                            <li class="work-step @(inner.ToolResult is null ? "waiting" : inner.ToolFailed ? "failed" : "ok")">
                                                <span class="work-step-mark">@(inner.ToolResult is null ? "⋯" : inner.ToolFailed ? "✗" : "✓")</span>
                                                <span class="work-step-name">@inner.ToolName</span>
                                                @if (Summarise(inner.ToolInput) is { Length: > 0 } innerArgs)
                                                {
                                                    <span class="work-step-args">@innerArgs</span>
                                                }
                                            </li>
                                        }
                                    </ol>
                                }
                                @if (step.SubTurn?.Usage is { } minionUsage)
                                {
                                    <div class="work-minion-cost" title="@UsageFormat.Detail(minionUsage, Currency)">@UsageFormat.Cost(minionUsage, Currency) · @minionUsage.Requests versoeke</div>
                                }
                                else if (minion.UsageLine is { } minionLine)
                                {
                                    <div class="work-minion-cost">@minionLine</div>
                                }
                            </div>
                        </li>
                        continue;
                    }
                    <li class="work-step @state">
                        <span class="work-step-mark">@(step.ToolResult is null ? "⋯" : step.ToolFailed ? "✗" : "✓")</span>
                        <span class="work-step-name">@step.ToolName</span>
                        @if (Summarise(step.ToolInput) is { Length: > 0 } args)
                        {
                            <span class="work-step-args">@args</span>
                        }
                    </li>
                }
            </ol>
            @if (thoughts > 0)
            {
                <div class="work-thoughts">@Text.Steps(steps.Count, thoughts)</div>
            }

            @if (sub?.Usage is { } usage)
            {
                <div class="work-cost" title="@UsageFormat.Detail(usage, Currency)">
                    <span>Koste</span>
                    <strong data-count="@UsageFormat.Cost(usage, Currency)">@UsageFormat.Cost(usage, Currency)</strong>
                    <span>@usage.Requests versoeke</span>
                </div>
            }
            else if (item.Delegation.UsageLine is { } line)
            {
                <div class="work-cost"><span>@line</span></div>
            }
        </section>
    }
</div>

@* What the chat cost so far: Puls's own requests and its specialists', side by side. Not added up: the chat's usage
   doesn't include the specialists' yet (the F5 roll-up), and once it does, a sum here would count them twice. *@
@* The pages this chat used or cited (F20): the answers' links and the pages the specialists read, newest turn first. *@
@if (ChatSources.Count > 0)
{
    <div class="work-sources">
        <div class="work-label">Bronne <span class="work-count">@ChatSources.Count</span></div>
        @foreach (var source in ChatSources)
        {
            <a class="work-source" href="@source.Url" target="_blank" rel="noopener noreferrer" title="@source.Url">
                <span class="source-dot">@source.Site[..1].ToUpperInvariant()</span>
                <span class="work-source-text"><strong>@source.Title</strong><small>@Address(source.Url)</small></span>
            </a>
        }
    </div>
}

@if (Chat?.Usage() is { } own)
{
    <div class="work-foot">
        @* data-count: a changed cost counts up to its value (F24, pulsUi.countCosts). *@
        <span title="@UsageFormat.Detail(own, Currency)">Puls <strong data-count="@UsageFormat.Cost(own, Currency)">@UsageFormat.Cost(own, Currency)</strong></span>
        @if (SpecialistUsage is { } specialists)
        {
            <span title="@UsageFormat.Detail(specialists, Currency)">Spesialiste <strong data-count="@UsageFormat.Cost(specialists, Currency)">@UsageFormat.Cost(specialists, Currency)</strong></span>
        }
    </div>
}

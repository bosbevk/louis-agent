@* A business's website, mocked (F127.1, Louis's pick 3a, made fuller: "a bit bland, we need to sell it"): a browser bar
   with its address, its header with its sample brand (its mark, its name and tagline, its typeface) and its menu, then
   its page, which scrolls inside the mock: on home the hero in the business's look with its scene and a call to
   action and a strip of facts, then its pages (F127.2), only the one it's on showing. Its agent sits in a widget in
   the corner, where its customers would meet it, and the place it shows is in the bar, lit, and scrolled to. *@
<div class="@Classes" style="@ColourStyle">
    @* A page change loads like a browser (F127.2): its address glows and a loading line runs under the bar, both drawn
       afresh on each change, so they play again. *@
    <div class="mock-chrome" aria-hidden="true">
        <i></i><i></i><i></i>
        <span class="@AddressClass" @key="AddressKey">@Address@Here</span>
        @if (_pageChanges > 0)
        {
            <span class="mock-loading" @key="LoadingKey"></span>
        }
    </div>
    <div class="mock-header">
        @if (Mark is not null)
        {
            <span class="mock-mark" aria-hidden="true">@Mark</span>
        }
        <span class="mock-names">
            <b class="mock-name">@Business</b>
            @if (Tagline is not null)
            {
                <span class="mock-tagline">@Tagline</span>
            }
        </span>
        @* Its menu: its pages, which a visitor can click through (F127.2). *@
        <span class="mock-nav">
            @foreach (var entry in MenuPages)
            {
                <button class="@NavClass(entry)" type="button" aria-current="@CurrentMark(entry)"
                        @onclick="() => GoAsync(entry.Path)">@entry.Label</button>
            }
        </span>
    </div>
    <div class="mock-page" @ref="_page">
        @if (ShowsHome)
        {
            <div class="mock-hero">
                <div class="mock-hero-words">
                    <p class="mock-hero-line">@HeroLine</p>
                    @if (HeroNote is not null)
                    {
                        <p class="mock-hero-note">@HeroNote</p>
                    }
                    @if (HeroAction is not null)
                    {
                        <span class="mock-action">@HeroAction</span>
                    }
                </div>
                @if (HeroPhoto is not null)
                {
                    <div class="mock-scene is-photo">
                        <img class="mock-photo" src="@HeroPhoto" alt="@HeroPhotoAlt" />
                        <span class="mock-photo-badge">
                            @if (Mark is not null)
                            {
                                <span class="mock-mark" aria-hidden="true">@Mark</span>
                            }
                            <b>@Business</b>
                        </span>
                    </div>
                }
                else if (Scene is not null)
                {
                    <div class="mock-scene" aria-hidden="true">@Scene</div>
                }
            </div>
            @if (Facts.Count > 0)
            {
                <ul class="mock-facts">
                    @foreach (var fact in Facts)
                    {
                        <li>@fact</li>
                    }
                </ul>
            }
        }
        @* Its pages learn their mock and the page it's on; their places, the place its agent showed. *@
        <CascadingValue Name="@ShownPlace" Value="Shown">
            <CascadingValue Value="this" IsFixed="true">
                <CascadingValue Name="@CurrentPageName" Value="CurrentPage">@Pages</CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
    <MockWidget Mark="Mark" Label="@AgentLabel">@Agent</MockWidget>
</div>

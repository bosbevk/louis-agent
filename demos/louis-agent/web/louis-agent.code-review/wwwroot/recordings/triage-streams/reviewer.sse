event: content_block_start
data: {"type":"content_block_start","index":15,"content_block":{"type":"tool_result","tool_use_id":"toolu_01LutxZDsXovinEgDDQ6ow6e","content":"using OrderService;\n\nnamespace OrderService.Tests.Regression;\n\n/// <summary>\n/// Regression: order 1003 carries the retired code SUMMER25, which is not in DiscountRates. The total used to throw\n/// KeyNotFoundException. Per the runbook, an unknown or retired code gives no discount: the total is the subtotal.\n/// </summary>\npublic class OrderTotalRetiredCodeTests\n{\n    [Test]\n    public void GetOrderTotal_RetiredCode_IsTheSubtotal() =>\n        // 3 x MUG-2 @ 8.00 + 2 x TEA-7 @ 5.50 = 35.00, no discount applied.\n        Assert.That(OrderApiTests.Api().GetOrderTotal(1003), Is.EqualTo(35.00m));\n\n    [Test]\n    public void GetOrderTotal_VipCode_StillAppliesItsRate() =>\n        // 79.90 with VIP20 (20% off) = 63.92.\n        Assert.That(OrderApiTests.Api().GetOrderTotal(1004), Is.EqualTo(63.92m));\n}\n","is_error":false}}

event: content_block_stop
data: {"type":"content_block_stop","index":15}

event: content_block_start
data: {"type":"content_block_start","index":16,"content_block":{"type":"tool_result","tool_use_id":"toolu_01U8o4vHxTVB8podis5bnoZ5","content":"using System.Globalization;\r\n\r\nnamespace OrderService;\r\n\r\npublic sealed partial class OrderApi\r\n{\r\n    /// <summary>GET /orders/{id}/discount-label - how the receipt shows the code, e.g. \"WELCOME (10% off)\".</summary>\r\n    public string GetDiscountLabel(int id)\r\n    {\r\n        Order order = _orders.Get(id);\r\n        string code = order.DiscountCode;\r\n        if (code.Length == 0) return \"no discount\";\r\n\r\n        int percent = int.Parse(code[^2..], CultureInfo.InvariantCulture);\r\n        return $\"{code[..^2]} ({percent}% off)\";\r\n    }\r\n}\r\n","is_error":false}}


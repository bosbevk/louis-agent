{
  "kind": "sequence",
  "title": "F154 The answer's motion: one answer, in and out",
  "caption": "The card grows out of the bar, its words come at a steady pace, and when it is put away it fades before it is taken from the page.",
  "sequence": {
    "participants": [
      { "id": "runner", "label": "ChatRunner", "icon": "message", "tone": "violet" },
      { "id": "bar", "label": "AgentBar", "icon": "stack", "tone": "teal" },
      { "id": "caption", "label": "AgentCaption", "icon": "file", "tone": "teal" },
      { "id": "pace", "label": "WordPace", "icon": "clock", "tone": "green" },
      { "id": "motion", "label": "The motion module", "icon": "chip", "tone": "green" }
    ],
    "steps": [
      { "step": "message", "from": "runner", "to": "bar", "text": "the answer's first words" },
      { "step": "message", "from": "bar", "to": "caption", "text": "draw it" },
      { "step": "message", "from": "caption", "to": "motion", "text": "growFrom(caption, the bar)" },
      { "step": "message", "from": "caption", "to": "pace", "text": "Shown(arrived, since, done), each frame" },
      { "step": "reply", "from": "pace", "to": "caption", "text": "how many letters to show" },
      { "step": "note", "over": ["caption"], "text": "the words keep coming at a steady pace until all have shown" },

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LouisAgent.Core</RootNamespace>
        <IsPackable>true</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Keeps the embedded prompts' folder paths (ManifestEmbeddedFileProvider). -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
      <!-- F18 step 1c: core reads a peer's stream through the one session-stream reader (CL11); the reader references nothing. -->
      <ProjectReference Include="..\LouisAgent.SessionStream\LouisAgent.SessionStream.csproj" />
      <!-- F18 step 7.5.2: the one parser for a name that is an enum member (SettingChoice); packs, identities and eval sets get it through core. -->
      <ProjectReference Include="..\LouisAgent.Choices\LouisAgent.Choices.csproj" />
      <ProjectReference Include="..\LouisAgent.Composition\LouisAgent.Composition.csproj" />
    </ItemGroup>

  <ItemGroup>
      <InternalsVisibleTo Include="LouisAgent.Core.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Web" />
      <InternalsVisibleTo Include="LouisAgent.Core.Telemetry" />
      <InternalsVisibleTo Include="LouisAgent.Core.Web.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Telemetry.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Anthropic" />
      <InternalsVisibleTo Include="LouisAgent.Core.Ollama" />
      <InternalsVisibleTo Include="LouisAgent.Core.OpenAi" />
      <InternalsVisibleTo Include="LouisAgent.Core.Anthropic.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Ollama.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.OpenAi.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Anthropic" />
      <InternalsVisibleTo Include="LouisAgent.Core.Ollama" />
      <InternalsVisibleTo Include="LouisAgent.Core.OpenAi" />
      <InternalsVisibleTo Include="LouisAgent.Core.Anthropic.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.Ollama.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.OpenAi.Tests" />
    <InternalsVisibleTo Include="LouisAgent.Packs.Web.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Coding.Catalog.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Core.IntegrationTests" />
      <!-- The API's file browser applies the same workspace and secret-file rules as the agent's tools. -->
      <InternalsVisibleTo Include="LouisAgent.Api" />
      <InternalsVisibleTo Include="LouisAgent.Api.Evals" />
      <InternalsVisibleTo Include="LouisAgent.Api.Evals.Tests" />
      <!-- The orchestrator runs git and dotnet against the service it watches without a shell, like the tools do. -->
      <InternalsVisibleTo Include="LouisAgent.Orchestrator" />
      <InternalsVisibleTo Include="LouisAgent.Orchestrator.Tests" />
      <InternalsVisibleTo Include="LouisAgent.Orchestrator.IntegrationTests" />
      <PackageReference Include="dotenv.net" Version="4.2.0" />
      <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Composite" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- CL8 step 4: the built-in prompts live in prompts/, one folder per level beside toolsets/, and are read only from
           the assembly (Skills/SkillFileSource), by their own paths through the manifest. What the agent writes stays on
           disk, in the skills folder (SKILLS_DIRECTORY, else the repo's Skills/). -->
      <EmbeddedResource Include="shared\**\*.md;toolsets\**\*.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- This project's design doc and how-to, shown under docs/ in the IDE's solution explorer; nothing is
             built or copied. -->
        <None Include="..\..\docs\projects\LouisAgent.Core.md" Link="docs\LouisAgent.Core.md" />
        <None Include="..\..\docs\guides\change-the-engine.md" Link="docs\change-the-engine.md" />
    </ItemGroup>

</Project>

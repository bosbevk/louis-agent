<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The framework's site's own host (F124): the site as HTML, and the API its guide's chat runs on. Its catalogue is
         the guide and its three packs, so the public site reaches nothing else. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>LouisAgent.SiteApi</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The framework's API and the engine's web and telemetry; this program says what it loads. -->
        <ProjectReference Include="..\..\engine\LouisAgent.Core.Web\LouisAgent.Core.Web.csproj" />
        <ProjectReference Include="..\..\engine\LouisAgent.Core.Telemetry\LouisAgent.Core.Telemetry.csproj" />
        <!-- The guide's model: Anthropic's, the one provider this program composes. -->
        <ProjectReference Include="..\..\engine\LouisAgent.Core.Anthropic\LouisAgent.Core.Anthropic.csproj" />
        <ProjectReference Include="..\..\hosts\LouisAgent.Api\LouisAgent.Api.csproj" />
        <!-- F126.3.1: the evals of the site's agents, mapped beside the API's routes. -->
        <ProjectReference Include="..\..\hosts\LouisAgent.Api.Evals\LouisAgent.Api.Evals.csproj" />
        <!-- The guide and the three packs it answers with. -->
        <ProjectReference Include="..\LouisAgent.Identities.Guide\LouisAgent.Identities.Guide.csproj" />
        <ProjectReference Include="..\LouisAgent.Identities.Showroom\LouisAgent.Identities.Showroom.csproj" />
        <ProjectReference Include="..\..\..\packs\tools\LouisAgent.Packs.Docs\LouisAgent.Packs.Docs.csproj" />
        <ProjectReference Include="..\..\..\packs\tools\LouisAgent.Packs.Leads\LouisAgent.Packs.Leads.csproj" />
        <ProjectReference Include="..\..\..\packs\tools\LouisAgent.Packs.Site\LouisAgent.Packs.Site.csproj" />
        <!-- The web app this program serves. Its files reach this project's output through this reference. -->
        <ProjectReference Include="..\LouisAgent.Site\LouisAgent.Site.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    </ItemGroup>

</Project>
